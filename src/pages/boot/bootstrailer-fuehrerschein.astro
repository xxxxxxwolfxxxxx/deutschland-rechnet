---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'bootstrailer-fuehrerschein')!;
const cat = CATEGORIES[calc.category];
---
<Layout
  title="Bootstrailer-Führerschein: B, B96 oder BE?"
  description="Prüfen Sie, ob Ihr Trailergespann mit Klasse B gefahren werden darf – oder ob B96 oder BE nötig ist. Nach zulässiger Gesamtmasse gemäß § 6 FeV."
  canonicalPath="/boot/bootstrailer-fuehrerschein/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}boot/`} class="back-link">← Boot & Wasser</a>
    <h1>Bootstrailer-Führerschein – reicht Klasse B für mein Gespann?</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Ob Sie Ihr Boot mit dem vorhandenen Führerschein zum Wasser ziehen dürfen, entscheidet nicht das gewogene Gewicht, sondern die zulässige Gesamtmasse aus den Fahrzeugpapieren. Dieser Rechner sagt Ihnen, ob Klasse B genügt oder ob Sie B96 oder BE brauchen."
    sourceNote="Rechtsgrundlage: § 6 Fahrerlaubnis-Verordnung (FeV), Rechtslage seit 19.01.2013. Ohne Gewähr – im Zweifel entscheidet die Fahrerlaubnisbehörde."
    explanation="Anhänger bis 750 kg zGM sind mit Klasse B immer erlaubt. Darüber gilt: Zugfahrzeug-zGM plus Anhänger-zGM dürfen zusammen 3.500 kg nicht überschreiten. Bis 4.250 kg genügt die Schlüsselzahl 96 (Schulung ohne Prüfung), darüber ist BE mit praktischer Prüfung nötig."
    faqs={[
      {
        q: "Zählt das tatsächliche Gewicht oder die zulässige Gesamtmasse?",
        a: "Immer die zulässige Gesamtmasse (zGM) aus den Fahrzeugpapieren – Feld F.1 bzw. F.2 im Fahrzeugschein. Was tatsächlich auf der Waage steht, ist für die Führerscheinklasse ohne Bedeutung. Ein 900-kg-Boot auf einem Trailer mit 1.500 kg zGM wird nach 1.500 kg beurteilt."
      },
      {
        q: "Was genau ist die Schlüsselzahl 96?",
        a: "Eine Erweiterung der Klasse B für Kombinationen zwischen 3.500 und 4.250 kg. Sie erfordert eine Fahrerschulung von sieben Zeitstunden (Theorie und Praxis), aber keine Prüfung. Sie wird als Zahl 96 hinter der Klasse B im Führerschein eingetragen."
      },
      {
        q: "Kann ich die zGM meines Trailers herabsetzen lassen?",
        a: "Ja, eine Auflastung oder Ablastung ist bei vielen Trailern möglich und wird von einer Prüfstelle eingetragen. Eine Ablastung kann ein Gespann wieder in die Klasse B bringen – reduziert aber entsprechend die zulässige Zuladung."
      },
      {
        q: "Gilt das auch für alte Führerscheine von vor 1999?",
        a: "Wer die alte Klasse 3 vor dem 01.01.1999 erworben hat, besitzt umfangreichere Rechte (unter anderem BE bis 12.000 kg Kombination). Dieser Rechner bildet die heutige Klasse B ab – mit einem Führerschein der alten Klasse 3 sind Sie in der Regel deutlich besser gestellt."
      },
      {
        q: "Darf ich mit dem Gespann 100 km/h fahren?",
        a: "Nur mit Tempo-100-Zulassung für den Anhänger, geeigneten Reifen, Stoßdämpfern und einer entsprechenden Bescheinigung. Ohne diese Zulassung gilt auf Autobahnen 80 km/h. Die Führerscheinklasse hat damit nichts zu tun."
      }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="zugfahrzeug">Zugfahrzeug – zul. Gesamtmasse (kg)</label>
          <input type="number" id="zugfahrzeug" min="500" max="7500" value="2100" step="50" />
        </div>
        <div class="calc-group">
          <label for="anhaenger">Trailer inkl. Boot – zul. Gesamtmasse (kg)</label>
          <input type="number" id="anhaenger" min="100" max="5000" value="1300" step="50" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Erforderliche Führerscheinklasse</div>
        <div id="klasse">—</div>
      </div>
      <p id="kombination" style="margin-top:0.5rem;font-size:0.9rem;font-weight:600;"></p>
      <p id="hinweis" style="margin-top:0.35rem;font-size:0.85rem;color:#666;line-height:1.5;"></p>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Trailergespann und Führerschein – worauf es ankommt"
    content="
    <p>Der Weg zum Wasser ist für viele Bootsbesitzer der unterschätzte Teil des Hobbys. Wer sein Boot trailert, bewegt ein Gespann, das rechtlich anders behandelt wird als ein einzelnes Fahrzeug – und die Grenzen verlaufen nicht dort, wo das Bauchgefühl sie vermutet.</p>

    <p><strong>Die entscheidende Zahl steht in den Papieren:</strong> Maßgeblich ist ausschließlich die zulässige Gesamtmasse, nicht das reale Gewicht. Das ist der häufigste und teuerste Irrtum. Ein Trailer mit 1.500 kg zGM zählt mit 1.500 kg, auch wenn er leer nur 200 kg wiegt und das Boot 900 kg. Bei einer Kontrolle wird nach Papieren beurteilt, nicht nach Waage.</p>

    <p><strong>Die 750-kg-Regel:</strong> Anhänger bis 750 kg zGM sind mit Klasse B immer erlaubt, unabhängig vom Zugfahrzeug. Das deckt kleine Trailer mit Schlauchbooten, Jollen und leichten Angelbooten ab. Sobald der Trailer schwerer zugelassen ist, greift die Kombinationsrechnung.</p>

    <p><strong>Die Kombinationsrechnung:</strong> Zugfahrzeug-zGM plus Anhänger-zGM ergeben die Kombination. Bis 3.500 kg reicht B, bis 4.250 kg reicht B96, darüber ist BE nötig. Ein typischer Mittelklasse-Kombi mit 2.100 kg zGM lässt also noch 1.400 kg für den Trailer – das reicht für Boote bis etwa sieben Meter.</p>

    <p><strong>B96 ist der günstige Zwischenschritt:</strong> Sieben Zeitstunden Schulung, keine Prüfung, kein Fahrlehrer-Marathon. Wer nur knapp über 3.500 kg liegt, spart sich damit die vollständige BE-Ausbildung mit praktischer Prüfung.</p>

    <p><strong>Ablastung als Alternative:</strong> Viele Trailer lassen sich auf eine niedrigere zGM ablasten. Das bringt ein Gespann zurück in die Klasse B, reduziert aber die zulässige Zuladung – für ein Boot, das ohnehin leichter ist als die Trailer-Zulassung hergibt, oft die eleganteste Lösung.</p>

    <p><strong>Stützlast nicht vergessen:</strong> Neben der Masse begrenzt die Stützlast der Anhängerkupplung, wie das Boot auf dem Trailer liegen darf. Sie steht in den Papieren des Zugfahrzeugs und liegt meist zwischen 50 und 100 kg. Eine zu geringe Stützlast lässt das Gespann bei höherem Tempo schlingern.</p>
    "
    relatedSlugs={['spritverbrauch-boot', 'rumpfgeschwindigkeit', 'kfz-steuer-rechner']}
  />
</Layout>

<script type="module">
const { berechneBootstrailer } = await import(window.__base + 'scripts/bootstrailer.js');

const KLASSEN_TEXT = {
  B:    'Klasse B genügt',
  B96:  'Klasse B96 erforderlich',
  BE:   'Klasse BE erforderlich',
  C1E:  'Außerhalb der Klasse B',
};

function fmtKg(n) { return n.toLocaleString('de-DE') + ' kg'; }

function berechne() {
  const zugfahrzeugKg = parseFloat(document.getElementById('zugfahrzeug').value) || 0;
  const anhaengerKg = parseFloat(document.getElementById('anhaenger').value) || 0;
  const r = berechneBootstrailer({ zugfahrzeugKg, anhaengerKg });

  document.getElementById('klasse').textContent = KLASSEN_TEXT[r.klasse];

  const kombiEl = document.getElementById('kombination');
  kombiEl.textContent = `Kombination: ${fmtKg(r.kombinationKg)}`
    + (r.spielraumKg > 0 ? ` · noch ${fmtKg(r.spielraumKg)} Spielraum` : '');
  kombiEl.style.color = r.erlaubtMitB ? '#1e7e34' : '#b71c1c';

  document.getElementById('hinweis').textContent = r.hinweis;
}

['zugfahrzeug','anhaenger'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne)
);
berechne();
</script>
