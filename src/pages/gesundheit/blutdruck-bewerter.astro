---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelBlutdruck from '../../components/artikel/blutdruck-optimal-und-erhoeht.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'blutdruck-bewerter')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Blutdruck-Bewerter ${year}`}
  description="Blutdruckwerte nach der ESH-Leitlinie einordnen: Fallen oberer und unterer Wert in verschiedene Kategorien, zählt die höhere."
  canonicalPath="/gesundheit/blutdruck-bewerter/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}gesundheit/`} class="back-link">← Gesundheit &amp; Fitness</a>
    <h1>Blutdruck-Bewerter {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Blutdruck-Bewerter ordnen Sie einen gemessenen Wert in die sechs Kategorien der europäischen Leitlinie ein – von optimal bis Hypertonie Grad 3. Der Rechner zeigt auch, welcher der beiden Werte die Einstufung trägt. Er ersetzt keine ärztliche Abklärung."
    sourceNote="Kategorien nach der ESH-Leitlinie 2023 (Praxismessung, Erwachsene), wie sie die Deutsche Hochdruckliga wiedergibt: optimal unter 120/80, Hypertonie ab 140/90. Fallen beide Werte in verschiedene Kategorien, gilt die höhere."
explanation="Die ESH-Leitlinie kennt sechs Kategorien: optimal (unter 120/80), normal (ab 120/80), hoch-normal (ab 130/85) und Hypertonie Grad 1 bis 3 (ab 140/90, 160/100 und 180/110). Maßgeblich ist immer die höhere der beiden Einstufungen – ein oberer Wert von 145 bedeutet Grad 1, auch wenn der untere Wert bei 85 liegt. Liegt nur einer der beiden Werte über 140 bzw. 90, spricht die Leitlinie von isolierter systolischer oder diastolischer Hypertonie. Ein einzelner Messwert ist keine Diagnose: Sie beruht auf wiederholten Messungen, und zu Hause gelten niedrigere Grenzen."
    faqs={[
      {
        q: "Was ist der Unterschied zwischen systolisch und diastolisch?",
        a: "Der systolische Wert (oben) misst den Druck beim Herzschlag, der diastolische Wert (unten) den Druck in der Entspannungsphase. Beide sind wichtig für die Bewertung der Herzgesundheit."
      },
      {
        q: "Ab wann ist Blutdruck zu hoch?",
        a: "In der Praxis gemessen spricht die ESH-Leitlinie ab 140/90 mmHg von Hypertonie – es genügt, dass einer der beiden Werte die Grenze erreicht. Bei der Selbstmessung zu Hause liegt dieselbe Grenze bei 135/85 mmHg, weil der Blutdruck in der Praxis im Mittel höher ausfällt."
      },
      {
        q: "Wie kann ich meinen Blutdruck senken?",
        a: "Regelmäßige Bewegung, Salzreduktion, Stressabbau, weniger Alkohol und eine ausgewogene Ernährung helfen nachweislich, den Blutdruck zu senken."
      },
      {
        q: "Warum ist Blutdruckmessung mehrmals täglich sinnvoll?",
        a: "Der Blutdruck schwankt tagsüber natürlicherweise. Mehrfachmessungen geben ein realistischeres Bild und helfen, Messfehler auszuschließen."
      },
      {
        q: "Sollte ich bei hohem Blutdruck zum Arzt?",
        a: "Ja, insbesondere wenn Werte dauerhaft über 140/90 liegen oder Sie Symptome wie Kopfschmerzen haben. Ein Arzt kann die Ursache klären und eine Behandlung empfehlen."
      },
      {
        q: "Beeinflussen Alter und Geschlecht die optimalen Blutdruckwerte?",
        a: "Die Kategorien der Leitlinie gelten unabhängig von Alter und Geschlecht für Erwachsene; der Rechner nutzt das Alter deshalb nicht für die Einstufung. Welcher Zielwert für eine einzelne Person sinnvoll ist, entscheidet die behandelnde Ärztin oder der Arzt."
      }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="systolisch">Systolisch (oberer Wert, mmHg)</label>
          <input type="number" id="systolisch" min="60" max="250" value="120" step="1" />
        </div>
        <div class="calc-group">
          <label for="diastolisch">Diastolisch (unterer Wert, mmHg)</label>
          <input type="number" id="diastolisch" min="40" max="150" value="80" step="1" />
        </div>
        <div class="calc-group">
          <label for="alter">Alter (Jahre)</label>
          <input type="number" id="alter" min="18" max="100" value="40" step="1" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label" id="ergebnis-label">Einstufung</div>
        <div id="ergebnis">—</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
    <ArtikelBlutdruck slot="artikel" />
  </CalculatorShell>
</Layout>

<script type="module">
const { klassifiziereBlutdruck, HYPERTONIE_AB_HEIM } = await import(window.__base + 'scripts/blutdruck.js');
const FARBEN = ['#1e7e34', '#1e7e34', '#b8860b', '#e65100', '#b71c1c', '#b71c1c'];
const HINWEISE = [
  'Im Zielbereich.',
  'Im Zielbereich.',
  'Noch keine Hypertonie, aber nah an der Grenze – im Auge behalten.',
  'Ab hier spricht die Leitlinie von Bluthochdruck: ärztlich abklären lassen.',
  'Deutlich erhöht: ärztlich abklären lassen.',
  'Stark erhöht: kurzfristig ärztlich abklären lassen.',
];
function berechne() {
  const sys = parseInt(document.getElementById('systolisch').value, 10) || 0;
  const dia = parseInt(document.getElementById('diastolisch').value, 10) || 0;
  const alter = parseInt(document.getElementById('alter').value, 10) || 0;
  const r = klassifiziereBlutdruck({ systolisch: sys, diastolisch: dia });
  document.getElementById('ergebnis-label').textContent = r.name;
  document.getElementById('ergebnis').textContent = `${sys}/${dia} mmHg`;
  document.getElementById('ergebnis').style.color = FARBEN[r.stufe];
  const treiber = r.treiber === 'beide'
    ? 'Beide Werte tragen diese Stufe.'
    : `Maßgeblich ist der ${r.treiber === 'oberer Wert' ? 'obere' : 'untere'} Wert; der andere liegt niedriger.`;
  document.getElementById('details').innerHTML =
    `<span>Alter: <strong>${alter} Jahre</strong></span>` +
    `<span>${treiber}</span>` +
    (r.isoliert ? `<span>Form: <strong>${r.isoliert}</strong></span>` : '') +
    `<span style="flex-basis:100%;">${HINWEISE[r.stufe]}</span>` +
    `<span style="flex-basis:100%;">Die Grenzen gelten für Messungen in der Praxis. Zu Hause gemessen beginnt Bluthochdruck schon bei ${HYPERTONIE_AB_HEIM.systolisch}/${HYPERTONIE_AB_HEIM.diastolisch} mmHg.</span>`;
}
['systolisch','diastolisch','alter'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>