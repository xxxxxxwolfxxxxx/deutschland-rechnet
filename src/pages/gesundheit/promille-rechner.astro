---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'promille-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Promille-Rechner ${year}`}
  description="Blutalkohol nach Widmark-Formel kostenlos berechnen. Mit Abbau-Funktion und Getränke-Vorlagen."
  canonicalPath="/gesundheit/promille-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}gesundheit/`} class="back-link">← Gesundheit &amp; Fitness</a>
    <h1>Promille-Rechner – Blutalkohol berechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Promille-Rechner schätzt den Blutalkoholgehalt nach der Widmark-Formel – als nachträgliche Orientierung darüber, wie viel Alkohol getrunken wurde und wie lange der Körper für den Abbau braucht. Das Ergebnis ist eine grobe Schätzung mit erheblicher Streuung und darf nicht als Entscheidungsgrundlage dafür dienen, ob jemand ein Fahrzeug führen kann. Wer Alkohol getrunken hat, fährt nicht."
    sourceNote="Widmark-Formel. Schätzwert ohne Gewähr, nicht zur Beurteilung der Fahrtüchtigkeit geeignet."
    explanation="Die Widmark-Formel ist die Standardmethode zur Schätzung der Blutalkoholkonzentration und wird auch in der Rechtsmedizin eingesetzt. Der geschlechtsspezifische Körperwasserfaktor (0,68 für Männer, 0,55 für Frauen) berücksichtigt den unterschiedlichen Wasseranteil im Körper. Der berechnete Wert weicht individuell stark ab: Trinkgeschwindigkeit, Mageninhalt, Medikamente und die persönliche Abbaurate beeinflussen ihn. Eine gemessene Blutalkoholkonzentration lässt sich damit nicht vorhersagen."
    faqs={[
      {
        q: "Warum unterscheidet sich die Blutalkoholkonzentration nach Geschlecht?",
        a: "Frauen haben weniger Wasser im Körper und metabolisieren Alkohol langsamer, daher steigt ihr Blutalkohol schneller. Der Widmark-Faktor beträgt 0,55 (Frauen) vs. 0,68 (Männer)."
      },
      {
        q: "Wie genau ist die Widmark-Formel?",
        a: "Sie liefert einen Schätzwert, keinen Messwert. Die Abweichung zur tatsächlich gemessenen Blutalkoholkonzentration kann erheblich sein, weil Mageninhalt, Trinkgeschwindigkeit, Medikamente und die individuelle Abbaurate einfließen. Verlässlich ist allein eine Blutprobe."
      },
      {
        q: "Wie schnell baut der Körper Alkohol ab?",
        a: "Der Abbau erfolgt fast vollständig über die Leber, mit etwa 0,1 bis 0,15 Promille pro Stunde. Der Wert ist individuell und lässt sich nicht beschleunigen – auch nicht durch Essen, Schlaf oder Bewegung."
      },
      {
        q: "Welche Promillegrenzen gelten in Deutschland?",
        a: "Ab 0,5 Promille liegt eine Ordnungswidrigkeit nach § 24a StVG vor (Bußgeld, Punkte, Fahrverbot). Ab 1,1 Promille gilt man als absolut fahruntüchtig – das ist eine Straftat nach § 316 StGB. Schon ab 0,3 Promille kann eine Straftat vorliegen, wenn Ausfallerscheinungen hinzukommen. Für Fahranfänger in der Probezeit und alle unter 21 gilt 0,0 Promille."
      },
      {
        q: "Kann ich mit dem Rechner prüfen, ob ich noch fahren darf?",
        a: "Nein. Der Rechner schätzt nur einen Durchschnittswert und ersetzt keine Messung. Alkohol beeinträchtigt Reaktionszeit, Urteilsvermögen und Sehleistung schon deutlich unter jeder gesetzlichen Grenze. Wer getrunken hat, sollte das Fahrzeug stehen lassen – unabhängig davon, was hier angezeigt wird."
      },
      {
        q: "Kann Kaffee oder kaltes Duschen helfen, schneller nüchtern zu werden?",
        a: "Nein, das sind Mythen. Nur die Leber baut Alkohol ab, und das geht mit konstanter Geschwindigkeit. Kaffee kann nur die Wachheit erhöhen (maskierter Alkoholeinfluss), macht aber nicht nüchterner."
      }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid two-col">
        <div class="calc-group">
          <label for="gewicht">Körpergewicht (kg)</label>
          <input type="number" id="gewicht" min="40" max="200" value="75" step="1" />
        </div>
        <div class="calc-group">
          <label for="geschlecht">Geschlecht</label>
          <select id="geschlecht">
            <option value="m">Männlich</option>
            <option value="w">Weiblich</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="stunden">Stunden seit Trinkbeginn</label>
          <input type="number" id="stunden" min="0" max="24" value="1" step="0.5" />
        </div>
      </div>

      <div class="calc-group">
        <label>Getränke hinzufügen</label>
        <div class="getraenke-vorlagen">
          <button type="button" class="vorlage-btn" data-menge="500" data-vol="5">+ Bier (0,5 L)</button>
          <button type="button" class="vorlage-btn" data-menge="200" data-vol="12">+ Wein (0,2 L)</button>
          <button type="button" class="vorlage-btn" data-menge="100" data-vol="11">+ Sekt (0,1 L)</button>
          <button type="button" class="vorlage-btn" data-menge="40" data-vol="40">+ Schnaps (4 cl)</button>
        </div>
      </div>

      <div id="getraenke-liste" class="getraenke-liste"></div>

      <div class="calc-result">
        <div class="label">Blutalkohol (BAK)</div>
        <div id="bak-wert">0,00 ‰</div>
      </div>
      <div id="bak-info" style="margin-top:0.5rem;font-size:0.85rem;color:#666;"></div>
      <p id="bak-hinweis" class="bak-warn" style="display:none;">Kein Fahrzeug führen. Der angezeigte Wert ist eine Schätzung und sagt nichts darüber aus, ob Sie fahren dürfen.</p>
    </div>
  </CalculatorShell>
  <CalculatorGuide
    title="Blutalkoholkonzentration verstehen"
    content="Die Blutalkoholkonzentration (BAK) misst die Menge Alkohol im Blut. Die Widmark-Formel schätzt diesen Wert aus Trinkmenge, Körpergewicht und Geschlecht – sie ist eine Näherung, kein Messverfahren. Verlässlich bestimmen lässt sich die BAK nur über eine Blutprobe.

**Absorption und Abbau:** Nach dem Trinken gelangt Alkohol schnell ins Blut, auf leeren Magen besonders schnell. Der Abbau läuft fast vollständig über die Leber, mit etwa 0,1 bis 0,15 Promille pro Stunde. Diese Rate ist weitgehend konstant und lässt sich nicht steigern – weder durch Kaffee noch durch Essen, Schlaf oder Sport.

**Warum die Schätzung streut:** Frauen erreichen bei gleicher Trinkmenge höhere Werte, weil weniger Körperwasser den Alkohol verdünnt. Ältere Menschen bauen langsamer ab, ebenso Menschen mit eingeschränkter Leberfunktion. Auch Medikamente verschieben das Ergebnis. Die Abweichung zwischen geschätztem und gemessenem Wert kann in beide Richtungen deutlich ausfallen.

**Die gesetzlichen Grenzen:** Ab 0,5 Promille liegt eine Ordnungswidrigkeit nach § 24a StVG vor, ab 1,1 Promille eine Straftat nach § 316 StGB wegen absoluter Fahruntüchtigkeit. Bereits ab 0,3 Promille kann eine Straftat vorliegen, wenn Ausfallerscheinungen dazukommen. Für Fahranfänger in der Probezeit und alle unter 21 Jahren gilt ein absolutes Alkoholverbot am Steuer.

**Was dieser Rechner nicht kann:** Er sagt nicht, ob jemand fahren darf. Reaktionszeit, Sehleistung und Risikoeinschätzung sind längst vor jeder gesetzlichen Grenze beeinträchtigt. Wer Alkohol getrunken hat, lässt das Fahrzeug stehen."
    relatedSlugs={['blutdruck-bewerter', 'schlaf-rechner', 'kalorien-rechner']}
  />
</Layout>

<style>
.two-col { grid-template-columns: 1fr 1fr; }
.getraenke-vorlagen { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
.vorlage-btn {
  padding: 0.4rem 0.75rem;
  background: var(--bg);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-family: var(--font-ui);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text);
  transition: border-color 0.15s;
}
.vorlage-btn:hover { border-color: var(--cat-color, var(--red)); }
.getraenke-liste { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0.75rem; }
.getraenk-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
}
.getraenk-row button {
  margin-left: auto;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1;
  padding: 0 0.25rem;
}
.getraenk-row button:hover { color: var(--red); }
.bak-warn {
  margin-top: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: #fff3cd;
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  color: #856404;
  border: 1px solid #ffc107;
}
</style>

<script type="module">
const { berechnePromille } = await import(window.__base + 'scripts/promille.js');

let getraenke = [];

function berechne() {
  const gewicht = parseFloat(document.getElementById('gewicht').value)||75;
  const geschlecht = document.getElementById('geschlecht').value;
  const stunden = parseFloat(document.getElementById('stunden').value)||0;
  const r = berechnePromille({ getraenke, gewichtKg: gewicht, geschlecht, stundenNachBeginn: stunden });
  document.getElementById('bak-wert').textContent = r.bak.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' ‰';
  document.getElementById('bak-info').textContent = getraenke.length
    ? `Reiner Alkohol: ${r.alkoholGramm} g · Rohwert: ${r.rohWert} ‰ · Abbau: ${r.abbau} ‰`
    : 'Fügen Sie Getränke hinzu.';
  /* Der Warnhinweis haengt nicht an einem Grenzwert: Jeder Wert ueber null ist
     ein Grund, das Fahrzeug stehen zu lassen. Eine Schwelle wuerde suggerieren,
     darunter sei das Fahren unbedenklich. */
  document.getElementById('bak-hinweis').style.display = r.bak > 0 ? '' : 'none';
}

function renderListe() {
  const liste = document.getElementById('getraenke-liste');
  liste.innerHTML = getraenke.map((g, i) =>
    `<div class="getraenk-row">
      <span>${g.label}</span>
      <span style="color:var(--muted);font-size:0.78rem;">${g.mengeML} ml · ${g.volProzent} %</span>
      <button onclick="entferne(${i})">×</button>
    </div>`
  ).join('');
  berechne();
}

window.entferne = function(i) { getraenke.splice(i, 1); renderListe(); };

document.querySelectorAll('.vorlage-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    getraenke.push({
      label: btn.textContent.replace('+ ',''),
      mengeML: parseInt(btn.dataset.menge),
      volProzent: parseInt(btn.dataset.vol),
    });
    renderListe();
  });
});

['gewicht','geschlecht','stunden'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
