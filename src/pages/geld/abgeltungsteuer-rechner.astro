---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelAbgeltungsteuer from '../../components/artikel/abgeltungsteuer-nie-25-prozent.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
// Bundeslaender und Saetze aus demselben Modul, das auch der Rechner laedt.
import { BUNDESLAENDER, kirchensteuersatz } from '../../../public/scripts/abgeltungsteuer.js';
const calc = CALCULATORS.find(c => c.slug === 'abgeltungsteuer-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Abgeltungsteuer-Rechner ${year}`}
  description="Kapitalerträge mit Abgeltungsteuer berechnen."
  canonicalPath="/geld/abgeltungsteuer-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Abgeltungsteuer-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Abgeltungsteuer-Rechner berechnen Sie die Steuer auf Ihre Kapitalerträge nach Abzug des Freibetrags. So sehen Sie sofort, wie viel von Ihren Zinsen, Dividenden und Kursgewinnen nach Steuern übrig bleibt."
    sourceNote="Berechnet nach § 32d Abs. 1 EStG – Satz 1 für den Regelfall, die Sätze 3 bis 5 bei Kirchensteuerpflicht. Solidaritätszuschlag nach § 4 SolzG 1995; die Freigrenze des § 3 Abs. 3 SolzG gilt hier nach dessen Satz 2 nicht. Sparer-Pauschbetrag nach § 20 Abs. 9 EStG. Kirchensteuersätze nach Angaben des Bundeszentralamts für Steuern: 8 Prozent in Bayern und Baden-Württemberg, 9 Prozent in den übrigen Ländern. Anrechenbare ausländische Quellensteuer (die Größe q der gesetzlichen Formel) bildet der Rechner nicht ab."
    explanation="25 Prozent nach § 32d Abs. 1 Satz 1 EStG, dazu 5,5 Prozent Solidaritätszuschlag. Wer kirchensteuerpflichtig ist, zahlt NICHT 25 Prozent plus Kirchensteuer obendrauf: § 32d Abs. 1 Satz 3 EStG ermäßigt die Kapitalertragsteuer um ein Viertel der Kirchensteuer, sodass sie auf 24,45 Prozent sinkt (bei 9 Prozent Kirchensteuer). Der Sparer-Pauschbetrag nach § 20 Abs. 9 EStG beträgt 1.000 Euro, bei Zusammenveranlagung 2.000 Euro."
    faqs={[
      { q: "Was ist die Abgeltungsteuer?", a: "Die Abgeltungsteuer ist eine einheitliche Steuer auf Kapitalerträge (Zinsen, Dividenden, Kursgewinne) in Höhe von 25%. Sie wird zusammen mit dem Solidaritätszuschlag (5,5%) erhoben. Bank oder Broker führen die Steuer direkt ab." },
      { q: "Was ist der Sparerpauschbetrag?", a: "Der Sparerpauschbetrag ist ein Freibetrag: Die ersten 1.000€ Kapitalerträge pro Jahr sind steuerfrei (Verheiratete: 2.000€). Erst danach fällt Abgeltungsteuer an. Der Freibetrag wird pro Depotinhaber gewährt." },
      { q: "Gilt die Abgeltungsteuer auch auf Aktien und ETFs?", a: "Ja. Realisierte Kursgewinne, Dividenden und Ausschüttungen unterliegen der Abgeltungsteuer, auch bei ETFs und Aktien. Eine Haltefrist gibt es nicht: Die einjährige Spekulationsfrist des § 23 EStG gilt für Wertpapiere nur noch bei Altbeständen, die vor dem 1. Januar 2009 gekauft wurden. Wer danach gekauft hat, zahlt bei jedem Verkauf mit Gewinn, unabhängig von der Haltedauer." },
      { q: "Wann zahle ich Kirchensteuer auf Kapitalerträge?", a: "Nur als Mitglied einer steuererhebenden Religionsgemeinschaft. Der Satz richtet sich nach dem Wohnsitz, nicht nach der Konfession: In Bayern und Baden-Württemberg sind es 8 Prozent, in allen übrigen Ländern 9 Prozent – für evangelische und katholische Mitglieder gleichermaßen. Bemessungsgrundlage ist die Kapitalertragsteuer, nicht der Ertrag. Die Bank ruft die Mitgliedschaft einmal jährlich beim Bundeszentralamt für Steuern ab und behält die Steuer ein." },
      { q: "Kann ich mehrere Depots nutzen, um den Freibetrag zu verdoppeln?", a: "Nein. Der Sparerpauschbetrag ist pro Steuerperson und Kalenderjahr begrenzt, unabhängig von der Anzahl der Depots. Die Depotbanken melden die Kapitalerträge zusammengefasst an das Finanzamt." },
      { q: "Fällt der Solidaritätszuschlag auf Kapitalerträge noch an?", a: "Ja, und zwar unabhängig vom Einkommen. Seit 2021 zahlen rund neun von zehn Steuerpflichtigen keinen Solidaritätszuschlag mehr, weil ihre Einkommensteuer unter der Freigrenze des § 3 Abs. 3 SolzG liegt. Satz 2 dieses Absatzes nimmt die Abgeltungsteuer davon aber ausdrücklich aus: Auf Kapitalerträge wird der Zuschlag von 5,5 Prozent weiter erhoben, auch bei kleinen Beträgen." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="kapital">Kapitalerträge (€)</label>
          <input type="number" id="kapital" min="0" max="10000000" value="5000" step="100" />
        </div>
        <div class="calc-group">
          <label for="freibetrag">Sparerpauschbetrag (€)</label>
          <input type="number" id="freibetrag" min="0" max="2000" value="1000" step="100" />
        </div>
        <div class="calc-group">
          <label for="bundesland">Bundesland</label>
          <select id="bundesland">
            {Object.entries(BUNDESLAENDER).map(([kuerzel, name]) => (
              <option value={kuerzel} selected={kuerzel === 'NW'}>
                {name} ({(kirchensteuersatz(kuerzel) * 100).toLocaleString('de-DE')} %)
              </option>
            ))}
          </select>
        </div>
        <div class="calc-group">
          <label for="kirchensteuer">
            <input type="checkbox" id="kirchensteuer" style="width:auto;margin-right:0.5rem;" />
            Kirchensteuerpflichtig
          </label>
        </div>
        <div class="calc-group">
          <label for="verheiratet">
            <input type="checkbox" id="verheiratet" style="width:auto;margin-right:0.5rem;" />
            Verheiratet (Sparerpauschbetrag verdoppeln)
          </label>
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Abgeltungsteuer gesamt</div>
        <div id="steuer">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>

    <ArtikelAbgeltungsteuer slot="artikel" />
  </CalculatorShell>
</Layout>

<script type="module">
const { berechneAbgeltungsteuer, SPARERPAUSCHBETRAG_EINZEL, SPARERPAUSCHBETRAG_ZUSAMMEN }
  = await import(window.__base + 'scripts/abgeltungsteuer.js');

const eur = (n) => n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';

function berechne() {
  const verheiratet = document.getElementById('verheiratet').checked;
  const feld = document.getElementById('freibetrag');
  // Der Pauschbetrag folgt der Veranlagung, solange niemand ihn von Hand
  // geaendert hat. § 20 Abs. 9 EStG kennt keinen Betrag dazwischen.
  if (feld.dataset.auto !== 'aus') {
    feld.value = verheiratet ? SPARERPAUSCHBETRAG_ZUSAMMEN : SPARERPAUSCHBETRAG_EINZEL;
  }

  const r = berechneAbgeltungsteuer({
    ertrag: parseFloat(document.getElementById('kapital').value) || 0,
    pauschbetrag: parseFloat(feld.value) || 0,
    bundesland: document.getElementById('bundesland').value,
    kirchensteuerpflichtig: document.getElementById('kirchensteuer').checked,
  });

  document.getElementById('steuer').textContent = eur(r.gesamt);
  const zeilen = [
    ['Steuerfrei über den Pauschbetrag', eur(r.freigestellt)],
    ['Zu versteuern', eur(r.zuVersteuern)],
    ['Kapitalertragsteuer', eur(r.kapitalertragsteuer)],
  ];
  if (r.kirchensteuer > 0) {
    zeilen.push([`Kirchensteuer (${(r.kirchensteuersatz * 100).toLocaleString('de-DE')} %)`, eur(r.kirchensteuer)]);
  }
  zeilen.push(['Solidaritätszuschlag', eur(r.soli)]);
  zeilen.push(['Bleibt nach Steuern', eur(r.netto)]);
  if (r.zuVersteuern > 0) {
    zeilen.push(['Belastung des zu versteuernden Teils',
      r.grenzbelastung.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' %']);
  }
  document.getElementById('details').innerHTML =
    zeilen.map(([k, v]) => `<span>${k}: <strong>${v}</strong></span>`).join('');
}

document.getElementById('freibetrag').addEventListener('input', (e) => {
  e.target.dataset.auto = 'aus';
});
['kapital','freibetrag'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
['bundesland'].forEach(id =>
  document.getElementById(id).addEventListener('change', berechne));
['verheiratet','kirchensteuer'].forEach(id =>
  document.getElementById(id).addEventListener('change', berechne));
berechne();
</script>
