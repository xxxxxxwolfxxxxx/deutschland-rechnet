---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { berechneKryptoSteuer, FREIGRENZE, RECHTSSTAND } from '../../../public/scripts/krypto-steuer.js';
const calc = CALCULATORS.find(c => c.slug === 'krypto-steuern-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const pz = (n: number) => n.toLocaleString('de-DE') + ' %';
const tarifJahr = RECHTSSTAND.slice(0, 4);
const ZVE = 40000;

const knappDrunter = berechneKryptoSteuer({ zvEOhne: ZVE, gewinn: FREIGRENZE - 1 });
const genauDrauf = berechneKryptoSteuer({ zvEOhne: ZVE, gewinn: FREIGRENZE });
if (knappDrunter.mehrsteuer !== 0) throw new Error('Freigrenze: 999 € muessen steuerfrei sein');
if (genauDrauf.steuerpflichtig !== FREIGRENZE || genauDrauf.mehrsteuer <= 0) {
  throw new Error('Freigrenze: 1.000 € muessen voll steuerpflichtig sein');
}

const GEWINNE = [FREIGRENZE - 1, FREIGRENZE, 1500, 5000, 10000, 25000];
const tabelle = GEWINNE.map((g) => ({ g, r: berechneKryptoSteuer({ zvEOhne: ZVE, gewinn: g }) }));
function tabellenzeile(g: number) {
  const r = berechneKryptoSteuer({ zvEOhne: ZVE, gewinn: g });
  return '<tr><td>' + eur(g) + '</td><td>' + eur(r.steuerpflichtig) + '</td><td>' + eur(r.mehrsteuer) + '</td><td>' + pz(r.belastungProzent) + '</td></tr>';
}
const tabellenzeilen = GEWINNE.map(tabellenzeile).join('');

// Ehepaar: Die Grenze gilt je Ehegatte, nicht gemeinsam.
const paarEiner = berechneKryptoSteuer({ zvEOhne: 60000, gewinn: 1500, gewinnPartner: 0, zusammen: true });
const paarBeide = berechneKryptoSteuer({ zvEOhne: 60000, gewinn: 900, gewinnPartner: 900, zusammen: true });
if (paarEiner.steuerpflichtigGesamt !== 1500 || paarBeide.steuerpflichtigGesamt !== 0) {
  throw new Error('Freigrenze je Ehegatte falsch');
}

const guideHtml = `
<h3>Freigrenze, nicht Freibetrag</h3>
<p>Nach § 23 Abs. 3 Satz 5 EStG bleiben Gewinne aus privaten Veräußerungsgeschäften steuerfrei, wenn der Gesamtgewinn im Kalenderjahr <strong>weniger als ${eur(FREIGRENZE)}</strong> beträgt. Das ist eine Freigrenze: Unterhalb bleibt alles frei, ab ${eur(FREIGRENZE)} ist der <strong>ganze</strong> Gewinn steuerpflichtig – nicht nur der Teil darüber. Viele Seiten und auch diese Seite bis September 2026 haben die Grenze wie einen Freibetrag abgezogen. Bei ${eur(1500)} Gewinn wird dann auf ${eur(500)} Steuer gerechnet statt auf ${eur(1500)}.</p>
<p>Der Sprung ist hart. Bei einem zu versteuernden Einkommen von ${eur(ZVE)} kostet ein Gewinn von ${eur(FREIGRENZE - 1)} keinen Cent Einkommensteuer, ein Gewinn von ${eur(FREIGRENZE)} kostet ${eur(genauDrauf.mehrsteuer)}. Wer im Dezember knapp unter der Grenze liegt, kann den nächsten Verkauf ins neue Jahr schieben – oder Verluste realisieren, die den Gesamtgewinn unter die Grenze drücken.</p>

<h3>Steuerpflichtig nur innerhalb eines Jahres</h3>
<p>§ 23 Abs. 1 Satz 1 Nr. 2 EStG erfasst Veräußerungen, bei denen zwischen Anschaffung und Veräußerung <strong>nicht mehr als ein Jahr</strong> liegt. Was länger gehalten wurde, gehört nicht in den Rechner: Tragen Sie nur den Saldo der Verkäufe mit kurzer Haltedauer ein. Verluste aus solchen Verkäufen dürfen nach § 23 Abs. 3 Satz 7 nur mit Gewinnen aus privaten Veräußerungsgeschäften verrechnet werden, dann auch über Vor- und Folgejahre (Satz 8).</p>

<h3>Was der Gewinn an Steuer kostet</h3>
<p>Private Veräußerungsgewinne unterliegen nicht der Abgeltungsteuer, sondern dem persönlichen Tarif des § 32a EStG. Der Rechner nimmt deshalb keinen festen Steuersatz an, sondern rechnet die Einkommensteuer einmal ohne und einmal mit dem Gewinn (Tarif ${tarifJahr}). Die Differenz ist die Steuer, die der Gewinn auslöst. Beispiel für ein zu versteuerndes Einkommen von ${eur(ZVE)} ohne den Gewinn:</p>
<table>
<thead><tr><th>Gesamtgewinn</th><th>steuerpflichtig</th><th>zusätzliche Einkommensteuer</th><th>Belastung</th></tr></thead>
<tbody>
${tabellenzeilen}
</tbody>
</table>
<p>Solidaritätszuschlag und Kirchensteuer kommen gegebenenfalls hinzu; sie sind nicht eingerechnet.</p>

<h3>Ehepaare: je Ehegatte eine Grenze</h3>
<p>Bei der Zusammenveranlagung werden nach § 26b EStG die Einkünfte zusammengerechnet, „die die Ehegatten erzielt haben". Ermittelt werden sie aber für jeden Ehegatten getrennt – und die Freigrenze gehört zu dieser Ermittlung. Es gibt deshalb keine gemeinsame Grenze von 2.000 €. Erzielt einer ${eur(1500)} und der andere nichts, sind ${eur(paarEiner.steuerpflichtigGesamt)} steuerpflichtig. Erzielen beide je ${eur(900)}, bleiben beide Gewinne frei. Die Steuer rechnet der Rechner dann im Splittingverfahren.</p>
`;

const faqs = [
  { q: `Gibt es einen Freibetrag von ${eur(FREIGRENZE)}?`, a: `Nein, eine Freigrenze. Liegt der Gesamtgewinn aus privaten Veräußerungsgeschäften im Kalenderjahr unter ${eur(FREIGRENZE)}, bleibt er steuerfrei (§ 23 Abs. 3 Satz 5 EStG). Ab ${eur(FREIGRENZE)} ist der gesamte Gewinn steuerpflichtig, nicht nur der übersteigende Teil.` },
  { q: 'Haben Verheiratete 2.000 € frei?', a: `Nicht gemeinsam. Die Freigrenze gilt für jeden Ehegatten und dessen eigenen Gesamtgewinn. ${eur(1500)} Gewinn eines Ehegatten sind voll steuerpflichtig, auch wenn der andere nichts verkauft hat.` },
  { q: 'Wann sind Krypto-Gewinne steuerfrei?', a: 'Wenn zwischen Kauf und Verkauf mehr als ein Jahr liegt. § 23 Abs. 1 Satz 1 Nr. 2 EStG erfasst nur Veräußerungen, bei denen dieser Zeitraum nicht mehr als ein Jahr beträgt. Und unabhängig davon, wenn der Gesamtgewinn des Jahres unter der Freigrenze bleibt.' },
  { q: 'Mit welchem Steuersatz werden Krypto-Gewinne besteuert?', a: `Mit dem persönlichen Einkommensteuertarif, nicht mit 25 % Abgeltungsteuer. Wie viel das ist, hängt vom übrigen Einkommen ab: Bei ${eur(ZVE)} zu versteuerndem Einkommen kosten ${eur(5000)} Gewinn ${eur(tabelle[3].r.mehrsteuer)} Einkommensteuer.` },
  { q: 'Was passiert mit Verlusten?', a: 'Verluste aus Verkäufen innerhalb der Jahresfrist dürfen nur mit Gewinnen aus privaten Veräußerungsgeschäften verrechnet werden – im selben Jahr oder über Verlustrück- und -vortrag (§ 23 Abs. 3 Sätze 7 und 8 EStG). Mit Lohn oder Mieteinnahmen lassen sie sich nicht verrechnen.' },
];
---
<Layout
  title={`Krypto-Steuern-Rechner ${year}`}
  description="Krypto-Gewinne nach § 23 EStG: Freigrenze von 1.000 € richtig anwenden, zusätzliche Einkommensteuer nach dem eigenen Tarif berechnen, auch für Ehepaare."
  canonicalPath="/geld/krypto-steuern-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Krypto-Steuern-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner zeigt, ob Ihre Krypto-Gewinne unter die Freigrenze fallen und wie viel Einkommensteuer sie nach Ihrem persönlichen Tarif zusätzlich kosten."
    sourceNote={`§ 23 Abs. 1 Satz 1 Nr. 2 und Abs. 3 Satz 5 EStG (Freigrenze, abgerufen am 14.09.2026), § 26b EStG, Tarif nach § 32a EStG (${tarifJahr}). Ohne Solidaritätszuschlag und Kirchensteuer.`}
    explanation={`Steuerpflichtig sind Verkäufe innerhalb eines Jahres nach dem Kauf. Liegt der Gesamtgewinn eines Jahres unter ${FREIGRENZE} €, bleibt er frei; ab ${FREIGRENZE} € ist er ganz steuerpflichtig. Die Grenze gilt je Ehegatte.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="gewinn">Gesamtgewinn im Jahr, Haltedauer bis 1 Jahr (€)</label>
          <input type="number" id="gewinn" min="-10000000" max="10000000" value="1500" step="100" />
        </div>
        <div class="calc-group">
          <label for="zve">Zu versteuerndes Einkommen ohne diesen Gewinn (€)</label>
          <input type="number" id="zve" min="0" max="10000000" value="40000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="veranlagung">Veranlagung</label>
          <select id="veranlagung">
            <option value="einzel" selected>Einzelveranlagung</option>
            <option value="zusammen">Zusammenveranlagung</option>
          </select>
        </div>
        <div class="calc-group" id="partner-gruppe" hidden>
          <label for="gewinnPartner">Gesamtgewinn des Ehegatten (€)</label>
          <input type="number" id="gewinnPartner" min="-10000000" max="10000000" value="0" step="100" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Zusätzliche Einkommensteuer</div>
        <div id="ergebnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So werden Krypto-Gewinne besteuert"
    content={guideHtml}
    relatedSlugs={['abgeltungsteuer-rechner', 'steuernachzahlung-rechner', 'etf-sparplan-rechner']}
  />
</Layout>

<script type="module">
const { berechneKryptoSteuer, FREIGRENZE } = await import(window.__base + 'scripts/krypto-steuer.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function freiText(gewinn, frei) {
  if (gewinn <= 0) return 'Verlust oder kein Gewinn: nichts zu versteuern';
  if (frei) return `unter ${eur(FREIGRENZE)} – steuerfrei (noch ${eur(FREIGRENZE - gewinn)} Luft)`;
  return `ab ${eur(FREIGRENZE)} voll steuerpflichtig`;
}
function berechne() {
  const zusammen = document.getElementById('veranlagung').value === 'zusammen';
  document.getElementById('partner-gruppe').hidden = !zusammen;
  const gewinn = wert('gewinn');
  const gewinnPartner = wert('gewinnPartner');
  const r = berechneKryptoSteuer({ zvEOhne: wert('zve'), gewinn, gewinnPartner, zusammen });
  document.getElementById('ergebnis').textContent = eur(r.mehrsteuer);
  const teile = [
    `<span>Ihr Gewinn: <strong>${freiText(gewinn, r.freiNachFreigrenze)}</strong></span>`,
  ];
  if (zusammen) teile.push(`<span>Ehegatte: <strong>${freiText(gewinnPartner, r.freiNachFreigrenzePartner)}</strong></span>`);
  teile.push(
    `<span>Steuerpflichtig: <strong>${eur(r.steuerpflichtigGesamt)}</strong></span>`,
    `<span>Einkommensteuer ohne / mit Gewinn: <strong>${eur(r.steuerOhne)} / ${eur(r.steuerMit)}</strong></span>`,
  );
  if (r.steuerpflichtigGesamt > 0) teile.push(`<span>Belastung des Gewinns: <strong>${r.belastungProzent.toLocaleString('de-DE')} %</strong></span>`);
  document.getElementById('details').innerHTML = teile.join('');
}
['gewinn', 'gewinnPartner', 'zve'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('veranlagung').addEventListener('change', berechne);
berechne();
</script>
