---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  MINDESTLOHN,
  MINIJOB_GRENZE,
  MINDESTLOHN_ENTWICKLUNG,
  berechneMindestlohn,
} from '../../../public/scripts/mindestlohn.js';
const calc = CALCULATORS.find(c => c.slug === 'mindestlohn-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Beträge kommen aus dem Rechenmodul. Vor dem 11.08.2026 stand hier
// durchgängig der Satz des Jahres 2025 (12,82 €) und in der Entwicklungs-
// tabelle mit "2025: 12,55 €" ein Wert, den es nie gegeben hat.
const euro = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const stundensatz = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

const vollzeit = berechneMindestlohn({ stundenProWoche: 40 });
const kuenftig = MINDESTLOHN_ENTWICKLUNG.find((e) => e.betrag > MINDESTLOHN);
const monatsMonat = (b: number) => euro(Math.round(b * (52 / 12) * 40 * 100) / 100);
---
<Layout
  title={`Mindestlohn-Rechner ${year}`}
  description={`Mindestlohn-Rechner ${year}: Aktuell ${stundensatz(MINDESTLOHN)}/h brutto. Monats- und Jahresgehalt bei 20h, 30h oder 40h Wochenstunden berechnen – mit Minijob-Grenze und Entwicklung der Sätze.`}
  canonicalPath="/geld/mindestlohn-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Mindestlohn-Rechner {year} – Gehalt berechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Mindestlohn-Rechner berechnen Sie Ihr monatliches Mindestlohn-Gehalt auf Basis Ihres Stundenlohns und Ihrer Wochenstunden. Prüfen Sie, ob Ihr Gehalt den gesetzlichen Mindestlohn erfüllt."
    sourceNote={`Mindestlohn seit 1. Januar 2026: ${stundensatz(MINDESTLOHN)} je Zeitstunde – § 1 der Fünften Mindestlohnanpassungsverordnung vom 05.11.2025 (BGBl. 2025 I Nr. 268). Geringfügigkeitsgrenze ${MINIJOB_GRENZE} € nach § 8 Abs. 1a SGB IV.`}
    explanation={`Der gesetzliche Mindestlohn beträgt seit Januar 2026 ${stundensatz(MINDESTLOHN)} brutto pro Stunde. Er gilt für alle Arbeitnehmer mit wenigen Ausnahmen wie Auszubildende und Langzeitarbeitslose in den ersten sechs Monaten. Bei einer 40-Stunden-Woche ergibt das ${euro(vollzeit.monat)} im Monat.${kuenftig ? ` Zum ${new Date(kuenftig.ab).toLocaleDateString('de-DE')} steigt der Satz auf ${stundensatz(kuenftig.betrag)} – bereits verkündet in derselben Verordnung.` : ''}`}
    faqs={[
      { q: "Wer bekommt Mindestlohn?", a: "Alle Arbeitnehmer in Deutschland, außer: Auszubildende, Auslandsentsandte bis 3 Monate, Langzeitarbeitslose in den ersten 6 Monaten. Auch Mini-Jobber, Schüler und Studenten müssen den Mindestlohn erhalten, wenn sie arbeiten." },
      { q: "Wie wird der Mindestlohn berechnet?", a: "Stundenlohn × Wochenstunden × 4,33 (Durchschnitt Wochen/Monat) oder einfach: Stundenlohn × (wöchentliche Stunden × 52 Wochen ÷ 12 Monate). Der Arbeitgeber muss mindes tens diesen Betrag zahlen, bevor Steuern abgezogen werden." },
      { q: "Gibt es Ausnahmen von der Mindestlohn-Regel?", a: "Ja: Auszubildende sind befreit. Auch: Freiberufler und Selbstständige müssen den Mindestlohn nicht zahlen – das betrifft nur Angestellte. Übergangsvorschriften für Langzeitarbeitslose (erste 6 Monate) können gelten." },
      { q: "Wird der Mindestlohn regelmäßig erhöht?", a: `Ja. Die Mindestlohnkommission schlägt die Anpassung vor, die Bundesregierung setzt sie nach § 1 Abs. 2 Satz 2 MiLoG per Rechtsverordnung um. Die verkündeten Sätze: ${MINDESTLOHN_ENTWICKLUNG.map((e) => `${e.ab.slice(0, 4)}: ${stundensatz(e.betrag)}`).join(', ')}.` },
      { q: "Kann mein Arbeitgeber den Mindestlohn verweigern?", a: "Nein. Es ist illegal. Du kannst Beschwerde bei der Finanzbehörde (Zollbehörden für Schwarzarbeit) oder der Gewerkschaft einreichen. Der Arbeitgeber muss nachzahlen + Verzugszinsen." },
      { q: "Ist Mindestlohn das gleiche wie Lohn im Tarifvertrag?", a: "Nein. Mindestlohn ist das Minimum, das ALLE erhalten müssen. Tarifverträge können höhere Löhne festlegen. Viele Branchen haben Tarifverträge mit 15-20€+/Stunde." },
      { q: "Wie wirkt sich der Mindestlohn auf Mini-Jobs aus?", a: `Seit Oktober 2022 ist die Geringfügigkeitsgrenze an den Mindestlohn gekoppelt. § 8 Abs. 1a Satz 2 SGB IV rechnet: Mindestlohn mal 130, geteilt durch drei, auf volle Euro aufgerundet. Bei ${stundensatz(MINDESTLOHN)} sind das ${MINIJOB_GRENZE} € im Monat – das entspricht zehn Wochenstunden. Verdienen Sie mehr, rutschen Sie in einen Midi-Job (${MINIJOB_GRENZE + 1} bis 2.000 €) mit anteiligen Sozialabgaben.` },
      { q: "Was passiert bei Mindestlohn-Verstößen des Arbeitgebers?", a: "Verstöße gegen das MiLoG sind Ordnungswidrigkeiten. Dem Arbeitgeber drohen Bußgelder bis zu 500.000€. Außerdem muss er den Differenzbetrag nachzahlen – rückwirkend für bis zu 3 Jahre. Zuständig für die Kontrolle ist die Finanzkontrolle Schwarzarbeit (FKS) des Zolls. Arbeitnehmer können sich anonym beim Zoll melden." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="stunden">Wochenstunden</label>
          <input type="number" id="stunden" min="1" max="80" value="40" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="stundenlohn">Ihr Stundenlohn (€, brutto)</label>
          <input type="number" id="stundenlohn" min="0" max="200" value={MINDESTLOHN} step="0.01" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Mindestlohn pro Monat (brutto)</div>
        <div id="monat">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So funktioniert der Mindestlohn"
    content={`<p><strong>Der Mindestlohn ist die unterste Lohngrenze,</strong> die Arbeitgeber zahlen müssen. In Deutschland liegt der gesetzliche Mindestlohn seit Januar 2026 bei <strong>${stundensatz(MINDESTLOHN)} brutto pro Stunde</strong>. Das Mindestlohngesetz (MiLoG) schreibt diese Untergrenze vor, um Lohndumping zu verhindern und Arbeitnehmer vor Ausbeutung zu schützen. Der Gesetzestext selbst nennt in § 1 Abs. 2 Satz 1 nur 12,00 Euro; die Erhöhungen ergehen nach Satz 2 durch Rechtsverordnung. Maßgeblich ist deshalb immer die jüngste Anpassungsverordnung – zurzeit die Fünfte vom 5. November 2025.</p>

<p><strong>Berechnung des Monatsgehalts:</strong> Stundenlohn × Wochenstunden × 52 Wochen ÷ 12 Monate. Bei ${stundensatz(MINDESTLOHN)} und einer 40-Stunden-Woche ergibt das ein Bruttomonatsgehalt von ${euro(vollzeit.monat)}. Urlaubstage ändern daran nichts: Bezahlter Urlaub wird nach § 11 BUrlG fortgezahlt, das Monatsentgelt bleibt gleich.</p>

<h3>Mindestlohn-Gehalt nach Wochenstunden (${year})</h3>
<table>
<thead><tr><th>Wochenstunden</th><th>Monatslohn brutto</th><th>Jahreslohn brutto</th><th>Typische Jobs</th></tr></thead>
<tbody>
${[
  { h: 10, was: 'Aushilfe, Nachhilfe' },
  { h: 20, was: 'Werkstudent, Teilzeit-Verkauf' },
  { h: 30, was: 'Teilzeit-Pflege, Büro' },
  { h: 35, was: 'Reduzierte Vollzeit' },
  { h: 38.5, was: 'Tarif-Vollzeit (IG Metall)' },
  { h: 40, was: 'Standard-Vollzeit' },
].map(({ h, was }) => {
  const r = berechneMindestlohn({ stundenProWoche: h });
  const label = h === 10 ? '10 h (Mini-Job)' : h === 40 ? '40 h (Vollzeit)' : `${h.toLocaleString('de-DE')} h`;
  return `<tr><td>${label}</td><td>${euro(r.monat)}</td><td>${euro(r.jahr)}</td><td>${was}</td></tr>`;
}).join('\n')}
</tbody>
</table>
<p style="font-size:0.9rem;color:#666;">Zehn Wochenstunden bleiben mit ${euro(berechneMindestlohn({ stundenProWoche: 10 }).monat)} knapp unter der Geringfügigkeitsgrenze von ${MINIJOB_GRENZE} € – genau so ist sie berechnet.</p>

<h3>Verkündete Mindestlohnsätze</h3>
<table>
<thead><tr><th>Gültig ab</th><th>Stundenlohn</th><th>Monatsgehalt (40 h)</th><th>Rechtsgrundlage</th></tr></thead>
<tbody>
${MINDESTLOHN_ENTWICKLUNG.map((e) => `<tr><td>${new Date(e.ab).toLocaleDateString('de-DE')}</td><td>${stundensatz(e.betrag)}</td><td>${monatsMonat(e.betrag)}</td><td>${e.fundstelle}</td></tr>`).join('\n')}
</tbody>
</table>
<p style="font-size:0.9rem;color:#666;">Vor Oktober 2022 galten Sätze ab 8,50 € (Einführung 2015). Sie beruhten auf inzwischen außer Kraft getretenen Verordnungen und werden hier nicht aufgeführt, weil die Fundstellen nicht mehr amtlich abrufbar sind.</p>

<p><strong>Wer bekommt Mindestlohn?</strong> Der gesetzliche Mindestlohn gilt für nahezu alle Arbeitnehmer in Deutschland – auch für Mini-Jobber, Saisonarbeiter, Teilzeitkräfte und ausländische Beschäftigte. Ausgenommen sind: Auszubildende (für die gilt seit 2020 eine eigene Mindestausbildungsvergütung), Pflichtpraktikanten und freiwillige Praktikanten unter drei Monaten, Langzeitarbeitslose in den ersten sechs Monaten einer neuen Beschäftigung sowie ehrenamtlich Tätige.</p>

<p><strong>Praxistipp – Mindestlohn bei Stücklohn und Akkordarbeit:</strong> Auch wenn Sie nach Stückzahl, Provision oder Akkord bezahlt werden, muss Ihr Arbeitgeber sicherstellen, dass der Stundenlohn im Monatsdurchschnitt mindestens ${stundensatz(MINDESTLOHN)} beträgt. Erreichen Ihre Provisionen diesen Betrag nicht, muss der Arbeitgeber die Differenz aufstocken. Dokumentieren Sie Ihre Arbeitszeiten sorgfältig – der Arbeitgeber ist ohnehin verpflichtet, Beginn, Ende und Dauer der täglichen Arbeitszeit aufzuzeichnen (§ 17 MiLoG).</p>

<p><strong>Mindestlohn und Minijob-Grenze:</strong> Seit Oktober 2022 ist die Geringfügigkeitsgrenze an den Mindestlohn gekoppelt und wird nicht mehr eigenständig festgesetzt. § 8 Abs. 1a Satz 2 SGB IV rechnet: Mindestlohn × 130 ÷ 3, aufgerundet auf volle Euro. Bei ${stundensatz(MINDESTLOHN)} sind das <strong>${MINIJOB_GRENZE} € im Monat</strong>. Ein Minijob auf Mindestlohnbasis erlaubt damit zehn Wochenstunden; darüber rutschen Sie in den Midi-Job-Bereich (${MINIJOB_GRENZE + 1} bis 2.000 €) mit anteiligen Sozialabgaben. Steigt der Mindestlohn, steigt die Grenze automatisch mit.</p>

<p><strong>Branchenmindestlöhne gehen vor:</strong> In vielen Branchen gelten tarifvertragliche Mindestlöhne, die über dem gesetzlichen liegen – etwa im Bauhauptgewerbe, im Dachdecker-, Maler- und Elektrohandwerk, in der Gebäudereinigung und in der Pflege. Sie werden nach dem Arbeitnehmer-Entsendegesetz für allgemeinverbindlich erklärt und gelten dann für alle Betriebe der Branche, auch für nicht tarifgebundene. § 1 Abs. 3 MiLoG stellt klar, dass sie dem gesetzlichen Mindestlohn vorgehen, soweit sie ihn nicht unterschreiten. Die jeweils geltenden Sätze ändern sich häufig; verbindlich sind die Rechtsverordnungen zum AEntG und die Auskunft der Finanzkontrolle Schwarzarbeit des Zolls.</p>`}
    relatedSlugs={['brutto-netto-rechner', 'gehaltserhoehung-rechner', 'kuendigungsfrist-rechner']}
  />
</Layout>

<script type="module">
const { berechneMindestlohn, MINDESTLOHN, MINIJOB_GRENZE } =
  await import(window.__base + 'scripts/mindestlohn.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const stunden = parseFloat(document.getElementById('stunden').value)||0;
  const eingegeben = parseFloat(document.getElementById('stundenlohn').value);
  const stundenlohn = Number.isFinite(eingegeben) ? eingegeben : MINDESTLOHN;
  const r = berechneMindestlohn({ stundenProWoche: stunden, stundenlohn });
  document.getElementById('monat').textContent = fmt(r.monat);

  const soll = berechneMindestlohn({ stundenProWoche: stunden });
  const fehlt = Math.round((soll.monat - r.monat) * 100) / 100;
  const hinweis = fehlt > 0
    ? `<span style="color:#b3261e;">Unter Mindestlohn – es fehlen <strong>${fmt(fehlt)}</strong> im Monat</span>`
    : `<span style="color:#146c2e;">Mindestlohn erfüllt</span>`;

  document.getElementById('details').innerHTML =
    `<span>Pro Jahr: ${fmt(r.jahr)}</span>` +
    `<span>Stunden/Monat: ${r.stundenProMonat.toLocaleString('de-DE')}</span>` +
    `<span>${r.ueberMinijobGrenze ? 'Über' : 'Innerhalb'} der Minijob-Grenze von ${MINIJOB_GRENZE} €</span>` +
    hinweis;
}
['stunden','stundenlohn'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
