---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { KIRCHENSTEUER_LAENDER } from '../../../public/scripts/kirchensteuer.js';
import { bundeslaenderAlphabetisch } from '../../../public/scripts/bundeslaender.js';
import {
  BBG_KV_PV_JAHR, BBG_KV_PV_MONAT, BBG_RV_AV_JAHR, BBG_RV_AV_MONAT,
  BEITRAGSSAETZE, PFLEGE_ARBEITGEBERANTEIL, pflegeArbeitnehmerSatz, krankenkasseArbeitnehmerSatz,
} from '../../../public/scripts/sozialversicherung.js';
import { SOLI_FREIGRENZE, ARBEITNEHMER_PAUSCHBETRAG, VORSORGEPAUSCHALE_HOECHSTBETRAG } from '../../../public/scripts/lohnsteuer.js';
import { GRUNDFREIBETRAG } from '../../../public/scripts/einkommensteuer.js';
const calc = CALCULATORS.find(c => c.slug === 'brutto-netto-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Auswahlliste und alle Zahlen im Text stammen aus den Rechenmodulen. Vorher
// standen sie hier fest verdrahtet: die Bundesländer mit anderen Kürzeln als
// das Modul ('nw' gegen 'nrw'), die Beitragsbemessungsgrenzen mit 92.400 und
// 102.600 € und die Rentenversicherung mit 8,4 % – alle drei falsch.
const laender = bundeslaenderAlphabetisch();

const euro = (n: number) => n.toLocaleString('de-DE') + ' €';
const proz = (n: number) => (n * 100).toLocaleString('de-DE', { maximumFractionDigits: 3 }) + ' %';

const kvAn = krankenkasseArbeitnehmerSatz();
const pvAn = pflegeArbeitnehmerSatz({ kinder: 1 });
const pvAnKinderlos = pflegeArbeitnehmerSatz({ kinder: 0 });
const pvAnSachsen = pflegeArbeitnehmerSatz({ kinder: 1, bundesland: 'SN' });
const rvAn = BEITRAGSSAETZE.rentenversicherung / 2;
const avAn = BEITRAGSSAETZE.arbeitslosenversicherung / 2;
const kiSaetze = [...new Set(Object.values(KIRCHENSTEUER_LAENDER).map(l => l.satz))].sort();
const achtProzentLaender = Object.values(KIRCHENSTEUER_LAENDER)
  .filter(l => l.satz === Math.min(...kiSaetze)).map(l => l.name);
---
<Layout
  title={`Brutto-Netto-Rechner ${year}`}
  description="Nettolohn aus Bruttogehalt berechnen – kostenlos, mit Steuerklasse, Bundesland und Kirchensteuer. Sofortiges Ergebnis."
  canonicalPath="/geld/brutto-netto-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld & Gehalt</a>
    <h1>Brutto-Netto-Rechner {year} – kostenlos & aktuell</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Brutto-Netto-Rechner 2026 berechnen Sie Ihren monatlichen Nettolohn aus dem Bruttogehalt. Geben Sie Bruttogehalt, Steuerklasse, Bundesland und die Zahl Ihrer Kinder unter 25 Jahren ein – Lohnsteuer, Solidaritätszuschlag, Kirchensteuer und Sozialversicherung werden daraus berechnet."
    sourceNote="Lohnsteuerabzug nach § 39b Abs. 2 EStG mit dem Tarif des § 32a EStG (VZ 2026), Solidaritätszuschlag nach SolzG 1995, Beitragssätze und Bemessungsgrenzen nach der Sozialversicherungsrechengrößen-Verordnung 2026."
    explanation={`Aus dem Jahresbruttolohn werden der Arbeitnehmer-Pauschbetrag von ${euro(ARBEITNEHMER_PAUSCHBETRAG)}, der Sonderausgaben-Pauschbetrag und die Vorsorgepauschale abgezogen; auf den Rest wird der Tarif des § 32a EStG angewendet. Der Solidaritätszuschlag beträgt ${proz(0.055)} der Lohnsteuer, fällt aber erst über einer Jahreslohnsteuer von ${euro(SOLI_FREIGRENZE)} an. Die Kirchensteuer liegt bei ${kiSaetze.map(proz).join(' oder ')} der Lohnsteuer.`}
    faqs={[
      { q: "Wie hoch sind die Abzüge?", a: `Die Sozialversicherung kostet den Arbeitnehmer ${proz(kvAn + pvAn + rvAn + avAn)} des Bruttolohns bis zu den Beitragsbemessungsgrenzen. Dazu kommen Lohnsteuer, gegebenenfalls Solidaritätszuschlag und Kirchensteuer. Zusammen liegen die Abzüge je nach Steuerklasse und Einkommen zwischen etwa 20 und 45 Prozent.` },
      { q: "Welche Steuerklasse sollte ich wählen?", a: "Ledig: Klasse I. Alleinerziehend mit Anspruch auf den Entlastungsbetrag: II. Verheiratet mit deutlich höherem Einkommen: III, der Partner dann V. Verheiratet mit ähnlichem Einkommen: beide IV. Zweites Arbeitsverhältnis: VI." },
      { q: "Warum weicht mein Netto ab?", a: `Der Rechner nimmt den gesetzlichen Regelfall an: gesetzlich kranken- und pflegeversichert, durchschnittlicher Zusatzbeitrag von ${proz(BEITRAGSSAETZE.zusatzbeitragDurchschnitt)}, keine Freibeträge nach § 39a EStG. Abweichungen entstehen durch einen anderen Zusatzbeitrag Ihrer Krankenkasse, eingetragene Freibeträge, private Krankenversicherung oder Kinderfreibeträge beim Solidaritätszuschlag.` },
      { q: "Was ist die Beitragsbemessungsgrenze?", a: `Der Betrag, bis zu dem Beiträge erhoben werden; darüber liegender Lohn bleibt beitragsfrei. 2026 liegt sie in der Renten- und Arbeitslosenversicherung bei ${euro(BBG_RV_AV_JAHR)} im Jahr (${euro(BBG_RV_AV_MONAT)} im Monat) und in der Kranken- und Pflegeversicherung bei ${euro(BBG_KV_PV_JAHR)} im Jahr (${euro(BBG_KV_PV_MONAT)} im Monat).` },
      { q: "Beeinflusst das Bundesland den Nettolohn?", a: `Ja, an zwei Stellen. Die Kirchensteuer beträgt in ${achtProzentLaender.join(' und ')} ${proz(Math.min(...kiSaetze))}, in allen übrigen Ländern ${proz(Math.max(...kiSaetze))} der Lohnsteuer. Und in Sachsen trägt der Arbeitnehmer nach § 58 Abs. 3 SGB XI einen Prozentpunkt der Pflegeversicherung allein, zahlt also ${proz(pvAnSachsen)} statt ${proz(pvAn)}.` },
      { q: "Was ist die Vorsorgepauschale?", a: `Beim Lohnsteuerabzug werden nicht die tatsächlichen Sozialabgaben abgezogen, sondern die Vorsorgepauschale nach § 39b Abs. 2 Satz 5 Nr. 3 EStG. Sie rechnet die Krankenversicherung mit dem ermäßigten Beitragssatz von ${proz(BEITRAGSSAETZE.krankenversicherungErmaessigt)} und berücksichtigt die Arbeitslosenversicherung nur, soweit die Teilbeträge zusammen ${euro(VORSORGEPAUSCHALE_HOECHSTBETRAG)} nicht übersteigen.` }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="brutto">Bruttogehalt (monatlich, €)</label>
          <input type="number" id="brutto" min="0" max="100000" value="3000" step="50" />
        </div>
        <div class="calc-group">
          <label for="steuerklasse">Steuerklasse</label>
          <select id="steuerklasse">
            <option value="1" selected>I – Ledig, getrennt lebend</option>
            <option value="2">II – Alleinerziehend</option>
            <option value="3">III – Verheiratet, höheres Einkommen</option>
            <option value="4">IV – Verheiratet, ähnliches Einkommen</option>
            <option value="5">V – Verheiratet, geringeres Einkommen</option>
            <option value="6">VI – Zweites Arbeitsverhältnis</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="bundesland">Bundesland</label>
          <select id="bundesland">
            {laender.map(l => (
              <option value={l.kuerzel} selected={l.kuerzel === 'NW'}>{l.name}</option>
            ))}
          </select>
        </div>
        <div class="calc-group">
          <label for="kirche">Kirchensteuer</label>
          <select id="kirche">
            <option value="nein" selected>Nein</option>
            <option value="ja">Ja</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="kinder">Kinder unter 25 Jahren</label>
          <select id="kinder">
            <option value="0">keine ({proz(pvAnKinderlos)} Pflegeversicherung)</option>
            <option value="1" selected>1 Kind ({proz(pvAn)})</option>
            <option value="2">2 Kinder ({proz(pflegeArbeitnehmerSatz({ kinder: 2 }))})</option>
            <option value="3">3 Kinder ({proz(pflegeArbeitnehmerSatz({ kinder: 3 }))})</option>
            <option value="4">4 Kinder ({proz(pflegeArbeitnehmerSatz({ kinder: 4 }))})</option>
            <option value="5">5 Kinder oder mehr ({proz(pflegeArbeitnehmerSatz({ kinder: 5 }))})</option>
          </select>
        </div>
      </div>
      <div class="calc-result" id="ergebnis">
        <div class="label">Nettolohn monatlich</div>
        <div id="netto-wert">— €</div>
      </div>
      <details class="details">
        <summary>Aufschlüsselung</summary>
        <table id="aufschluss">
          <tr><td>Bruttogehalt</td><td id="r-brutto">—</td></tr>
          <tr><td>Lohnsteuer</td><td id="r-lst">—</td></tr>
          <tr><td>Solidaritätszuschlag</td><td id="r-soli">—</td></tr>
          <tr><td>Kirchensteuer</td><td id="r-ki">—</td></tr>
          <tr><td>Krankenversicherung</td><td id="r-kv">—</td></tr>
          <tr><td>Rentenversicherung</td><td id="r-rv">—</td></tr>
          <tr><td>Arbeitslosenversicherung</td><td id="r-av">—</td></tr>
          <tr><td>Pflegeversicherung</td><td id="r-pv">—</td></tr>
          <tr class="total"><td><strong>Nettolohn</strong></td><td id="r-netto"><strong>—</strong></td></tr>
        </table>
      </details>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So funktioniert die Lohnsteuer"
    content={`<p>Der Weg vom Brutto zum Netto führt über den <strong>zu versteuernden Jahresbetrag</strong> nach § 39b Abs. 2 EStG. Vom Jahresbruttolohn werden abgezogen: der Arbeitnehmer-Pauschbetrag von ${euro(ARBEITNEHMER_PAUSCHBETRAG)}, der Sonderausgaben-Pauschbetrag von 36 € und die Vorsorgepauschale. In Steuerklasse II kommt der Entlastungsbetrag für Alleinerziehende von 4.260 € hinzu, in Steuerklasse VI entfallen beide Pauschbeträge.</p>

<p>Auf diesen Betrag wird der <strong>Tarif des § 32a EStG</strong> angewendet. Er beginnt oberhalb des Grundfreibetrags von ${euro(GRUNDFREIBETRAG)} bei 14 % und steigt bis 45 %. Der Grundfreibetrag steckt bereits im Tarif und wird nicht zusätzlich abgezogen. Steuerklasse III rechnet mit dem Splittingverfahren, die Klassen V und VI nach der Sonderformel des § 39b Abs. 2 Satz 7 EStG – deshalb fällt dort deutlich mehr Lohnsteuer an.</p>

<p>Die <strong>Vorsorgepauschale</strong> ist nicht dasselbe wie die tatsächlichen Sozialabgaben. Sie setzt sich zusammen aus der Hälfte des Rentenbeitrags, dem Arbeitnehmeranteil zur Krankenversicherung gerechnet mit dem <em>ermäßigten</em> Beitragssatz von ${proz(BEITRAGSSAETZE.krankenversicherungErmaessigt)}, dem Pflegeanteil und dem Beitrag zur Arbeitslosenversicherung – letzterer nur, soweit die Teilbeträge zusammen ${euro(VORSORGEPAUSCHALE_HOECHSTBETRAG)} nicht übersteigen.</p>

<p>Der <strong>Solidaritätszuschlag</strong> beträgt 5,5 % der Lohnsteuer. Er wird erst erhoben, wenn die Jahreslohnsteuer ${euro(SOLI_FREIGRENZE)} übersteigt (Steuerklasse III: ${euro(SOLI_FREIGRENZE * 2)}). Direkt oberhalb dieser Freigrenze greift eine Milderungszone: Der Zuschlag beträgt dort höchstens 11,9 % des übersteigenden Betrags und wächst erst allmählich auf die vollen 5,5 % an.</p>

<p><strong>Sozialversicherungsbeiträge</strong> tragen Arbeitgeber und Arbeitnehmer grundsätzlich je zur Hälfte. Die Arbeitnehmeranteile 2026:
<ul>
  <li><strong>Krankenversicherung:</strong> ${proz(kvAn)} – die Hälfte des allgemeinen Beitragssatzes von ${proz(BEITRAGSSAETZE.krankenversicherungAllgemein)} plus die Hälfte des Zusatzbeitrags Ihrer Kasse, im Durchschnitt ${proz(BEITRAGSSAETZE.zusatzbeitragDurchschnitt)}</li>
  <li><strong>Rentenversicherung:</strong> ${proz(rvAn)} von ${proz(BEITRAGSSAETZE.rentenversicherung)}</li>
  <li><strong>Arbeitslosenversicherung:</strong> ${proz(avAn)} von ${proz(BEITRAGSSAETZE.arbeitslosenversicherung)}</li>
  <li><strong>Pflegeversicherung:</strong> ${proz(pvAn)} bei einem Kind. Kinderlose zahlen den Zuschlag von ${proz(BEITRAGSSAETZE.pflegeZuschlagKinderlose)} allein und kommen auf ${proz(pvAnKinderlos)}; ab dem zweiten bis zum fünften Kind sinkt der Satz um je ${proz(BEITRAGSSAETZE.pflegeAbschlagJeKind)}. Der Arbeitgeberanteil bleibt in allen Fällen bei ${proz(PFLEGE_ARBEITGEBERANTEIL)}.</li>
</ul>
</p>

<p><strong>Kirchensteuer</strong> beträgt in ${achtProzentLaender.join(' und ')} ${proz(Math.min(...kiSaetze))} und in allen übrigen Bundesländern ${proz(Math.max(...kiSaetze))} der Lohnsteuer – nicht des Bruttogehalts. Sie wird nur von Mitgliedern einer steuererhebenden Religionsgemeinschaft erhoben.</p>

<p><strong>Tipp:</strong> Die Aufschlüsselung im Rechner zeigt jeden Abzug einzeln. Wer seinen tatsächlichen Zusatzbeitrag kennt, kann die Abweichung zur Gehaltsabrechnung daran ablesen.</p>`}
    relatedSlugs={['arbeitslosengeld-rechner', 'gehaltserhoehung-rechner', 'steuerklassen-vergleich']}
  />
</Layout>

<script type="module">
const { berechneNettoGehalt } = await import(window.__base + 'scripts/brutto-netto.js');
function fmt(n) { return n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; }
function berechne() {
  const brutto = parseFloat(document.getElementById('brutto').value) || 0;
  const sk = parseInt(document.getElementById('steuerklasse').value);
  const bl = document.getElementById('bundesland').value;
  const ki = document.getElementById('kirche').value === 'ja';
  const kinder = parseInt(document.getElementById('kinder').value);
  const r = berechneNettoGehalt({ bruttoMonat: brutto, steuerklasse: sk, bundesland: bl, kirchensteuer: ki, kinder });
  document.getElementById('netto-wert').textContent = fmt(r.netto);
  document.getElementById('r-brutto').textContent = fmt(brutto);
  document.getElementById('r-lst').textContent = '− ' + fmt(r.lohnsteuer);
  document.getElementById('r-soli').textContent = '− ' + fmt(r.soli);
  document.getElementById('r-ki').textContent = '− ' + fmt(r.kirchensteuer);
  document.getElementById('r-kv').textContent = '− ' + fmt(r.krankenversicherung);
  document.getElementById('r-rv').textContent = '− ' + fmt(r.rentenversicherung);
  document.getElementById('r-av').textContent = '− ' + fmt(r.arbeitslosenversicherung);
  document.getElementById('r-pv').textContent = '− ' + fmt(r.pflegeversicherung);
  document.getElementById('r-netto').innerHTML = '<strong>' + fmt(r.netto) + '</strong>';
}
document.querySelectorAll('#brutto, #steuerklasse, #bundesland, #kirche, #kinder').forEach(el => {
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
berechne();
</script>

<style>
.details { margin-top: 1rem; }
.details summary { cursor: pointer; color: var(--color-text-muted); font-size: 0.9rem; }
table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; font-size: 0.9rem; }
td { padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--color-border); }
td:last-child { text-align: right; }
tr.total td { border-top: 2px solid var(--color-black); border-bottom: none; }
</style>
