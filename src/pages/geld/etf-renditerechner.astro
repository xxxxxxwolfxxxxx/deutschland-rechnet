---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelEtfRendite from '../../components/artikel/durchschnittsrendite-und-reihenfolge.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'etf-renditerechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`ETF-Renditerechner ${year}`}
  description="ETF-Rendite berechnen: Endwert eines Sparplans mit Anfangskapital, Sparrate und eigener Renditeannahme – und warum sieben Prozent im Schnitt keine sieben Prozent sind."
  canonicalPath="/geld/etf-renditerechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>ETF-Renditerechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem ETF-Renditerechner berechnen Sie Ihr Vermögen nach regelmäßigem Sparen mit einer erwarteten jährlichen Rendite."
    sourceNote="Die Rendite ist Ihre Eingabe, keine Statistik. Gerechnet wird mit Einzahlung am Monatsende und einem Monatsfaktor, der über zwölf Monate genau die eingetragene Jahresrendite ergibt – vor Steuern und vor Fondskosten."
    explanation="Der Rechner unterstellt, dass jedes Jahr genau die eingetragene Rendite bringt. Echte Anlagejahre schwanken – was das für den Durchschnitt und für einen Sparplan bedeutet, rechnet der Artikel unten durch. Steuern beim Verkauf berücksichtigt der ETF-Sparplan-Rechner."
    faqs={[
      { q: "Was ist ein ETF?", a: "Ein Exchange Traded Fund ist ein börsengehandelter Fonds, der meist einen Index wie den DAX oder den MSCI World nachbildet. Die laufenden Kosten stehen im Basisinformationsblatt des jeweiligen Fonds; ziehen Sie sie von der Rendite ab, die Sie eintragen." },
      { q: "Welche Rendite soll ich eintragen?", a: "Das ist eine Annahme über die Zukunft, die kein Rechner Ihnen abnehmen kann. Rechnen Sie mehrere Werte durch. Achten Sie bei historischen Angaben darauf, ob die jährliche Rendite gemeint ist, die das Depot tatsächlich gebracht hat (geometrisches Mittel), oder der Durchschnitt der einzelnen Jahresrenditen – der liegt bei schwankenden Anlagen immer höher." },
      { q: "Wie werden ETF-Gewinne besteuert?", a: "Bei Aktienfonds sind für Privatanleger 30 Prozent der Erträge steuerfrei (§ 20 Abs. 1 InvStG). Auf den Rest fallen nach Abzug des Sparer-Pauschbetrags 25 Prozent Abgeltungsteuer an, dazu der Solidaritätszuschlag und gegebenenfalls Kirchensteuer. Diese Rechnung übernimmt der ETF-Sparplan-Rechner; der Wert hier ist vor Steuern." },
      { q: "Ist regelmäßiges Sparen besser als eine Einmalanlage?", a: "Bei gleicher Rendite wächst Geld, das früher angelegt ist, länger. Ein Sparplan verteilt die Käufe dafür über die Zeit. Der Preis dafür: Beim Sparplan hängt das Ergebnis davon ab, in welcher Reihenfolge gute und schlechte Jahre kommen – bei der Einmalanlage nicht. Die Zahlen dazu stehen im Artikel auf dieser Seite." },
      { q: "Warum rechnet der Rechner nicht einfach mit einem Zwölftel der Rendite pro Monat?", a: "Weil sich die Monatserträge mitverzinsen: 7 Prozent geteilt durch zwölf ergeben über ein Jahr 7,23 Prozent. Der Rechner nimmt deshalb den Monatsfaktor, der über zwölf Monate genau die eingetragenen 7 Prozent ergibt." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="anfangsinvest">Anfangskapital (€)</label>
          <input type="number" id="anfangsinvest" min="0" max="500000" value="5000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="sparrate">Monatliche Sparrate (€)</label>
          <input type="number" id="sparrate" min="0" max="50000" value="500" step="50" />
        </div>
        <div class="calc-group">
          <label for="rendite">Erwartete jährliche Rendite (%)</label>
          <input type="number" id="rendite" min="0" max="15" value="7" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="jahre">Zeitraum (Jahre)</label>
          <input type="number" id="jahre" min="0" max="50" value="20" step="1" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Endsumme nach Gewinnen</div>
        <div id="endsumme">— €</div>
      </div>
      <div class="calc-result" style="background:#e8f5e9;">
        <div class="label">Gewonnene Zinsen/Rendite</div>
        <div id="gewinne">— €</div>
      </div>
      <div class="calc-result">
        <div class="label">Eingezahltes Kapital</div>
        <div id="eingezahlt">— €</div>
      </div>

      <details class="details">
        <summary>Entwicklung (Wert pro 5-Jahres-Periode)</summary>
        <div id="fortschritt"></div>
      </details>

      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;"></div>
    </div>
    <ArtikelEtfRendite slot="artikel" />
  </CalculatorShell>

</Layout>

<script type="module">
const { sparplanVerlauf } = await import(window.__base + 'scripts/etf-sparplan.js');
const eur = (n, stellen = 2) =>
  n.toLocaleString('de-DE', { minimumFractionDigits: stellen, maximumFractionDigits: stellen }) + ' €';
const wert = (id) => {
  const n = parseFloat(document.getElementById(id).value);
  return Number.isFinite(n) ? n : 0;
};
function berechne() {
  const jahre = Math.max(0, Math.round(wert('jahre')));
  const r = sparplanVerlauf({
    startkapital: wert('anfangsinvest'),
    sparrate: wert('sparrate'),
    renditeProzent: wert('rendite'),
    jahre,
  });
  document.getElementById('endsumme').textContent = eur(r.endkapital);
  document.getElementById('gewinne').textContent = eur(r.gewinn);
  document.getElementById('eingezahlt').textContent = eur(r.eingezahlt);

  const zeilen = r.jahreswerte
    .map((w, j) => ({ w, j }))
    .filter(({ j }) => j % 5 === 0 || j === jahre)
    .map(({ w, j }) => `<div style="display:flex; gap:1rem;"><strong style="width:70px;">Jahr ${j}:</strong><span>${eur(w, 0)}</span></div>`);
  document.getElementById('fortschritt').innerHTML = `<div style="display:grid; gap:0.5rem;">${zeilen.join('')}</div>`;
}
['anfangsinvest','sparrate','rendite','jahre'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>

<style>
.page-header { margin-bottom: 2rem; }
</style>
