---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'ratenkredit-detailrechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Ratenkredit-Detailrechner ${year}`}
  description="Ratenkredit berechnen mit Tilgungsplan: Monatliche Rate, Gesamtzinsen und Restschuld bei 3-15 % Effektivzins sofort ermitteln. Vergleich Laufzeiten und Zinskosten 2025."
  canonicalPath="/geld/ratenkredit-detailrechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Ratenkredit-Detailrechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Ratenkredit-Detailrechner berechnen Sie die monatliche Rate, Gesamtzinsen und erhalten einen detaillierten Tilgungsplan."
    sourceNote="Berechnung nach aktuellen Bankgebühren."
    explanation="Ein Ratenkredit ist ein festgesicherter Kredit mit festem Zinssatz und gleichbleibenden Raten. Die monatliche Rate setzt sich aus Tilgung und Zinsen zusammen."
    faqs={[
      { q: "Was ist ein Ratenkredit?", a: "Ein Kredit mit festem Zinssatz, fester Laufzeit und gleichbleibenden monatlichen Raten. Der Kreditnehmer zahlt kontinuierlich Zinsen und Tilgung." },
      { q: "Wie funktioniert die Tilgung?", a: "Mit jeder Rate sinkt der Restkreditbetrag, die Zinsen werden auf die verbleibende Schuld berechnet. Am Ende der Laufzeit ist der Kredit vollständig getilgt." },
      { q: "Effektiver Zins vs. Sollzins – was ist der Unterschied?", a: "Der Sollzins ist der reine Zinssatz. Der effektive Zins berücksichtigt auch Gebühren und wird nach PAngV berechnet. Immer den effektiven Zins vergleichen!" },
      { q: "Kann ich den Kredit früher zurückzahlen?", a: "Ja, fast alle Ratenkredite erlauben Sondertilgungen ohne Vorfälligkeitsentschädigung (ab 200€ monatliche Rückzahlung)." },
      { q: "Wie viel Kredit kann ich bekommen?", a: "Das hängt vom Einkommen, Bonität und bestehenden Schulden ab. Banken vergeben typischerweise 1-5x das monatliche Nettoeinkommen." },
      { q: "Welche Zinssätze sind 2025 realistisch?", a: "Im Jahr 2025 liegen die effektiven Zinssätze für Ratenkredite in Deutschland zwischen 3,5 % (sehr gute Bonität, kurze Laufzeit) und 10-12 % (schwache Bonität, lange Laufzeit). Der Median liegt bei etwa 6-7 %. Autofinanzierungen über Herstellerbanken beginnen teils bei 2,99 %. Vergleichen Sie mindestens 3-5 Anbieter, da die Spanne je nach SCHUFA-Score erheblich ist." },
      { q: "Was passiert bei Zahlungsverzug?", a: "Bei Verzug darf die Bank Verzugszinsen von 5 Prozentpunkten über dem Basiszinssatz berechnen (2025: ca. 8,7 % Verzugszins). Nach zwei aufeinanderfolgenden ausgebliebenen Raten und mindestens 10 % der Kreditsumme oder bei mehr als 2,5 % Rückstand darf die Bank den gesamten Kredit fällig stellen. Sprechen Sie bei Zahlungsschwierigkeiten frühzeitig mit der Bank – Ratenpausen oder Laufzeitverlängerungen sind oft möglich." },
      { q: "Lohnt sich eine Umschuldung?", a: "Eine Umschuldung lohnt sich, wenn der neue Zinssatz mindestens 1-2 Prozentpunkte unter dem alten liegt. Bei einem Restkredit von 10.000 Euro und 3 % Zinsdifferenz sparen Sie über 36 Monate rund 950 Euro. Beachten Sie die maximale Vorfälligkeitsentschädigung von 1 % der Restschuld. Viele Banken bieten spezielle Umschuldungskredite mit günstigen Konditionen an." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="kreditsumme">Kreditsumme (€)</label>
          <input type="number" id="kreditsumme" min="1000" max="500000" value="10000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="laufzeit">Laufzeit (Monate)</label>
          <input type="number" id="laufzeit" min="6" max="240" value="60" step="1" />
        </div>
        <div class="calc-group">
          <label for="zinssatz">Effektiver Zinssatz (%)</label>
          <input type="number" id="zinssatz" min="0.5" max="15" value="5.5" step="0.1" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Monatliche Rate</div>
        <div id="rate">— €</div>
      </div>
      <div class="calc-result" style="background:#fff3e0;">
        <div class="label">Gesamtzinsen</div>
        <div id="gesamt_zinsen">— €</div>
      </div>
      <div class="calc-result">
        <div class="label">Gesamtbetrag (Kredit + Zinsen)</div>
        <div id="gesamtbetrag">— €</div>
      </div>

      <details class="details">
        <summary>Tilgungsplan (erste 12 Monate)</summary>
        <table id="tilgungsplan">
          <thead>
            <tr><th>Monat</th><th>Rate</th><th>Tilgung</th><th>Zinsen</th><th>Restschuld</th></tr>
          </thead>
          <tbody id="plan-body"></tbody>
        </table>
      </details>

      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Ratenkredit: Zinsen, Tilgung und versteckte Kosten"
    content={`<p>Der Ratenkredit ist die haeufigste Kreditform fuer Verbraucher in Deutschland. Mit festen monatlichen Raten und planbarer Laufzeit bietet er hohe Planungssicherheit. Doch die Zinsunterschiede zwischen Anbietern sind erheblich: Waehrend bonitaetsstarke Kreditnehmer Zinsen ab 3-4 % erhalten, zahlen andere bis zu 10 % oder mehr.</p>

<h3>Zinskosten im Vergleich: Laufzeit und Zinssatz</h3>
<table>
<thead><tr><th>Kreditsumme</th><th>Laufzeit</th><th>Effektivzins</th><th>Monatliche Rate</th><th>Gesamtzinsen</th></tr></thead>
<tbody>
<tr><td>10.000 EUR</td><td>36 Monate</td><td>4,9 %</td><td>299,66 EUR</td><td>787,76 EUR</td></tr>
<tr><td>10.000 EUR</td><td>60 Monate</td><td>5,5 %</td><td>190,99 EUR</td><td>1.459,40 EUR</td></tr>
<tr><td>10.000 EUR</td><td>84 Monate</td><td>6,5 %</td><td>148,59 EUR</td><td>2.481,56 EUR</td></tr>
<tr><td>20.000 EUR</td><td>48 Monate</td><td>5,2 %</td><td>462,42 EUR</td><td>2.196,16 EUR</td></tr>
<tr><td>20.000 EUR</td><td>72 Monate</td><td>6,0 %</td><td>331,40 EUR</td><td>3.860,80 EUR</td></tr>
<tr><td>30.000 EUR</td><td>60 Monate</td><td>5,9 %</td><td>578,55 EUR</td><td>4.713,00 EUR</td></tr>
</tbody>
</table>

<p><strong>Effektivzins ist Pflicht beim Vergleich:</strong> Nach der Preisangabenverordnung (PAngV) muessen Banken den effektiven Jahreszins angeben. Dieser enthaelt alle Kosten inklusive Bearbeitungsgebuehren und Kontofuehrungsgebuehren. Der Sollzins allein ist truegerisch - vergleichen Sie ausschliesslich den Effektivzins. Bei einem 10.000-Euro-Kredit ueber 60 Monate bedeutet 1 % Zinsunterschied etwa 270 Euro mehr oder weniger an Gesamtkosten.</p>

<h3>Typische Zinsspannen nach Kreditart (Stand 2025)</h3>
<table>
<thead><tr><th>Kreditart</th><th>Zinsspanne (eff.)</th><th>Typische Laufzeit</th><th>Besonderheit</th></tr></thead>
<tbody>
<tr><td>Autokredit (Herstellerbank)</td><td>2,99 - 5,49 %</td><td>36 - 60 Monate</td><td>Fahrzeug als Sicherheit</td></tr>
<tr><td>Freier Ratenkredit</td><td>4,50 - 9,90 %</td><td>12 - 84 Monate</td><td>Keine Zweckbindung</td></tr>
<tr><td>Umschuldungskredit</td><td>3,90 - 7,50 %</td><td>24 - 72 Monate</td><td>Abloesung bestehender Kredite</td></tr>
<tr><td>Kleinkredit (unter 3.000 EUR)</td><td>6,00 - 12,00 %</td><td>6 - 36 Monate</td><td>Hoehere Zinsen wegen geringer Summe</td></tr>
<tr><td>Beamtenkredit</td><td>2,50 - 4,50 %</td><td>12 - 120 Monate</td><td>Unkuendbares Dienstverhaeltnis</td></tr>
</tbody>
</table>

<p><strong>Laufzeit vs. monatliche Belastung:</strong> Eine laengere Laufzeit senkt die monatliche Rate, erhoeht aber die Gesamtzinskosten deutlich. Beispiel: 15.000 Euro bei 5,5 % Zinsen kosten ueber 36 Monate insgesamt 1.310 Euro Zinsen, ueber 72 Monate hingegen 2.690 Euro - mehr als doppelt so viel. Waehlen Sie die kuerzeste Laufzeit, die Ihr Budget erlaubt.</p>

<p><strong>Sondertilgungsrecht pruefen:</strong> Laut BGB Paragraph 500 duerfen Verbraucher Ratenkredite jederzeit ganz oder teilweise vorzeitig zurueckzahlen. Die Bank darf maximal 1 % der Restschuld als Vorfaelligkeitsentschaedigung verlangen. Viele Online-Banken verzichten ganz auf diese Gebuehr - ein wichtiges Vergleichskriterium.</p>

<p><strong>Praxistipp:</strong> Beantragen Sie nie mehr Kredit als noetig und vermeiden Sie Restschuldversicherungen. Diese kosten oft 5-10 % der Kreditsumme und sind in den meisten Faellen ueberfluessig. Pruefen Sie stattdessen, ob Ihre bestehende Risikolebensversicherung oder Berufsunfaehigkeitsversicherung den Kreditfall bereits abdeckt.</p>`}
    relatedSlugs={['kreditvergleich', 'autofinanzierung-rechner', 'schuldentilgungs-rechner', 'sparen-rechner']}
  />
</Layout>

<script type="module">
function berechne() {
  const kreditsumme = parseFloat(document.getElementById('kreditsumme').value)||10000;
  const laufzeit = parseInt(document.getElementById('laufzeit').value)||60;
  const zinssatz = parseFloat(document.getElementById('zinssatz').value)||5.5;

  const monatszins = zinssatz / 100 / 12;
  const rate = kreditsumme * (monatszins * Math.pow(1 + monatszins, laufzeit)) / (Math.pow(1 + monatszins, laufzeit) - 1);
  const gesamtzinsen = rate * laufzeit - kreditsumme;
  const gesamtbetrag = kreditsumme + gesamtzinsen;

  document.getElementById('rate').textContent = rate.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
  document.getElementById('gesamt_zinsen').textContent = gesamtzinsen.toLocaleString('de-DE', {minimumFractionDigits:2}) + ' €';
  document.getElementById('gesamtbetrag').textContent = gesamtbetrag.toLocaleString('de-DE', {minimumFractionDigits:2}) + ' €';

  // Tilgungsplan
  let restschuld = kreditsumme;
  let planHTML = '';
  for (let monat = 1; monat <= Math.min(12, laufzeit); monat++) {
    const zinsen = restschuld * monatszins;
    const tilgung = rate - zinsen;
    restschuld -= tilgung;
    planHTML += `<tr><td>${monat}</td><td>${rate.toLocaleString('de-DE', {minimumFractionDigits:2})}</td><td>${tilgung.toLocaleString('de-DE', {minimumFractionDigits:2})}</td><td>${zinsen.toLocaleString('de-DE', {minimumFractionDigits:2})}</td><td>${Math.max(0, restschuld).toLocaleString('de-DE', {minimumFractionDigits:2})}</td></tr>`;
  }
  document.getElementById('plan-body').innerHTML = planHTML;
}

['kreditsumme','laufzeit','zinssatz'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>

<style>
.page-header { margin-bottom: 2rem; }
#tilgungsplan { width: 100%; border-collapse: collapse; margin-top: 1rem; }
#tilgungsplan th, #tilgungsplan td { border: 1px solid #ddd; padding: 0.5rem; text-align: right; }
#tilgungsplan th { background: var(--dark); color: white; }
#tilgungsplan tbody tr:nth-child(odd) { background: #f9f9f9; }
</style>
