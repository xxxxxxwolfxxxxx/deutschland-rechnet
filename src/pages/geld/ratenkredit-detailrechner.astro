---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { annuitaetenrate, tilgungsplan, effektivzins } from '../../../public/scripts/annuitaet.js';
const calc = CALCULATORS.find(c => c.slug === 'ratenkredit-detailrechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const eur0 = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const pz = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' %';

function kosten(betrag: number, sollzins: number, monate: number) {
  const rate = annuitaetenrate({ betrag, sollzins, monate });
  const plan = tilgungsplan({ betrag, sollzins, monate, rate });
  const zinsen = plan.reduce((s, z) => s + z.zins, 0);
  return { rate, zinsen };
}

const ZINSSAETZE = [4, 6, 8];
const LAUFZEITEN = [36, 60, 84];
function zeile(monate: number) {
  return '<tr><td>' + monate + ' Monate</td>' + ZINSSAETZE.map((z) => {
    const k = kosten(10000, z, monate);
    return '<td>' + eur(k.rate) + '<br><small>Zinsen ' + eur0(k.zinsen) + '</small></td>';
  }).join('') + '</tr>';
}
const zeilen = LAUFZEITEN.map(zeile).join('');
const kurz = kosten(10000, 6, 36);
const lang = kosten(10000, 6, 84);
if (!(lang.zinsen > 2 * kurz.zinsen)) throw new Error('Ratenkredit: Text zur Laufzeit stimmt nicht');

const bspRate = annuitaetenrate({ betrag: 10000, sollzins: 6, monate: 60 });
const effOhne = effektivzins({ auszahlung: 10000, rate: bspRate, monate: 60 });
const effMit = effektivzins({ auszahlung: 9800, rate: bspRate, monate: 60 });
if (!(effMit > effOhne)) throw new Error('Ratenkredit: Effektivzins-Beispiel stimmt nicht');

const guideHtml = `
<h3>Rate und Zinsen</h3>
<p>Ein Ratenkredit wird meist als Annuitätendarlehen vergeben: Die Monatsrate bleibt gleich, der Zinsanteil sinkt mit der Restschuld, der Tilgungsanteil steigt. Die Tabelle zeigt Raten und Gesamtzinsen für ${eur0(10000)} bei verschiedenen Sollzinssätzen – Beispielwerte, keine Aussage über aktuelle Angebote:</p>
<table>
<thead><tr><th>Laufzeit</th>${ZINSSAETZE.map((z) => '<th>' + z + ' % Sollzins</th>').join('')}</tr></thead>
<tbody>${zeilen}</tbody>
</table>
<p>Eine längere Laufzeit senkt die Rate, erhöht aber die Zinsen: Bei 6 % kosten ${eur0(10000)} über 36 Monate ${eur0(kurz.zinsen)} Zinsen, über 84 Monate ${eur0(lang.zinsen)}.</p>

<h3>Sollzins und effektiver Jahreszins</h3>
<p>Der Sollzins bestimmt die Rate. Der effektive Jahreszins nach der Preisangabenverordnung rechnet zusätzlich die Kosten ein, die der Kreditnehmer tragen muss, und berücksichtigt die monatliche Zahlweise. Ohne weitere Kosten liegt er bei ${pz(6)} Sollzins und 60 Monaten bei ${pz(effOhne)}. Mindern ${eur0(200)} Kosten die Auszahlung auf ${eur0(9800)}, steigt er bei gleicher Rate auf ${pz(effMit)}. Vergleichen Sie Angebote deshalb am effektiven Jahreszins.</p>

<h3>Vorzeitig zurückzahlen</h3>
<p>Ein Verbraucherdarlehen darf jederzeit ganz oder teilweise vorzeitig zurückgezahlt werden (§ 500 Abs. 2 Satz 1 BGB). Eine Vorfälligkeitsentschädigung darf der Darlehensgeber nur verlangen, wenn zum Zeitpunkt der Rückzahlung ein gebundener Sollzins geschuldet wird (§ 502 Abs. 1 BGB). Sie darf höchstens 1 % des vorzeitig zurückgezahlten Betrags betragen, 0,5 %, wenn bis zur vereinbarten Rückzahlung höchstens ein Jahr bleibt, und nicht mehr als die Zinsen, die bis dahin angefallen wären (§ 502 Abs. 3 BGB).</p>

<h3>Wenn Raten ausbleiben</h3>
<p>Verzugszinsen richten sich nach § 288 Abs. 1 BGB (§ 497 Abs. 1 BGB). Den ganzen Kredit kündigen darf der Darlehensgeber bei einem Teilzahlungsdarlehen nur, wenn der Darlehensnehmer mit mindestens zwei aufeinanderfolgenden Raten ganz oder teilweise in Verzug ist, der Rückstand mindestens 10 % des Nennbetrags erreicht – bei einer Laufzeit von mehr als drei Jahren 5 % – und eine zweiwöchige Zahlungsfrist mit Kündigungsandrohung erfolglos verstrichen ist (§ 498 Abs. 1 BGB).</p>
`;

const faqs = [
  { q: 'Wie wird die Monatsrate berechnet?', a: 'Nach der Annuitätenformel aus Kreditbetrag, monatlichem Sollzins und Zahl der Raten. Die Rate bleibt über die Laufzeit gleich; nur das Verhältnis von Zins und Tilgung verschiebt sich.' },
  { q: 'Was ist der Unterschied zwischen Sollzins und Effektivzins?', a: `Der Sollzins bestimmt die Rate. Der effektive Jahreszins nach der Preisangabenverordnung rechnet Kosten und Zahlweise ein. Im Beispiel dieser Seite machen ${eur0(200)} Kosten aus ${pz(effOhne)} effektiv ${pz(effMit)}.` },
  { q: 'Darf ich den Kredit früher zurückzahlen?', a: 'Ja, jederzeit ganz oder teilweise (§ 500 Abs. 2 BGB). Eine Vorfälligkeitsentschädigung ist nur bei gebundenem Sollzins zulässig und auf 1 % des vorzeitig gezahlten Betrags begrenzt, 0,5 % bei höchstens einem Jahr Restlaufzeit (§ 502 BGB).' },
  { q: 'Wann darf die Bank den Kredit kündigen?', a: 'Bei mindestens zwei aufeinanderfolgenden rückständigen Raten, einem Rückstand von mindestens 10 % des Nennbetrags (5 % bei mehr als drei Jahren Laufzeit) und nach erfolglosem Ablauf einer zweiwöchigen Zahlungsfrist mit Kündigungsandrohung (§ 498 Abs. 1 BGB).' },
];
---
<Layout
  title={`Ratenkredit-Detailrechner ${year}`}
  description="Ratenkredit mit Tilgungsplan: Monatsrate, Gesamtzinsen und effektiver Jahreszins – dazu Ihre Rechte bei vorzeitiger Rückzahlung und Zahlungsverzug nach BGB."
  canonicalPath="/geld/ratenkredit-detailrechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Ratenkredit-Detailrechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner ermittelt Monatsrate, Gesamtzinsen und Tilgungsplan eines Ratenkredits und zeigt, wie einmalige Kosten den effektiven Jahreszins erhöhen."
    sourceNote="Annuitätenrate und Tilgungsplan aus Sollzins, Betrag und Laufzeit; effektiver Jahreszins nach der Barwertmethode der Anlage zu § 16 PAngV. Rechte bei vorzeitiger Rückzahlung und Verzug nach §§ 497, 498, 500, 502 BGB (abgerufen am 14.09.2026). Zinssätze sind Ihre Eingaben."
    explanation="Rate = Betrag × i × (1 + i)^n ÷ ((1 + i)^n − 1) mit i = Sollzins ÷ 12 und n = Zahl der Monate. Der Effektivzins ist der Jahreszins, bei dem der Barwert aller Raten dem ausgezahlten Betrag entspricht."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="kreditsumme">Kreditbetrag (€)</label>
          <input type="number" id="kreditsumme" min="100" max="1000000" value="10000" step="500" />
        </div>
        <div class="calc-group">
          <label for="laufzeit">Laufzeit (Monate)</label>
          <input type="number" id="laufzeit" min="1" max="120" value="60" step="6" />
        </div>
        <div class="calc-group">
          <label for="zinssatz">Sollzins (% p. a.)</label>
          <input type="number" id="zinssatz" min="0" max="30" value="6" step="0.1" />
        </div>
        <div class="calc-group">
          <label for="kosten">Einmalige Kosten, die die Auszahlung mindern (€)</label>
          <input type="number" id="kosten" min="0" max="100000" value="0" step="50" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Monatliche Rate</div>
        <div id="rate">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
      <div style="overflow-x:auto;margin-top:1rem;">
        <table id="tilgungsplan">
          <thead><tr><th>Monat</th><th>Rate</th><th>Tilgung</th><th>Zinsen</th><th>Restschuld</th></tr></thead>
          <tbody id="plan"></tbody>
        </table>
      </div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Ratenkredit: Rate, Effektivzins und Ihre Rechte"
    content={guideHtml}
    relatedSlugs={['kreditvergleich', 'tilgungs-kreditrechner', 'schuldentilgungs-rechner']}
  />
</Layout>

<script type="module">
const { annuitaetenrate, tilgungsplan, effektivzins } = await import(window.__base + 'scripts/annuitaet.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const betrag = wert('kreditsumme');
  const monate = Math.max(1, Math.round(wert('laufzeit')));
  const sollzins = wert('zinssatz');
  const rate = annuitaetenrate({ betrag, sollzins, monate });
  const plan = tilgungsplan({ betrag, sollzins, monate, rate });
  const zinsen = plan.reduce((s, z) => s + z.zins, 0);
  const gezahlt = plan.reduce((s, z) => s + z.rate, 0);
  const eff = effektivzins({ auszahlung: betrag - wert('kosten'), rate, monate });
  document.getElementById('rate').textContent = eur(rate);
  document.getElementById('details').innerHTML = [
    `<span>Gesamtzinsen: <strong>${eur(zinsen)}</strong></span>`,
    `<span>Summe aller Raten: <strong>${eur(gezahlt)}</strong></span>`,
    `<span>Effektiver Jahreszins: <strong>${eff.toLocaleString('de-DE', { maximumFractionDigits: 2 })} %</strong></span>`,
  ].join('');
  document.getElementById('plan').innerHTML = plan.slice(0, 12).map((z) =>
    `<tr><td>${z.monat}</td><td>${eur(z.rate)}</td><td>${eur(z.tilgung)}</td><td>${eur(z.zins)}</td><td>${eur(z.restschuld)}</td></tr>`).join('');
}
['kreditsumme', 'laufzeit', 'zinssatz', 'kosten'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>

<style>
#tilgungsplan { width: 100%; border-collapse: collapse; }
#tilgungsplan th, #tilgungsplan td { border: 1px solid #ddd; padding: 0.5rem; text-align: right; font-size: 0.85rem; }
#tilgungsplan th { background: var(--dark); color: white; }
#tilgungsplan tbody tr:nth-child(odd) { background: #f9f9f9; }
</style>
