---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { berechneNettoGehalt } from '../../../public/scripts/brutto-netto.js';
import { GRUNDFREIBETRAG } from '../../../public/scripts/einkommensteuer.js';
import { ENTLASTUNGSBETRAG_ALLEINERZIEHENDE } from '../../../public/scripts/lohnsteuer.js';
const calc = CALCULATORS.find(c => c.slug === 'steuerklassen-vergleich')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Die Beispieltabelle wird aus demselben Rechenmodul erzeugt wie der Rechner
// oben. Vorher stand sie als Fließtext daneben – mit den Werten von 2025 und
// einer Lohnsteuer, die zur Rechnung auf der Seite nicht passte.
const BEISPIEL_BRUTTO = 3500;
const beispiel = berechneNettoGehalt({
  bruttoMonat: BEISPIEL_BRUTTO, steuerklasse: 1, bundesland: 'NW', kirchensteuer: false, kinder: 1,
});
const euro = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Euro';
const anteil = (n: number) => (n / BEISPIEL_BRUTTO * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
const beispielZeilen = [
  ['Lohnsteuer', beispiel.lohnsteuer],
  ['Solidaritätszuschlag', beispiel.soli],
  ['Krankenversicherung (inkl. durchschnittlichem Zusatzbeitrag)', beispiel.krankenversicherung],
  ['Pflegeversicherung (ein Kind)', beispiel.pflegeversicherung],
  ['Rentenversicherung', beispiel.rentenversicherung],
  ['Arbeitslosenversicherung', beispiel.arbeitslosenversicherung],
] as const;
const gfb = GRUNDFREIBETRAG.toLocaleString('de-DE');
const gfbDoppelt = (GRUNDFREIBETRAG * 2).toLocaleString('de-DE');
const entlastung = ENTLASTUNGSBETRAG_ALLEINERZIEHENDE.toLocaleString('de-DE');
---
<Layout
  title={`Steuerklassen-Vergleich ${year}`}
  description={`Steuerklassen I bis VI vergleichen: Lohnsteuer, Solidaritätszuschlag und Nettolohn für jede Klasse, berechnet nach § 39b EStG. Mit Erklärung zur Kombination III/V und zu IV mit Faktor für Ehepaare ${year}.`}
  canonicalPath="/geld/steuerklassen-vergleich/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Steuerklassen-Vergleich {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Steuerklassen-Vergleich sehen Sie auf einen Blick, wie sich die Steuerklassen I bis VI auf Ihren Nettolohn auswirken. Geben Sie Ihr Bruttogehalt ein und vergleichen Sie die Abzüge aller sechs Steuerklassen in einer Übersicht."
    sourceNote={`Lohnsteuerabzug nach § 39b Abs. 2 EStG mit dem Tarif des § 32a EStG (VZ ${year}), Beitragssätze nach der Sozialversicherungsrechengrößen-Verordnung ${year}. Angenommen: Nordrhein-Westfalen, ein Kind unter 25 Jahren, keine Kirchensteuer, keine Freibeträge nach § 39a EStG.`}
    explanation={`Klasse III hat den geringsten Abzug, weil dort der Splittingtarif des § 32a Abs. 5 EStG angewendet wird – er wirkt wie ein verdoppelter Grundfreibetrag von ${gfbDoppelt} Euro. Die Klassen V und VI rechnen nach der Sonderformel des § 39b Abs. 2 Satz 7 EStG; in Klasse VI entfallen zusätzlich Arbeitnehmer- und Sonderausgaben-Pauschbetrag, weshalb die Abzüge dort am höchsten sind. Die Steuerklasse verteilt die Steuer über das Jahr, sie verändert die endgültige Jahressteuer nicht.`} faqs={[
      { q: "Welche Steuerklassen gibt es in Deutschland?", a: "Es gibt sechs Steuerklassen: I (Ledige, Geschiedene, Verwitwete), II (Alleinerziehende mit Entlastungsbetrag), III (Verheiratete mit höherem Einkommen, Partner in V), IV (Verheiratete bei ähnlichem Einkommen), V (Verheiratete mit niedrigerem Einkommen, Partner in III) und VI (für Zweit- und Nebenjobs). Die Steuerklasse bestimmt die Höhe der monatlichen Lohnsteuerabzüge." },
      { q: "Warum zahle ich in Steuerklasse V so viel Lohnsteuer?", a: "Weil der Partner in Klasse III bereits den vollen Splittingvorteil erhält, rechnet Klasse V nach der Sonderformel des § 39b Abs. 2 Satz 7 EStG: dem zweifachen Unterschied zwischen der Steuer auf das Eineinviertelfache und der Steuer auf das Dreiviertelfache des zu versteuernden Betrags, mindestens aber 14 Prozent. Dadurch wird praktisch vom ersten Euro an Lohnsteuer einbehalten. Die Gesamtsteuerbelastung des Paares bleibt bei der Jahresabrechnung identisch – es ist ein reiner Verteilungseffekt über das Jahr." },
      { q: "Wie bekomme ich Steuerklasse II als Alleinerziehende/r?", a: "Steuerklasse II steht Alleinerziehenden zu, bei denen mindestens ein Kind gemeldet ist und die keinen Haushaltsgemeinschaft mit einer anderen volljährigen Person bilden. Sie erhalten einen Entlastungsbetrag von 4.260 Euro für das erste Kind und je 240 Euro für jedes weitere Kind. Den Antrag stellen Sie beim Finanzamt oder über ELSTER." },
      { q: "Bestimmt die Steuerklasse meine endgültige Steuerlast?", a: "Nein. Die Steuerklasse regelt nur, wie viel Lohnsteuer Ihr Arbeitgeber monatlich einbehält. Die tatsächliche Steuerlast wird erst mit der Einkommensteuererklärung berechnet. Wer zu viel gezahlt hat, bekommt Geld zurück; wer zu wenig gezahlt hat, muss nachzahlen. Bei der Kombination III/V ist eine Steuererklärung Pflicht." },
      { q: "Was passiert steuerlich bei Heirat oder Scheidung?", a: "Nach der Heirat werden beide Partner automatisch in Steuerklasse IV eingestuft. Sie können dann gemeinsam eine andere Kombination (III/V oder IV mit Faktor) beantragen. Bei Scheidung oder Trennung wechseln Sie im Folgejahr zurück in Steuerklasse I (bzw. II bei Kindern). Im Trennungsjahr gilt noch die gemeinsame Veranlagung." },
      { q: "Wann lohnt sich die Kombination III/V statt IV/IV?", a: "Die Kombination III/V lohnt sich, wenn ein Partner deutlich mehr verdient als der andere (Faustregel: mindestens 60/40-Verhältnis). Der Besserverdiener nimmt Klasse III und profitiert vom Splittingtarif, der wie ein verdoppelter Grundfreibetrag wirkt. Nachteil: Bei III/V ist eine Steuererklärung Pflicht und es drohen Nachzahlungen." },
      { q: "Wie wirkt sich die Steuerklasse auf Elterngeld und Arbeitslosengeld aus?", a: "Elterngeld, Arbeitslosengeld, Krankengeld und Kurzarbeitergeld werden auf Basis des Nettogehalts berechnet. Wer vor dem Bezug in eine günstigere Steuerklasse wechselt, erhält mehr Lohnersatzleistung. Der Wechsel muss mindestens 7 Monate vor Beginn des Mutterschutzes erfolgen, damit er beim Elterngeld anerkannt wird." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-group" style="max-width:280px;">
        <label for="brutto">Bruttogehalt (€/Monat)</label>
        <input type="number" id="brutto" min="500" max="30000" value="3500" step="50" />
      </div>
      <div class="presets" style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;">
        <span style="font-size:0.82rem;color:var(--muted);align-self:center;">Schnellwahl:</span>
        <button class="preset-btn" data-v="2000">2.000 €</button>
        <button class="preset-btn" data-v="3000">3.000 €</button>
        <button class="preset-btn" data-v="3500">3.500 €</button>
        <button class="preset-btn" data-v="5000">5.000 €</button>
        <button class="preset-btn" data-v="8000">8.000 €</button>
      </div>
      <div id="tabelle"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Die sechs Steuerklassen in Deutschland: Was Sie wissen müssen"
    content={`<p>Das deutsche Lohnsteuersystem kennt sechs Steuerklassen, die bestimmen, wie viel Lohnsteuer Ihr Arbeitgeber monatlich von Ihrem Bruttogehalt einbehält. Die Steuerklasse beeinflusst nur den monatlichen Abzug, nicht die endgültige Steuerlast im Jahr. Trotzdem ist die richtige Wahl wichtig, denn sie bestimmt Ihr monatliches Nettoeinkommen und die Höhe von Lohnersatzleistungen wie Elterngeld oder Arbeitslosengeld.</p>

<h4>Übersicht: Alle Steuerklassen auf einen Blick (${year})</h4>
<table>
  <thead>
    <tr><th>Klasse</th><th>Für wen?</th><th>Wirkung beim Lohnsteuerabzug</th><th>Besonderheit</th></tr>
  </thead>
  <tbody>
    <tr><td>I</td><td>Ledige, Geschiedene, Verwitwete</td><td>Grundtarif, Grundfreibetrag ${gfb} Euro</td><td>Standard-Steuerklasse</td></tr>
    <tr><td>II</td><td>Alleinerziehende</td><td>Grundtarif zuzüglich Entlastungsbetrag ${entlastung} Euro</td><td>Antrag beim Finanzamt nötig</td></tr>
    <tr><td>III</td><td>Verheiratete (Besserverdiener)</td><td>Splittingtarif, wirkt wie ${gfbDoppelt} Euro Grundfreibetrag</td><td>Partner muss in V sein</td></tr>
    <tr><td>IV</td><td>Verheiratete (ähnliches Einkommen)</td><td>Grundtarif wie Klasse I</td><td>Standard nach Heirat</td></tr>
    <tr><td>V</td><td>Verheiratete (Geringverdiener)</td><td>Sonderformel des § 39b Abs. 2 Satz 7 EStG</td><td>Partner muss in III sein</td></tr>
    <tr><td>VI</td><td>Zweit- und Nebenjobs</td><td>Sonderformel, zusätzlich ohne Pauschbeträge</td><td>Höchste Abzüge</td></tr>
  </tbody>
</table>

<p><strong>Steuerklasse I:</strong> Gilt für Ledige, Geschiedene und dauerhaft getrennt Lebende. Der Grundfreibetrag liegt ${year} bei ${gfb} Euro. Wer weniger als diesen Betrag im Jahr zu versteuern hat, zahlt keine Einkommensteuer. Steuerklasse I ist die Standardklasse und wird automatisch zugewiesen, wenn keine andere Klasse beantragt wird.</p>

<p><strong>Steuerklasse II:</strong> Für Alleinerziehende, die mit mindestens einem Kind zusammenleben. Beim Lohnsteuerabzug wird zusätzlich der Entlastungsbetrag von ${entlastung} Euro für das erste Kind berücksichtigt (§ 24b Abs. 2 Satz 1 EStG); die 240 Euro für jedes weitere Kind kommen erst über einen Freibetrag nach § 39a EStG oder die Steuererklärung hinzu. Voraussetzung: Keine weitere volljährige Person gehört zum Haushalt (Ausnahme: volljährige Kinder, für die Kindergeld bezogen wird). Der Antrag erfolgt beim Finanzamt.</p>

<p><strong>Steuerklassen III, IV und V:</strong> Diese drei Klassen stehen nur Verheirateten und eingetragenen Lebenspartnern zur Verfügung. IV/IV ist die Standardkombination. III/V eignet sich bei unterschiedlich hohen Einkommen. Der Partner in III zahlt deutlich weniger Lohnsteuer, der in V deutlich mehr. In Summe kann das monatliche Nettoeinkommen steigen, allerdings entsteht häufig eine Nachzahlungspflicht bei der Steuererklärung. Seit 2010 gibt es alternativ IV/IV mit Faktor, das die Steuerlast genauer verteilt.</p>

<p><strong>Steuerklasse VI:</strong> Wird automatisch für den zweiten und jeden weiteren Job zugewiesen. Hier entfallen der Arbeitnehmer-Pauschbetrag und der Sonderausgaben-Pauschbetrag, und es gilt die Sonderformel für hohe Abzüge. Bei Minijobs bis 603 Euro monatlich ist keine Steuerklasse relevant, da der Arbeitgeber pauschal versteuert.</p>

<h4>Nettolohn bei ${BEISPIEL_BRUTTO.toLocaleString('de-DE')} Euro brutto (${year}, Steuerklasse I, Nordrhein-Westfalen, ein Kind, keine Kirchensteuer)</h4>
<table>
  <thead>
    <tr><th>Abzug</th><th>Betrag/Monat</th><th>Anteil am Brutto</th></tr>
  </thead>
  <tbody>
    ${beispielZeilen.map(([bezeichnung, betrag]) =>
      `<tr><td>${bezeichnung}</td><td>${euro(betrag)}</td><td>${anteil(betrag)}</td></tr>`).join('')}
    <tr><td><strong>Netto</strong></td><td><strong>${euro(beispiel.netto)}</strong></td><td><strong>${anteil(beispiel.netto)}</strong></td></tr>
  </tbody>
</table>

<p>Die Werte in dieser Tabelle stammen aus demselben Rechenmodul wie der Rechner oben – sie können nicht auseinanderlaufen. Der Solidaritätszuschlag steht bei diesem Einkommen auf null, weil er erst über einer Jahreslohnsteuer von 20.350 Euro erhoben wird.</p>

<p><strong>Praxistipp:</strong> Vergleichen Sie die Nettolöhne in verschiedenen Steuerklassen mit dem Rechner oben. Denken Sie daran: Die Steuerklasse verändert nicht Ihre Gesamtsteuerlast im Jahr, sondern nur die monatliche Verteilung. Eine Steuererklärung gleicht Unterschiede aus. Besonders wichtig ist die Steuerklassenwahl vor dem Bezug von Elterngeld, Arbeitslosengeld oder Krankengeld, da diese auf dem Nettoeinkommen basieren. Der Wechsel der Steuerklasse ist seit 2023 mehrfach im Jahr möglich (früher nur einmal).</p>`}
    relatedSlugs={['steuerklasse-optimieren', 'brutto-netto-rechner', 'steuernachzahlung-rechner']}
  />
</Layout>

<style>
.preset-btn {
  background: var(--surface); border: 1.5px solid var(--border); border-radius: 20px;
  padding: 0.25rem 0.75rem; font-size: 0.8rem; cursor: pointer;
  transition: border-color 0.15s, background 0.15s; font-family: var(--font-ui); color: var(--text);
}
.preset-btn:hover, .preset-btn.active { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, white); color: var(--accent); }
.sk-table { width:100%; border-collapse:collapse; font-size:0.88rem; margin-top:0.5rem; }
.sk-table th { text-align:left; font-weight:600; font-size:0.78rem; color:var(--muted); padding:0.4rem 0.6rem; border-bottom:2px solid var(--border); text-transform:uppercase; letter-spacing:0.04em; }
.sk-table td { padding:0.55rem 0.6rem; border-bottom:1px solid var(--border); }
.sk-table tr.highlight td { background:color-mix(in srgb, var(--accent) 6%, white); font-weight:600; }
.sk-table tr:last-child td { border-bottom:none; }
.sk-table td.netto { font-family:var(--font-display); font-size:1rem; font-weight:600; }
.sk-badge { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; background:var(--border); font-weight:700; font-size:0.85rem; }
</style>

<script type="module">
const { berechneAlleKlassen } = await import(window.__base + 'scripts/steuerklassen.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const brutto = parseFloat(document.getElementById('brutto').value)||3500;
  const result = berechneAlleKlassen(brutto * 12, { bundesland: 'NW', kinder: 1 });
  const maxNetto = Math.max(...result.map(r => r.nettoMonat));
  document.getElementById('tabelle').innerHTML =
    `<table class="sk-table">
      <thead><tr>
        <th>Klasse</th><th>Lohnsteuer</th><th>Soli</th><th>Sozialvers.</th><th>Netto/Monat</th>
      </tr></thead>
      <tbody>` +
    result.map(r =>
      `<tr class="${r.nettoMonat === maxNetto ? 'highlight' : ''}">
        <td><span class="sk-badge">${r.klasse}</span></td>
        <td>${fmt(r.lstMonat)}</td>
        <td>${r.soliMonat > 0 ? fmt(r.soliMonat) : '—'}</td>
        <td>${fmt(r.svMonat)}</td>
        <td class="netto">${fmt(r.nettoMonat)}</td>
      </tr>`
    ).join('') +
    `</tbody></table>`;
  document.querySelectorAll('.preset-btn').forEach(b =>
    b.classList.toggle('active', parseFloat(b.dataset.v) === brutto));
}
document.getElementById('brutto').addEventListener('input', berechne);
document.querySelectorAll('.preset-btn').forEach(b => {
  b.addEventListener('click', () => { document.getElementById('brutto').value = b.dataset.v; berechne(); });
});
berechne();
</script>
