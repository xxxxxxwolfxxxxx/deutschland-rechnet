---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  berechneRentenluecke,
  besteuerungsanteil,
  WERBUNGSKOSTEN_PAUSCHBETRAG_RENTE,
  SONDERAUSGABEN_PAUSCHBETRAG,
} from '../../../public/scripts/rentenluecke.js';
import { BEITRAGSSAETZE } from '../../../public/scripts/sozialversicherung.js';
const calc = CALCULATORS.find(c => c.slug === 'rentenlucken-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus denselben Modulen, die der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const pz = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' %';
const zusatzProzent = (BEITRAGSSAETZE.zusatzbeitragDurchschnitt * 100).toLocaleString('de-DE');

const bsp = berechneRentenluecke({ bruttoMonat: 1500, jahrRentenbeginn: 2055, wunschNetto: 2000, jahreBisRente: 30, bezugsjahre: 20, renditeProzent: 3 });
if (!(bsp.rente.netto < 1500 && bsp.lueckeMonat > 0 && bsp.rente.besteuerungsanteil === 98.5)) {
  throw new Error('Rentenluecke: Beispiel stimmt nicht');
}
const bspOhneRendite = berechneRentenluecke({ bruttoMonat: 1500, jahrRentenbeginn: 2055, wunschNetto: 2000, jahreBisRente: 30, bezugsjahre: 20, renditeProzent: 0 });

const JAHRE = [2026, 2030, 2040, 2050, 2058];
const anteilZeilen = JAHRE.map((j) => '<tr><td>' + j + '</td><td>' + pz(besteuerungsanteil(j)) + '</td></tr>').join('');

const guideHtml = `
<h3>Die Rente steht in der Renteninformation</h3>
<p>Eine pauschale Quote, mit der sich die gesetzliche Rente aus dem heutigen Einkommen ableiten ließe, gibt es nicht – sie hängt an Beitragsjahren, Verdiensten und Zeiten ohne Beiträge. Die Deutsche Rentenversicherung schickt Versicherten ab dem 27. Lebensjahr jährlich eine Renteninformation, ab 55 alle drei Jahre eine Rentenauskunft (§ 109 Abs. 1 SGB VI). Darin steht eine Prognose der Regelaltersrente. Tragen Sie den Betrag ohne künftige Rentenanpassungen ein, dann rechnet der Rechner durchgehend in heutiger Kaufkraft.</p>

<h3>Von der Brutto- zur Nettorente</h3>
<p>Vom Rentenbetrag gehen Kranken- und Pflegeversicherung ab: Rentner zahlen die Hälfte des allgemeinen Beitragssatzes und des Zusatzbeitrags ihrer Kasse sowie den vollen Pflegebeitrag, Kinderlose mit Zuschlag. Voreingestellt ist der durchschnittliche Zusatzbeitrag von ${zusatzProzent} %.</p>
<p>Dazu kommt die Einkommensteuer. Steuerpflichtig ist nur der Besteuerungsanteil, der vom Jahr des Rentenbeginns abhängt (§ 22 Nr. 1 Satz 3 Buchst. a Doppelbuchst. aa EStG):</p>
<table><thead><tr><th>Rentenbeginn</th><th>Besteuerungsanteil</th></tr></thead><tbody>${anteilZeilen}</tbody></table>
<p>Von diesem Anteil zieht der Rechner den Werbungskosten-Pauschbetrag von ${eur(WERBUNGSKOSTEN_PAUSCHBETRAG_RENTE)} (§ 9a EStG), die Kranken- und Pflegeversicherungsbeiträge als Sonderausgaben (§ 10 Abs. 1 Nr. 3 EStG) und den Sonderausgaben-Pauschbetrag von ${eur(SONDERAUSGABEN_PAUSCHBETRAG)} (§ 10c EStG) ab und wendet den Tarif des § 32a EStG an. Unterstellt ist, dass die Rente die einzige Einkunft ist; Betriebsrenten, Mieten oder das Einkommen eines Ehepartners verändern die Steuer.</p>

<h3>Beispiel</h3>
<p>Laut Renteninformation ${eur(1500)} Regelaltersrente, Rentenbeginn 2055, Wunsch ${eur(2000)} netto im Monat. Nach ${eur(bsp.rente.krankenversicherung)} Krankenversicherung, ${eur(bsp.rente.pflegeversicherung)} Pflegeversicherung und ${eur(bsp.rente.steuerMonat)} Einkommensteuer bleiben ${eur(bsp.rente.netto)}. Die Lücke beträgt ${eur(bsp.lueckeMonat)} im Monat.</p>
<p>Soll sie 20 Jahre lang gedeckt werden, braucht es bei Rentenbeginn ${eur(bspOhneRendite.kapitalbedarf)}, wenn das Geld unverzinst liegt, oder ${eur(bsp.kapitalbedarf)} bei 3 % Rendite. Über 30 Jahre angespart sind das ${eur(bspOhneRendite.sparrate ?? 0)} beziehungsweise ${eur(bsp.sparrate ?? 0)} im Monat. Rendite und Bezugsdauer sind Annahmen; Steuern auf Kapitalerträge sind nicht berücksichtigt.</p>
`;

const faqs = [
  { q: 'Wie hoch wird meine gesetzliche Rente?', a: 'Das steht in Ihrer Renteninformation, die Versicherte ab 27 jährlich erhalten (§ 109 SGB VI). Eine allgemeine Quote vom heutigen Einkommen gibt es nicht.' },
  { q: 'Wie viel Steuer zahle ich auf die Rente?', a: `Steuerpflichtig ist der Besteuerungsanteil nach dem Jahr des Rentenbeginns – ${pz(besteuerungsanteil(2026))} bei Beginn 2026, ${pz(besteuerungsanteil(2040))} bei 2040, 100 % ab 2058. Ob tatsächlich Steuer anfällt, hängt von der Höhe aller Einkünfte ab.` },
  { q: 'Welche Beiträge gehen von der Rente ab?', a: 'Kranken- und Pflegeversicherung. Rentner tragen die Hälfte des Krankenversicherungsbeitrags einschließlich Zusatzbeitrag und den vollen Pflegeversicherungsbeitrag.' },
  { q: 'Wie viel muss ich sparen, um die Lücke zu schließen?', a: `Im Beispiel mit ${eur(bsp.lueckeMonat)} Lücke, 20 Jahren Bezug und 3 % Rendite ${eur(bsp.sparrate ?? 0)} im Monat über 30 Jahre. Tragen Sie Ihre eigenen Annahmen ein – das Ergebnis reagiert stark auf Rendite und Dauer.` },
];
---
<Layout
  title={`Rentenlücken-Rechner ${year}`}
  description="Rentenlücke aus der eigenen Renteninformation: Nettorente nach Kranken- und Pflegeversicherung und Besteuerungsanteil, Kapitalbedarf und Sparrate."
  canonicalPath="/geld/rentenlucken-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Rentenlücken-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner nimmt die Rente aus Ihrer Renteninformation, zieht Kranken- und Pflegeversicherung und die Einkommensteuer ab und zeigt, wie groß die Lücke zu Ihrem Wunsch-Netto ist und was ihr Schließen kostet."
    sourceNote="Besteuerungsanteil nach § 22 Nr. 1 Satz 3 Buchst. a Doppelbuchst. aa EStG, Pauschbeträge nach §§ 9a, 10c EStG, Vorsorgeaufwendungen nach § 10 Abs. 1 Nr. 3 EStG, Tarif nach § 32a EStG, Renteninformation nach § 109 SGB VI (abgerufen am 14.09.2026). Unterstellt: Rente als einzige Einkunft, ohne Solidaritätszuschlag und Kirchensteuer. Rendite und Bezugsdauer sind Annahmen des Nutzers."
    explanation="Nettorente = Bruttorente − Kranken- und Pflegeversicherung − Einkommensteuer auf den Besteuerungsanteil. Lücke = Wunsch-Netto − Nettorente. Kapitalbedarf = Barwert der Lücke über die Bezugsdauer, Sparrate = Rate, die dieses Kapital bis zum Rentenbeginn erreicht."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="brutto">Rente laut Renteninformation (€/Monat)</label>
          <input type="number" id="brutto" min="0" max="10000" value="1500" step="50" />
        </div>
        <div class="calc-group">
          <label for="beginn">Jahr des Rentenbeginns</label>
          <input type="number" id="beginn" min="2005" max="2100" value="2055" step="1" />
        </div>
        <div class="calc-group">
          <label for="wunsch">Gewünschtes Netto im Ruhestand (€/Monat)</label>
          <input type="number" id="wunsch" min="0" max="20000" value="2000" step="50" />
        </div>
        <div class="calc-group">
          <label for="bis">Jahre bis zum Rentenbeginn</label>
          <input type="number" id="bis" min="0" max="50" value="30" step="1" />
        </div>
        <div class="calc-group">
          <label for="dauer">Lücke decken über (Jahre)</label>
          <input type="number" id="dauer" min="1" max="50" value="20" step="1" />
        </div>
        <div class="calc-group">
          <label for="rendite">Angenommene Rendite (% p. a.)</label>
          <input type="number" id="rendite" min="0" max="15" value="3" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="eltern">Kinder</label>
          <select id="eltern">
            <option value="ja" selected>Elternteil</option>
            <option value="nein">kinderlos</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="zusatz">Zusatzbeitrag der Krankenkasse (%)</label>
          <input type="number" id="zusatz" min="0" max="10" value={zusatzProzent.replace(',', '.')} step="0.1" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Monatliche Rentenlücke</div>
        <div id="luecke">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So wird die Rentenlücke berechnet"
    content={guideHtml}
    relatedSlugs={['renten-rechner', 'rentenpunkte-rechner', 'etf-sparplan-rechner', 'fire-rechner']}
  />
</Layout>

<script type="module">
const { berechneRentenluecke } = await import(window.__base + 'scripts/rentenluecke.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = berechneRentenluecke({
    bruttoMonat: wert('brutto'),
    jahrRentenbeginn: wert('beginn'),
    wunschNetto: wert('wunsch'),
    jahreBisRente: wert('bis'),
    bezugsjahre: wert('dauer'),
    renditeProzent: wert('rendite'),
    elternteil: document.getElementById('eltern').value === 'ja',
    zusatzbeitrag: wert('zusatz') / 100,
  });
  const n = r.rente;
  document.getElementById('luecke').textContent = eur(r.lueckeMonat);
  const teile = [
    `<span>Nettorente: <strong>${eur(n.netto)}</strong></span>`,
    `<span>Kranken- / Pflegeversicherung: <strong>${eur(n.krankenversicherung)} / ${eur(n.pflegeversicherung)}</strong></span>`,
    `<span>Einkommensteuer: <strong>${eur(n.steuerMonat)}</strong> (Besteuerungsanteil ${n.besteuerungsanteil.toLocaleString('de-DE')} %)</span>`,
  ];
  if (r.lueckeMonat > 0) {
    teile.push(`<span>Kapitalbedarf bei Rentenbeginn: <strong>${eur(r.kapitalbedarf)}</strong></span>`);
    teile.push(r.sparrate === null
      ? '<span>Sparrate: <strong>kein Zeitraum mehr zum Ansparen</strong></span>'
      : `<span>Sparrate bis dahin: <strong>${eur(r.sparrate)}</strong> im Monat</span>`);
  }
  document.getElementById('details').innerHTML = teile.join('');
}
['brutto', 'beginn', 'wunsch', 'bis', 'dauer', 'rendite', 'zusatz'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('eltern').addEventListener('change', berechne);
berechne();
</script>
