---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  BBG_KV_PV_MONAT,
  BBG_RV_AV_MONAT,
  BEITRAGSSAETZE,
  krankenkasseArbeitnehmerSatz,
  pflegeArbeitnehmerSatz,
} from '../../../public/scripts/sozialversicherung.js';
import {
  GRUNDFREIBETRAG,
  ZONE_3_OBERGRENZE,
  ZONE_4_OBERGRENZE,
} from '../../../public/scripts/einkommensteuer.js';

const calc = CALCULATORS.find(c => c.slug === 'gehaltserhoehung-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Diese Werte standen bis zum 11.08.2026 als eigene Zahlen im Fließtext und
// waren durchweg auf dem Stand von 2024: 7.550 Euro Beitragsbemessungsgrenze,
// 5.512,50 Euro in der Krankenversicherung, 1,7 Prozent Pflegeversicherung.
const euro = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Euro';
const euroGlatt = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' Euro';
const satz = (n: number) => (n * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 2 }) + ' %';

const kvHalb = BEITRAGSSAETZE.krankenversicherungAllgemein / 2;
const kvZusatzHalb = BEITRAGSSAETZE.zusatzbeitragDurchschnitt / 2;
const pflegeMitKind = pflegeArbeitnehmerSatz({ kinder: 1 });
const pflegeKinderlos = pflegeArbeitnehmerSatz({ kinder: 0 });
const abgabenGesamt = krankenkasseArbeitnehmerSatz()
  + pflegeMitKind
  + BEITRAGSSAETZE.rentenversicherung / 2
  + BEITRAGSSAETZE.arbeitslosenversicherung / 2;
---
<Layout
  title={`Gehaltserhöhung-Rechner ${year}`}
  description={`Gehaltserhöhung-Rechner ${year}: Berechnen Sie den Netto-Gewinn Ihrer Brutto-Erhöhung inkl. Grenzsteuersatz, Sozialabgaben und Steuerklasse. Mit Beispielrechnungen für 3.000-6.000 Euro Gehalt.`}
  canonicalPath="/geld/gehaltserhoehung-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Gehaltserhöhung-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Gehaltserhöhung-Rechner sehen Sie, wie viel von einer Brutto-Erhöhung tatsächlich netto übrig bleibt. Ideal zur Vorbereitung auf Gehaltsverhandlungen oder um den realen Wert einer Gehaltsanpassung einzuschätzen."
    sourceNote="Grenzsteuersatz berücksichtigt."
    explanation={`Die Netto-Erhöhung wird durch den Grenzsteuersatz bestimmt, der bei 42 % (ab einem zu versteuernden Einkommen von ${euroGlatt(ZONE_3_OBERGRENZE + 1)}) bzw. 45 % (ab ${euroGlatt(ZONE_4_OBERGRENZE + 1)}) liegen kann. Sozialabgaben fallen oberhalb der Beitragsbemessungsgrenze von ${euro(BBG_RV_AV_MONAT)} im Monat nicht mehr an, was den Nettoeffekt bei hohen Gehältern verbessert.`}
    faqs={[
      { q: "Warum ist die Netto-Erhöhung viel kleiner als die Brutto-Erhöhung?", a: "Das ist der Grenzsteuersatz! Auf Ihre Gehaltserhöhung zahlen Sie die höchsten Steuern und Sozialabgaben, die Sie insgesamt zahlen – nicht den Durchschnitt. Mit Einkommen über 60.000€ sind das leicht 40-50% Abgaben. Bei 500€ Brutto-Plus bleiben also nur 250-300€ netto übrig." },
      { q: "Was ist der Grenzsteuersatz?", a: "Der Grenzsteuersatz ist die Steuer auf den letzten verdientem Euro. Nicht auf das ganze Gehalt. Beispiel: Mit 50.000€ Einkommen (Steuerklasse IV) zahlen Sie ca. 42% Grenzsteuersatz. Das bedeutet: Jeder zusätzlich verdiente Euro kostet Sie 42 Cent Steuern." },
      { q: "Wie viel Netto ist realistisch?", a: "Faustregel: Bei moderaten Einkommen (30-60k€) sind ca. 60-70% Netto üblich. Bei höheren Einkommen (60-100k€) sinkt das auf 50-60% Netto. Über 100k€ können es nur noch 40-50% sein. Die Sozialabgaben sinken ab einem bestimmten Einkommen (Beitragssatz-Grenze bei ca. 90k€)." },
      { q: "Kann ich mit Werbungskosten die Netto-Erhöhung erhöhen?", a: "Indirekt ja. Höhere Werbungskosten (Homeoffice, Fahrtkosten) senken das zu versteuernde Einkommen. Aber das beeinflusst weniger die aktuelle Gehaltserhöhung, sondern eher Ihre gesamte Steuerlast." },
      { q: "Macht eine Steuerklassenwahl einen Unterschied?", a: "Ja! Steuerklasse III hat niedrigere Steuersätze als Klasse V. Alleinerziehende sollten Klasse II wählen (Entlastungsbetrag). Verheiratete können mit III/V mehr Netto aus einer Gehaltserhöhung herausholen, wenn einer deutlich mehr verdient." },
      { q: "Kann ich mit einer Gehaltserhöhung in eine höhere Steuerklasse rutschen?", a: "Nein. Die Steuerklasse richtet sich nach Familienstand und Kinderfreibeträgen, nicht nach Einkommen. Aber: Das zu versteuernde Einkommen steigt, und damit der Grenzsteuersatz." },
      { q: "Lohnt sich eine Gehaltserhöhung von 200 Euro brutto?", a: "Bei einem Gehalt von 3.500 Euro brutto (Steuerklasse I) bleiben von 200 Euro Erhöhung ca. 110-120 Euro netto. Das sind rund 1.320-1.440 Euro mehr pro Jahr. Lohnt sich also definitiv, auch wenn der Nettoanteil nur bei 55-60% liegt." },
      { q: "Wie verhandle ich eine Gehaltserhöhung richtig?", a: "Bereiten Sie konkrete Argumente vor: Marktvergleich (Gehalt.de, StepStone Gehaltsreport), eigene Leistungen der letzten 12 Monate, zusätzliche Verantwortungen. Fordern Sie 10-15% mehr als Ihr aktuelles Gehalt. Typische Erhöhungen liegen bei 3-7% jahrlich, bei Beförderung 10-15%." },
      { q: "Was sind Alternativen zur klassischen Gehaltserhöhung?", a: "Steuerfreie oder begünstigte Alternativen: Jobticket (bis 2.394 Euro/Jahr steuerfrei), Sachbezug (50 Euro/Monat steuerfrei), betriebliche Altersvorsorge, Dienstfahrrad-Leasing, Essenszuschuss (bis 7,23 Euro/Tag). Diese Extras können netto mehr bringen als eine Brutto-Erhöhung." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="brutto">Aktuelles Monatsbrutto (€)</label>
          <input type="number" id="brutto" min="450" max="50000" value="3500" step="50" />
        </div>
        <div class="calc-group">
          <label for="erhoehung">Gehaltserhöhung (€ oder %)</label>
          <div style="display:flex;gap:0.5rem;">
            <input type="number" id="erhoehung" min="0" max="50000" value="200" style="flex:1;" />
            <select id="typ" style="width:80px;">
              <option value="euro">€</option>
              <option value="prozent">%</option>
            </select>
          </div>
        </div>
        <div class="calc-group">
          <label for="stklasse">Steuerklasse</label>
          <select id="stklasse">
            <option value="I">I</option>
            <option value="II">II (Alleinerziehende)</option>
            <option value="III">III</option>
            <option value="IV" selected>IV</option>
            <option value="V">V</option>
          </select>
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Netto-Gewinn pro Monat</div>
        <div id="gewinn">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So funktioniert die Netto-Berechnung bei Gehaltserhöhung"
    content={`<p><strong>Der Grenzsteuersatz ist der Schlüssel:</strong> Wenn Sie eine Gehaltserhöhung erhalten, zahlen Sie nicht Ihre durchschnittliche Steuerlast, sondern den <strong>Grenzsteuersatz</strong> – die Steuer auf den letzten Euro Einkommen. Bei einem zu versteuernden Einkommen über ${euroGlatt(ZONE_3_OBERGRENZE + 1)} kann dieser 42% oder sogar 45% (ab ${euroGlatt(ZONE_4_OBERGRENZE + 1)}) betragen. Deshalb bringt eine Brutto-Erhöhung von 500 Euro oft nur 250-300 Euro netto.</p>

<h4>Beispielrechnungen: Was bleibt netto von einer Gehaltserhöhung?</h4>
<table>
  <thead>
    <tr><th>Aktuelles Brutto</th><th>Erhöhung brutto</th><th>Steuerklasse</th><th>Netto-Gewinn ca.</th><th>Netto-Quote</th></tr>
  </thead>
  <tbody>
    <tr><td>3.000 Euro</td><td>+200 Euro</td><td>I</td><td>~120 Euro</td><td>60%</td></tr>
    <tr><td>3.500 Euro</td><td>+300 Euro</td><td>I</td><td>~170 Euro</td><td>57%</td></tr>
    <tr><td>4.000 Euro</td><td>+500 Euro</td><td>IV</td><td>~265 Euro</td><td>53%</td></tr>
    <tr><td>5.000 Euro</td><td>+500 Euro</td><td>IV</td><td>~255 Euro</td><td>51%</td></tr>
    <tr><td>6.000 Euro</td><td>+500 Euro</td><td>I</td><td>~245 Euro</td><td>49%</td></tr>
    <tr><td>7.500 Euro</td><td>+1.000 Euro</td><td>III</td><td>~580 Euro</td><td>58%</td></tr>
  </tbody>
</table>

<h4>Sozialabgaben ${year} im Überblick</h4>
<table>
  <thead>
    <tr><th>Beitrag</th><th>Arbeitnehmeranteil</th><th>Beitragsbemessungsgrenze</th></tr>
  </thead>
  <tbody>
    <tr><td>Krankenversicherung</td><td>${satz(kvHalb)} + halber Zusatzbeitrag (durchschnittlich ${satz(kvZusatzHalb)})</td><td>${euro(BBG_KV_PV_MONAT)}/Monat</td></tr>
    <tr><td>Pflegeversicherung</td><td>${satz(pflegeMitKind)} (kinderlos: ${satz(pflegeKinderlos)})</td><td>${euro(BBG_KV_PV_MONAT)}/Monat</td></tr>
    <tr><td>Rentenversicherung</td><td>${satz(BEITRAGSSAETZE.rentenversicherung / 2)}</td><td>${euro(BBG_RV_AV_MONAT)}/Monat</td></tr>
    <tr><td>Arbeitslosenversicherung</td><td>${satz(BEITRAGSSAETZE.arbeitslosenversicherung / 2)}</td><td>${euro(BBG_RV_AV_MONAT)}/Monat</td></tr>
  </tbody>
</table>
<p>Gesamtbelastung Arbeitnehmer: rund ${satz(abgabenGesamt)} Sozialabgaben plus Einkommensteuer. Die Beitragsbemessungsgrenzen gelten seit 2025 bundeseinheitlich; die frühere Unterscheidung zwischen West und Ost ist entfallen.</p>

<p><strong>Wie der Grenzsteuersatz funktioniert:</strong> Deutschland hat ein progressives Steuersystem. Der Grundfreibetrag liegt ${year} bei ${euroGlatt(GRUNDFREIBETRAG)} (steuerfrei). Danach steigt der Steuersatz von 14% linear auf 42%, der ab einem zu versteuernden Einkommen von ${euroGlatt(ZONE_3_OBERGRENZE + 1)} greift. Der Spitzensteuersatz von 45% beginnt bei ${euroGlatt(ZONE_4_OBERGRENZE + 1)} (§ 32a Abs. 1 EStG). Wenn Sie bereits 50.000 Euro verdienen und 500 Euro mehr bekommen, zahlen Sie auf diese 500 Euro Ihren persönlichen Grenzsteuersatz.</p>

<p><strong>Beitragsbemessungsgrenzen beachten:</strong> Die Renten- und Arbeitslosenversicherung sind ab ${euro(BBG_RV_AV_MONAT)}/Monat gedeckelt. Wer darüber verdient, zahlt auf eine Gehaltserhöhung keine zusätzlichen RV/AV-Beiträge mehr. Das verbessert die Netto-Quote bei hohen Gehältern spürbar.</p>

<h4>Tipps zur Gehaltsverhandlung</h4>
<p><strong>Durchschnittliche Gehaltserhöhungen in Deutschland 2025:</strong> Laut Vergütungsstudien liegen reguläre Gehaltsanpassungen bei 3,5-5% pro Jahr. Bei einem Jobwechsel sind 10-20% realistisch. Die Inflationsrate lag 2024 bei 2,2%, das heisst alles unter 3% ist real ein Gehaltsverlust.</p>

<p><strong>Steuerfreie Alternativen zur Gehaltserhöhung:</strong> Sachbezug (50 Euro/Monat steuerfrei), Jobticket (Deutschlandticket als Firmenticket), Essenszuschuss (bis 7,23 Euro/Arbeitstag), Erholungsbeihilfe (156 Euro/Jahr steuerfrei), Dienstfahrrad-Leasing und betriebliche Altersvorsorge. Diese Extras bringen netto oft mehr als eine vergleichbare Brutto-Erhöhung.</p>`}
    relatedSlugs={['brutto-netto-rechner', 'mindestlohn-rechner', 'ueberstunden-rechner']}
  />
</Layout>

<script type="module">
const { berechneGehaltserhoehung } = await import(window.__base + 'scripts/gehaltserhoehung.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const brutto = parseFloat(document.getElementById('brutto').value)||3500;
  const erhoehung = parseFloat(document.getElementById('erhoehung').value)||200;
  const typ = document.getElementById('typ').value;
  const stklasse = document.getElementById('stklasse').value;
  const r = berechneGehaltserhoehung({ brutto, erhoehung, typ, stklasse });
  document.getElementById('gewinn').textContent = fmt(r.nettoGewinn);
  const prozent = Math.round(r.grenzbelastung);
  document.getElementById('details').innerHTML =
    `<span>Brutto-Erhöhung: <strong>${fmt(r.bruttoGewinn)}</strong></span>` +
    `<span>Netto-Erhöhung: <strong style="color:#1e7e34">${fmt(r.nettoGewinn)}</strong></span>` +
    `<span>Abgaben: <strong style="color:#c8102e">${fmt(r.abgaben)} (${prozent}%)</strong></span>` +
    `<span>Neues Brutto: <strong>${fmt(r.neuesBrutto)}</strong></span>` +
    `<span>Neues Netto: <strong>${fmt(r.neuesNetto)}</strong></span>`;
}
['brutto','erhoehung'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
['stklasse','typ'].forEach(id =>
  document.getElementById(id).addEventListener('change', berechne));
berechne();
</script>
