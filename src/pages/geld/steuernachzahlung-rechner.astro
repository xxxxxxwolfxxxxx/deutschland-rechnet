---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  einkommensteuer,
  GRUNDFREIBETRAG,
  ZONE_2_OBERGRENZE,
  ZONE_3_OBERGRENZE,
  ZONE_4_OBERGRENZE,
} from '../../../public/scripts/einkommensteuer.js';
import {
  ARBEITNEHMER_PAUSCHBETRAG,
  ENTLASTUNGSBETRAG_ALLEINERZIEHENDE,
} from '../../../public/scripts/lohnsteuer.js';
import {
  KINDERFREIBETRAG_JE_ELTERNTEIL,
  BEA_FREIBETRAG_JE_ELTERNTEIL,
} from '../../../public/scripts/kindergeld.js';

const calc = CALCULATORS.find(c => c.slug === 'steuernachzahlung-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Tarif und Freibeträge werden aus den Rechenmodulen abgeleitet. Bis zum
// 11.08.2026 standen hier die Werte des Jahres 2025 als eigene Zahlen:
// 12.096 Euro Grundfreibetrag, Zonengrenzen bei 17.443 und 66.760 Euro.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' EUR';
const pct = (n: number) => (n * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';

const TARIFZONEN = [
  { bereich: `bis ${eur(GRUNDFREIBETRAG)}`, grenz: '0 %', bis: GRUNDFREIBETRAG },
  { bereich: `${eur(GRUNDFREIBETRAG + 1)} - ${eur(ZONE_2_OBERGRENZE)}`, grenz: '14 - 24 %', bis: ZONE_2_OBERGRENZE },
  { bereich: `${eur(ZONE_2_OBERGRENZE + 1)} - ${eur(ZONE_3_OBERGRENZE)}`, grenz: '24 - 42 %', bis: ZONE_3_OBERGRENZE },
  { bereich: `${eur(ZONE_3_OBERGRENZE + 1)} - ${eur(ZONE_4_OBERGRENZE)}`, grenz: '42 %', bis: ZONE_4_OBERGRENZE },
];

const tarifZeilen = TARIFZONEN.map(z => {
  const steuer = einkommensteuer(z.bis);
  if (steuer === 0) return `<tr><td>${z.bereich}</td><td>${z.grenz}</td><td>0 EUR</td><td>0 %</td></tr>`;
  return `<tr><td>${z.bereich}</td><td>${z.grenz}</td><td>bis ${eur(steuer)}</td><td>bis ${pct(steuer / z.bis)}</td></tr>`;
}).join('\n');

const spitzensteuerAb = einkommensteuer(ZONE_4_OBERGRENZE);
const tarifZeileSpitze = `<tr><td>ab ${eur(ZONE_4_OBERGRENZE + 1)}</td><td>45 %</td><td>ab ${eur(spitzensteuerAb)}</td><td>ab ${pct(spitzensteuerAb / ZONE_4_OBERGRENZE)}</td></tr>`;

const kinderfreibetragGesamt = KINDERFREIBETRAG_JE_ELTERNTEIL * 2;
const beaFreibetragGesamt = BEA_FREIBETRAG_JE_ELTERNTEIL * 2;
---
<Layout
  title={`Steuernachzahlung-Rechner ${year}`}
  description={`Steuernachzahlung oder Erstattung ${year} berechnen: Der Rechner stellt die einbehaltene Lohnsteuer der geschuldeten Jahressteuer gegenüber – mit Steuerklasse, Partnereinkommen, Werbungskosten und Sonderausgaben.`}
  canonicalPath="/geld/steuernachzahlung-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld & Gehalt</a>
    <h1>Steuernachzahlung-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Steuernachzahlung-Rechner schätzen Sie, ob Sie mit einer Steuernachzahlung oder Erstattung rechnen können. So vermeiden Sie böse Überraschungen und können rechtzeitig Rücklagen bilden."
    sourceNote={`Einbehalt nach § 39b Abs. 2 EStG, Jahressteuer nach § 32a EStG (Grund- oder Splittingtarif), Solidaritätszuschlag nach SolzG 1995, Beitragssätze ${year}. Die Vorsorgeaufwendungen werden mit der Vorsorgepauschale angesetzt; die Veranlagung rechnet sie nach § 10 EStG, davon kann das Ergebnis abweichen. Kinderfreibeträge und Progressionsvorbehalt sind nicht abgebildet.`}
    explanation="Der Rechner stellt zwei Größen gegenüber: die Lohnsteuer, die Ihr Arbeitgeber über das Jahr einbehalten hat, und die Einkommensteuer, die Sie tatsächlich schulden. Die Differenz ist die Nachzahlung oder Erstattung. Nachzahlungen entstehen vor allem bei der Steuerklassenkombination III/V, bei Nebeneinkünften und bei Lohnersatzleistungen mit Progressionsvorbehalt. Die verbindliche Berechnung nimmt erst das Finanzamt vor." faqs={[
      { q: "Wann muss ich mit einer Steuernachzahlung rechnen?", a: "Nachzahlungen entstehen, wenn im Laufe des Jahres zu wenig Lohnsteuer einbehalten wurde. Typische Fälle sind: Steuerklassenkombination III/V, Einkünfte aus Nebenjobs oder Selbstständigkeit, Abfindungen, Mieteinnahmen oder andere Einkünfte neben dem Gehalt. Auch bei Lohnersatzleistungen wie Kurzarbeitergeld oder Elterngeld kann der Progressionsvorbehalt zu Nachzahlungen führen." },
      { q: "Wie kann ich eine Steuernachzahlung vermeiden?", a: "Sie können beim Finanzamt die Eintragung eines Freibetrags oder eine Erhöhung der Vorauszahlungen beantragen, um die Steuerlast besser über das Jahr zu verteilen. Bei der Kombination III/V empfiehlt sich der Wechsel zu IV/IV mit Faktor. Legen Sie zudem jeden Monat einen Teil des Nettoeinkommens zur Seite, wenn Sie mit einer Nachzahlung rechnen." },
      { q: "Welche Freibeträge kann ich geltend machen?", a: "Die wichtigsten Freibeträge sind: Grundfreibetrag (12.348 Euro, § 32a Abs. 1 EStG), Arbeitnehmer-Pauschbetrag (1.230 Euro, § 9a EStG), Sonderausgaben-Pauschbetrag (36 Euro, § 10c EStG), Sparer-Pauschbetrag (1.000 Euro, § 20 Abs. 9 EStG) und der Kinderfreibetrag samt Betreuungsfreibetrag (3.414 plus 1.464 Euro je Elternteil, bei Zusammenveranlagung also 9.756 Euro je Kind – alternativ zum Kindergeld, das Finanzamt prüft von selbst, was günstiger ist). Zusätzlich absetzbar sind tatsächliche Werbungskosten, die Entfernungspauschale von 0,38 Euro je Entfernungskilometer ab dem ersten Kilometer (§ 9 Abs. 1 Nr. 4 EStG) und die Homeoffice-Pauschale von 6 Euro je Tag, höchstens 1.260 Euro im Jahr." },
      { q: "Bis wann muss ich meine Steuererklärung abgeben?", a: "Bei Pflichtveranlagung endet die Frist am 31. Juli des Folgejahres, für das Steuerjahr 2026 also am 31. Juli 2027. Wer einen Steuerberater oder Lohnsteuerhilfeverein beauftragt, hat bis Ende Februar des übernächsten Jahres Zeit. Bei freiwilliger Abgabe haben Sie vier Jahre, für 2026 also bis Ende 2030. Wer die Frist bei Pflichtabgabe versäumt, riskiert einen Verspätungszuschlag von mindestens 25 Euro pro angefangenem Monat." },
      { q: "Lohnt sich eine freiwillige Steuererklärung?", a: "Ja, in den meisten Fällen. Arbeitnehmer erhalten laut Statistischem Bundesamt im Durchschnitt etwa 1.095 Euro zurück. Besonders lohnend ist die Abgabe bei hohen Fahrtkosten, Homeoffice-Nutzung, außergewöhnlichen Belastungen (Krankheitskosten, Pflegekosten), Handwerkerleistungen oder haushaltsnahen Dienstleistungen. Eine freiwillige Erklärung kann rückwirkend bis zu vier Jahre eingereicht werden." },
      { q: "Wie hoch sind die Nachzahlungszinsen vom Finanzamt?", a: "Das Finanzamt berechnet ab dem 16. Monat nach Ablauf des Steuerjahres Zinsen von 0,15 % pro Monat (1,8 % pro Jahr) auf Nachzahlungen und Erstattungen. Fuer das Steuerjahr 2024 beginnt die Verzinsung ab dem 1. Mai 2026. Bei einer Nachzahlung von 3.000 Euro waeren das 4,50 Euro pro Monat. Vorauszahlungen koennen beim Finanzamt beantragt werden, um Nachzahlungszinsen zu vermeiden." },
      { q: "Was ist der Progressionsvorbehalt?", a: "Lohnersatzleistungen wie Elterngeld, Kurzarbeitergeld, Arbeitslosengeld I oder Krankengeld sind zwar steuerfrei, erhoehen aber den Steuersatz auf das uebrige Einkommen (Progressionsvorbehalt nach Paragraph 32b EStG). Beispiel: Bei 40.000 Euro Gehalt und 10.000 Euro Elterngeld wird die Steuer so berechnet, als haetten Sie 50.000 Euro verdient – der hoehere Steuersatz wird dann auf die 40.000 Euro angewandt. Das fuehrt haeufig zu Nachzahlungen von 1.000-3.000 Euro." },
      { q: "Welche Steuerklassenkombination verursacht Nachzahlungen?", a: "Die Kombination III/V fuehrt fast immer zu Nachzahlungen, weil bei Steuerklasse III zu wenig und bei V zu viel Lohnsteuer einbehalten wird – aber in Summe reicht es nicht. Seit 2010 gibt es die Alternative IV/IV mit Faktor, die das Einkommen beider Partner beruecksichtigt und Nachzahlungen minimiert. Den Faktorwechsel koennen Sie jederzeit beim Finanzamt beantragen." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="brutto">Jahresbruttoeinkommen (€)</label>
          <input type="number" id="brutto" min="0" max="1000000" value="50000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="stklasse">Ihre Steuerklasse</label>
          <select id="stklasse">
            <option value="1">I</option>
            <option value="2">II (Alleinerziehende)</option>
            <option value="3">III</option>
            <option value="4" selected>IV</option>
            <option value="5">V</option>
            <option value="6">VI</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="partnerBrutto">Jahresbrutto Partner (€)</label>
          <input type="number" id="partnerBrutto" min="0" max="1000000" value="0" step="1000" />
        </div>
        <div class="calc-group">
          <label for="partnerKlasse">Steuerklasse Partner</label>
          <select id="partnerKlasse">
            <option value="0" selected>Keine Zusammenveranlagung</option>
            <option value="3">III</option>
            <option value="4">IV</option>
            <option value="5">V</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="werbung">Werbungskosten (€/Jahr)</label>
          <input type="number" id="werbung" min="0" max="100000" value="1000" step="100" />
        </div>
        <div class="calc-group">
          <label for="sonder">Sonderausgaben ohne Vorsorgeaufwendungen (€/Jahr)</label>
          <input type="number" id="sonder" min="0" max="100000" value="0" step="100" />
        </div>
        <div class="calc-group">
          <label for="kinder">Kinder unter 25 Jahren</label>
          <select id="kinder">
            <option value="0">keine</option>
            <option value="1" selected>1 Kind</option>
            <option value="2">2 Kinder</option>
            <option value="3">3 Kinder</option>
            <option value="4">4 Kinder</option>
            <option value="5">5 Kinder oder mehr</option>
          </select>
        </div>
      </div>

      <div class="calc-result">
        <div class="label" id="result-label">Geschätztes Ergebnis</div>
        <div id="ergebnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Steuernachzahlung oder Erstattung: Was Sie erwartet"
    content={`<p>Nach der Einkommensteuererklaerung kommt der Steuerbescheid, und damit die Frage: Muss ich nachzahlen oder bekomme ich Geld zurueck? Der Steuernachzahlung-Rechner gibt Ihnen eine erste Einschaetzung, ob Sie eher mit einer Nachzahlung oder einer Erstattung rechnen koennen.</p>

<p><strong>Wie entsteht eine Steuernachzahlung?</strong> Waehrend des Jahres behaelt Ihr Arbeitgeber Lohnsteuer ein, die auf Basis Ihrer Steuerklasse und Ihres monatlichen Gehalts berechnet wird. Stimmt die einbehaltene Steuer nicht mit der tatsaechlichen Jahressteuer ueberein, ergibt sich eine Differenz. Haeufigste Gruende fuer Nachzahlungen sind: die Steuerklassenkombination III/V, Einkuenfte aus Vermietung oder Nebentaetigkeit, der Progressionsvorbehalt bei Lohnersatzleistungen und nicht angegebene geldwerte Vorteile.</p>

<h3>Einkommensteuertarif ${year}: Grenzsteuersaetze</h3>
<table>
<thead><tr><th>Zu versteuerndes Einkommen</th><th>Grenzsteuersatz</th><th>Steuer auf Gesamtbetrag</th><th>Durchschnittssteuersatz</th></tr></thead>
<tbody>
${tarifZeilen}
${tarifZeileSpitze}
</tbody>
</table>
<p><em>Grundtarif nach § 32a Abs. 1 EStG, also ohne Splitting. Die Steuerbetraege sind aus demselben Rechenmodul erzeugt wie der Rechner oben.</em></p>

<p><strong>Die wichtigsten Abzugsmoeglichkeiten:</strong> Werbungskosten mindern die Steuerlast direkt. Der Arbeitnehmerpauschbetrag betraegt 1.230 Euro. Erst wenn Ihre tatsaechlichen Werbungskosten darueber liegen, lohnt es sich, diese einzeln nachzuweisen. Typische Werbungskosten sind Fahrtkosten zur Arbeit (Entfernungspauschale: 0,38 Euro je Entfernungskilometer ab dem ersten Kilometer, höchstens 4.500 Euro im Jahr – ohne diese Grenze, wenn Sie einen eigenen Wagen nutzen), Arbeitsmittel wie Computer oder Fachliteratur, Fortbildungskosten und die Homeoffice-Pauschale (6 Euro pro Tag, maximal 1.260 Euro im Jahr).</p>

<h3>Wichtige Freibetraege und Pauschalen ${year}</h3>
<table>
<thead><tr><th>Freibetrag / Pauschale</th><th>Betrag ${year}</th><th>Gilt fuer</th></tr></thead>
<tbody>
<tr><td>Grundfreibetrag</td><td>${eur(GRUNDFREIBETRAG)}</td><td>Alle Steuerpflichtigen</td></tr>
<tr><td>Arbeitnehmerpauschbetrag</td><td>${eur(ARBEITNEHMER_PAUSCHBETRAG)}</td><td>Arbeitnehmer (Werbungskosten)</td></tr>
<tr><td>Sparerpauschbetrag</td><td>1.000 EUR / 2.000 EUR (Ehepaar)</td><td>Kapitalertraege</td></tr>
<tr><td>Kinderfreibetrag</td><td>${eur(kinderfreibetragGesamt)} pro Kind, zzgl. ${eur(beaFreibetragGesamt)} Betreuungsfreibetrag</td><td>Eltern (alternativ zu Kindergeld)</td></tr>
<tr><td>Entlastungsbetrag Alleinerziehende</td><td>${eur(ENTLASTUNGSBETRAG_ALLEINERZIEHENDE)}</td><td>Steuerklasse II</td></tr>
<tr><td>Homeoffice-Pauschale</td><td>6 EUR/Tag, max. 1.260 EUR</td><td>Arbeitnehmer im Homeoffice</td></tr>
<tr><td>Entfernungspauschale</td><td>0,38 EUR je Entfernungskilometer</td><td>Pendler</td></tr>
<tr><td>Sonderausgabenpauschale</td><td>36 EUR / 72 EUR (Ehepaar)</td><td>Alle Steuerpflichtigen</td></tr>
</tbody>
</table>

<p><strong>Sonderausgaben und aussergewoehnliche Belastungen:</strong> Absetzbar sind Vorsorgeaufwendungen (Kranken- und Pflegeversicherung, Riester-Beitraege bis 2.100 Euro), Kirchensteuer, Spenden (bis 20 % des Gesamtbetrags der Einkuenfte), Kinderbetreuungskosten (2/3 der Kosten, maximal 4.000 Euro pro Kind) und aussergewoehnliche Belastungen wie Krankheitskosten oberhalb der zumutbaren Eigenbelastung.</p>

<p><strong>Steuerliche Vorteile fuer Familien:</strong> Fuer jedes Kind wird entweder Kindergeld (259 Euro monatlich nach Paragraph 66 Abs. 1 EStG) oder werden die Freibetraege nach Paragraph 32 Abs. 6 EStG beruecksichtigt (zusammenveranlagt 6.828 Euro sachliches Existenzminimum zzgl. 2.928 Euro Betreuungs- und Erziehungsbedarf je Kind), je nachdem was guenstiger ist. Das Finanzamt prueft automatisch die guenstigere Variante (Guenstigerpruefung). Alleinerziehende erhalten zusaetzlich den Entlastungsbetrag von 4.260 Euro fuer das erste Kind.</p>

<p><strong>Praxistipp:</strong> Sammeln Sie alle Belege ueber das Jahr: Fahrtkosten, Arbeitsmittel, Handwerkerrechnungen, Spendenbescheinigungen. Nutzen Sie ELSTER fuer die elektronische Abgabe. Und wichtig: Pruefen Sie Ihren Steuerbescheid sorgfaeltig. Laut Bund der Steuerzahler ist etwa jeder dritte Bescheid fehlerhaft. Einspruch ist innerhalb von einem Monat nach Zustellung kostenfrei moeglich.</p>`}
    relatedSlugs={['steuerklassen-vergleich', 'kirchensteuer-rechner', 'homeoffice-pauschale']}
  />
</Layout>

<script type="module">
const { berechneSteuernachzahlung } = await import(window.__base + 'scripts/steuernachzahlung.js');

function fmt(n) { return Math.abs(n).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' \u20ac'; }

function berechne() {
  const r = berechneSteuernachzahlung({
    bruttoJahr: parseFloat(document.getElementById('brutto').value) || 0,
    steuerklasse: parseInt(document.getElementById('stklasse').value),
    partnerBruttoJahr: parseFloat(document.getElementById('partnerBrutto').value) || 0,
    partnerSteuerklasse: parseInt(document.getElementById('partnerKlasse').value) || 0,
    werbungskosten: parseFloat(document.getElementById('werbung').value) || 0,
    sonderausgaben: parseFloat(document.getElementById('sonder').value) || 0,
    kinder: parseInt(document.getElementById('kinder').value) || 0,
  });

  const ergebnisEl = document.getElementById('ergebnis');
  const labelEl = document.getElementById('result-label');

  if (r.nachzahlung > 0) {
    ergebnisEl.textContent = '\u2212 ' + fmt(r.nachzahlung);
    ergebnisEl.style.color = '#c8102e';
    labelEl.textContent = 'Voraussichtliche Nachzahlung';
  } else if (r.erstattung > 0) {
    ergebnisEl.textContent = '+ ' + fmt(r.erstattung);
    ergebnisEl.style.color = '#1e7e34';
    labelEl.textContent = 'Voraussichtliche Erstattung';
  } else {
    ergebnisEl.textContent = '0,00 \u20ac';
    ergebnisEl.style.color = '';
    labelEl.textContent = 'Weder Nachzahlung noch Erstattung';
  }

  document.getElementById('details').innerHTML =
    `<span>Einbehaltene Lohnsteuer: <strong>${fmt(r.einbehaltenLohnsteuer)}</strong></span>` +
    `<span>Einbehaltener Soli: <strong>${fmt(r.einbehaltenSoli)}</strong></span>` +
    `<span>Geschuldete Jahressteuer: <strong>${fmt(r.jahressteuer)}</strong></span>` +
    `<span>Zu versteuerndes Einkommen: <strong>${fmt(r.zuVersteuerndesEinkommen)}</strong></span>` +
    `<span>Veranlagung: <strong>${r.zusammenveranlagung ? 'zusammen' : 'einzeln'}</strong></span>`;
}

['brutto','partnerBrutto','werbung','sonder','stklasse','partnerKlasse','kinder'].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
berechne();
</script>
