---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  einkommensteuer,
  GRUNDFREIBETRAG,
  TARIF_STAND,
  ZONE_2_OBERGRENZE,
  ZONE_3_OBERGRENZE,
  ZONE_4_OBERGRENZE,
} from '../../../public/scripts/einkommensteuer.js';
import {
  ARBEITNEHMER_PAUSCHBETRAG,
  ENTLASTUNGSBETRAG_ALLEINERZIEHENDE,
  SONDERAUSGABEN_PAUSCHBETRAG,
} from '../../../public/scripts/lohnsteuer.js';
import {
  KINDERGELD_MONAT,
  KINDERFREIBETRAG_JE_ELTERNTEIL,
  BEA_FREIBETRAG_JE_ELTERNTEIL,
} from '../../../public/scripts/kindergeld.js';
import { ENTFERNUNGSPAUSCHALE_JE_KM, ENTFERNUNGSPAUSCHALE_HOECHSTBETRAG } from '../../../public/scripts/fahrtkosten.js';
import { SPARERPAUSCHBETRAG_EINZEL, SPARERPAUSCHBETRAG_ZUSAMMEN } from '../../../public/scripts/abgeltungsteuer.js';
import { ABZUGSQUOTE, HOECHSTBETRAG_JE_KIND, ALTERSGRENZE } from '../../../public/scripts/betreuungskosten.js';
import { TAGESPAUSCHALE, TAGESPAUSCHALE_HOECHSTBETRAG } from '../../../public/scripts/homeoffice.js';

const calc = CALCULATORS.find(c => c.slug === 'steuernachzahlung-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
const tarifJahr = Number(TARIF_STAND.slice(0, 4));

// Alle Beträge kommen aus den Rechenmodulen. Bis zum 11.08.2026 standen hier
// die Werte des Jahres 2025 als eigene Zahlen; bis zum 16.09.2026 außerdem
// unbelegte Statistiken und Kinderbetreuungskosten nach altem Recht.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const eurCent = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const pct = (n: number, s = 1) => (n * 100).toLocaleString('de-DE', { minimumFractionDigits: s, maximumFractionDigits: s }) + ' %';
const dez = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const TARIFZONEN = [
  { bereich: 'bis ' + eur(GRUNDFREIBETRAG), grenz: '0 %', bis: GRUNDFREIBETRAG },
  { bereich: eur(GRUNDFREIBETRAG + 1) + ' – ' + eur(ZONE_2_OBERGRENZE), grenz: '14 – 24 %', bis: ZONE_2_OBERGRENZE },
  { bereich: eur(ZONE_2_OBERGRENZE + 1) + ' – ' + eur(ZONE_3_OBERGRENZE), grenz: '24 – 42 %', bis: ZONE_3_OBERGRENZE },
  { bereich: eur(ZONE_3_OBERGRENZE + 1) + ' – ' + eur(ZONE_4_OBERGRENZE), grenz: '42 %', bis: ZONE_4_OBERGRENZE },
];
function tarifZeile(z: { bereich: string; grenz: string; bis: number }) {
  const steuer = einkommensteuer(z.bis);
  if (steuer === 0) return '<tr><td>' + z.bereich + '</td><td>' + z.grenz + '</td><td>0 €</td><td>0 %</td></tr>';
  return '<tr><td>' + z.bereich + '</td><td>' + z.grenz + '</td><td>bis ' + eur(steuer) + '</td><td>bis ' + pct(steuer / z.bis) + '</td></tr>';
}
const tarifZeilen = TARIFZONEN.map(tarifZeile).join('');
const spitzensteuerAb = einkommensteuer(ZONE_4_OBERGRENZE);
const tarifZeileSpitze = '<tr><td>ab ' + eur(ZONE_4_OBERGRENZE + 1) + '</td><td>45 %</td><td>ab ' + eur(spitzensteuerAb) + '</td><td>ab ' + pct(spitzensteuerAb / ZONE_4_OBERGRENZE) + '</td></tr>';

const freibetragJeKindZusammen = (KINDERFREIBETRAG_JE_ELTERNTEIL + BEA_FREIBETRAG_JE_ELTERNTEIL) * 2;

// § 238 Abs. 1a AO: 0,15 Prozent für jeden Monat bei Zinsen nach § 233a.
const ZINS_JE_MONAT = 0.0015;
const ZINS_BEISPIEL = 3000;

// Progressionsvorbehalt (§ 32b EStG), vereinfacht: Der Steuersatz auf
// Einkommen plus Leistung wird auf das Einkommen allein angewendet.
const PV_EINKOMMEN = 40000;
const PV_LEISTUNG = 10000;
const pvSatz = einkommensteuer(PV_EINKOMMEN + PV_LEISTUNG) / (PV_EINKOMMEN + PV_LEISTUNG);
const pvMehrsteuer = Math.round(PV_EINKOMMEN * pvSatz) - einkommensteuer(PV_EINKOMMEN);
if (pvMehrsteuer <= 0) {
  throw new Error('Steuernachzahlung: Beispiel zum Progressionsvorbehalt ergibt keine Mehrsteuer');
}
if (ABZUGSQUOTE !== 0.8 || HOECHSTBETRAG_JE_KIND !== 4800) {
  throw new Error('Steuernachzahlung: Kinderbetreuungskosten weichen von § 10 Abs. 1 Nr. 5 EStG ab – Text prüfen');
}

const faqs = [
  { q: 'Wann muss ich mit einer Steuernachzahlung rechnen?', a: 'Wenn über das Jahr weniger Lohnsteuer einbehalten wurde, als Sie tatsächlich schulden. Typische Gründe sind die Steuerklassen III/V oder IV mit Faktor – dann ist die Erklärung Pflicht (§ 46 Abs. 2 Nr. 3a EStG) –, Einkünfte neben dem Arbeitslohn, von denen keine Steuer abgezogen wird, Lohnersatzleistungen unter Progressionsvorbehalt (§ 32b EStG) und ein Freibetrag im Lohnsteuerabzug, der unter den Voraussetzungen des § 46 Abs. 2 Nr. 4 EStG ebenfalls zur Abgabe verpflichtet.' },
  { q: 'Wie kann ich eine Steuernachzahlung vermeiden?', a: 'Ehegatten in Steuerklasse IV können auf gemeinsamen Antrag das Faktorverfahren wählen (§ 39f Abs. 1 EStG): Der Faktor richtet den Lohnsteuerabzug an der voraussichtlichen gemeinsamen Jahressteuer aus. Wer Einkünfte ohne Steuerabzug hat, legt am besten die Summe zurück, die dieser Rechner als Nachzahlung zeigt. Ein Freibetrag im Lohnsteuerabzug senkt dagegen die monatliche Steuer und macht eine Nachzahlung eher wahrscheinlicher.' },
  { q: 'Welche Freibeträge und Pauschalen gibt es?', a: `Grundfreibetrag ${eur(GRUNDFREIBETRAG)} (§ 32a Abs. 1 EStG), Arbeitnehmer-Pauschbetrag ${eur(ARBEITNEHMER_PAUSCHBETRAG)} (§ 9a EStG), Sonderausgaben-Pauschbetrag ${eur(SONDERAUSGABEN_PAUSCHBETRAG)}, bei Zusammenveranlagung das Doppelte (§ 10c EStG), Sparer-Pauschbetrag ${eur(SPARERPAUSCHBETRAG_EINZEL)} bzw. ${eur(SPARERPAUSCHBETRAG_ZUSAMMEN)} (§ 20 Abs. 9 EStG) und je Kind ${eur(KINDERFREIBETRAG_JE_ELTERNTEIL)} plus ${eur(BEA_FREIBETRAG_JE_ELTERNTEIL)} je Elternteil (§ 32 Abs. 6 EStG) – das Finanzamt prüft, ob sie oder das Kindergeld günstiger sind (§ 31 EStG). Als Werbungskosten zählen unter anderem die Entfernungspauschale von ${dez(ENTFERNUNGSPAUSCHALE_JE_KM)} € je vollem Entfernungskilometer (§ 9 Abs. 1 Satz 3 Nr. 4 EStG) und die Tagespauschale von ${eur(TAGESPAUSCHALE)} je Homeoffice-Tag, höchstens ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)} im Jahr (§ 4 Abs. 5 Satz 1 Nr. 6c EStG).` },
  { q: 'Bis wann muss ich meine Steuererklärung abgeben?', a: `Spätestens sieben Monate nach Ablauf des Kalenderjahres (§ 149 Abs. 2 AO), für ${tarifJahr} also bis zum 31. Juli ${tarifJahr + 1}. Mit Steuerberater oder Lohnsteuerhilfeverein gilt der letzte Tag im Februar des zweiten folgenden Jahres, also Februar ${tarifJahr + 2} (§ 149 Abs. 3 AO). Wer verspätet abgibt, riskiert einen Verspätungszuschlag von mindestens 25 € für jeden angefangenen Monat (§ 152 Abs. 5 AO).` },
  { q: 'Wie lange habe ich für eine freiwillige Steuererklärung Zeit?', a: 'Maßgeblich ist die Festsetzungsfrist von vier Jahren (§ 169 Abs. 2 Satz 1 Nr. 2 AO). Sie beginnt mit Ablauf des Kalenderjahres, in dem die Steuer entstanden ist (§ 170 Abs. 1 AO). Ob sich die Erklärung lohnt, hängt davon ab, ob Ihre Abzüge die Pauschbeträge übersteigen, die der Lohnsteuerabzug schon berücksichtigt – etwa bei Werbungskosten über dem Arbeitnehmer-Pauschbetrag, außergewöhnlichen Belastungen (§ 33 EStG) oder Handwerkerleistungen (§ 35a EStG).' },
  { q: 'Wie hoch sind die Nachzahlungszinsen?', a: `0,15 % für jeden Monat, also 1,8 % im Jahr (§ 238 Abs. 1a AO), auf den Unterschiedsbetrag der Festsetzung (§ 233a Abs. 1 AO). Der Zinslauf beginnt 15 Monate nach Ablauf des Kalenderjahres, in dem die Steuer entstanden ist (§ 233a Abs. 2 Satz 1 AO) – für ${tarifJahr} also am 1. April ${tarifJahr + 2}. Für die Jahre 2019 bis 2024 gelten nach Art. 97 § 36 EGAO längere Fristen, für 2024 etwa 17 Monate: Dort beginnt der Zinslauf am 1. Juni 2026. Bei ${eur(ZINS_BEISPIEL)} sind das ${eurCent(ZINS_BEISPIEL * ZINS_JE_MONAT)} im Monat.` },
  { q: 'Was ist der Progressionsvorbehalt?', a: `Bestimmte Leistungen sind steuerfrei, erhöhen aber den Steuersatz auf das übrige Einkommen (§ 32b EStG) – darunter Arbeitslosengeld, Kurzarbeitergeld, Krankengeld, Mutterschaftsgeld und Elterngeld. Vereinfacht gerechnet: Bei ${eur(PV_EINKOMMEN)} zu versteuerndem Einkommen und ${eur(PV_LEISTUNG)} Elterngeld gilt der Durchschnittssatz für ${eur(PV_EINKOMMEN + PV_LEISTUNG)} (${pct(pvSatz)}) auf die ${eur(PV_EINKOMMEN)}. Das sind rund ${eur(pvMehrsteuer)} mehr als ohne Elterngeld – ein Betrag, den der Arbeitgeber nicht einbehalten hat. Der Rechner oben bildet den Progressionsvorbehalt nicht ab.` },
  { q: 'Welche Steuerklassenkombination führt zu Nachzahlungen?', a: 'Alle Kombinationen führen in der Veranlagung zur selben Jahressteuer; sie unterscheiden sich nur darin, wie viel unterjährig einbehalten wird. Bei III/V und bei IV mit Faktor ist die Erklärung Pflicht (§ 46 Abs. 2 Nr. 3a EStG). Ob dabei nachgezahlt wird, hängt vom Verhältnis der beiden Löhne ab – der Rechner zeigt es für Ihre Werte.' },
];

const guideHtml = `
<p>Nach der Einkommensteuererklärung kommt der Steuerbescheid und mit ihm die Frage: nachzahlen oder erstattet bekommen? Der Rechner gibt eine erste Einschätzung.</p>

<p><strong>Wie entsteht eine Nachzahlung?</strong> Während des Jahres behält der Arbeitgeber Lohnsteuer ein, berechnet nach Steuerklasse und Monatslohn. Weicht die einbehaltene Steuer von der Jahressteuer ab, entsteht eine Differenz. Häufige Gründe sind die Steuerklassen III/V, Einkünfte aus Vermietung oder Nebentätigkeit und der Progressionsvorbehalt bei Lohnersatzleistungen.</p>

<h3>Einkommensteuertarif ${tarifJahr}: Grenzsteuersätze</h3>
<table>
<thead><tr><th>Zu versteuerndes Einkommen</th><th>Grenzsteuersatz</th><th>Steuer auf den Gesamtbetrag</th><th>Durchschnittssteuersatz</th></tr></thead>
<tbody>
${tarifZeilen}
${tarifZeileSpitze}
</tbody>
</table>
<p><em>Grundtarif nach § 32a Abs. 1 EStG, ohne Splitting. Die Steuerbeträge stammen aus demselben Rechenmodul wie der Rechner oben.</em></p>

<p><strong>Werbungskosten</strong> mindern das zu versteuernde Einkommen, soweit sie den Arbeitnehmer-Pauschbetrag von ${eur(ARBEITNEHMER_PAUSCHBETRAG)} übersteigen. Dazu gehören die Entfernungspauschale von ${dez(ENTFERNUNGSPAUSCHALE_JE_KM)} € je vollem Entfernungskilometer – höchstens ${eur(ENTFERNUNGSPAUSCHALE_HOECHSTBETRAG)} im Jahr, ohne diese Grenze bei Fahrten mit dem eigenen oder zur Nutzung überlassenen Kraftwagen –, Arbeitsmittel, Fortbildungskosten und die Tagespauschale von ${eur(TAGESPAUSCHALE)} je Homeoffice-Tag, höchstens ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)} im Jahr.</p>

<h3>Freibeträge und Pauschalen ${tarifJahr}</h3>
<table>
<thead><tr><th>Freibetrag / Pauschale</th><th>Betrag</th><th>Gilt für</th></tr></thead>
<tbody>
<tr><td>Grundfreibetrag</td><td>${eur(GRUNDFREIBETRAG)}</td><td>alle Steuerpflichtigen</td></tr>
<tr><td>Arbeitnehmer-Pauschbetrag</td><td>${eur(ARBEITNEHMER_PAUSCHBETRAG)}</td><td>Arbeitnehmer (Werbungskosten)</td></tr>
<tr><td>Sparer-Pauschbetrag</td><td>${eur(SPARERPAUSCHBETRAG_EINZEL)} / ${eur(SPARERPAUSCHBETRAG_ZUSAMMEN)} bei Zusammenveranlagung</td><td>Kapitalerträge</td></tr>
<tr><td>Freibeträge für Kinder</td><td>${eur(freibetragJeKindZusammen)} je Kind bei Zusammenveranlagung</td><td>Eltern, alternativ zum Kindergeld</td></tr>
<tr><td>Entlastungsbetrag für Alleinerziehende</td><td>${eur(ENTLASTUNGSBETRAG_ALLEINERZIEHENDE)} für das erste Kind, 240 € je weiterem Kind</td><td>Alleinerziehende (§ 24b Abs. 2 EStG)</td></tr>
<tr><td>Homeoffice-Tagespauschale</td><td>${eur(TAGESPAUSCHALE)} je Tag, höchstens ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)}</td><td>Tätigkeit überwiegend in der Wohnung</td></tr>
<tr><td>Entfernungspauschale</td><td>${dez(ENTFERNUNGSPAUSCHALE_JE_KM)} € je Entfernungskilometer</td><td>Pendler</td></tr>
<tr><td>Sonderausgaben-Pauschbetrag</td><td>${eur(SONDERAUSGABEN_PAUSCHBETRAG)} / ${eur(2 * SONDERAUSGABEN_PAUSCHBETRAG)} bei Zusammenveranlagung</td><td>alle Steuerpflichtigen</td></tr>
</tbody>
</table>

<p><strong>Sonderausgaben und außergewöhnliche Belastungen:</strong> Abziehbar sind unter anderem Vorsorgeaufwendungen, Altersvorsorgebeiträge von Pflichtversicherten einschließlich Zulage bis ${eur(2100)} (§ 10a Abs. 1 EStG), gezahlte Kirchensteuer (§ 10 Abs. 1 Nr. 4 EStG), Spenden bis 20 % des Gesamtbetrags der Einkünfte (§ 10b Abs. 1 EStG) und Kinderbetreuungskosten für Kinder unter ${ALTERSGRENZE} Jahren mit ${pct(ABZUGSQUOTE, 0)} der Aufwendungen, höchstens ${eur(HOECHSTBETRAG_JE_KIND)} je Kind (§ 10 Abs. 1 Nr. 5 EStG). Außergewöhnliche Belastungen wie Krankheitskosten wirken nur, soweit sie die zumutbare Belastung übersteigen (§ 33 Abs. 1 EStG).</p>

<p><strong>Familien:</strong> Für jedes Kind gibt es entweder Kindergeld – ${eur(KINDERGELD_MONAT)} im Monat (§ 66 Abs. 1 EStG) – oder die Freibeträge nach § 32 Abs. 6 EStG, bei Zusammenveranlagung ${eur(2 * KINDERFREIBETRAG_JE_ELTERNTEIL)} plus ${eur(2 * BEA_FREIBETRAG_JE_ELTERNTEIL)} je Kind. Das Finanzamt prüft, was günstiger ist (§ 31 EStG). Diese Günstigerprüfung rechnet der <a href="${import.meta.env.BASE_URL}geld/einkommensteuer-rechner/">Einkommensteuer-Rechner</a>.</p>

<p><strong>Praxistipp:</strong> Sammeln Sie Belege über das Jahr – Fahrtkosten, Arbeitsmittel, Handwerkerrechnungen, Spendenbescheinigungen – und prüfen Sie den Bescheid. Einspruch ist innerhalb eines Monats nach Bekanntgabe möglich (§ 355 Abs. 1 AO).</p>
`;
---
<Layout
  title={`Steuernachzahlung-Rechner ${year}`}
  description={`Steuernachzahlung oder Erstattung ${tarifJahr} berechnen: Der Rechner stellt die einbehaltene Lohnsteuer der geschuldeten Jahressteuer gegenüber – mit Steuerklasse, Partnereinkommen, Werbungskosten und Sonderausgaben.`}
  canonicalPath="/geld/steuernachzahlung-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Steuernachzahlung-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Steuernachzahlung-Rechner schätzen Sie, ob Sie mit einer Nachzahlung oder einer Erstattung rechnen können – so können Sie rechtzeitig Rücklagen bilden."
    sourceNote={`Einbehalt nach § 39b Abs. 2 EStG, Jahressteuer nach § 32a EStG (Grund- oder Splittingtarif), Solidaritätszuschlag nach SolzG 1995, Beitragssätze ${tarifJahr}. Die Vorsorgeaufwendungen werden mit der Vorsorgepauschale angesetzt; die Veranlagung rechnet sie nach § 10 EStG, davon kann das Ergebnis abweichen. Kinder mit Günstigerprüfung nach § 31 EStG, Entlastungsbetrag nach § 24b Abs. 2 EStG, zulässige Steuerklassen nach § 38b EStG. Beim einbehaltenen Solidaritätszuschlag sind die Kinderfreibeträge nach § 3 Abs. 2a SolzG mit der Zahl 0,5 je Kind in den Klassen I und II und 1 je Kind in III und IV angesetzt. Kirchensteuer und Progressionsvorbehalt sind nicht abgebildet. Abgabefristen und Zinsen nach §§ 149, 152, 233a und 238 AO sowie Art. 97 § 36 EGAO, Wortlaut abgerufen am 16.09.2026.`}
    explanation="Der Rechner stellt zwei Größen gegenüber: die Lohnsteuer, die Ihr Arbeitgeber über das Jahr einbehalten hat, und die Einkommensteuer, die Sie tatsächlich schulden. Die Differenz ist die Nachzahlung oder Erstattung. Verbindlich rechnet erst das Finanzamt."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="brutto">Jahresbruttoeinkommen (€)</label>
          <input type="number" id="brutto" min="0" max="1000000" value="50000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="stklasse">Ihre Steuerklasse</label>
          <select id="stklasse">
            <option value="1" selected>I</option>
            <option value="2">II (Alleinerziehende)</option>
            <option value="3">III</option>
            <option value="4">IV</option>
            <option value="5">V</option>
            <option value="6">VI</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="partnerBrutto">Jahresbrutto Partner (€)</label>
          <input type="number" id="partnerBrutto" min="0" max="1000000" value="0" step="1000" />
        </div>
        <div class="calc-group">
          <label for="partnerKlasse">Steuerklasse Partner</label>
          <select id="partnerKlasse">
            <option value="0" selected>Keine Zusammenveranlagung</option>
            <option value="3">III</option>
            <option value="4">IV</option>
            <option value="5">V</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="werbung">Werbungskosten (€/Jahr)</label>
          <input type="number" id="werbung" min="0" max="100000" value="1000" step="100" />
        </div>
        <div class="calc-group">
          <label for="sonder">Sonderausgaben ohne Vorsorgeaufwendungen (€/Jahr)</label>
          <input type="number" id="sonder" min="0" max="100000" value="0" step="100" />
        </div>
        <div class="calc-group">
          <label for="kinder">Kinder unter 25 Jahren (für die Pflegeversicherung)</label>
          <select id="kinder">
            <option value="0" selected>keine</option>
            <option value="1">1 Kind</option>
            <option value="2">2 Kinder</option>
            <option value="3">3 Kinder</option>
            <option value="4">4 Kinder</option>
            <option value="5">5 Kinder oder mehr</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="kinderKindergeld">Kinder mit Kindergeld im ganzen Jahr</label>
          <input type="number" id="kinderKindergeld" min="0" max="20" value="0" step="1" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label" id="result-label">Geschätztes Ergebnis</div>
        <div id="ergebnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Steuernachzahlung oder Erstattung: Was Sie erwartet"
    content={guideHtml}
    relatedSlugs={['einkommensteuer-rechner', 'steuerklassen-vergleich', 'kirchensteuer-rechner']}
  />
</Layout>

<script type="module">
const { berechneSteuernachzahlung } = await import(window.__base + 'scripts/steuernachzahlung.js');

function fmt(n) { return Math.abs(n).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }

function berechne() {
  const ergebnisEl = document.getElementById('ergebnis');
  const labelEl = document.getElementById('result-label');
  const detailsEl = document.getElementById('details');

  let r;
  try {
    r = berechneSteuernachzahlung({
      bruttoJahr: parseFloat(document.getElementById('brutto').value) || 0,
      steuerklasse: parseInt(document.getElementById('stklasse').value),
      partnerBruttoJahr: parseFloat(document.getElementById('partnerBrutto').value) || 0,
      partnerSteuerklasse: parseInt(document.getElementById('partnerKlasse').value) || 0,
      werbungskosten: parseFloat(document.getElementById('werbung').value) || 0,
      sonderausgaben: parseFloat(document.getElementById('sonder').value) || 0,
      kinder: parseInt(document.getElementById('kinder').value) || 0,
      kinderKindergeld: Math.max(0, Math.floor(Number(document.getElementById('kinderKindergeld').value) || 0)),
    });
  } catch (fehler) {
    labelEl.textContent = 'Eingaben prüfen';
    ergebnisEl.textContent = '—';
    ergebnisEl.style.color = '';
    const hinweis = document.createElement('span');
    hinweis.textContent = fehler.message;
    detailsEl.replaceChildren(hinweis);
    return;
  }

  if (r.nachzahlung > 0) {
    ergebnisEl.textContent = '− ' + fmt(r.nachzahlung);
    ergebnisEl.style.color = '#c8102e';
    labelEl.textContent = 'Voraussichtliche Nachzahlung';
  } else if (r.erstattung > 0) {
    ergebnisEl.textContent = '+ ' + fmt(r.erstattung);
    ergebnisEl.style.color = '#1e7e34';
    labelEl.textContent = 'Voraussichtliche Erstattung';
  } else {
    ergebnisEl.textContent = '0,00 €';
    ergebnisEl.style.color = '';
    labelEl.textContent = 'Weder Nachzahlung noch Erstattung';
  }

  const zeilen = [
    ['Einbehaltene Lohnsteuer: ', fmt(r.einbehaltenLohnsteuer)],
    ['Einbehaltener Soli: ', fmt(r.einbehaltenSoli)],
    ['Geschuldete Jahressteuer: ', fmt(r.jahressteuer)],
    ['Zu versteuerndes Einkommen: ', fmt(r.zuVersteuerndesEinkommen)],
    ['Veranlagung: ', r.zusammenveranlagung ? 'zusammen' : 'einzeln'],
  ];
  if (r.freibetraegeGuenstiger) {
    zeilen.push(['Kinder: Freibeträge günstiger, Kindergeld hinzugerechnet: ', fmt(r.hinzurechnungKindergeld)]);
  }
  detailsEl.replaceChildren(...zeilen.map(([text, wert]) => {
    const span = document.createElement('span');
    const strong = document.createElement('strong');
    strong.textContent = wert;
    span.append(text, strong);
    return span;
  }));
}

['brutto','partnerBrutto','werbung','sonder','stklasse','partnerKlasse','kinder','kinderKindergeld'].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
berechne();
</script>
