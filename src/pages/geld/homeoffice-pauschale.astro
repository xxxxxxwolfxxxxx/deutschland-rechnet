---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { TAGESPAUSCHALE, TAGESPAUSCHALE_HOECHSTBETRAG, steuervorteil } from '../../../public/scripts/homeoffice.js';
import { ARBEITNEHMER_PAUSCHBETRAG } from '../../../public/scripts/lohnsteuer.js';
import { ENTFERNUNGSPAUSCHALE_JE_KM } from '../../../public/scripts/fahrtkosten.js';

const calc = CALCULATORS.find(c => c.slug === 'homeoffice-pauschale')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Beträge aus den Modulen. Bis zum 16.09.2026 stand hier unter anderem
// eine Pendlerpauschale von „1,30 €/km für Hin- und Rückweg“, ein
// Arbeitszimmer „bis 1.250 €“ und ein Rechner, der die Pauschale mit einem
// frei gewählten Steuersatz multiplizierte und den Arbeitnehmer-Pauschbetrag
// übersah.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const eurCent = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

const TAGE_BIS_HOECHSTBETRAG = TAGESPAUSCHALE_HOECHSTBETRAG / TAGESPAUSCHALE;
const TAGE_BIS_PAUSCHBETRAG = Math.ceil(ARBEITNEHMER_PAUSCHBETRAG / TAGESPAUSCHALE);
if (!Number.isInteger(TAGE_BIS_HOECHSTBETRAG) || TAGE_BIS_PAUSCHBETRAG >= TAGE_BIS_HOECHSTBETRAG) {
  throw new Error('Homeoffice: Pauschbetrag und Tagespauschale passen nicht mehr zum Text');
}

// Tabelle: Ersparnis bei 50.000 € zu versteuerndem Einkommen, Grundtarif.
const BSP_ZVE = 50000;
const BSP_SONSTIGE = 1500;
const TABELLEN_TAGE = [50, 100, 150, TAGE_BIS_HOECHSTBETRAG];
function tabellenZeile(tage: number) {
  const ohne = steuervorteil({ tage, zvE: BSP_ZVE });
  const mit = steuervorteil({ tage, zvE: BSP_ZVE, sonstigeWerbungskosten: BSP_SONSTIGE });
  return '<tr><td>' + tage + '</td><td>' + eur(ohne.pauschale) + '</td><td>' + eur(ohne.ersparnis) + '</td><td>' + eur(mit.ersparnis) + '</td></tr>';
}
const tabellenZeilen = TABELLEN_TAGE.map(tabellenZeile).join('');
if (steuervorteil({ tage: 100, zvE: BSP_ZVE }).ersparnis !== 0) {
  throw new Error('Homeoffice: Pauschale unter dem Pauschbetrag darf nichts sparen');
}

// Beispiel Pendeln und Homeoffice in derselben Woche. Die Zahl der
// Arbeitswochen ist eine Annahme des Beispiels.
const BSP_KM = 25;
const BSP_BUEROTAGE = 3;
const BSP_HOMEOFFICETAGE = 2;
const BSP_WOCHEN = 46;
const pendelJeTag = BSP_KM * ENTFERNUNGSPAUSCHALE_JE_KM;
const jeWoche = BSP_BUEROTAGE * pendelJeTag + BSP_HOMEOFFICETAGE * TAGESPAUSCHALE;
const jeJahr = jeWoche * BSP_WOCHEN;

const guideHtml = `
<h3>Was die Tagespauschale ist</h3>
<p>Für jeden Kalendertag, an dem Sie überwiegend in der eigenen Wohnung arbeiten und keine erste Tätigkeitsstätte außerhalb aufsuchen, können Sie ${eur(TAGESPAUSCHALE)} abziehen, höchstens ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)} im Jahr (§ 4 Abs. 5 Satz 1 Nr. 6c EStG). Der Höchstbetrag ist nach ${TAGE_BIS_HOECHSTBETRAG} Tagen erreicht. Steht Ihnen dauerhaft kein anderer Arbeitsplatz zur Verfügung, zählt der Tag auch dann, wenn Sie am selben Tag auswärts oder an der ersten Tätigkeitsstätte arbeiten. Die Pauschale gilt für Selbständige als Betriebsausgabe und über § 9 Abs. 5 EStG für Arbeitnehmer als Werbungskosten. Ein eigenes Zimmer ist nicht nötig.</p>

<h3>Arbeitnehmer: erst der Pauschbetrag, dann die Pauschale</h3>
<p>Arbeitnehmer erhalten ohne jeden Nachweis den Arbeitnehmer-Pauschbetrag von ${eur(ARBEITNEHMER_PAUSCHBETRAG)} (§ 9a EStG). Die Tagespauschale spart deshalb nur, soweit alle Werbungskosten zusammen diesen Betrag übersteigen. Ohne weitere Werbungskosten ist das erst ab ${TAGE_BIS_PAUSCHBETRAG} Homeoffice-Tagen der Fall. Wer dagegen Fahrtkosten, Arbeitsmittel oder Fortbildungen absetzt, liegt schneller darüber – dann zählt jeder Homeoffice-Tag voll.</p>
<table>
<thead><tr><th>Homeoffice-Tage</th><th>Pauschale</th><th>Ersparnis ohne weitere Werbungskosten</th><th>Ersparnis bei ${eur(BSP_SONSTIGE)} weiteren Werbungskosten</th></tr></thead>
<tbody>${tabellenZeilen}</tbody>
</table>
<p><em>Einkommensteuer im Grundtarif bei ${eur(BSP_ZVE)} zu versteuerndem Einkommen, ohne Solidaritätszuschlag und Kirchensteuer; gerechnet mit demselben Modul wie der Rechner oben.</em></p>

<h3>Pauschale oder Arbeitszimmer?</h3>
<p>Aufwendungen für ein häusliches Arbeitszimmer sind nur abziehbar, wenn es den Mittelpunkt der gesamten betrieblichen und beruflichen Betätigung bildet (§ 4 Abs. 5 Satz 1 Nr. 6b EStG). Dann können Sie die tatsächlichen Kosten oder pauschal ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)} im Jahr ansetzen; für jeden vollen Monat ohne diese Voraussetzung sinkt die Jahrespauschale um ein Zwölftel. Bildet das Zimmer nicht den Mittelpunkt, ist es gar nicht abziehbar – dann bleibt nur die Tagespauschale. Beides zugleich geht nicht: Die Tagespauschale entfällt, soweit ein Abzug für das Arbeitszimmer vorgenommen wird (Nr. 6c).</p>

<h3>Pendeln und Homeoffice in derselben Woche</h3>
<p>An Tagen, an denen Sie die erste Tätigkeitsstätte aufsuchen, gibt es die Entfernungspauschale von ${ENTFERNUNGSPAUSCHALE_JE_KM.toLocaleString('de-DE', { minimumFractionDigits: 2 })} € je vollem Entfernungskilometer, an den übrigen die Tagespauschale. Beispiel mit ${BSP_KM} km einfachem Weg, ${BSP_BUEROTAGE} Bürotagen und ${BSP_HOMEOFFICETAGE} Homeoffice-Tagen je Woche: ${eurCent(jeWoche)} Werbungskosten in der Woche, bei ${BSP_WOCHEN} Arbeitswochen ${eur(jeJahr)} im Jahr – mehr als der Arbeitnehmer-Pauschbetrag.</p>
`;

const faqs = [
  { q: 'Wie viel bringt die Homeoffice-Pauschale?', a: `${eur(TAGESPAUSCHALE)} je Tag, höchstens ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)} im Jahr. Wie viel Steuer das spart, hängt von Ihrem Einkommen und Ihren übrigen Werbungskosten ab: Arbeitnehmer profitieren erst, soweit alle Werbungskosten den Pauschbetrag von ${eur(ARBEITNEHMER_PAUSCHBETRAG)} übersteigen. Der Rechner oben rechnet das mit dem Einkommensteuertarif aus.` },
  { q: 'Welche Tage zählen?', a: 'Tage, an denen Sie überwiegend in der häuslichen Wohnung arbeiten und keine erste Tätigkeitsstätte außerhalb aufsuchen. Haben Sie dauerhaft keinen anderen Arbeitsplatz, zählen auch Tage, an denen Sie zusätzlich auswärts oder an der ersten Tätigkeitsstätte tätig sind (§ 4 Abs. 5 Satz 1 Nr. 6c EStG).' },
  { q: 'Gilt die Pauschale auch für Selbständige?', a: 'Ja. Sie steht in § 4 Abs. 5 EStG bei den Betriebsausgaben und gilt über § 9 Abs. 5 EStG ebenso für die Werbungskosten von Arbeitnehmern.' },
  { q: 'Kann ich Pauschale und Arbeitszimmer kombinieren?', a: `Nein. Die Tagespauschale entfällt, soweit ein Abzug für das häusliche Arbeitszimmer vorgenommen wird. Das Arbeitszimmer ist ohnehin nur abziehbar, wenn es den Mittelpunkt der gesamten Tätigkeit bildet – dann mit den tatsächlichen Kosten oder ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)} im Jahr (§ 4 Abs. 5 Satz 1 Nr. 6b EStG).` },
  { q: 'Und die Pendlerpauschale?', a: `Für Tage, an denen Sie die erste Tätigkeitsstätte aufsuchen, gilt die Entfernungspauschale von ${ENTFERNUNGSPAUSCHALE_JE_KM.toLocaleString('de-DE', { minimumFractionDigits: 2 })} € je vollem Kilometer der einfachen Strecke. An Homeoffice-Tagen gilt die Tagespauschale. Beides zusammen zählt zu den Werbungskosten.` },
];
---
<Layout
  title={`Homeoffice-Pauschale ${year}`}
  description={`Homeoffice-Pauschale berechnen: ${TAGESPAUSCHALE} € je Tag, höchstens ${TAGESPAUSCHALE_HOECHSTBETRAG.toLocaleString('de-DE')} € im Jahr – und wie viel Steuer sie nach Abzug des Arbeitnehmer-Pauschbetrags wirklich spart.`}
  canonicalPath="/geld/homeoffice-pauschale/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Homeoffice-Pauschale {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner zeigt, wie viel Einkommensteuer die Homeoffice-Pauschale Ihnen tatsächlich spart – mit Ihrem zu versteuernden Einkommen und Ihren übrigen Werbungskosten."
    sourceNote={`Tagespauschale nach § 4 Abs. 5 Satz 1 Nr. 6c EStG, für Werbungskosten über § 9 Abs. 5 EStG; Arbeitnehmer-Pauschbetrag nach § 9a EStG (${eur(ARBEITNEHMER_PAUSCHBETRAG)}); Tarif nach § 32a EStG. Ersparnis ohne Solidaritätszuschlag und Kirchensteuer. Wortlaut abgerufen am 16.09.2026.`}
    explanation={`Pauschale = Tage × ${eur(TAGESPAUSCHALE)}, höchstens ${eur(TAGESPAUSCHALE_HOECHSTBETRAG)}. Bei Arbeitnehmern wirkt davon nur, was die Werbungskosten über den Pauschbetrag hebt. Ersparnis = Einkommensteuer vorher − Einkommensteuer nach diesem zusätzlichen Abzug.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="tage">Homeoffice-Tage im Jahr</label>
          <input type="number" id="tage" min="0" max="366" value="120" step="1" />
        </div>
        <div class="calc-group">
          <label for="einkommen">Zu versteuerndes Einkommen ohne die Pauschale (€)</label>
          <input type="number" id="einkommen" min="0" max="10000000" value="50000" step="100" />
        </div>
        <div class="calc-group">
          <label for="sonstige">Übrige Werbungskosten (€/Jahr)</label>
          <input type="number" id="sonstige" min="0" max="1000000" value="0" step="10" />
        </div>
        <div class="calc-group">
          <label><input type="checkbox" id="arbeitnehmer" checked style="width:auto;margin-right:0.4rem;" />Arbeitnehmer (sonst Selbständige: Betriebsausgabe)</label>
          <label><input type="checkbox" id="splitting" style="width:auto;margin-right:0.4rem;" />Zusammenveranlagung (Splittingtarif)</label>
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Einkommensteuer-Ersparnis im Jahr</div>
        <div id="ergebnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.9rem;color:#555;display:flex;flex-direction:column;gap:0.3rem;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So wirkt die Homeoffice-Pauschale"
    content={guideHtml}
    relatedSlugs={['einkommensteuer-rechner', 'steuernachzahlung-rechner', 'brutto-netto-rechner']}
  />
</Layout>

<script type="module">
const { steuervorteil } = await import(window.__base + 'scripts/homeoffice.js');
const feld = (id) => document.getElementById(id);
const fmt = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

function zeile(text, wert) {
  const span = document.createElement('span');
  span.append(text);
  if (wert !== undefined) {
    const strong = document.createElement('strong');
    strong.textContent = wert;
    span.append(strong);
  }
  return span;
}

function berechne() {
  const arbeitnehmer = feld('arbeitnehmer').checked;
  feld('sonstige').disabled = !arbeitnehmer;
  const r = steuervorteil({
    tage: Number(feld('tage').value) || 0,
    zvE: Number(feld('einkommen').value) || 0,
    sonstigeWerbungskosten: Number(feld('sonstige').value) || 0,
    arbeitnehmer,
    splitting: feld('splitting').checked,
  });
  feld('ergebnis').textContent = fmt(r.ersparnis);
  const zeilen = [
    zeile('Tagespauschale: ', fmt(r.pauschale)),
    zeile('Davon wirksamer Abzug: ', fmt(r.zusaetzlicherAbzug)),
  ];
  if (arbeitnehmer && r.tageBisPauschbetrag > 0) {
    zeilen.push(zeile('Ohne weitere Werbungskosten wirkt die Pauschale erst ab ' + r.tageBisPauschbetrag + ' Tagen – bis dahin deckt der Arbeitnehmer-Pauschbetrag alles ab.'));
  }
  zeilen.push(zeile('Ohne Solidaritätszuschlag und Kirchensteuer.'));
  feld('details').replaceChildren(...zeilen);
}

document.querySelectorAll('.calc-form input').forEach((el) => {
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
berechne();
</script>
