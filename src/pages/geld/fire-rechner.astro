---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelFire from '../../components/artikel/sparquote-schlaegt-rendite.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'fire-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`FIRE-Rechner ${year}`}
  description="Financial Independence, Retire Early – Wann kannst du in Rente gehen?"
  canonicalPath="/geld/fire-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>FIRE-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem FIRE-Rechner berechnen Sie, wann Sie durch Ihre Sparquote finanziell unabhängig werden. Finden Sie heraus, wie viel Vermögen Sie benötigen und wie lange es dauert, bis Ihre Kapitalerträge die Lebenshaltungskosten decken."
    sourceNote="Zielkapital nach der 4-%-Regel, also das 25-Fache der Jahresausgaben (Bengen 1994; Trinity-Studie 1998, beide auf 30 Jahre und US-Daten gerechnet). Angespart wird mit der realen Rendite, also Rendite abzüglich Inflation. Steuern auf die Entnahme sind nicht enthalten."
    explanation="Grundlage ist die 4-%-Regel: Das Zielkapital ist das 25-Fache der Jahresausgaben, bei 30.000 € also 750.000 €. Die Sparquote ergibt sich aus Einkommen und Ausgaben und ist die entscheidende Größe – sie erhöht die Sparrate und senkt zugleich das Ziel. Das Einkommen selbst kürzt sich aus der Rechnung heraus: Bei gleicher Quote dauert es bei 24.000 € genauso lange wie bei 400.000 €."
    faqs={[
      { q: "Was besagt die 4-%-Regel?", a: "Sie geht auf William Bengen (1994) und die Trinity-Studie (1998) zurück: Wer im ersten Jahr 4 % seines Depots entnimmt und den Betrag danach jährlich an die Inflation anpasst, hätte es in den untersuchten historischen 30-Jahres-Zeiträumen nicht aufgebraucht. Daraus folgt das Zielkapital vom 25-Fachen der Jahresausgaben." },
      { q: "Gilt die Regel auch für einen sehr frühen Ausstieg?", a: "Sie ist auf 30 Jahre gerechnet. Wer mit 45 aufhört, plant für 40 bis 50 Jahre – dafür sagt die Studie nichts aus. Entscheidend ist, ob die reale Rendite dauerhaft über der Entnahmerate liegt; der Artikel auf dieser Seite rechnet vor, wie lange das Kapital bei verschiedenen realen Renditen reicht." },
      { q: "Sind Steuern eingerechnet?", a: "Nein. Die Regel stammt aus den USA und nennt eine Entnahme vor Steuern. In Deutschland fällt auf den Gewinnanteil einer Entnahme Abgeltungsteuer an, bei Aktienfonds nach der Teilfreistellung von 30 % (§ 20 Abs. 1 InvStG). Je nach Gewinnanteil im Depot steigt das nötige Kapital dadurch vom 25-Fachen auf das 26- bis 30-Fache der Ausgaben." },
      { q: "Warum wird die Sparquote nicht eingegeben?", a: "Weil sie aus Einkommen und Ausgaben folgt: Was nicht ausgegeben wird, wird gespart. Drei frei wählbare Felder könnten sich widersprechen. Der Rechner zeigt die Quote deshalb als Ergebnis an." },
      { q: "Zählt eine eigene Immobilie mit?", a: "Nur indirekt. Eine abbezahlte Wohnung senkt die Ausgaben und damit das Zielkapital – als entnehmbares Vermögen taugt sie dagegen nicht, solange man darin wohnt. Tragen Sie in diesem Fall die Ausgaben ohne Miete ein." },
      { q: "Was ist mit der gesetzlichen Rente?", a: "Der Rechner lässt sie weg und rechnet so, als müsste das Depot die Ausgaben dauerhaft allein tragen. Das ist die vorsichtigere Annahme: Eine spätere Rente senkt den Kapitalbedarf für die Zeit ab Rentenbeginn. Die früheste Altersrente für langjährig Versicherte ist nach § 36 SGB VI mit 63 möglich, dann mit Abschlägen." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="einkommen">Jährliches Nettoeinkommen (€)</label>
          <input type="number" id="einkommen" min="10000" max="500000" value="50000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="ausgaben">Jährliche Ausgaben (€)</label>
          <input type="number" id="ausgaben" min="5000" max="200000" value="30000" step="500" />
        </div>
        <div class="calc-group">
          <label for="vermoegen">Aktuelles Vermögen (€)</label>
          <input type="number" id="vermoegen" min="0" max="5000000" value="20000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="rendite">Erwartete Rendite (% p.a.)</label>
          <input type="number" id="rendite" min="0" max="15" value="7" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="inflation">Inflation (% p.a.)</label>
          <input type="number" id="inflation" min="0" max="10" value="2" step="0.5" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Jahre bis FIRE</div>
        <div id="fire-jahre">—</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
    <ArtikelFire slot="artikel" />
  </CalculatorShell>

</Layout>

<script type="module">
// Die Sparquote stand hier bis September 2026 als eigenes Eingabefeld neben
// Einkommen und Ausgaben – drei Zahlen, von denen nur zwei frei sind. Wer
// 30.000 € Ausgaben und 90 % Sparquote eintrug, gab damit mehr aus und sparte
// mehr, als er verdiente. Sie wird jetzt aus den beiden anderen gerechnet.
const proz = (n) =>
  n.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).replace(/^-/, '−') + ' %';
const eur = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }).replace(/^-/, '−') + ' €';

function berechne() {
  const einkommen = parseFloat(document.getElementById('einkommen').value) || 0;
  const ausgaben = parseFloat(document.getElementById('ausgaben').value) || 0;
  const vermoegen = parseFloat(document.getElementById('vermoegen').value) || 0;
  const rendite = parseFloat(document.getElementById('rendite').value) || 0;
  const inflation = parseFloat(document.getElementById('inflation').value) || 0;

  const sparen = einkommen - ausgaben;
  const sparquote = einkommen > 0 ? (sparen / einkommen) * 100 : 0;
  const fireZiel = ausgaben / 0.04;
  const realeRendite = (1 + rendite / 100) / (1 + inflation / 100) - 1;

  let kapital = vermoegen;
  let jahre = 0;
  while (kapital < fireZiel && jahre < 100 && sparen > 0) {
    kapital = (kapital + sparen) * (1 + realeRendite);
    jahre += 1;
  }
  const erreichbar = sparen > 0 && jahre < 100;

  const ziel = document.getElementById('fire-jahre');
  ziel.textContent = erreichbar ? `${jahre} Jahre` : 'Nicht erreichbar';
  ziel.style.color = erreichbar ? '#1e7e34' : '#c8102e';

  const teile = [
    `<span>Sparquote: <strong>${proz(sparquote)}</strong></span>`,
    `<span>Jährliches Sparen: <strong>${eur(sparen)}</strong></span>`,
    `<span>Zielkapital: <strong>${eur(fireZiel)}</strong></span>`,
    `<span>Reale Rendite: <strong>${proz(realeRendite * 100)}</strong></span>`,
  ];
  if (sparen <= 0) {
    teile.push('<span style="flex-basis:100%;">Ohne Überschuss zwischen Einkommen und Ausgaben wächst kein Kapital: Die Ausgaben müssen unter dem Einkommen liegen.</span>');
  }
  teile.push('<span style="flex-basis:100%;">Gerechnet ist vor Steuern. Auf die Entnahme aus einem Depot fällt Abgeltungsteuer auf den Gewinnanteil an – das Zielkapital liegt dadurch höher, als die Regel vom 25-Fachen vermuten lässt. Der Artikel unten rechnet beides durch.</span>');
  document.getElementById('details').innerHTML = teile.join('');
}
['einkommen', 'ausgaben', 'vermoegen', 'rendite', 'inflation'].forEach((id) =>
  document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
