---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelGmbh from '../../components/artikel/gmbh-break-even-ist-ein-hebesatz.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'gmbh-vs-einzelunternehmen')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`GmbH vs. Einzelunternehmen ${year}`}
  description="Steuerbelastung vergleichen: GmbH oder Einzelunternehmen? Finden Sie die steuerlich günstigere Rechtsform."
  canonicalPath="/geld/gmbh-vs-einzelunternehmen/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>GmbH vs. Einzelunternehmen {year} – Steuervergleich</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner stellt die Steuerbelastung beider Rechtsformen für denselben Gewinn gegenüber – mit Gewerbesteuer, Anrechnung nach § 35 EStG beim Einzelunternehmen und der zweiten Stufe der GmbH bei der Ausschüttung. Wie viel Sie ausschütten, entscheidet über das Ergebnis mehr als die Höhe des Gewinns."
    sourceNote="Einkommensteuer nach § 32a EStG, Gewerbesteuer nach §§ 11, 16 GewStG (Freibetrag 24.500 € nur für Einzelunternehmen), Anrechnung nach § 35 Abs. 1 EStG (das Vierfache des Messbetrags, begrenzt auf die gezahlte Gewerbesteuer), Körperschaftsteuer 15 % nach § 23 Abs. 1 KStG, Abgeltungsteuer 25 % nach § 32d Abs. 1 EStG, jeweils zuzüglich Solidaritätszuschlag."
    explanation="Das Einzelunternehmen versteuert den Gewinn einmal: Einkommensteuer nach dem Tarif (14 bis 45 Prozent) plus Gewerbesteuer, die nach § 35 EStG zum großen Teil auf die Einkommensteuer angerechnet wird. Die GmbH versteuert zweimal: erst Körperschaftsteuer und Gewerbesteuer auf Gesellschaftsebene, dann Abgeltungsteuer auf die Ausschüttung. Weil keine dieser Steuern progressiv ist, ist die GmbH-Belastung bei jedem Gewinn gleich hoch – eine Gewinnschwelle, ab der sich die GmbH bei voller Ausschüttung lohnt, gibt es bei üblichen Hebesätzen deshalb nicht. Der Vorteil entsteht erst, wenn Gewinne im Unternehmen bleiben."
    faqs={[
      { q: "Ab welchem Gewinn lohnt sich eine GmbH?", a: "Bei voller Ausschüttung bei keinem: Weil Körperschaft-, Gewerbe- und Abgeltungsteuer feste Sätze haben, ist die GmbH-Belastung vom Gewinn unabhängig – bei einem Hebesatz von 410 % rund 48,6 Prozent. Das Einzelunternehmen bleibt selbst bei sehr hohen Gewinnen darunter. Die verbreiteten Faustregeln „ab 50.000 €“ oder „ab 80.000 €“ gelten nur für den Fall, dass Gewinne im Unternehmen bleiben. Die Rechnung dazu steht im Artikel auf dieser Seite." },
      { q: "Wie werden einbehaltene Gewinne besteuert?", a: "Mit Körperschaftsteuer von 15 % (§ 23 Abs. 1 KStG), Solidaritätszuschlag darauf und Gewerbesteuer – bei einem Hebesatz von 410 % zusammen rund 30 Prozent. Das ist aber keine endgültige Ersparnis: Sobald das Geld an den Gesellschafter fließt, kommen Abgeltungsteuer und Solidaritätszuschlag hinzu. Einzelunternehmer können für nicht entnommene Gewinne einen ähnlichen Weg über § 34a EStG wählen, mit Nachversteuerung bei der Entnahme." },
      { q: "Was kostet eine GmbH neben den Steuern?", a: "Notar und Handelsregister bei der Gründung, dazu laufend Buchführung nach HGB, Jahresabschluss und dessen Offenlegung. Diese Kosten rechnet der Rechner nicht mit; sie vergrößern den Abstand zulasten der GmbH. Ein Stammkapital von 25.000 € ist aufzubringen, davon mindestens die Hälfte bei der Anmeldung (§ 5 Abs. 1, § 7 Abs. 2 GmbHG)." },
      { q: "Muss ich mir als Gesellschafter-Geschäftsführer ein Gehalt zahlen?", a: "Vorgeschrieben ist es nicht. Steuerlich wirkt es aber stark: Das Gehalt ist Betriebsausgabe der GmbH, mindert Gewerbe- und Körperschaftsteuer und wird beim Empfänger nur einmal versteuert. Die Grenze zieht die verdeckte Gewinnausschüttung – ein unangemessen hohes Gehalt behandelt das Finanzamt wie eine Ausschüttung." },
      { q: "Zahlt eine GmbH auch ohne Gewinn Gewerbesteuer?", a: "Nein. Bemessungsgrundlage ist der Gewerbeertrag; ohne Ertrag fällt keine Gewerbesteuer an. Anders als das Einzelunternehmen hat die GmbH allerdings keinen Freibetrag von 24.500 € (§ 11 Abs. 1 Satz 3 Nr. 1 GewStG), sodass schon kleine Erträge belastet werden." },
      { q: "Wie wirkt der Hebesatz der Gemeinde?", a: "Er trifft beide Rechtsformen, aber unterschiedlich stark. Beim Einzelunternehmen ist die Anrechnung nach § 35 EStG auf das Vierfache des Messbetrags gedeckelt – das entspricht einem Hebesatz von 400 %; was darüber liegt, bleibt endgültig hängen. Bei der GmbH mindert jeder Euro Gewerbesteuer zugleich die Ausschüttung und damit die Abgeltungsteuer." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="gewinn">Jährlicher Gewinn (€)</label>
          <input type="number" id="gewinn" min="0" max="5000000" value="150000" step="5000" />
        </div>
        <div class="calc-group">
          <label for="ausschuettung">Ausschüttung an Gesellschafter (€)</label>
          <input type="number" id="ausschuettung" min="0" max="5000000" value="80000" step="5000" />
        </div>
        <div class="calc-group">
          <label for="hebesatz">Gewerbesteuer-Hebesatz (%)</label>
          <input type="number" id="hebesatz" min="200" max="900" value="410" step="10" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Günstigere Rechtsform</div>
        <div id="ergebnis">—</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
    <ArtikelGmbh slot="artikel" />
  </CalculatorShell>

  <CalculatorGuide
    title="So funktioniert der Vergleich GmbH vs. Einzelunternehmen"
    content={`<p><strong>Die Wahl der Rechtsform ist eine Steuerfrage:</strong> Ein Einzelunternehmer zahlt Einkommensteuer (bis 45%) + Sozialversicherung (ca. 19,5%) + Gewerbesteuer auf alle Gewinne. Eine GmbH zahlt Körperschaftsteuer (15%) + Solidaritätszuschlag (5,5%) + Gewerbesteuer, aber erst bei Ausschüttung wird der Gesellschafter (als Privatperson) mit Abgeltungsteuer (25%) belastet.</p>

<p><strong>Der Break-Even punkt:</strong> Bei Gewinnen unter 40.000€ ist meist das Einzelunternehmen günstiger (weniger Aufwand, keine GmbH-Kosten). Ab 50.000-80.000€ wird die GmbH interessanter, weil die GmbH-Steuerbelastung niedriger ist, wenn man Gewinne einbehält (thesauriert). Der exakte Punkt hängt vom persönlichen Grenzsteuersatz ab.</p>

<p><strong>Die Steuerstundungs-Strategie:</strong> Eine GmbH ermöglicht es, Gewinne mit nur 31,65% (15% KSt + 5,5% Soli + 11,15% Gewerbesteuer im Schnitt) zu besteuern und einzubehalten. Erst wenn Sie Geld ausschütten, zahlt der Gesellschafter zusätzlich Abgeltungsteuer (25%). Ein Einzelunternehmer zahlt sofort die volle Steuerlast (bis 45% ESt).</p>

<p><strong>Versteckte Kosten der GmbH:</strong> Gründung (800-1.500€), jährliche Bilanzbuchhaltung (500-2.000€), Steuererklärungen, Geschäftsführervergütung (mind. angemessen), Gewerbesteuer auch bei Verlust (in manchen Bundesländern). Das addiert sich zu 3.000-5.000€ pro Jahr.</p>

<p><strong>Praktisches Beispiel:</strong> Bei 100.000€ Gewinn zahlt ein Einzelunternehmer (Stklasse IV, Hebesatz 410%) ca. 40.000€ Gewinnesteuer + Gewerbesteuer. Eine GmbH mit gleicher Ausschüttung zahlt ca. 28.000€. Aber: Nach GmbH-Gründungs- und Betriebskosten ist der Vorteil nur noch 5.000-10.000€. Lohnt sich erst bei wiederkehrend hohen Gewinnen.</p>`}
    relatedSlugs={['gewerbesteuer-rechner', 'brutto-netto-rechner', 'gehaltserhoehung-rechner']}
  />
</Layout>

<script type="module">
// Bis zum 11.08.2026 stand der Tarif hier als eigene Kopie – mit dem
// Grundfreibetrag von 2025 und Faktoren aus 2023. Er kommt jetzt aus
// einkommensteuer.js, dem einzigen Ort im Projekt, an dem § 32a EStG steht.
const { einkommensteuer } = await import(window.__base + 'scripts/einkommensteuer.js');
const { solidaritaetszuschlag } = await import(window.__base + 'scripts/lohnsteuer.js');

function berechne() {
  const gewinn = parseFloat(document.getElementById('gewinn').value) || 150000;
  const ausschuettung = parseFloat(document.getElementById('ausschuettung').value) || 80000;
  const hebesatz = parseFloat(document.getElementById('hebesatz').value) || 410;
  
  // Einzelunternehmen
  // § 11 GewStG: Gewerbeertrag auf volle 100 € abrunden, Freibetrag 24.500 €
  // für natürliche Personen, Steuermesszahl 3,5 %.
  const gewStFreibetrag = 24500;
  const gewStBasis = Math.max(0, Math.floor(gewinn / 100) * 100 - gewStFreibetrag);
  const messbetrag = gewStBasis * 0.035;
  const gewSt = messbetrag * (hebesatz / 100);
  // § 35 Abs. 1 EStG: das Vierfache des Steuermessbetrags, nach Satz 5 begrenzt
  // auf die tatsächlich zu zahlende Gewerbesteuer und auf den
  // Ermäßigungshöchstbetrag. Vorher stand hier das 3,8-fache der Gewerbesteuer
  // selbst statt des Messbetrags – bei 150.000 € Gewinn wurde dadurch fast die
  // gesamte Einkommensteuer wegangerechnet.
  const zvE_EU = gewinn;
  const est = einkommensteuer(zvE_EU);
  const gewStAnrechnung = Math.min(4 * messbetrag, gewSt, est);
  const estNachAnrechnung = est - gewStAnrechnung;
  // Der Solidaritätszuschlag wurde auf der GmbH-Seite berechnet, auf der Seite
  // des Einzelunternehmens aber vergessen – das verzerrte den Vergleich.
  const soliEU = solidaritaetszuschlag(estNachAnrechnung);
  const gesamtEU = estNachAnrechnung + soliEU + gewSt;
  
  // GmbH
  const kSt = gewinn * 0.15;
  const soliKSt = kSt * 0.055;
  const gewStGmbH = gewinn * 0.035 * (hebesatz / 100);
  // Ausschütten lässt sich nur, was nach Gewerbe- und Körperschaftsteuer übrig
  // ist. Vorher nahm die Seite die Eingabe ungeprüft und wies zugleich
  // "Gewinn minus Ausschüttung" als thesauriert aus – zusammen war das mehr,
  // als die GmbH überhaupt hat.
  const verfuegbar = Math.max(0, gewinn - kSt - soliKSt - gewStGmbH);
  const ausschuettungEff = Math.min(ausschuettung, verfuegbar);
  const abgeltungsteuer = ausschuettungEff * 0.25;
  const soliAbgeltung = abgeltungsteuer * 0.055;
  const gesamtGmbH = kSt + soliKSt + gewStGmbH + abgeltungsteuer + soliAbgeltung;
  const thesaurierung = verfuegbar - ausschuettungEff;

  const guenstiger = gesamtEU < gesamtGmbH ? 'Einzelunternehmen' : 'GmbH';
  const diff = Math.abs(gesamtEU - gesamtGmbH);
  const eur = (n, stellen = 2) =>
    n.toLocaleString('de-DE', { minimumFractionDigits: stellen, maximumFractionDigits: stellen }) + ' €';

  document.getElementById('ergebnis').textContent = guenstiger;
  document.getElementById('ergebnis').style.color = guenstiger === 'GmbH' ? '#1565c0' : '#1e7e34';

  const nettoEU = gewinn - gesamtEU;
  const nettoGmbH = ausschuettungEff - abgeltungsteuer - soliAbgeltung;

  const teile = [
    `<span>Steuern Einzelunternehmen: <strong>${eur(gesamtEU)}</strong> (${(gesamtEU / gewinn * 100).toLocaleString('de-DE', {maximumFractionDigits:2})} %)</span>`,
    `<span>Steuern GmbH: <strong>${eur(gesamtGmbH)}</strong> (${(gesamtGmbH / gewinn * 100).toLocaleString('de-DE', {maximumFractionDigits:2})} %)</span>`,
    `<span>Differenz: <strong>${eur(diff)}</strong></span>`,
    `<span>Beim Einzelunternehmer bleiben: <strong>${eur(nettoEU, 0)}</strong></span>`,
    `<span>Beim Gesellschafter kommen an: <strong>${eur(nettoGmbH, 0)}</strong></span>`,
    `<span>In der GmbH bleiben: <strong>${eur(thesaurierung, 0)}</strong></span>`,
  ];
  if (ausschuettung > verfuegbar) {
    teile.push(`<span style="flex-basis:100%;">Mehr als ${eur(verfuegbar, 0)} lassen sich nicht ausschütten: Gewerbe- und Körperschaftsteuer gehen vorher ab. Gerechnet wurde mit diesem Betrag.</span>`);
  }
  teile.push(`<span style="flex-basis:100%;">Was in der GmbH bleibt, ist nicht steuerfrei, sondern noch nicht ausgeschüttet – bei einer späteren Ausschüttung fallen Abgeltungsteuer und Solidaritätszuschlag an. Ein Geschäftsführergehalt rechnet diese Seite nicht mit; was es ändert, steht im Artikel unten.</span>`);
  document.getElementById('details').innerHTML = teile.join('');
}
['gewinn','ausschuettung','hebesatz'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
