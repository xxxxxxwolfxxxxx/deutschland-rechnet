---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { sparverlaufMitSteuer } from '../../../public/scripts/sparen.js';
import { SPARERPAUSCHBETRAG_EINZEL, SPARERPAUSCHBETRAG_ZUSAMMEN, belastungssatz } from '../../../public/scripts/abgeltungsteuer.js';
const calc = CALCULATORS.find(c => c.slug === 'sparen-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus denselben Modulen, die der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const belastung = belastungssatz().toLocaleString('de-DE', { maximumFractionDigits: 3 });

const bsp = sparverlaufMitSteuer({ startkapital: 10000, sparrate: 200, zinsProzent: 2.5, jahre: 10 });
const gross = sparverlaufMitSteuer({ startkapital: 100000, sparrate: 0, zinsProzent: 2.5, jahre: 10 });
const grossOhne = sparverlaufMitSteuer({ startkapital: 100000, sparrate: 0, zinsProzent: 2.5, jahre: 10, pauschbetrag: 0 });
if (bsp.steuern !== 0 || !(gross.steuern > 0 && grossOhne.steuern > gross.steuern)) {
  throw new Error('Sparen: Beispiele passen nicht zum Text');
}

function zeile(jahre: number) {
  const r = sparverlaufMitSteuer({ startkapital: 10000, sparrate: 200, zinsProzent: 2.5, jahre });
  return '<tr><td>' + jahre + ' Jahre</td><td>' + eur(r.eingezahlt) + '</td><td>' + eur(r.zinsenBrutto) + '</td><td>' + eur(r.steuern) + '</td><td>' + eur(r.endkapital) + '</td></tr>';
}
const zeilen = [5, 10, 20, 30].map(zeile).join('');

const guideHtml = `
<h3>Zinseszins und die 72er-Regel</h3>
<p>Werden Zinsen nicht ausgezahlt, sondern dem Guthaben zugeschlagen, verzinsen sie sich in den Folgejahren mit. Als Faustformel für die Verdopplungszeit dient die 72er-Regel: 72 geteilt durch den Zinssatz. Bei 2 % sind das rund 36 Jahre, bei 4 % rund 18. Die Regel ist eine Näherung an die exakte Rechnung, die dieser Rechner monatsgenau ausführt.</p>

<h3>Steuer jedes Jahr, Pauschbetrag jedes Jahr</h3>
<p>Zinsen auf Tages- und Festgeld unterliegen der Abgeltungsteuer mit Solidaritätszuschlag, zusammen ${belastung} % ohne Kirchensteuer. Frei bleibt der Sparer-Pauschbetrag von ${eur(SPARERPAUSCHBETRAG_EINZEL)} im Jahr, bei Zusammenveranlagung ${eur(SPARERPAUSCHBETRAG_ZUSAMMEN)}. Weil Sparzinsen jährlich zufließen, rechnet der Rechner die Steuer am Ende jedes Jahres und zieht sie vom Guthaben ab – der Pauschbetrag wirkt so in jedem Jahr neu.</p>
<p>Eine Teilfreistellung wie bei Aktienfonds gibt es für Sparzinsen nicht. Die frühere Fassung dieses Rechners hatte die Steuer trotzdem mit 0,7 multipliziert.</p>
<p><strong>Beispiel:</strong> Mit ${eur(10000)} Startkapital, ${eur(200)} im Monat und 2,5 % Zins bleiben die Zinsen über zehn Jahre unter dem Pauschbetrag – Steuer: ${eur(bsp.steuern)}. Wer ${eur(100000)} zu 2,5 % anlegt, zahlt in zehn Jahren ${eur(gross.steuern)} Steuer; ohne freien Pauschbetrag wären es ${eur(grossOhne.steuern)}.</p>

<h3>Verlauf</h3>
<p>${eur(10000)} Startkapital, ${eur(200)} monatlich, 2,5 % Zins, Pauschbetrag ${eur(SPARERPAUSCHBETRAG_EINZEL)}:</p>
<table>
<thead><tr><th>Laufzeit</th><th>eingezahlt</th><th>Zinsen</th><th>Steuer</th><th>Guthaben</th></tr></thead>
<tbody>${zeilen}</tbody>
</table>
<p>Der Zinssatz ist Ihre Eingabe. Tragen Sie den Satz Ihres Angebots ein – bei variabel verzinstem Tagesgeld ist das eine Annahme über die Zukunft.</p>
`;

const faqs = [
  { q: 'Wie werden Sparzinsen besteuert?', a: `Mit Abgeltungsteuer und Solidaritätszuschlag, zusammen ${belastung} % ohne Kirchensteuer, auf den Teil der Zinsen, der über dem Sparer-Pauschbetrag von ${eur(SPARERPAUSCHBETRAG_EINZEL)} im Jahr liegt.` },
  { q: 'Gilt der Pauschbetrag jedes Jahr?', a: 'Ja, er gilt je Kalenderjahr für alle Kapitalerträge zusammen. Hat ihn schon ein anderes Konto oder Depot verbraucht, wählen Sie „bereits verbraucht".' },
  { q: 'Warum ist das Ergebnis niedriger als bei einfachem Zinseszins?', a: 'Weil die Steuer jedes Jahr vom Guthaben abgeht und der abgezogene Betrag nicht mehr mitverzinst wird. Bleiben die Zinsen unter dem Pauschbetrag, gibt es keinen Unterschied.' },
  { q: 'Berücksichtigt der Rechner die Inflation?', a: 'Nein. Er zeigt den nominalen Endbetrag. Um die Kaufkraft abzuschätzen, nutzen Sie den Inflationsrechner.' },
];
---
<Layout
  title={`Sparen-Rechner ${year}`}
  description="Sparplan mit Zinseszins berechnen – mit jährlicher Abgeltungsteuer und Sparer-Pauschbetrag, wie bei Tages- und Festgeld."
  canonicalPath="/geld/sparen-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Sparen-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner zeigt, wie ein Guthaben mit monatlicher Einzahlung und Zinseszins wächst – nach Abzug der Steuer, die auf Sparzinsen jedes Jahr fällig wird."
    sourceNote={`Abgeltungsteuer nach § 32d Abs. 1 EStG mit Solidaritätszuschlag (${belastung} %), Sparer-Pauschbetrag nach § 20 Abs. 9 EStG je Kalenderjahr. Monatliche Einzahlung am Monatsende, monatliche Verzinsung, Steuer am Jahresende. Ohne Kirchensteuer. Der Zinssatz ist Ihre Eingabe.`}
    explanation="Jeden Monat: Guthaben + Zinsen + Sparrate. Jedes Jahresende: Steuer auf die Zinsen des Jahres über dem Pauschbetrag, abgezogen vom Guthaben."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="start">Startkapital (€)</label>
          <input type="number" id="start" min="0" max="10000000" value="10000" step="500" />
        </div>
        <div class="calc-group">
          <label for="sparplan">Monatliche Einzahlung (€)</label>
          <input type="number" id="sparplan" min="0" max="100000" value="200" step="25" />
        </div>
        <div class="calc-group">
          <label for="zins">Zinssatz (% p. a.)</label>
          <input type="number" id="zins" min="0" max="20" value="2.5" step="0.1" />
        </div>
        <div class="calc-group">
          <label for="jahre">Laufzeit (Jahre)</label>
          <input type="number" id="jahre" min="1" max="60" value="10" step="1" />
        </div>
        <div class="calc-group">
          <label for="pausch">Sparer-Pauschbetrag je Jahr</label>
          <select id="pausch">
            <option value="1000" selected>1.000 € (einzeln)</option>
            <option value="2000">2.000 € (zusammenveranlagt)</option>
            <option value="0">bereits verbraucht</option>
          </select>
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Guthaben nach Steuern</div>
        <div id="endkapital">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So wächst ein Sparguthaben nach Steuern"
    content={guideHtml}
    relatedSlugs={['etf-sparplan-rechner', 'abgeltungsteuer-rechner', 'inflationsrechner']}
  />
</Layout>

<script type="module">
const { sparverlaufMitSteuer } = await import(window.__base + 'scripts/sparen.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = sparverlaufMitSteuer({
    startkapital: wert('start'),
    sparrate: wert('sparplan'),
    zinsProzent: wert('zins'),
    jahre: wert('jahre'),
    pauschbetrag: parseFloat(document.getElementById('pausch').value),
  });
  document.getElementById('endkapital').textContent = eur(r.endkapital);
  document.getElementById('details').innerHTML = [
    `<span>Eingezahlt: <strong>${eur(r.eingezahlt)}</strong></span>`,
    `<span>Zinsen: <strong>${eur(r.zinsenBrutto)}</strong></span>`,
    `<span>Steuer: <strong>${eur(r.steuern)}</strong></span>`,
    `<span>Zinsen nach Steuer: <strong>${eur(r.zinsenNetto)}</strong></span>`,
  ].join('');
}
['start', 'sparplan', 'zins', 'jahre'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('pausch').addEventListener('change', berechne);
berechne();
</script>
