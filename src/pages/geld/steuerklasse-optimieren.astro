---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelSteuerklasse from '../../components/artikel/steuerklasse-wechseln-was-bringt.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { vergleicheKombinationen } from '../../../public/scripts/steuerklassenwahl.js';
import { GRUNDFREIBETRAG } from '../../../public/scripts/einkommensteuer.js';
import {
  SATZ_MIN as ELTERNGELD_SATZ_MIN,
  SATZ_MAX as ELTERNGELD_SATZ_MAX,
  HOECHSTBETRAG as ELTERNGELD_HOECHSTBETRAG,
  berechneElterngeld,
} from '../../../public/scripts/elterngeld.js';
const calc = CALCULATORS.find(c => c.slug === 'steuerklasse-optimieren')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Das Rechenbeispiel im Ratgeber stammt aus demselben Modul wie der Rechner
// oben. Vorher standen dort frei gewählte Zahlen, die zur Rechnung auf der
// Seite nicht passten – und die Rechnung selbst war ebenfalls falsch.
const BEISPIEL_A = 50000;
const BEISPIEL_B = 25000;
const beispiel = vergleicheKombinationen({ bruttoJahrA: BEISPIEL_A, bruttoJahrB: BEISPIEL_B, kinder: 1 });
const euro = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Euro';
const euro0 = (n: number) => Math.round(n).toLocaleString('de-DE') + ' Euro';
const prozent = (n: number) => (n * 100).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' Prozent';

// Der größte Abstand zwischen den Steuerklassen III und V beim Elterngeld wird
// aus dem Rechenmodul gesucht, statt eine gerundete Zahl zu behaupten. Oberhalb
// dieses Punktes schrumpft er wieder, weil Klasse III den Höchstbetrag erreicht.
const elterngeldSpanne = (() => {
  let beste = { brutto: 0, klasse3: 0, klasse5: 0, differenz: 0 };
  for (let brutto = 1000; brutto <= 6000; brutto += 50) {
    const klasse3 = berechneElterngeld({ einnahmenMonat: brutto, steuerklasse: 3 }).basiselterngeld;
    const klasse5 = berechneElterngeld({ einnahmenMonat: brutto, steuerklasse: 5 }).basiselterngeld;
    if (klasse3 - klasse5 > beste.differenz) {
      beste = { brutto, klasse3, klasse5, differenz: klasse3 - klasse5 };
    }
  }
  return beste;
})();
const gfb = GRUNDFREIBETRAG.toLocaleString('de-DE');
const gfbDoppelt = (GRUNDFREIBETRAG * 2).toLocaleString('de-DE');
const beispielZeilen = beispiel.kombinationen.filter(k => k.anwendbar).map(k => {
  const abrechnung = Math.abs(k.differenz) < 1
    ? 'ausgeglichen'
    : (k.differenz > 0 ? `Erstattung ${euro0(k.differenz)}` : `Nachzahlung ${euro0(-k.differenz)}`);
  const name = k.faktorverfahren ? `${k.name} (Faktor ${beispiel.faktor.wert.toLocaleString('de-DE', { minimumFractionDigits: 3 })})` : k.name;
  return `<tr><td>${name}</td><td>${euro(k.partnerA.lohnsteuerMonat)}</td><td>${euro(k.partnerB.lohnsteuerMonat)}</td><td>${euro(k.abzugMonat)}</td><td>${abrechnung}</td></tr>`;
}).join('');
---
<Layout
  title={`Steuerklasse optimieren ${year}`}
  description={`Steuerklassen-Rechner ${year} für Ehepaare: III/V, IV/IV und IV/IV mit Faktor im Vergleich – monatlicher Lohnsteuerabzug und die daraus folgende Nachzahlung oder Erstattung, berechnet nach § 39b und § 39f EStG.`}
  canonicalPath="/geld/steuerklasse-optimieren/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Steuerklasse optimieren {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner vergleicht für Ehepaare und eingetragene Lebenspartner alle Steuerklassen-Kombinationen: Wie viel Lohnsteuer jeder Partner monatlich zahlt und was bei der Steuererklärung als Nachzahlung oder Erstattung übrig bleibt. Die Jahressteuer selbst steht dabei fest – sie hängt nicht von der Steuerklasse ab."
    sourceNote={`Lohnsteuerabzug nach § 39b Abs. 2 EStG, Splittingverfahren nach § 32a Abs. 5 EStG, Faktor nach § 39f EStG, Solidaritätszuschlag mit Kinderfreibeträgen nach § 3 Abs. 2 und 2a SolzG, Beitragssätze ${year}. Angenommen: keine Kirchensteuer, keine Freibeträge nach § 39a EStG, keine weiteren Einkünfte. Wechsel, Trennung und Elterngeld nach §§ 26, 38b, 39 EStG und §§ 2b, 2c BEEG, Wortlaut abgerufen am 16.09.2026.`}
    explanation="Die Steuerklassenwahl verändert die Jahressteuer des Paares nicht, sondern nur, wie viel davon monatlich einbehalten wird. Bei III/V und bei IV mit Faktor ist die Einkommensteuererklärung Pflicht (§ 46 Abs. 2 Nr. 3a EStG). Ehegatten können die Änderung der Steuerklassen im Laufe des Jahres beantragen; sie wirkt ab dem folgenden Monat, und für das laufende Jahr muss der Antrag bis zum 30. November gestellt sein (§ 39 Abs. 6 EStG)." faqs={[
      { q: "Welche Steuerklassen-Kombinationen gibt es für Ehepaare?", a: "Ehegatten – und nach § 2 Abs. 8 EStG ebenso eingetragene Lebenspartner – wählen zwischen IV/IV, III/V und IV/IV mit Faktor (§ 38b Abs. 1 Satz 2 Nr. 4 und 5, § 39f EStG). Die Klassen III und IV setzen unter anderem voraus, dass die Ehegatten nicht dauernd getrennt leben. Unverheiratete Paare können keine dieser Kombinationen wählen." },
      { q: "Wann lohnt sich die Kombination III/V?", a: "Das hängt vom Verhältnis der beiden Löhne ab – der Rechner zeigt für Ihre Werte, wie viel monatlich einbehalten wird und was bei der Erklärung übrig bleibt. Klasse III rechnet mit dem Splittingtarif, Klasse V mit der Sonderformel des § 39b Abs. 2 Satz 7 EStG. Weil der Abzug nicht an der gemeinsamen Jahressteuer ausgerichtet ist, kann eine Nachzahlung entstehen; die Erklärung ist bei III/V Pflicht (§ 46 Abs. 2 Nr. 3a EStG)." },
      { q: "Wie wechsle ich die Steuerklasse?", a: "Ehegatten beantragen die Änderung beim Finanzamt (§ 39 Abs. 6 Satz 3 EStG). Das Finanzamt ändert die Steuerklassen mit Wirkung vom Beginn des Monats, der auf den Antrag folgt. Soll die Änderung noch im laufenden Jahr wirken, muss der Antrag spätestens am 30. November gestellt sein (§ 39 Abs. 6 Satz 5 und 6 EStG)." },
      { q: "Was ist die Steuerklasse IV mit Faktor?", a: "Beide Ehegatten bleiben in Klasse IV, ihre Lohnsteuer wird aber mit dem Faktor Y : X multipliziert. Y ist die voraussichtliche Einkommensteuer beider Ehegatten im Splittingverfahren, X die Summe ihrer Lohnsteuer in Klasse IV (§ 39f Abs. 1 Satz 3 und 4 EStG). So richtet sich der Abzug an der gemeinsamen Jahressteuer aus. Das Finanzamt bildet den Faktor nur, wenn er kleiner als 1 ist; er gilt bis zum Ende des Jahres, das auf das Jahr folgt, in dem er erstmals gilt oder zuletzt geändert wurde (Satz 9)." },
      { q: "Beeinflusst die Steuerklasse mein Elterngeld oder Arbeitslosengeld?", a: "Ja. Maßgeblich ist nicht das Netto der Gehaltsabrechnung, sondern ein pauschalierter Nettobetrag: beim Arbeitslosengeld und Kurzarbeitergeld das Leistungsentgelt nach § 153 SGB III, beim Elterngeld das Einkommen nach den §§ 2c bis 2f BEEG. In beide geht die Steuerklasse ein. Beim Elterngeld zählt eine geänderte Steuerklasse nur, wenn sie in der überwiegenden Zahl der Kalendermonate des Bemessungszeitraums galt (§ 2c Abs. 3 Satz 2 BEEG). Der Bemessungszeitraum sind grundsätzlich die zwölf Kalendermonate vor dem Monat der Geburt (§ 2b Abs. 1 Satz 1 BEEG) – die neue Klasse muss also in mindestens sieben davon gegolten haben." },
      { q: "Was passiert mit der Steuerklasse bei Trennung?", a: "Zusammen veranlagt werden können Ehegatten, wenn die Voraussetzungen – darunter, dass sie nicht dauernd getrennt leben – zu Beginn des Jahres vorlagen oder im Laufe des Jahres eingetreten sind (§ 26 Abs. 1 EStG); im Jahr der Trennung ist das also noch möglich. Fallen die Voraussetzungen für eine günstigere Steuerklasse weg, muss der Arbeitnehmer das dem Finanzamt mitteilen und die Steuerklasse ändern lassen. Tut er das nicht, ändert das Finanzamt sie von Amts wegen (§ 39 Abs. 5 EStG)." },
      { q: "Gibt es die Kombination III/V noch?", a: "Ja. In der am 16.09.2026 abgerufenen Fassung sieht § 38b Abs. 1 Satz 2 Nr. 5 EStG die Steuerklasse V für Ehegatten weiterhin vor, deren Partner auf gemeinsamen Antrag in Klasse III eingereiht ist. Ändert der Gesetzgeber das, wird der Rechner angepasst." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="einkommen1">Einkommen Partner 1 (€/Jahr)</label>
          <input type="number" id="einkommen1" min="0" max="500000" value="45000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="einkommen2">Einkommen Partner 2 (€/Jahr)</label>
          <input type="number" id="einkommen2" min="0" max="500000" value="25000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="kinder">Kinder unter 25 Jahren</label>
          <select id="kinder">
            <option value="0">keine</option>
            <option value="1" selected>1 Kind</option>
            <option value="2">2 Kinder</option>
            <option value="3">3 Kinder</option>
            <option value="4">4 Kinder</option>
            <option value="5">5 Kinder oder mehr</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="kfb">Gemeinsame Kinder mit Kinderfreibetrag (für den Soli)</label>
          <input type="number" id="kfb" min="0" max="20" value="0" step="1" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Voraussichtliche Jahressteuer des Paares</div>
        <div id="jahressteuer">— €</div>
      </div>
      <p class="hinweis">Dieser Betrag ändert sich durch die Steuerklassenwahl <strong>nicht</strong>. Die Steuerklasse bestimmt nur, wie viel davon monatlich einbehalten wird – der Rest kommt als Nachzahlung oder Erstattung zurück.</p>
      <div id="tabelle"></div>
    </div>

    <ArtikelSteuerklasse slot="artikel" />
  </CalculatorShell>
</Layout>

<style>
.hinweis { font-size: 0.85rem; color: var(--muted); margin: 0.5rem 0 1rem; }
.kombi-table { width:100%; border-collapse:collapse; font-size:0.88rem; margin-top:0.5rem; }
.kombi-table th { text-align:left; font-weight:600; font-size:0.78rem; color:var(--muted); padding:0.4rem 0.6rem; border-bottom:2px solid var(--border); text-transform:uppercase; letter-spacing:0.04em; }
.kombi-table td { padding:0.55rem 0.6rem; border-bottom:1px solid var(--border); }
.kombi-table td:not(:first-child) { text-align:right; }
.kombi-table tr.empfohlen td { background:color-mix(in srgb, var(--accent) 6%, white); font-weight:600; }
.kombi-table tr:last-child td { border-bottom:none; }
.nachzahlung { color:#c8102e; }
.erstattung { color:#1e7e34; }
</style>

<script type="module">
const { vergleicheKombinationen } = await import(window.__base + 'scripts/steuerklassenwahl.js');

function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' \u20ac'; }
function fmt0(n) { return Math.round(n).toLocaleString('de-DE') + ' \u20ac'; }

function berechne() {
  const bruttoJahrA = parseFloat(document.getElementById('einkommen1').value) || 0;
  const bruttoJahrB = parseFloat(document.getElementById('einkommen2').value) || 0;
  const kinder = parseInt(document.getElementById('kinder').value) || 0;
  const kinderfreibetraege = Math.max(0, Math.floor(Number(document.getElementById('kfb').value) || 0));

  const { jahressteuer, faktor, kombinationen } = vergleicheKombinationen({ bruttoJahrA, bruttoJahrB, kinder, kinderfreibetraege });

  document.getElementById('jahressteuer').textContent = fmt(jahressteuer.gesamt);

  // Empfohlen ist die Kombination, die der Jahressteuer am n\u00e4chsten kommt:
  // Sie vermeidet sowohl Nachzahlung als auch ein zinsloses Darlehen ans Finanzamt.
  const waehlbar = kombinationen.filter(k => k.anwendbar);
  const beste = waehlbar.reduce((a, b) => Math.abs(a.differenz) <= Math.abs(b.differenz) ? a : b, waehlbar[0]);

  document.getElementById('tabelle').innerHTML =
    `<table class="kombi-table">
      <thead><tr>
        <th>Kombination</th><th>Abzug Partner 1</th><th>Abzug Partner 2</th><th>Abzug gesamt/Monat</th><th>Bei der Steuererkl\u00e4rung</th>
      </tr></thead><tbody>` +
    kombinationen.map(k => {
      if (!k.anwendbar) {
        return `<tr><td>${k.name}</td><td colspan="4" style="text-align:left;color:var(--muted);">Nicht m\u00f6glich \u2013 das Finanzamt bildet den Faktor nur, wenn er kleiner als 1 ist (\u00a7 39f Abs. 1 Satz 1 EStG).</td></tr>`;
      }
      const d = k.differenz;
      const text = Math.abs(d) < 1
        ? 'ausgeglichen'
        : (d > 0 ? `Erstattung ${fmt0(d)}` : `Nachzahlung ${fmt0(-d)}`);
      const klasse = Math.abs(d) < 1 ? '' : (d > 0 ? 'erstattung' : 'nachzahlung');
      const name = k.faktorverfahren ? `${k.name} (${faktor.wert.toLocaleString('de-DE', {minimumFractionDigits:3})})` : k.name;
      return `<tr class="${k === beste ? 'empfohlen' : ''}">
        <td>${name}</td>
        <td>${fmt(k.partnerA.lohnsteuerMonat + k.partnerA.soliJahr / 12)}</td>
        <td>${fmt(k.partnerB.lohnsteuerMonat + k.partnerB.soliJahr / 12)}</td>
        <td>${fmt(k.abzugMonat)}</td>
        <td class="${klasse}">${text}</td>
      </tr>`;
    }).join('') +
    `</tbody></table>`;
}

['einkommen1','einkommen2','kinder','kfb'].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
berechne();
</script>
