---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'trinkgeld-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Trinkgeld-Rechner ${year}`}
  description="Trinkgeld-Rechner: Angemessenes Trinkgeld berechnen fuer Restaurant, Friseur, Taxi und Lieferdienst. Uebliche Saetze in Deutschland (5-15%) mit Vergleichstabelle nach Branche und Land."
  canonicalPath="/geld/trinkgeld-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}geld/`} class="back-link">← Geld &amp; Gehalt</a>
    <h1>Trinkgeld-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Trinkgeld-Rechner finden Sie schnell heraus, wie viel Trinkgeld in verschiedenen Situationen üblich und angemessen ist. Wählen Sie den Anlass und die Servicequalität und erhalten Sie einen passenden Vorschlag."
    sourceNote="Trinkgeld ist freiwillig."
    explanation="In Deutschland ist Trinkgeld freiwillig und steuerfrei für den Empfänger (§ 3 Nr. 51 EStG). Übliche Sätze liegen bei 5-10% im Restaurant, 10% bei gutem Service und 15-20% bei herausragendem Service. Bar geben ist bevorzugt, da es direkt beim Personal ankommt."
    faqs={[
      { q: "Wie viel Trinkgeld ist üblich?", a: "10% im Restaurant, 5% beim Friseur, 5-10€ beim Lieferdienst, 1-2€ pro Getränk an der Bar." },
      { q: "Muss man Trinkgeld geben?", a: "Nein, Trinkgeld ist in Deutschland freiwillig. Es besteht keine Pflicht, aber es ist eine schöne Geste für guten Service." },
      { q: "Trinkgeld mit Karte oder bar?", a: "Bar wird bevorzugt, da die Mitarbeiter es direkt bekommen. Mit Karte kann man auch ein Trinkgeld hinzufügen, das dann meist direkt an den Mitarbeiter geht." },
      { q: "Ist Trinkgeld in anderen Ländern höher oder niedriger?", a: "Sehr unterschiedlich: USA 15-20% (fast Pflicht), Großbritannien 10-15%, Südeuropa 5%, Skandinavien oft nicht üblich. Deutschland ist mit 5-10% im unteren Bereich." },
      { q: "Wie berechne ich Trinkgeld bei Bargeldlos-Zahlung korrekt?", a: "Manche Karten-Terminals fragen direkt nach Trinkgeld – dann einfach den Betrag eingeben. Manche Restaurants schreiben die Rechnung ohne Trinkgeld – dann können Sie es bar hinzufügen oder später an den Server zahlen." },
      { q: "Muss ich auf Trinkgeld Steuern zahlen?", a: "Nein. Trinkgeld ist fuer Arbeitnehmer steuerfrei und sozialabgabenfrei gemaess Paragraph 3 Nr. 51 EStG – sofern es freiwillig vom Kunden gezahlt wird und direkt an den Mitarbeiter geht. Nur wenn der Arbeitgeber Trinkgeld verteilt (z.B. Poolsystem vom Chef organisiert), kann es steuerpflichtig werden." },
      { q: "Wie viel Trinkgeld gebe ich bei einer grossen Gruppe?", a: "Bei Gruppen ab 6 Personen ist 10-15% angemessen, da der Serviceaufwand hoeher ist. Manche Restaurants berechnen automatisch einen Servicezuschlag von 10-15% bei Gruppen. Pruefen Sie die Rechnung – ist bereits ein Zuschlag enthalten, ist zusaetzliches Trinkgeld optional (1-2 Euro pro Person als Extra)." },
      { q: "Soll ich Trinkgeld auf den Netto- oder Bruttobetrag berechnen?", a: "In Deutschland berechnet man Trinkgeld immer auf den Gesamtbetrag der Rechnung (also inklusive Mehrwertsteuer). Bei einer Rechnung von 45 Euro sind 10% Trinkgeld = 4,50 Euro, Gesamtzahlung also 49,50 Euro. Das Aufrunden auf 50 Euro ist eine gaengige Praxis." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="rechnung">Rechnungsbetrag (€)</label>
          <input type="number" id="rechnung" min="1" max="10000" value="45" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="prozent">Trinkgeld (%)</label>
          <input type="number" id="prozent" min="0" max="30" value="10" step="1" />
        </div>
      </div>

      <div class="presets" style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.75rem;">
        <span style="font-size:0.82rem;color:var(--muted);align-self:center;">Schnell:</span>
        <button class="preset-btn" data-p="5">5%</button>
        <button class="preset-btn" data-p="10">10%</button>
        <button class="preset-btn" data-p="15">15%</button>
        <button class="preset-btn" data-p="20">20%</button>
      </div>

      <div class="calc-result">
        <div class="label">Trinkgeld</div>
        <div id="trinkgeld">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

<script type="module">
function berechne() {
  const rechnung = parseFloat(document.getElementById('rechnung').value)||45;
  const prozent = parseFloat(document.getElementById('prozent').value)||10;
  const trinkgeld = rechnung * (prozent / 100);
  const gesamt = rechnung + trinkgeld;
  document.getElementById('trinkgeld').textContent = trinkgeld.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
  document.getElementById('details').innerHTML =
    `<span>Rechnung: <strong>${rechnung.toLocaleString('de-DE')} €</strong></span>` +
    `<span>Trinkgeld: <strong>${trinkgeld.toLocaleString('de-DE')} €</strong></span>` +
    `<span>Gesamt: <strong>${gesamt.toLocaleString('de-DE')} €</strong></span>`;
  document.querySelectorAll('.preset-btn').forEach(b =>
    b.classList.toggle('active', parseFloat(b.dataset.p) === prozent));
}
['rechnung','prozent'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
document.querySelectorAll('.preset-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.getElementById('prozent').value = b.dataset.p;
    berechne();
  });
});
berechne();
</script>

<style>
.preset-btn {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 20px;
  padding: 0.25rem 0.75rem;
  font-size: 0.8rem;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
  font-family: var(--font-ui);
  color: var(--text);
}
.preset-btn:hover, .preset-btn.active {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 8%, white);
  color: var(--accent);
}
</style>

  <CalculatorGuide
    title="Trinkgeld-Rechner – Faire Vergütung berechnen"
    content={`
      <p><strong>Trinkgeld</strong> ist eine freiwillige, zusaetzliche Zahlung an Servicepersonal als Anerkennung fuer guten Service. In Deutschland ist Trinkgeld ein bewaehrtes Konzept, aber anders als in den USA nicht verpflichtend. Der Trinkgeld-Rechner hilft Ihnen, schnell und fair zu berechnen, wie viel Trinkgeld in verschiedenen Situationen angemessen ist.</p>

      <p><strong>Rechtlicher Hintergrund:</strong> Trinkgeld ist fuer Arbeitnehmer steuerfrei (Paragraph 3 Nr. 51 EStG), sofern es freiwillig vom Gast gegeben wird. Der Arbeitgeber darf Trinkgeld nicht auf den Mindestlohn anrechnen. Seit Januar 2026 liegt der gesetzliche Mindestlohn bei 13,90 Euro je Stunde (Fünfte Mindestlohnanpassungsverordnung) – Trinkgeld kommt immer obendrauf.</p>

      <h4>Trinkgeld-Empfehlung nach Branche</h4>
      <table>
        <thead>
          <tr><th>Branche</th><th>Ueblicher Satz</th><th>Minimum</th><th>Bei sehr gutem Service</th><th>Beispiel (Rechnung 50 Euro)</th></tr>
        </thead>
        <tbody>
          <tr><td>Restaurant</td><td>5-10%</td><td>1-2 Euro</td><td>15%</td><td>5,00 Euro</td></tr>
          <tr><td>Cafe/Bar</td><td>5-10%</td><td>0,50-1 Euro</td><td>10-15%</td><td>3,00 Euro</td></tr>
          <tr><td>Friseur</td><td>5-10%</td><td>1-2 Euro</td><td>10-15%</td><td>3,50 Euro</td></tr>
          <tr><td>Taxi</td><td>5-10%</td><td>Aufrunden</td><td>10-15%</td><td>5,00 Euro</td></tr>
          <tr><td>Lieferdienst</td><td>5-10%</td><td>1-2 Euro</td><td>3-5 Euro</td><td>2,50 Euro</td></tr>
          <tr><td>Hotel (pro Nacht)</td><td>Pauschal</td><td>1 Euro</td><td>2-5 Euro</td><td>2,00 Euro</td></tr>
          <tr><td>Handwerker</td><td>Nicht ueblich</td><td>–</td><td>5-10 Euro</td><td>–</td></tr>
          <tr><td>Kosmetik/Massage</td><td>5-10%</td><td>2 Euro</td><td>10-15%</td><td>5,00 Euro</td></tr>
        </tbody>
      </table>

      <h4>Trinkgeld im internationalen Vergleich</h4>
      <table>
        <thead>
          <tr><th>Land</th><th>Ueblicher Satz</th><th>Pflicht?</th><th>Besonderheiten</th></tr>
        </thead>
        <tbody>
          <tr><td>Deutschland</td><td>5-10%</td><td>Nein</td><td>Bar bevorzugt, steuerfrei</td></tr>
          <tr><td>USA</td><td>15-25%</td><td>De facto ja</td><td>Servicekraefte verdienen unter Mindestlohn</td></tr>
          <tr><td>Grossbritannien</td><td>10-15%</td><td>Nein</td><td>Oft als Service Charge auf Rechnung</td></tr>
          <tr><td>Frankreich</td><td>5-10%</td><td>Nein</td><td>Service compris (im Preis enthalten)</td></tr>
          <tr><td>Italien</td><td>5-10%</td><td>Nein</td><td>Coperto (Gedeck) statt Trinkgeld</td></tr>
          <tr><td>Japan</td><td>0%</td><td>–</td><td>Trinkgeld gilt als Beleidigung</td></tr>
          <tr><td>Skandinavien</td><td>0-5%</td><td>Nein</td><td>Im Gehalt eingerechnet</td></tr>
          <tr><td>Tuerkei</td><td>10-15%</td><td>Nein</td><td>Erwartet in Restaurants</td></tr>
          <tr><td>Oesterreich</td><td>5-10%</td><td>Nein</td><td>Aehnlich wie Deutschland</td></tr>
        </tbody>
      </table>

      <h4>Wann sollte ich mehr oder weniger geben?</h4>
      <p><strong>Mehr Trinkgeld (10-15%):</strong> Aussergewoehnlich freundlicher Service, besondere Wuensche wurden erfuellt, grosser Ansturm im Lokal, komplexe Bestellung korrekt geliefert, regelmaessiger Stammgast.</p>
      <p><strong>Weniger oder kein Trinkgeld:</strong> Unhoefliches Verhalten, extrem lange Wartezeit ohne Erklaerung, fehlerhafte Bestellung die nicht korrigiert wird. Wichtig: Trinkgeld bezieht sich auf den Service, nicht auf die Qualitaet des Essens (dafuer ist die Kueche verantwortlich).</p>

      <h4>Trinkgeld bargeldlos oder bar?</h4>
      <p>In Deutschland ist Bargeld fuer Trinkgeld nach wie vor die Norm. Vorteile von Bar-Trinkgeld: Der Mitarbeiter erhaelt es sofort und direkt. Bei Kartenzahlung gibt es drei Optionen: (1) Gesamtbetrag inkl. Trinkgeld auf der Karte zahlen, (2) Rechnung mit Karte, Trinkgeld bar, oder (3) am Terminal den Trinkgeld-Betrag eingeben wenn abgefragt. Option 2 ist die sicherste Variante, dass das Trinkgeld beim Mitarbeiter ankommt.</p>

      <h4>Praktische Tipps zum Aufrunden</h4>
      <p>Die einfachste Methode: Runden Sie auf den naechsten vollen Euro-Betrag auf und addieren Sie je nach Zufriedenheit 1-5 Euro. Beispiel: Rechnung 37,80 Euro, aufrunden auf 40 Euro (= 2,20 Euro Trinkgeld / 5,8%). Bei hoeheren Rechnungen (ueber 100 Euro) rechnen Sie besser mit Prozent statt aufzurunden.</p>
    `}
    relatedSlugs={['rabatt-rechner', 'kreditvergleich']}
  />
</Layout>
