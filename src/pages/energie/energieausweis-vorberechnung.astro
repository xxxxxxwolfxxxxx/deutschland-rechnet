---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  EFFIZIENZKLASSEN,
  NUTZFLAECHE_FAKTOR,
  ZUSCHLAG_DEZENTRALES_WARMWASSER,
} from '../../../public/scripts/jahresenergie.js';
import {
  ABRECHNUNGSJAHRE,
  EMISSIONSFAKTOREN_G_JE_KWH,
  FERNWAERME_RUECKFALL,
  HEIZWERT_ERDGAS_H_KWH_JE_M3,
  HEIZWERT_ERDGAS_L_KWH_JE_M3,
  HEIZWERT_HEIZOEL_EL_KWH_JE_LITER,
  VERBRAUCH_TRAEGER,
  ausweisPflicht,
  verbrauchskennwert,
} from '../../../public/scripts/energieausweis.js';
const calc = CALCULATORS.find(c => c.slug === 'energieausweis-vorberechnung')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

const dez = (n: number, s = 2) => n.toLocaleString('de-DE', { minimumFractionDigits: s, maximumFractionDigits: s });
const tsd = (n: number) => n.toLocaleString('de-DE');

// Beispiel: drei Gasabrechnungen, 100 m² Wohnfläche. Einmal als Wohnung
// (Faktor 1,2), einmal als Einfamilienhaus mit beheiztem Keller (1,35).
const BSP_JAHRE = [14000, 13000, 12000];
const bspWohnung = verbrauchskennwert({ traeger: 'gas', jahresmengen: BSP_JAHRE, wohnflaeche: 100 });
const bspHaus = verbrauchskennwert({ traeger: 'gas', jahresmengen: BSP_JAHRE, wohnflaeche: 100, mitBeheiztemKeller: true });

// Kernaussagen der Seite absichern: Klassen nach Anlage 10 bis H, Beispiel
// nach § 82 Abs. 2, Ausweisart nach § 80 Abs. 3.
const letzteKlassen = EFFIZIENZKLASSEN.slice(-2);
if (
  EFFIZIENZKLASSEN.length !== 9 || EFFIZIENZKLASSEN[0].klasse !== 'A+' || EFFIZIENZKLASSEN[0].bis !== 30 ||
  letzteKlassen[0].klasse !== 'G' || letzteKlassen[0].bis !== 250 || letzteKlassen[1].klasse !== 'H'
) {
  throw new Error('Energieausweis: Effizienzklassen weichen von Anlage 10 GModG ab');
}
if (!bspWohnung || !bspHaus || bspWohnung.kwhJeQm !== 108 || bspWohnung.klasse !== 'D' || bspHaus.kwhJeQm !== 96 || bspHaus.klasse !== 'C') {
  throw new Error('Energieausweis: Beispiel widerspricht § 82 Abs. 2 GModG oder Anlage 10');
}
if (
  ausweisPflicht({ wohnungen: 2, bauantragVor1977: true, waermeschutz1977: 'nein' })?.art !== 'bedarf' ||
  ausweisPflicht({ wohnungen: 2, bauantragVor1977: true, waermeschutz1977: 'ja' })?.art !== 'wahl' ||
  ausweisPflicht({ wohnungen: 5, bauantragVor1977: true, waermeschutz1977: 'nein' })?.art !== 'wahl'
) {
  throw new Error('Energieausweis: Ausweisart widerspricht § 80 Abs. 3 GModG');
}

const klassenZeilen = EFFIZIENZKLASSEN.map((k, i) => {
  const von = i === 0 ? '' : 'über ' + EFFIZIENZKLASSEN[i - 1].bis + ' ';
  const bis = Number.isFinite(k.bis) ? 'bis ' + k.bis : '';
  return '<tr><td>' + k.klasse + '</td><td>' + (von + bis).trim() + '</td></tr>';
}).join('');
const klassenText = EFFIZIENZKLASSEN.map((k, i) =>
  Number.isFinite(k.bis) ? k.klasse + ' bis ' + k.bis : k.klasse + ' über ' + EFFIZIENZKLASSEN[i - 1].bis
).join(', ');

const faktorGas = dez(EMISSIONSFAKTOREN_G_JE_KWH.erdgas / 1000, 2);
const faktorStrom = EMISSIONSFAKTOREN_G_JE_KWH.stromNetzbezogen;
const faktorFernwaerme = EMISSIONSFAKTOREN_G_JE_KWH[FERNWAERME_RUECKFALL];

const guideHtml = `
<h3>Was der Rechner rechnet</h3>
<p>Ein Energieverbrauchsausweis gibt den Endenergieverbrauch für Heizung und Warmwasser in Kilowattstunden je Quadratmeter Gebäudenutzfläche und Jahr an (§ 82 Abs. 2 GModG). Grundlage sind Abrechnungen aus mindestens 36 zusammenhängenden Monaten, deren Ende nicht mehr als 18 Monate zurückliegen darf (§ 82 Abs. 4 GModG). Setzt man die 36 Monate aus Jahresabrechnungen zusammen, ist der Wert der Durchschnitt aus drei Jahreswerten – so regelt es die Bekanntmachung der Regeln für Energieverbrauchswerte im Wohngebäudebestand vom 29. März 2021, Nr. 2. Genau diese drei Jahreswerte fragt der Rechner ab.</p>
<p>Die Gebäudenutzfläche ist größer als die Wohnfläche. Ist sie nicht bekannt, darf sie bei Wohngebäuden mit bis zu zwei Wohneinheiten und beheiztem Keller mit dem ${dez(NUTZFLAECHE_FAKTOR.mitBeheiztemKeller)}-Fachen, sonst mit dem ${dez(NUTZFLAECHE_FAKTOR.sonstige, 1)}-Fachen der Wohnfläche angesetzt werden. Wird das Warmwasser dezentral erzeugt und ist dessen Verbrauch nicht bekannt, kommen ${ZUSCHLAG_DEZENTRALES_WARMWASSER} kWh je Quadratmeter hinzu.</p>
<p>Ein Beispiel: ${tsd(BSP_JAHRE[0])}, ${tsd(BSP_JAHRE[1])} und ${tsd(BSP_JAHRE[2])} kWh Gas bei 100 m² Wohnfläche ergeben im Mittel ${tsd(bspWohnung.mittelKwh)} kWh. In einem Mehrfamilienhaus sind das ${bspWohnung.kwhJeQm} kWh/m² und Klasse ${bspWohnung.klasse}, im Einfamilienhaus mit beheiztem Keller ${bspHaus.kwhJeQm} kWh/m² und Klasse ${bspHaus.klasse}.</p>

<h3>Die Effizienzklassen</h3>
<p>Die Klasse ergibt sich unmittelbar aus dem Endenergieverbrauch oder Endenergiebedarf (§ 86 Abs. 2 GModG), nicht aus der Primärenergie und nicht aus dem Energieträger. Die Grenzen stehen in Anlage 10:</p>
<table>
<thead><tr><th>Klasse</th><th>kWh je m² Gebäudenutzfläche und Jahr</th></tr></thead>
<tbody>${klassenZeilen}</tbody>
</table>

<h3>Warum das Ergebnis kein Ausweiswert ist</h3>
<p><strong>Witterung:</strong> Der Heizverbrauch ist einer Witterungsbereinigung zu unterziehen (§ 82 Abs. 3 GModG). Die Bekanntmachung rechnet dazu mit Klimafaktoren je Postleitzahl, bezogen auf den Referenzstandort Potsdam. Nach einem kalten Winter liegt der Rechner deshalb über, nach einem milden unter dem Ausweiswert.</p>
<p><strong>Brennwert und Heizwert:</strong> Verbrauchsangaben, die sich auf den Brennwert beziehen, sind nach Nr. 2 der Bekanntmachung auf den unteren Heizwert umzurechnen; den Faktor legt DIN V 18599-1 Tabelle B.1 fest. Wird Ihr Gas nach Brennwert abgerechnet, ist der Ausweiswert kleiner als die Kilowattstunden auf der Rechnung. Tragen Sie Gas in Kilowattstunden ein, nimmt der Rechner die Rechnungswerte unverändert und liegt entsprechend zu hoch. Die Bekanntmachung lässt aber einen zweiten Weg zu: die verbrauchte Brennstoffmenge mit dem Heizwert nach § 9 Abs. 3 der Heizkostenverordnung umrechnen. Wählen Sie dazu Erdgas H oder Erdgas L und tragen Sie die Kubikmeter ein – der Rechner setzt ${HEIZWERT_ERDGAS_H_KWH_JE_M3} kWh je m³ für Erdgas H und ${HEIZWERT_ERDGAS_L_KWH_JE_M3} kWh je m³ für Erdgas L an. Welche Gasart Sie beziehen, nennt Ihnen im Zweifel der Versorger. Weist Ihre Abrechnung einen Heizwert aus, ist nach der Bekanntmachung dieser zu verwenden. Heizöl rechnet der Rechner mit ${HEIZWERT_HEIZOEL_EL_KWH_JE_LITER} kWh je Liter um, dem Heizwert für Heizöl EL nach derselben Vorschrift.</p>
<p><strong>Primärenergie und Leerstand:</strong> Der Ausweis nennt auch den Primärenergieverbrauch, berechnet mit den Primärenergiefaktoren nach § 22 GModG, und korrigiert längere Leerstände. Beides bildet der Rechner nicht nach.</p>

<h3>Treibhausgasemissionen</h3>
<p>Der Energieausweis weist auch die Treibhausgasemissionen in Kilogramm CO₂-Äquivalent je Quadratmeter und Jahr aus (§ 85 Abs. 6 GModG). Beim Verbrauchsausweis ist das der Verbrauch je Energieträger mal dem Emissionsfaktor aus Anlage 9 – für Erdgas ${faktorGas} kg je kWh, für netzbezogenen Strom ${faktorStrom} g. Für Fernwärme unterstellt der Rechner ${faktorFernwaerme} g je kWh (Kraft-Wärme-Kopplung mit gasförmigen oder flüssigen Brennstoffen); Ihr Versorger kennt den Wert für Ihr Netz.</p>

<h3>Bedarfs- oder Verbrauchsausweis?</h3>
<p>Wird ein Gebäude oder eine Wohnung verkauft, vermietet, verpachtet oder verleast, ist ein Energieausweis auszustellen, wenn nicht schon ein gültiger vorliegt (§ 80 Abs. 3 Satz 1 GModG). Für Wohngebäude mit weniger als fünf Wohnungen, deren Bauantrag vor dem 1. November 1977 gestellt wurde, muss es ein Energiebedarfsausweis sein (Satz 2). Das gilt nicht, wenn das Gebäude schon bei Fertigstellung das Anforderungsniveau der Wärmeschutzverordnung vom 11. August 1977 erfüllt hat oder später mindestens darauf gebracht wurde (Satz 3). Auf Baudenkmäler ist § 80 Abs. 3 bis 7 nicht anzuwenden (§ 79 Abs. 4).</p>

<h3>Vorlegen, übergeben, inserieren</h3>
<p>Verkäufer oder Makler müssen den Ausweis oder eine Kopie spätestens bei der Besichtigung vorlegen – ein deutlich sichtbarer Aushang genügt – und nach Abschluss des Kaufvertrags unverzüglich übergeben (§ 80 Abs. 4 GModG). Für Vermietung, Verpachtung und Leasing gilt das entsprechend (§ 80 Abs. 5). Liegt beim Aufgeben einer Immobilienanzeige in kommerziellen Medien ein Ausweis vor, muss die Anzeige die Ausweisart, den Endenergiewert, die wesentlichen Energieträger der Heizung und bei Wohngebäuden Baujahr und Effizienzklasse nennen (§ 87 Abs. 1). Ein Energieausweis gilt zehn Jahre (§ 79 Abs. 3).</p>
`;

const faqs = [
  { q: 'Welche Energieeffizienzklassen gibt es?', a: `Anlage 10 GModG kennt neun Klassen, in kWh je Quadratmeter Gebäudenutzfläche und Jahr: ${klassenText}. Maßgeblich ist die Endenergie (§ 86 Abs. 2 GModG).` },
  { q: 'Warum fragt der Rechner drei Jahre ab?', a: 'Weil der Verbrauchsausweis Abrechnungen aus mindestens 36 zusammenhängenden Monaten verlangt, deren Ende höchstens 18 Monate zurückliegt (§ 82 Abs. 4 GModG). Aus drei Jahresabrechnungen wird der Durchschnitt gebildet. Mit weniger Jahren rechnet der Rechner auch, weist aber darauf hin.' },
  { q: 'Ist das Ergebnis mein Energieausweis-Wert?', a: 'Nein. Der Ausweis bereinigt den Heizverbrauch um die Witterung (§ 82 Abs. 3 GModG), rechnet brennwertbezogene Gasmengen auf den Heizwert um und berücksichtigt längere Leerstände. Der Rechner zeigt den Wert vor diesen Korrekturen.' },
  { q: 'Wann brauche ich einen Bedarfsausweis?', a: 'Bei Wohngebäuden mit weniger als fünf Wohnungen, deren Bauantrag vor dem 1. November 1977 gestellt wurde (§ 80 Abs. 3 Satz 2 GModG) – außer das Gebäude erreicht das Niveau der Wärmeschutzverordnung von 1977, von Anfang an oder durch spätere Modernisierung (Satz 3).' },
  { q: 'Wer darf einen Energieausweis ausstellen?', a: 'Die Berechtigten nennt § 88 GModG, unter den dort genannten Voraussetzungen unter anderem Personen, die nach Bauordnungsrecht Wärmeschutznachweise unterzeichnen dürfen, Hochschulabsolventen bestimmter technischer oder naturwissenschaftlicher Fachrichtungen, Handwerksmeister, staatlich anerkannte oder geprüfte Techniker und Energieberater mit Qualifikationsprüfung des BAFA.' },
  { q: 'Warum weist der Rechner für eine Wärmepumpe so viel CO₂ je kWh aus?', a: `Weil der Energieausweis mit dem gesetzlichen Faktor für netzbezogenen Strom rechnet: ${faktorStrom} g CO₂-Äquivalent je kWh nach Anlage 9 GModG, veröffentlicht 2020. Der Vorteil der Wärmepumpe steckt im Verbrauch: Sie braucht für dieselbe Wärme weniger Kilowattstunden als ein Kessel.` },
  { q: 'Was muss in einer Immobilienanzeige stehen?', a: 'Liegt ein Energieausweis vor, nach § 87 Abs. 1 GModG: die Art des Ausweises, der Wert des Endenergiebedarfs oder -verbrauchs, die wesentlichen Energieträger der Heizung und bei Wohngebäuden das Baujahr und die Effizienzklasse.' },
];

const traegerOptionen = Object.entries(VERBRAUCH_TRAEGER).map(([wert, t]) => ({ wert, text: t.label + ' (' + t.einheit + ')' }));
const jahrFelder = Array.from({ length: ABRECHNUNGSJAHRE }, (_, i) => ({ id: 'jahr' + (i + 1), nr: i + 1, wert: BSP_JAHRE[i] }));
---
<Layout
  title={`Energieausweis-Vorberechnung ${year}`}
  description="Verbrauchskennwert und Effizienzklasse aus drei Heizabrechnungen nach § 82 GModG und Anlage 10 vorab berechnen – und prüfen, ob ein Bedarfsausweis Pflicht ist."
  canonicalPath="/energie/energieausweis-vorberechnung/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Energieausweis-Vorberechnung {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Tragen Sie den Heizverbrauch aus Ihren letzten drei Jahresabrechnungen ein. Der Rechner zeigt Kennwert, Effizienzklasse und CO₂-Emissionen so, wie sie ein Energieverbrauchsausweis ermittelt – nur ohne Witterungsbereinigung. Darunter prüfen Sie, ob für Ihr Haus ein Bedarfsausweis vorgeschrieben ist."
    sourceNote={`Kennwert nach § 82 Abs. 2 und 4 GModG und Nr. 2 der Bekanntmachung der Regeln für Energieverbrauchswerte im Wohngebäudebestand vom 29.03.2021 (BAnz AT 16.04.2021 B1), ohne Witterungsbereinigung; Gas in kWh ohne Umrechnung von Brennwert auf Heizwert. Klasse nach Anlage 10, CO₂ nach Anlage 9 GModG; für Fernwärme ist ${faktorFernwaerme} g/kWh (KWK, gasförmige und flüssige Brennstoffe) unterstellt. Heizwerte nach § 9 Abs. 3 HeizkostenV: Heizöl EL ${HEIZWERT_HEIZOEL_EL_KWH_JE_LITER} kWh/l, Erdgas H ${HEIZWERT_ERDGAS_H_KWH_JE_M3} kWh/m³, Erdgas L ${HEIZWERT_ERDGAS_L_KWH_JE_M3} kWh/m³. Ausweisart nach § 80 Abs. 3 GModG. Abgerufen am 15.09.2026.`}
    explanation={`Kennwert = Mittel der Jahresverbräuche in kWh ÷ Gebäudenutzfläche (falls unbekannt: Wohnfläche × ${dez(NUTZFLAECHE_FAKTOR.sonstige, 1)} bzw. × ${dez(NUTZFLAECHE_FAKTOR.mitBeheiztemKeller)}), bei dezentralem Warmwasser + ${ZUSCHLAG_DEZENTRALES_WARMWASSER} kWh/m². CO₂ = Heizverbrauch je m² × Emissionsfaktor.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="traeger">Energieträger der Heizung</label>
          <select id="traeger">
            {traegerOptionen.map(o => <option value={o.wert}>{o.text}</option>)}
          </select>
        </div>
        {jahrFelder.map(f => (
          <div class="calc-group">
            <label for={f.id}>Verbrauch Jahr {f.nr} (<span class="einheit">kWh</span>)</label>
            <input type="number" id={f.id} min="0" max="1000000" value={f.wert} step="1" />
          </div>
        ))}
        <div class="calc-group">
          <label for="wohnflaeche">Wohnfläche (m²)</label>
          <input type="number" id="wohnflaeche" min="0" max="10000" value="100" step="1" />
        </div>
        <div class="calc-group">
          <label for="gnf">Gebäudenutzfläche (m², falls bekannt)</label>
          <input type="number" id="gnf" min="0" max="20000" step="1" placeholder="—" />
        </div>
        <div class="calc-group">
          <label><input type="checkbox" id="keller" style="width:auto;margin-right:0.4rem;" />Höchstens zwei Wohneinheiten mit beheiztem Keller</label>
          <label><input type="checkbox" id="dezentral" style="width:auto;margin-right:0.4rem;" />Warmwasser dezentral, Verbrauch dafür unbekannt</label>
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Endenergieverbrauch (vor Witterungsbereinigung)</div>
        <div id="ergebnis">— kWh/(m²·a)</div>
        <div class="result-actions">
          <button data-copy-result="#ergebnis" class="btn-copy" title="Resultat kopieren">📋 Kopieren</button>
          <button data-save-pdf="#ergebnis" class="btn-pdf" title="Als PDF speichern">📄 PDF</button>
        </div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.9rem;color:#555;display:flex;flex-direction:column;gap:0.3rem;"></div>

      <h2 style="margin-top:1.75rem;font-size:1.1rem;">Welcher Ausweis ist vorgeschrieben?</h2>
      <div class="calc-grid">
        <div class="calc-group">
          <label for="wohnungen">Wohnungen im Gebäude</label>
          <input type="number" id="wohnungen" min="1" max="500" value="1" step="1" />
        </div>
        <div class="calc-group">
          <label for="bauantrag">Bauantrag gestellt</label>
          <select id="bauantrag">
            <option value="vor">vor dem 1. November 1977</option>
            <option value="ab">am 1. November 1977 oder später</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="wschvo">Niveau der Wärmeschutzverordnung 1977 erreicht (von Anfang an oder durch Modernisierung)?</label>
          <select id="wschvo">
            <option value="unbekannt">weiß nicht</option>
            <option value="nein">nein</option>
            <option value="ja">ja</option>
          </select>
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Ausweisart</div>
        <div id="pflicht">—</div>
      </div>
      <div id="pflicht-grund" style="margin-top:0.5rem;font-size:0.9rem;color:#555;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Energieverbrauchsausweis: Kennwert, Klasse und Pflichten"
    content={guideHtml}
    relatedSlugs={['jahresenergieverbrauch', 'heizkosten-rechner', 'co2-einsparung-renovierung']}
  />
</Layout>

<script type="module">
const { VERBRAUCH_TRAEGER, EMISSIONSFAKTOREN_G_JE_KWH, FERNWAERME_RUECKFALL, verbrauchskennwert, ausweisPflicht } = await import(window.__base + 'scripts/energieausweis.js');

const feld = (id) => document.getElementById(id);
const zahl = (id) => parseFloat(feld(id).value) || 0;
const tsd = (n) => n.toLocaleString('de-DE');

function zeile(text, fett) {
  const span = document.createElement('span');
  span.append(text);
  if (fett) {
    const strong = document.createElement('strong');
    strong.textContent = fett;
    span.append(strong);
  }
  return span;
}

function berechneKennwert() {
  const traeger = feld('traeger').value;
  document.querySelectorAll('.einheit').forEach((el) => { el.textContent = VERBRAUCH_TRAEGER[traeger].einheit; });
  const r = verbrauchskennwert({
    traeger,
    jahresmengen: ['jahr1', 'jahr2', 'jahr3'].map(zahl),
    wohnflaeche: zahl('wohnflaeche'),
    gebaeudenutzflaeche: zahl('gnf'),
    mitBeheiztemKeller: feld('keller').checked,
    dezentralesWarmwasser: feld('dezentral').checked,
  });
  const details = feld('details');
  details.replaceChildren();
  if (!r) {
    feld('ergebnis').textContent = '— kWh/(m²·a)';
    details.append(zeile('Bitte mindestens einen Jahresverbrauch und eine Fläche eintragen.'));
    return;
  }
  feld('ergebnis').textContent = r.kwhJeQm + ' kWh/(m²·a) – Klasse ' + r.klasse;
  const flaeche = tsd(r.nutzflaeche) + ' m² ' + (r.flaecheGeschaetzt ? '(pauschal aus der Wohnfläche)' : '(eingetragen)');
  details.append(
    zeile('Effizienzklasse nach Anlage 10: ', r.klasse),
    zeile('Treibhausgasemissionen: ', tsd(r.co2KgJeQm) + ' kg CO₂-Äquivalent je m² und Jahr'),
    zeile('Mittlerer Verbrauch: ' + tsd(r.mittelKwh) + ' kWh aus ' + r.jahre + (r.jahre === 1 ? ' Jahr' : ' Jahren') + ', Gebäudenutzfläche ' + flaeche),
  );
  if (!r.vollstaendig) details.append(zeile('Der Ausweis verlangt Abrechnungen aus mindestens 36 Monaten (§ 82 Abs. 4 GModG).'));
  if (r.brennwertbezogen) details.append(zeile('Gas nach Brennwert abgerechnet? Der Ausweis rechnet auf den Heizwert um, sein Wert liegt dann niedriger.'));
  if (traeger === 'fernwaerme') details.append(zeile('CO₂ mit ' + EMISSIONSFAKTOREN_G_JE_KWH[FERNWAERME_RUECKFALL] + ' g/kWh unterstellt – den Wert für Ihr Netz nennt der Versorger.'));
  details.append(zeile('Ohne Witterungsbereinigung nach § 82 Abs. 3 GModG.'));
}

function pruefePflicht() {
  const r = ausweisPflicht({
    wohnungen: Number(feld('wohnungen').value),
    bauantragVor1977: feld('bauantrag').value === 'vor',
    waermeschutz1977: feld('wschvo').value,
  });
  if (!r) {
    feld('pflicht').textContent = '—';
    feld('pflicht-grund').textContent = 'Bitte die Zahl der Wohnungen als ganze Zahl eintragen.';
    return;
  }
  feld('pflicht').textContent = r.art === 'bedarf' ? 'Energiebedarfsausweis vorgeschrieben' : 'Bedarfs- oder Verbrauchsausweis möglich';
  feld('pflicht-grund').textContent = r.grund;
}

document.querySelectorAll('.calc-form input, .calc-form select').forEach((el) => {
  const neu = ['wohnungen', 'bauantrag', 'wschvo'].includes(el.id) ? pruefePflicht : berechneKennwert;
  el.addEventListener('input', neu);
  el.addEventListener('change', neu);
});
berechneKennwert();
pruefePflicht();
</script>
