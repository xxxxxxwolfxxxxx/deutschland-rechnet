---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelCo2 from '../../components/artikel/co2-kosten-stufen-mieter-vermieter.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { BRENNSTOFFE } from '../../../public/scripts/heizkosten.js';
const calc = CALCULATORS.find(c => c.slug === 'co2-einsparung-renovierung')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Gedämmt und Fenster getauscht wird gegen HEIZenergie, nicht gegen
// Haushaltsstrom: Eingespart wird das, was der Kessel heute verbrennt. Erdgas
// ist der häufigste Bestandsbrennstoff und deshalb die Voreinstellung. Vorher
// standen hier 25 ct ohne Herkunft – zu viel für Gas, zu wenig für Strom.
const GASPREIS_CENT = BRENNSTOFFE.gas.arbeitspreisCent;
---
<Layout
  title={`CO₂-Einsparung durch Renovierung ${year}`}
  description="Energie- und CO₂-Einsparung einer Sanierung berechnen – mit eigener Einsparungsannahme, Förderquote und der Aufteilung der CO₂-Kosten zwischen Mieter und Vermieter."
  canonicalPath="/energie/co2-einsparung-renovierung/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>CO₂-Einsparung durch Renovierung {year}</h1>
  </div>
   <CalculatorShell
     calculator={calc}
     intro="Der Rechner setzt eine Einsparung je Quadratmeter an und rechnet daraus Energie, CO₂, Kosten und Amortisation. Einsparung und Kosten sind vorbelegte Richtwerte, die Sie durch die Zahlen Ihres Angebots oder Ihrer Energieberatung ersetzen sollten – von ihnen hängt das Ergebnis vollständig ab."
     sourceNote="CO₂-Faktor für Erdgas 0,181 kg je abgerechneter kWh nach EBeV 2030 Anlage 2 Teil 4; Energiepreis aus den Brennstoffdaten des Heizkostenmoduls. Die vorbelegten Einsparungen und Kosten je Quadratmeter sind Richtwerte ohne amtliche Quelle und überschreibbar."
     explanation="Die CO₂-Menge folgt unmittelbar aus der eingesparten Heizenergie: Jede nicht verbrannte Kilowattstunde Erdgas spart 0,181 kg CO₂. Wie viel Energie eine Maßnahme einspart, ist dagegen keine Konstante, sondern hängt vom Zustand des Gebäudes ab – deshalb ist dieser Wert hier eine Eingabe. Bei vermieteten Wohnungen teilt das Kohlendioxidkostenaufteilungsgesetz die CO₂-Kosten nach einem Stufenmodell zwischen Mieter und Vermieter auf; der Artikel auf dieser Seite rechnet durch, wie wenig davon beim Sanierenden ankommt."
 faqs={[
        { q: "Wie viel CO₂ spart eine eingesparte Kilowattstunde?", a: "Bei Erdgas 0,181 kg je abgerechneter Kilowattstunde – das ist der Standardwert der EBeV 2030 (Anlage 2 Teil 4) und bezieht sich auf den Brennwert, also auf die Zahl der Gasrechnung. Achtung: Der Energieausweis rechnet mit einem anderen Faktor (0,24 kg je kWh, Anlage 9 GModG) und bezieht ihn auf die Gebäudenutzfläche statt auf die Wohnfläche." },
        { q: "Woher kommen die vorbelegten Einsparungen je Quadratmeter?", a: "Sie sind Richtwerte dieser Seite ohne amtliche Quelle und dienen nur als Startpunkt. Was eine Maßnahme im konkreten Gebäude bringt, ergibt sich aus dessen Zustand, der Ausführung und dem Nutzerverhalten – belastbare Zahlen liefert eine Energieberatung oder der Vergleich der Verbrauchsabrechnungen vor und nach der Maßnahme." },
        { q: "Wer profitiert von der Einsparung, wenn die Wohnung vermietet ist?", a: "Die Energiekosten trägt der Mieter, deshalb kommt der größte Teil der Ersparnis bei ihm an. Vom CO₂-Anteil im Preis trägt der Vermieter je nach Gebäudezustand 0 bis 95 Prozent (Stufenmodell der Anlage zum CO2KostAufG). Selbst im schlechtesten Zustand sind das nur rund 10 Prozent der gesamten Ersparnis je Kilowattstunde." },
        { q: "Welche Förderung soll ich eintragen?", a: "Den Satz aus Ihrem Zuwendungsbescheid oder Ihrer Antragsplanung. Der Rechner nennt bewusst keine Quote: Die Programme der Bundesförderung für effiziente Gebäude ändern sich regelmäßig, und die Höhe hängt von Maßnahme, Boni und Antragszeitpunkt ab." },
        { q: "Wie ist die Amortisationszeit gerechnet?", a: "Nettoinvestition geteilt durch die jährliche Energiekosteneinsparung, ohne Zinsen, Energiepreissteigerung, Instandhaltung und ohne die Mieterhöhung, die § 559 BGB nach einer Modernisierung erlaubt. Sie ist eine nominale Vergleichsgröße, keine Wirtschaftlichkeitsrechnung." }
      ]}
   >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="wohnflaeche">Wohnfläche (m²)</label>
          <input type="number" id="wohnflaeche" min="30" max="300" value="120" step="5" />
        </div>
        <div class="calc-group">
          <label for="maßnahme">Sanierungsmaßnahme</label>
          <select id="maßnahme">
            <option value="wände-extern">Außenwanddämmung (16 cm)</option>
            <option value="dach">Dachboden-/Deckendämmung</option>
            <option value="fenster">Fenster austauschen (3-fach verglast)</option>
            <option value="heizung">Heizung austauschen (Wärmepumpe)</option>
            <option value="kellerdecke">Kellerdeckendämmung</option>
            <option value="komplett">Komplettsanierung (KfW-Effizienzhaus 85)</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="baujahr">Baujahr des Hauses</label>
          <select id="baujahr">
            <option value="vor1979">vor 1979 (unsaniert)</option>
            <option value="1979-1995">1979-1995</option>
            <option value="nach1995">nach 1995 (teilweise saniert)</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="foerderung">Fördersatz (%)</label>
          <input type="number" id="foerderung" min="0" max="50" value="20" step="5" />
        </div>
        <div class="calc-group">
          <label for="einsparung">Erwartete Einsparung (kWh je m² und Jahr)</label>
          <input type="number" id="einsparung" min="0" max="400" step="5" />
          <small style="color:#666;">Vorbelegt mit einem Richtwert zur Maßnahme – belastbar wird die Zahl erst durch eine Berechnung für Ihr Gebäude.</small>
        </div>
        <div class="calc-group">
          <label for="kosten">Kosten der Maßnahme (€ je m² Wohnfläche)</label>
          <input type="number" id="kosten" min="0" max="5000" step="10" />
          <small style="color:#666;">Vorbelegt mit einem Richtwert – maßgeblich ist Ihr Angebot.</small>
        </div>
        <div class="calc-group">
          <label for="energiepreis">Energiepreis (ct/kWh)</label>
          <input type="number" id="energiepreis" min="5" max="50" value={GASPREIS_CENT} step="0.5" />
          <small>Preis der eingesparten Heizenergie – voreingestellt Erdgas</small>
        </div>
      </div>
       <div class="calc-result">
         <div class="label">Jährliche CO₂-Einsparung</div>
         <div id="ergebnis">— kg</div>
         <div class="result-actions">
           <button 
             data-copy-result="#ergebnis" 
             class="btn-copy"
             title="Resultat kopieren"
           >
             📋 Kopieren
           </button>
           <button 
             data-save-pdf="#ergebnis" 
             class="btn-pdf"
             title="Als PDF speichern"
           >
             📄 PDF
           </button>
         </div>
       </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
    <ArtikelCo2 slot="artikel" />
  </CalculatorShell>

</Layout>

<script type="module">
const { emissionsfaktor } = await import(window.__base + 'scripts/heizkosten.js');

// Gedämmt wird gegen Heizenergie, nicht gegen Haushaltsstrom: Eingespart wird
// der Brennstoff, den der Kessel heute verbrennt. Der Faktor gehört deshalb
// zum selben Brennstoff wie der Energiepreis im Formular – voreingestellt
// Erdgas. Vorher standen hier 0,402 kg/kWh, ein Strommix-Wert, der zu einer
// Dämmmaßnahme nicht passt und die Einsparung um mehr als das Doppelte
// überzeichnet hat.
const CO2_FAKTOR_KG_JE_KWH = emissionsfaktor('gas');

// Richtwerte je Maßnahme und Baualter: Einsparung in kWh je m² und Jahr,
// Kosten in € je m² Wohnfläche. Sie stammen aus keiner amtlichen Quelle und
// sind bewusst als überschreibbare Vorbelegung der Eingabefelder angelegt –
// was eine Maßnahme im einzelnen Gebäude bringt, entscheidet dessen Zustand.
const RICHTWERTE = {
  'wände-extern': { alt: 80, neu: 40, kosten: 180 },
  dach: { alt: 60, neu: 30, kosten: 100 },
  fenster: { alt: 50, neu: 25, kosten: 400 },
  heizung: { alt: 100, neu: 50, kosten: 800 },
  kellerdecke: { alt: 20, neu: 10, kosten: 40 },
  komplett: { alt: 150, neu: 75, kosten: 1000 },
};

function richtwert() {
  const m = RICHTWERTE[document.getElementById('maßnahme').value] ?? { alt: 50, neu: 25, kosten: 200 };
  const alt = document.getElementById('baujahr').value === 'vor1979';
  return { einsparung: alt ? m.alt : m.neu, kosten: m.kosten };
}

/** Vorbelegung setzen, wenn Maßnahme oder Baujahr wechseln. */
function vorbelegen() {
  const r = richtwert();
  document.getElementById('einsparung').value = r.einsparung;
  document.getElementById('kosten').value = r.kosten;
  berechne();
}

function berechne() {
  const flaeche = parseFloat(document.getElementById('wohnflaeche').value) || 0;
  const foerderung = parseFloat(document.getElementById('foerderung').value) || 0;
  const energiepreisCt = parseFloat(document.getElementById('energiepreis').value) || 0;
  const energiepreis = energiepreisCt / 100; // €/kWh
  const einsparungProQm = parseFloat(document.getElementById('einsparung').value) || 0;
  const investitionProQm = parseFloat(document.getElementById('kosten').value) || 0;

  const jahresEinsparungKwh = flaeche * einsparungProQm;
  const investitionGesamt = flaeche * investitionProQm;
  const foerderungsBetrag = investitionGesamt * (foerderung / 100);
  const nettoInvestition = investitionGesamt - foerderungsBetrag;
  const jahresCo2Einsparung = jahresEinsparungKwh * CO2_FAKTOR_KG_JE_KWH;
  const jahresEinsparungEuro = jahresEinsparungKwh * energiepreis;
  const amortisationsjahre = jahresEinsparungEuro > 0 ? nettoInvestition / jahresEinsparungEuro : null;
  const ganz = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 });

  document.getElementById('ergebnis').textContent = ganz(jahresCo2Einsparung) + ' kg';
  const teile = [
    `<span>Jährliche Energieeinsparung: <strong>${ganz(jahresEinsparungKwh)} kWh</strong></span>`,
    `<span>Jährliche Energiekosteneinsparung: <strong>${ganz(jahresEinsparungEuro)} €</strong></span>`,
    `<span>Investition: <strong>${ganz(investitionGesamt)} €</strong></span>`,
    `<span>Förderung (${ganz(foerderung)} %): <strong>${ganz(foerderungsBetrag)} €</strong></span>`,
    `<span>Nettoinvestition: <strong>${ganz(nettoInvestition)} €</strong></span>`,
    `<span>Amortisationszeit: <strong>${amortisationsjahre === null ? '—' : amortisationsjahre.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' Jahre'}</strong></span>`,
  ];
  if (flaeche > 0) {
    teile.push(`<span style="flex-basis:100%;">Wie viel davon beim Vermieter ankommt, entscheidet bei vermieteten Wohnungen das Stufenmodell des CO2KostAufG – der Artikel unten rechnet es durch.</span>`);
  }
  document.getElementById('details').innerHTML = teile.join('');
}
['wohnflaeche','foerderung','energiepreis','einsparung','kosten'].forEach((id) => {
  const el = document.getElementById(id);
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
['maßnahme','baujahr'].forEach((id) => document.getElementById(id).addEventListener('change', vorbelegen));
vorbelegen();
</script>