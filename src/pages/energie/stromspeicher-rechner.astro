---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'stromspeicher-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Stromspeicher-Rechner ${year}`}
  description="Stromspeicher-Rechner 2025: Amortisation, Eigenverbrauch und jaehrliche Ersparnis eines Batteriespeichers berechnen. Vergleich 5-15 kWh Speicher mit aktuellen Preisen ab 500 Euro/kWh."
  canonicalPath="/energie/stromspeicher-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Stromspeicher-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Berechnen Sie, ob sich ein Stromspeicher für Ihre PV-Anlage wirtschaftlich lohnt. So erfahren Sie die Amortisationszeit und die jährliche Ersparnis durch höheren Eigenverbrauch."
    sourceNote="500-800€ pro kWh."
    explanation="Stromspeicher kosten aktuell 500-800 Euro pro kWh nutzbarer Kapazität bei einer Lebensdauer von 15-20 Jahren. Ohne Speicher nutzen Sie nur ca. 30% Ihres PV-Stroms selbst, mit Speicher bis zu 70%."
    faqs={[
      { q: "Wann amortisiert sich ein Stromspeicher wirklich?", a: "Bei moderaten Strompreisen (35ct/kWh) und ausreichend PV-Überschuss: 15-20 Jahre. Ein 10-kWh-Speicher (10.000€) bei 1.000€/a Zusatzersparnis amortisiert sich in 10 Jahren. Bei hohem Strompreis (50ct/kWh) schneller, bei niedrigem Preis länger." },
      { q: "Rentiert sich Speicher ohne PV-Anlage?", a: "Nein. Ohne PV würde der Speicher nur nachts günstig laden (Nachtstrom-Tarife) – das lohnt sich nicht mehr, da Nachtstrom-Rabatte klein sind (~5-10% Unterschied zu Normaltarif). Speicher + PV ist die wirtschaftliche Kombination." },
      { q: "Welche Zusatzkosten fallen für einen Speicher an?", a: "Installation/Elektriker: 500-1.500€. Wechselrichter für AC-gekoppelten Speicher: 2.000-4.000€ (optional, oft im Speicher-Komplettpaket). Wartung/Versicherung: ~50-100€/a. Diese Kosten sollten bei der Amortisationszeitberechnung berücksichtigt werden." },
      { q: "Ist es billiger, einen Speicher später zu installieren?", a: "Nicht unbedingt. Speicherpreise fallen zwar, aber auch Strompreise steigen. Ein Speicher heute mit 10.000€ amortisiert sich, ein zukünftiger zu 7.000€ aber vielleicht nicht schneller – und Sie verpassen Einsparungen dazwischen. Faustregel: Kauf lohnt sich jetzt bei hohem Strompreis." },
      { q: "Wie wirkt sich Strompreisanstieg auf die Amortisation aus?", a: "Strompreisanstieg +5%/a (realistisch): Nach 10 Jahren 50% höhere Strompreise, die Amortisationszeit verkürzt sich deutlich (von 18 auf 12-14 Jahre). Deshalb sollten Speicher realistisch mit zukünftigen, höheren Strompreisen kalkuliert werden." },
      { q: "Kann ich mit Speicher autark vom Stromnetz leben?", a: "Nicht komplett. Ein 10-kWh-Speicher + 10-kWp-PV reicht für 2-3 Tage Autarkie. Im Winter oder längeren Schlechtwetter reicht es nicht. Volle Autarkie (365 Tage) würde 50-100 kWh Speicher benötigen (500.000€+). Realistisch: 80-90% Stromversorgung mit Speicher, Rest vom Netz." },
      { q: "Welche Speichergroesse brauche ich fuer meinen Haushalt?", a: "Faustregel: Speicher in kWh = Jahresverbrauch geteilt durch 1.000. Bei 4.000 kWh Verbrauch also ein 4-5 kWh Speicher. Fuer maximalen Eigenverbrauch (70%+) sollte der Speicher dem 1,5-fachen Tagesverbrauch entsprechen: bei 4.000 kWh/Jahr sind das ca. 16 kWh/Tag, also 8-10 kWh Speicher." },
      { q: "Wie lange haelt ein Stromspeicher?", a: "Moderne Lithium-Eisenphosphat-Speicher (LFP) halten 6.000-10.000 Zyklen, was bei einem Zyklus pro Tag 15-25 Jahre Lebensdauer bedeutet. Die meisten Hersteller geben 10-15 Jahre Garantie auf mindestens 70-80% Restkapazitaet. NMC-Speicher (aeltere Technologie) schaffen 3.000-5.000 Zyklen." },
      { q: "Gibt es Foerderung fuer Stromspeicher 2025?", a: "Eine bundesweite Foerderung gibt es seit Ende des KfW-Programms 442 nicht mehr. Regionale Programme existieren aber weiterhin: z.B. Bayern (EnergieBonusBayern), Sachsen, Berlin und mehrere Stadtwerke bieten Zuschuesse von 100-200 Euro pro kWh. Pruefen Sie die Foerderdatenbank Ihrer Gemeinde oder des Bundeslandes." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="speicher">Speichergröße (kWh)</label>
          <input type="number" id="speicher" min="1" max="30" value="10" step="1" />
        </div>
        <div class="calc-group">
          <label for="pv_leistung">PV-Leistung (kWp)</label>
          <input type="number" id="pv_leistung" min="3" max="30" value="10" step="1" />
        </div>
        <div class="calc-group">
          <label for="stromverbrauch">Jahresstromverbrauch (kWh)</label>
          <input type="number" id="stromverbrauch" min="1000" max="20000" value="4000" step="100" />
        </div>
        <div class="calc-group">
          <label for="strompreis">Strompreis (ct/kWh)</label>
          <input type="number" id="strompreis" min="20" max="60" value="35" step="1" />
        </div>
        <div class="calc-group">
          <label for="speicherkosten">Speicherkosten (€/kWh)</label>
          <input type="number" id="speicherkosten" min="500" max="2000" value="1000" step="50" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Jährliche Ersparnis</div>
        <div id="ersparnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

<script type="module">
const { berechneStromspeicher } = await import(window.__base + 'scripts/stromspeicher.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const speicher = parseFloat(document.getElementById('speicher').value)||10;
  const pvLeistung = parseFloat(document.getElementById('pv_leistung').value)||10;
  const stromverbrauch = parseFloat(document.getElementById('stromverbrauch').value)||4000;
  const strompreis = parseFloat(document.getElementById('strompreis').value)||35;
  const speicherkosten = parseFloat(document.getElementById('speicherkosten').value)||1000;
  const r = berechneStromspeicher({ speicher, pvLeistung, stromverbrauch, strompreis, speicherkosten });
  document.getElementById('ersparnis').textContent = fmt(r.ersparnis);
  document.getElementById('details').innerHTML =
    `<span>Ohne Speicher: <strong>${fmt(r.ohneSpeicher)}</strong></span>` +
    `<span>Mit Speicher: <strong>${fmt(r.mitSpeicher)}</strong></span>` +
    `<span>Eigenverbrauch: <strong>${r.eigenverbrauch}%</strong></span>` +
    `<span>Investition: <strong>${fmt(r.investition)}</strong></span>` +
    `<span>Amortisation: <strong>${r.amortisation} Jahre</strong></span>`;
}
['speicher','pv_leistung','stromverbrauch','strompreis','speicherkosten'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>

<CalculatorGuide
  title="Stromspeicher wirtschaftlich bewerten"
  content={`<p>Ein Stromspeicher macht Solaranlagen wirtschaftlicher, indem er PV-Ueberschuss fuer Abend und Nacht nutzbar macht. Statt 8,1 ct/kWh Einspeiseverguetung (2025) erhalten Sie effektiv 35-42 ct/kWh Ersparnis durch Eigenverbrauch. Die Differenz von ca. 27-34 ct/kWh pro gespeicherter Kilowattstunde ist der wirtschaftliche Kern eines Speichers.</p>

<h4>Stromspeicher-Vergleich: Beliebte Modelle 2025</h4>
<table>
  <thead>
    <tr><th>Modell</th><th>Kapazitaet</th><th>Technologie</th><th>Preis ca.</th><th>Garantie</th></tr>
  </thead>
  <tbody>
    <tr><td>BYD HVS 5.1</td><td>5,1 kWh</td><td>LFP</td><td>3.200 Euro</td><td>10 Jahre</td></tr>
    <tr><td>BYD HVS 10.2</td><td>10,2 kWh</td><td>LFP</td><td>5.800 Euro</td><td>10 Jahre</td></tr>
    <tr><td>Huawei LUNA2000 5</td><td>5 kWh</td><td>LFP</td><td>3.000 Euro</td><td>10 Jahre</td></tr>
    <tr><td>Huawei LUNA2000 10</td><td>10 kWh</td><td>LFP</td><td>5.500 Euro</td><td>10 Jahre</td></tr>
    <tr><td>Tesla Powerwall 3</td><td>13,5 kWh</td><td>LFP</td><td>8.500 Euro</td><td>10 Jahre</td></tr>
    <tr><td>Senec Home 4</td><td>10 kWh</td><td>LFP</td><td>7.000 Euro</td><td>15 Jahre</td></tr>
    <tr><td>sonnen Batterie 10</td><td>11 kWh</td><td>LFP</td><td>9.500 Euro</td><td>10 Jahre</td></tr>
  </tbody>
</table>

<h4>Amortisationsrechnung: Beispielszenarien</h4>
<table>
  <thead>
    <tr><th>Szenario</th><th>Speicher</th><th>Investition</th><th>Zusatzersparnis/Jahr</th><th>Amortisation</th></tr>
  </thead>
  <tbody>
    <tr><td>4-Personen-Haushalt, 10 kWp PV</td><td>10 kWh</td><td>7.000 Euro</td><td>550-650 Euro</td><td>11-13 Jahre</td></tr>
    <tr><td>2-Personen-Haushalt, 7 kWp PV</td><td>5 kWh</td><td>4.000 Euro</td><td>350-450 Euro</td><td>9-11 Jahre</td></tr>
    <tr><td>Einfamilienhaus + Waermepumpe</td><td>15 kWh</td><td>9.500 Euro</td><td>800-1.000 Euro</td><td>10-12 Jahre</td></tr>
    <tr><td>Kleiner Haushalt, 5 kWp PV</td><td>5 kWh</td><td>4.000 Euro</td><td>250-350 Euro</td><td>12-16 Jahre</td></tr>
  </tbody>
</table>

<p><strong>Annahmen:</strong> Strompreis 38 ct/kWh, Einspeiseverguetung 8,1 ct/kWh, Speicher-Wirkungsgrad 92%, Eigenverbrauchsquote steigt von 30% ohne auf 60-70% mit Speicher.</p>

<p><strong>Eigenverbrauch mit und ohne Speicher:</strong> Ohne Speicher nutzen Sie typisch nur 25-35% Ihres PV-Stroms selbst (der Rest fliesst ins Netz). Mit einem passend dimensionierten Speicher steigt der Eigenverbrauch auf 60-75%. Das bedeutet: Statt 8,1 ct Einspeiseverguetung sparen Sie 38 ct Strombezugskosten. Jede zusaetzlich selbst genutzte kWh bringt ca. 30 ct Vorteil.</p>

<p><strong>Gesamtkosten richtig kalkulieren:</strong> Zum reinen Speicherpreis kommen hinzu: Installation und Elektriker (800-1.500 Euro), ggf. Hybrid-Wechselrichter (1.500-3.000 Euro falls nicht vorhanden), Notstromfunktion optional (500-1.000 Euro Aufpreis). Rechnen Sie mit 20-30% Aufschlag auf den reinen Speicherpreis fuer die Gesamtinstallation.</p>

<p><strong>Speichertechnologien 2025:</strong> Lithium-Eisenphosphat (LFP) hat sich als Standard durchgesetzt: 6.000-10.000 Zyklen Lebensdauer, kein thermisches Durchgehen, wartungsfrei. NMC-Speicher (aeltere Technologie) bieten hoehere Energiedichte, aber kuerzere Lebensdauer (3.000-5.000 Zyklen). Salzwasserspeicher und Redox-Flow-Batterien sind Nischenprodukte fuer Gewerbe.</p>

<p><strong>Wann sich ein Speicher besonders lohnt:</strong> Hoher Strompreis (ueber 35 ct/kWh), regelmaessiger Abendverbrauch (Kochen, Waschen, E-Auto laden nachts), PV-Anlage mit mindestens 7 kWp, und wenn kein dynamischer Stromtarif genutzt wird. Bei Kombination mit Waermepumpe steigt die Wirtschaftlichkeit deutlich.</p>`}
  relatedSlugs={['photovoltaik-rechner', 'solarspeicher-dimensionierung', 'waermepumpe-rechner']}
/>
</Layout>
