---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  berechneStromspeicher,
  DIREKTVERBRAUCH_ANTEIL,
  SPEICHER_WIRKUNGSGRAD,
  SPEICHER_NUTZTAGE,
} from '../../../public/scripts/stromspeicher.js';
import { verguetungProKwh, SPEZIFISCHER_ERTRAG } from '../../../public/scripts/photovoltaik.js';
import { STROMPREIS_CENT_PRO_KWH, STROMPREIS_QUELLE } from '../../../public/scripts/strompreis.js';
const calc = CALCULATORS.find(c => c.slug === 'stromspeicher-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Einspeisevergütung nach § 48 Abs. 2 EEG aus photovoltaik.js, Strompreis aus
// strompreis.js. Speicherpreise stehen hier nicht: Sie kommen aus dem Angebot
// des Nutzers. Statt eines erfundenen Marktpreises zeigt die Seite, bis zu
// welchem Preis je kWh sich ein Speicher überhaupt tragen kann.
const STROMPREIS_CENT = STROMPREIS_CENT_PRO_KWH;
const verguetungCent = verguetungProKwh(10) * 100;
const dez = (n: number, stellen = 2) => n.toLocaleString('de-DE', { minimumFractionDigits: stellen, maximumFractionDigits: stellen });
const euro = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';

// Preis je kWh Kapazität, bei dem sich der Speicher nach `jahre` Jahren
// gerade bezahlt hat – ohne Zinsen, Alterung und Strompreisänderung.
const breakEven = (ersparnis: number, speicher: number, jahre: number) => (speicher > 0 ? (ersparnis * jahre) / speicher : 0);

const szenarien = [
  { name: '2 Personen, 3.000 kWh, 7 kWp', speicher: 5, pvLeistung: 7, verbrauch: 3000 },
  { name: '4 Personen, 5.000 kWh, 10 kWp', speicher: 8, pvLeistung: 10, verbrauch: 5000 },
  { name: 'Mit Wärmepumpe, 9.000 kWh, 12 kWp', speicher: 12, pvLeistung: 12, verbrauch: 9000 },
  { name: 'Großer Speicher, kleiner Verbrauch: 2.500 kWh, 10 kWp', speicher: 10, pvLeistung: 10, verbrauch: 2500 },
];
const szenarioErgebnisse = szenarien.map((s) => ({
  ...s,
  r: berechneStromspeicher({ speicher: s.speicher, pvLeistung: s.pvLeistung, stromverbrauch: s.verbrauch, strompreis: STROMPREIS_CENT, speicherkosten: 0 }),
}));
const szenarienZeilen = szenarioErgebnisse
  .map(({ name, speicher, r }) =>
    '<tr><td>' + name + '</td><td>' + speicher + ' kWh</td><td>' + r.speicherKwh.toLocaleString('de-DE') + ' kWh</td><td>' + euro(r.ersparnis) + '</td><td>' + euro(breakEven(r.ersparnis, speicher, 10)) + '</td><td>' + euro(breakEven(r.ersparnis, speicher, 15)) + '</td></tr>')
  .join('\n');
const gross = szenarioErgebnisse[3];
const mittel = szenarioErgebnisse[1];
if (!(breakEven(gross.r.ersparnis, gross.speicher, 15) < breakEven(mittel.r.ersparnis, mittel.speicher, 15))) {
  throw new Error('Stromspeicher: Ein überdimensionierter Speicher muss je kWh weniger tragen');
}

const faqs = [
  { q: 'Wann amortisiert sich ein Stromspeicher?', a: `Das hängt am Preis Ihres Angebots. Jede gespeicherte Kilowattstunde bringt nicht den Strompreis, sondern dessen Abstand zur Einspeisevergütung: ${dez(STROMPREIS_CENT - verguetungCent)} ct. Ein 8-kWh-Speicher an einer 10-kWp-Anlage mit 5.000 kWh Verbrauch verschiebt rund ${mittel.r.speicherKwh.toLocaleString('de-DE')} kWh im Jahr und spart ${euro(mittel.r.ersparnis)}. Soll er sich in 15 Jahren bezahlt machen, darf er höchstens ${euro(breakEven(mittel.r.ersparnis, 8, 15))} je kWh Kapazität kosten – ohne Zinsen und Alterung gerechnet.` },
  { q: 'Was bringt ein Speicher bei niedrigem Strompreis?', a: 'Weniger. Der Vorteil ist die Differenz aus Netzstrompreis und entgangener Einspeisevergütung – fällt der Strompreis, schrumpft diese Spanne unmittelbar und mit ihr der Preis, den ein Speicher kosten darf.' },
  { q: 'Lohnt sich ein größerer Speicher?', a: `Nur bis zu dem Punkt, an dem er an den meisten Tagen noch geleert wird. Der Rechner begrenzt die tägliche Entladung auf den Verbrauch, der nicht direkt aus der Anlage gedeckt wird. Im Beispiel eines Haushalts mit 2.500 kWh und 10-kWh-Speicher bleibt ein Teil der Kapazität deshalb ungenutzt: Er dürfte für 15 Jahre nur ${euro(breakEven(gross.r.ersparnis, gross.speicher, 15))} je kWh kosten. Welche Größe sich für Ihre Werte trägt, zeigt die Speicher-Dimensionierung.` },
  { q: 'Rentiert sich ein Speicher ohne PV-Anlage?', a: 'Nach dieser Rechnung nicht: Ohne Anlage gibt es keinen Überschuss, den der Speicher verschieben könnte. Ein Nutzen entsteht dann nur aus einem Tarif mit unterschiedlichen Preisen je Tageszeit, den der Rechner nicht abbildet.' },
  { q: 'Was ist der Unterschied zwischen Autarkiegrad und Eigenverbrauchsquote?', a: 'Der Autarkiegrad ist der Anteil Ihres Verbrauchs, den Sie selbst decken. Die Eigenverbrauchsquote ist der Anteil des erzeugten Stroms, den Sie selbst nutzen. Bei großer Anlage und kleinem Verbrauch liegen beide weit auseinander.' },
];

const guideHtml = `<p>Ein Stromspeicher verdient nicht am Strom, den die Anlage erzeugt, sondern an der Umwidmung: Statt für ${dez(verguetungCent)} ct/kWh Einspeisevergütung nach § 48 Abs. 2 EEG (Anlagen bis 10 kWp) ins Netz zu gehen, ersetzt die gespeicherte Kilowattstunde am Abend Netzstrom zu ${dez(STROMPREIS_CENT)} ct/kWh (${STROMPREIS_QUELLE}). Die Differenz von ${dez(STROMPREIS_CENT - verguetungCent)} ct/kWh ist der wirtschaftliche Kern eines Speichers.</p>

<h4>Bis zu welchem Preis sich ein Speicher trägt</h4>
<p>Speicherpreise unterscheiden sich je Hersteller, Installation und Region stark; der Rechner nennt deshalb keinen Marktpreis, sondern rechnet mit dem Preis Ihres Angebots. Die Tabelle zeigt umgekehrt, wie viel ein Speicher je kWh Kapazität höchstens kosten darf, damit ihn die Ersparnis nach 10 oder 15 Jahren bezahlt hat:</p>
<table>
  <thead>
    <tr><th>Szenario</th><th>Speicher</th><th>Verschoben/Jahr</th><th>Ersparnis/Jahr</th><th>Höchstpreis je kWh, 10 Jahre</th><th>15 Jahre</th></tr>
  </thead>
  <tbody>
${szenarienZeilen}
  </tbody>
</table>

<p><strong>Annahmen des Rechners:</strong> Strompreis ${dez(STROMPREIS_CENT)} ct/kWh, Einspeisevergütung ${dez(verguetungCent)} ct/kWh, Jahresertrag ${SPEZIFISCHER_ERTRAG} kWh je kWp, Round-Trip-Wirkungsgrad ${Math.round(SPEICHER_WIRKUNGSGRAD * 100)} %, ${SPEICHER_NUTZTAGE} Tage im Jahr mit genug Überschuss zum Laden, ohne Speicher direkt gedeckter Anteil des Verbrauchs ${Math.round(DIREKTVERBRAUCH_ANTEIL * 100)} %. Die letzten drei sind Planungsgrößen, keine Messwerte – ein Haushalt mit hohem Tagesverbrauch deckt mehr direkt und braucht den Speicher weniger. Nicht enthalten sind Zinsen, Strompreisänderungen und die Alterung des Speichers; die Höchstpreise sind deshalb eher zu hoch als zu niedrig.</p>

<p><strong>Autarkiegrad und Eigenverbrauchsquote:</strong> Beide Zahlen werden ständig verwechselt. Der Autarkiegrad ist der Anteil Ihres <em>Verbrauchs</em>, den Sie selbst decken; die Eigenverbrauchsquote ist der Anteil des <em>erzeugten</em> Stroms, den Sie selbst nutzen. Wirtschaftlich zählt keine der beiden Prozentzahlen, sondern die Menge: Jede zusätzlich selbst genutzte Kilowattstunde bringt ${dez(STROMPREIS_CENT - verguetungCent)} ct.</p>

<p><strong>Was im Angebot stehen sollte:</strong> Vergleichen Sie Angebote über den Preis je kWh <em>nutzbarer</em> Kapazität einschließlich Installation und gegebenenfalls Wechselrichter – nur dieser Preis lässt sich mit den Höchstpreisen oben vergleichen.</p>`;
---
<Layout
  title={`Stromspeicher-Rechner ${year}`}
  description="Jährliche Ersparnis und Amortisation eines Batteriespeichers an der PV-Anlage – mit Einspeisevergütung nach EEG und dem Höchstpreis, zu dem sich ein Speicher trägt."
  canonicalPath="/energie/stromspeicher-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Stromspeicher-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Berechnen Sie, was ein Stromspeicher an Ihrer PV-Anlage im Jahr einspart, wann er sich zum Preis Ihres Angebots bezahlt macht und bis zu welchem Preis er sich überhaupt tragen kann."
    sourceNote={`Einspeisevergütung nach § 48 Abs. 2 EEG, Strompreis nach ${STROMPREIS_QUELLE}, Jahresertrag ${SPEZIFISCHER_ERTRAG} kWh/kWp. Planungsannahmen: Wirkungsgrad ${Math.round(SPEICHER_WIRKUNGSGRAD * 100)} %, ${SPEICHER_NUTZTAGE} Ladetage, ${Math.round(DIREKTVERBRAUCH_ANTEIL * 100)} % Direktverbrauch. Der Speicherpreis ist Ihre Eingabe. Ohne Zinsen, Strompreisänderung und Alterung.`}
    explanation="Ersparnis = zusätzlich selbst genutzte kWh × (Strompreis − Einspeisevergütung). Amortisation = Speicherpreis ÷ Ersparnis. Höchstpreis je kWh = Ersparnis × Jahre ÷ Kapazität."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="speicher">Nutzbare Speicherkapazität (kWh)</label>
          <input type="number" id="speicher" min="0" max="50" value="8" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="pv_leistung">PV-Leistung (kWp)</label>
          <input type="number" id="pv_leistung" min="0" max="30" value="10" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="stromverbrauch">Jahresstromverbrauch (kWh)</label>
          <input type="number" id="stromverbrauch" min="0" max="30000" value="5000" step="100" />
        </div>
        <div class="calc-group">
          <label for="strompreis">Strompreis (ct/kWh)</label>
          <input type="number" id="strompreis" min="0" max="100" value={STROMPREIS_CENT} step="0.5" />
        </div>
        <div class="calc-group">
          <label for="speicherkosten">Preis je kWh laut Angebot (€, optional)</label>
          <input type="number" id="speicherkosten" min="0" max="5000" step="10" placeholder="—" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Jährliche Ersparnis durch den Speicher</div>
        <div id="ersparnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#555;display:flex;gap:0.35rem 1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Stromspeicher wirtschaftlich bewerten"
    content={guideHtml}
    relatedSlugs={['photovoltaik-rechner', 'solarspeicher-dimensionierung', 'waermepumpe-rechner']}
  />
</Layout>

<script type="module">
const { berechneStromspeicher } = await import(window.__base + 'scripts/stromspeicher.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const eur0 = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const speicher = wert('speicher');
  const r = berechneStromspeicher({
    speicher, pvLeistung: wert('pv_leistung'), stromverbrauch: wert('stromverbrauch'),
    strompreis: wert('strompreis'), speicherkosten: wert('speicherkosten'),
  });
  document.getElementById('ersparnis').textContent = eur(r.ersparnis);
  const teile = [
    `<span>Zusätzlich selbst genutzt: <strong>${r.speicherKwh.toLocaleString('de-DE')} kWh/Jahr</strong></span>`,
    `<span>Autarkiegrad: <strong>${r.autarkiegrad} %</strong> des Verbrauchs</span>`,
    `<span>Eigenverbrauchsquote: <strong>${r.eigenverbrauchsquote} %</strong> des Ertrags</span>`,
    `<span>Einspeisevergütung: <strong>${r.verguetungCentProKwh.toLocaleString('de-DE', { minimumFractionDigits: 2 })} ct/kWh</strong></span>`,
  ];
  if (speicher > 0) {
    teile.push(`<span>Höchstpreis je kWh für 10 Jahre: <strong>${eur0((r.ersparnis * 10) / speicher)}</strong>, für 15 Jahre: <strong>${eur0((r.ersparnis * 15) / speicher)}</strong></span>`);
  }
  if (r.investition > 0) {
    teile.push(`<span>Investition: <strong>${eur0(r.investition)}</strong>, Amortisation: <strong>${r.amortisation === null ? 'nicht erreicht' : r.amortisation.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' Jahre'}</strong></span>`);
  }
  document.getElementById('details').innerHTML = teile.join('');
}
document.querySelectorAll('.calc-form input').forEach((el) => el.addEventListener('input', berechne));
berechne();
</script>
