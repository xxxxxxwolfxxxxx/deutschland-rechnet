---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  berechneStromspeicher,
  vergleicheSpeichergroessen,
  DIREKTVERBRAUCH_ANTEIL,
  SPEICHER_NUTZTAGE,
  SPEICHER_WIRKUNGSGRAD,
} from '../../../public/scripts/stromspeicher.js';
import { verguetungProKwh, SPEZIFISCHER_ERTRAG } from '../../../public/scripts/photovoltaik.js';
import { STROMPREIS_CENT_PRO_KWH, STROMPREIS_QUELLE } from '../../../public/scripts/strompreis.js';
const calc = CALCULATORS.find(c => c.slug === 'solarspeicher-dimensionierung')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen stammen aus stromspeicher.js – derselben Jahresbilanz, die der
// Stromspeicher-Rechner zeigt. Die frühere Seite rechnete mit eigenen
// Nachtanteilen, Deckeln und einer Faustregel ohne Quelle.
const STROMPREIS_CENT = STROMPREIS_CENT_PRO_KWH;
const REFERENZ_PV_KWP = 10;
const verguetungCent = verguetungProKwh(REFERENZ_PV_KWP) * 100;
const euro = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const kwh = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' kWh';
const dez = (n: number, stellen = 2) => n.toLocaleString('de-DE', { minimumFractionDigits: stellen, maximumFractionDigits: stellen });

// Beispiel: 4-Personen-Haushalt, 5.000 kWh, 10 kWp. Preis und Nutzungsdauer
// sind ausdrücklich angenommene Werte, damit die Empfehlung sichtbar wird.
const BEISPIEL = { pvLeistung: REFERENZ_PV_KWP, stromverbrauch: 5000, strompreis: STROMPREIS_CENT, nutzungsdauer: 15 };
const bei600 = vergleicheSpeichergroessen({ ...BEISPIEL, preisJeKwh: 600 });
// Bis zur Sättigung ist der Grenzertrag je kWh konstant – die Empfehlung
// kippt deshalb nicht allmählich, sondern auf einen Schlag, sobald der Preis
// je kWh den Grenzertrag der ersten Stufe über die Nutzungsdauer übersteigt.
const GRENZE = bei600.zeilen[0].grenzertragJeKwh * BEISPIEL.nutzungsdauer;
const SCHWELLE = Math.floor(GRENZE);
const teuer = vergleicheSpeichergroessen({ ...BEISPIEL, preisJeKwh: SCHWELLE + 100 });
if (!(bei600.empfehlung > 0) || teuer.empfehlung !== 0) throw new Error('Solarspeicher: Beispiel widerspricht dem Modul');

const tabellenzeile = (z: ReturnType<typeof vergleicheSpeichergroessen>['zeilen'][number]) =>
  '<tr><td>' + z.speicher + ' kWh</td><td>' + kwh(z.speicherKwh) + '</td><td>' + z.autarkiegrad + ' %</td><td>' + z.eigenverbrauchsquote + ' %</td><td>' + euro(z.ersparnis) + '</td><td>' + euro(z.grenzertragJeKwh) + '</td></tr>';
const groessenZeilen = bei600.zeilen.map(tabellenzeile).join('\n');

const ohneSpeicher = berechneStromspeicher({ speicher: 0, ...BEISPIEL, speicherkosten: 0 });
const letzte = bei600.zeilen[bei600.zeilen.length - 1];
const erste = bei600.zeilen[0];

const faqs = [
  { q: 'Wie groß sollte der Speicher sein?', a: `So groß, wie die letzte zusätzliche Kilowattstunde Kapazität ihren Preis noch hereinholt. Im Beispiel mit 5.000 kWh Verbrauch und 10 kWp bringt die erste Stufe ${euro(erste.grenzertragJeKwh)} je kWh Kapazität im Jahr, die Stufe bis ${letzte.speicher} kWh nur noch ${euro(letzte.grenzertragJeKwh)}. Bis ${bei600.empfehlung} kWh bringt jede Stufe gleich viel, darüber bleibt Kapazität ungenutzt. Bei 15 Jahren Nutzung lohnt sich ein Speicher bis ${bei600.empfehlung} kWh deshalb, solange er weniger als rund ${euro(GRENZE)} je kWh kostet – teurer lohnt sich keine Größe.` },
  { q: 'Warum bringt ein größerer Speicher immer weniger?', a: 'Weil er an vielen Tagen nicht mehr leer wird. Entladen lässt sich nur, was der Haushalt außerhalb der Sonnenstunden verbraucht; darüber hinaus steht zusätzliche Kapazität ungenutzt. Außerdem füllt die Anlage den Speicher im Winterhalbjahr oft nicht.' },
  { q: 'Was ist der Unterschied zwischen nutzbarer und nominaler Kapazität?', a: 'Die nominale Kapazität ist die Größe der Batteriezellen, die nutzbare der Teil, den das System tatsächlich lädt und entlädt. Rechnen Sie immer mit der nutzbaren Kapazität aus dem Datenblatt – der Rechner tut das auch.' },
  { q: 'Ist ein Stromspeicher immer wirtschaftlich?', a: `Nein. Ohne Speicher deckt die Anlage in diesem Rechner bereits ${Math.round(DIREKTVERBRAUCH_ANTEIL * 100)} % des Verbrauchs direkt. Der Speicher verdient nur an der Differenz zwischen Strompreis und Einspeisevergütung, derzeit ${dez(STROMPREIS_CENT - verguetungCent)} ct je verschobener kWh. Ist der Speicher im Verhältnis dazu zu teuer, empfiehlt der Rechner keinen.` },
];

const guideHtml = `<p>Ein Stromspeicher verschiebt tagsüber erzeugten Überschuss in den Abend. Jede verschobene Kilowattstunde spart ${dez(STROMPREIS_CENT)} ct Netzstrom (${STROMPREIS_QUELLE}), kostet aber die Einspeisevergütung von ${dez(verguetungCent)} ct nach § 48 Abs. 2 EEG. Die richtige Größe ist deshalb keine Frage einer Faustregel, sondern des Grenzertrags: Was bringt die nächste Kilowattstunde Kapazität, und was kostet sie?</p>

<h3>Grenzertrag nach Speichergröße</h3>
<p>Für einen Haushalt mit ${kwh(BEISPIEL.stromverbrauch)} Jahresverbrauch und einer ${REFERENZ_PV_KWP}-kWp-Anlage (${kwh(REFERENZ_PV_KWP * SPEZIFISCHER_ERTRAG)} Ertrag). Ohne Speicher deckt er ${ohneSpeicher.autarkiegrad} % des Verbrauchs selbst.</p>
<table>
<thead><tr><th>Kapazität</th><th>Verschoben/Jahr</th><th>Autarkiegrad</th><th>Eigenverbrauchsquote</th><th>Ersparnis/Jahr</th><th>Grenzertrag je kWh/Jahr*</th></tr></thead>
<tbody>
${groessenZeilen}
</tbody>
</table>
<p><small>* Zusätzliche Ersparnis gegenüber der vorigen Zeile, geteilt durch die zusätzliche Kapazität. Der Autarkiegrad bezieht sich auf den Verbrauch, die Eigenverbrauchsquote auf den Ertrag.</small></p>

<h3>Von der Tabelle zur Empfehlung</h3>
<p>Eine Stufe lohnt sich, wenn ihr Grenzertrag über die Nutzungsdauer ihren Preis je kWh deckt. Im Beispiel bringt jede Kilowattstunde bis ${bei600.empfehlung} kWh denselben Grenzertrag; danach fällt er stark ab, weil der Speicher nicht mehr geleert wird. Die Empfehlung ist deshalb entweder ${bei600.empfehlung} kWh oder gar kein Speicher: Bei 15 Jahren Nutzung liegt die Grenze bei rund ${euro(GRENZE)} je kWh – derselbe Höchstpreis, den der Stromspeicher-Rechner für 8 kWh nennt. Mit ${euro(SCHWELLE + 100)} je kWh empfiehlt der Rechner keinen Speicher mehr. Tragen Sie den Preis Ihres Angebots und die Garantie- oder erwartete Nutzungsdauer ein.</p>

<h3>Annahmen</h3>
<p>Der Rechner nutzt die Jahresbilanz des Stromspeicher-Rechners: ${Math.round(DIREKTVERBRAUCH_ANTEIL * 100)} % des Verbrauchs werden ohne Speicher direkt gedeckt, der Speicher wird an ${SPEICHER_NUTZTAGE} Tagen im Jahr gefüllt und gibt ${Math.round(SPEICHER_WIRKUNGSGRAD * 100)} % der geladenen Energie wieder ab. Das sind Planungsgrößen, keine Messwerte. Ein Haushalt, der tagsüber viel verbraucht, deckt mehr direkt und braucht einen kleineren Speicher. Zinsen, Strompreisänderungen und die Alterung des Speichers sind nicht enthalten – die Empfehlung ist deshalb eine Obergrenze.</p>

<h3>Eigenverbrauch ohne größeren Speicher erhöhen</h3>
<p>Wer Waschmaschine, Geschirrspüler oder das Laden eines Elektroautos in die Mittagsstunden legt, erhöht den direkt gedeckten Anteil. Dann bleibt weniger Überschuss für den Speicher, und eine kleinere Größe erreicht denselben Autarkiegrad.</p>`;
---
<Layout
  title={`Solarspeicher-Dimensionierung ${year}`}
  description="Die wirtschaftlich sinnvolle Speichergröße für Ihre PV-Anlage: Grenzertrag je Kilowattstunde Kapazität gegen den Preis Ihres Angebots – mit Einspeisevergütung nach EEG."
  canonicalPath="/energie/solarspeicher-dimensionierung/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Solarspeicher-Dimensionierung {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner vergleicht Speichergrößen von 2 bis 15 kWh für Ihre Anlage und Ihren Verbrauch und empfiehlt die größte, deren zusätzliche Kapazität sich zum Preis Ihres Angebots über die Nutzungsdauer noch bezahlt macht."
    sourceNote={`Jahresbilanz aus dem Stromspeicher-Modul: Einspeisevergütung nach § 48 Abs. 2 EEG, Strompreis nach ${STROMPREIS_QUELLE}, ${SPEZIFISCHER_ERTRAG} kWh/kWp; Planungsannahmen ${Math.round(DIREKTVERBRAUCH_ANTEIL * 100)} % Direktverbrauch, ${SPEICHER_NUTZTAGE} Ladetage, ${Math.round(SPEICHER_WIRKUNGSGRAD * 100)} % Wirkungsgrad. Speicherpreis und Nutzungsdauer sind Ihre Eingaben. Ohne Zinsen und Alterung.`}
    explanation="Eine Stufe lohnt sich, wenn zusätzliche Ersparnis × Nutzungsdauer ≥ zusätzliche Kapazität × Preis je kWh. Empfohlen wird die größte Stufe, bis zu der das ohne Unterbrechung gilt."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="jahresverbrauch">Jahresstromverbrauch (kWh)</label>
          <input type="number" id="jahresverbrauch" min="0" max="30000" value={BEISPIEL.stromverbrauch} step="100" />
        </div>
        <div class="calc-group">
          <label for="pvleistung">PV-Leistung (kWp)</label>
          <input type="number" id="pvleistung" min="0" max="50" value={REFERENZ_PV_KWP} step="0.5" />
        </div>
        <div class="calc-group">
          <label for="strompreis">Strompreis (ct/kWh)</label>
          <input type="number" id="strompreis" min="0" max="100" value={STROMPREIS_CENT} step="0.5" />
        </div>
        <div class="calc-group">
          <label for="preis">Speicherpreis je kWh laut Angebot (€)</label>
          <input type="number" id="preis" min="0" max="5000" value="600" step="10" />
        </div>
        <div class="calc-group">
          <label for="dauer">Nutzungsdauer (Jahre)</label>
          <input type="number" id="dauer" min="1" max="30" value={BEISPIEL.nutzungsdauer} step="1" />
        </div>
      </div>
      <p style="margin-top:0.25rem;font-size:0.82rem;color:#777;">Preis und Nutzungsdauer sind angenommen – ersetzen Sie sie durch Angebot und Garantiezeit.</p>
      <div class="calc-result">
        <div class="label">Wirtschaftlich sinnvolle Größe</div>
        <div id="ergebnis">— kWh</div>
      </div>
      <div class="ssd-tabelle"><table id="tabelle"></table></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Stromspeicher nach Grenzertrag dimensionieren"
    content={guideHtml}
    relatedSlugs={['photovoltaik-rechner', 'stromspeicher-rechner', 'jahresenergieverbrauch']}
  />
</Layout>

<script type="module">
const { vergleicheSpeichergroessen } = await import(window.__base + 'scripts/stromspeicher.js');
const eur = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const v = vergleicheSpeichergroessen({
    pvLeistung: wert('pvleistung'), stromverbrauch: wert('jahresverbrauch'), strompreis: wert('strompreis'),
    preisJeKwh: wert('preis'), nutzungsdauer: wert('dauer'),
  });
  document.getElementById('ergebnis').textContent = v.empfehlung > 0 ? `${v.empfehlung} kWh` : 'kein Speicher';
  document.getElementById('tabelle').innerHTML =
    '<thead><tr><th>Kapazität</th><th>Ersparnis/Jahr</th><th>Grenzertrag je kWh/Jahr</th><th>Autarkie</th><th>Lohnt die Stufe?</th></tr></thead><tbody>' +
    v.zeilen.map((z) => `<tr><td>${z.speicher} kWh</td><td>${eur(z.ersparnis)}</td><td>${eur(z.grenzertragJeKwh)}</td><td>${z.autarkiegrad} %</td><td>${z.lohntStufe ? 'ja' : 'nein'}</td></tr>`).join('') +
    '</tbody>';
}
document.querySelectorAll('.calc-form input').forEach((el) => el.addEventListener('input', berechne));
berechne();
</script>

<style>
.ssd-tabelle { overflow-x: auto; margin-top: 1rem; }
.ssd-tabelle table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.ssd-tabelle th, .ssd-tabelle td { padding: 0.35rem 0.5rem; text-align: left; white-space: nowrap; }
</style>
