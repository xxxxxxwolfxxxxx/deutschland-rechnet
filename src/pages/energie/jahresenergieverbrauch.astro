---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  STROMPREIS_CENT_PRO_KWH,
  STROMPREIS_QUELLE,
  STROMPREIS_REFERENZVERBRAUCH_KWH,
  WAERMEPUMPENSTROM_CENT_PRO_KWH,
} from '../../../public/scripts/strompreis.js';
import { BRENNSTOFFE, HEIZKOSTEN_STAND, kwhJeLiterHeizoel } from '../../../public/scripts/heizkosten.js';
import {
  berechneJahresenergie,
  EFFIZIENZKLASSEN,
  HEIZWERT_HEIZOEL_EL_KWH_JE_LITER,
  NUTZFLAECHE_FAKTOR,
  ZUSCHLAG_DEZENTRALES_WARMWASSER,
} from '../../../public/scripts/jahresenergie.js';
const calc = CALCULATORS.find(c => c.slug === 'jahresenergieverbrauch')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;

const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const ct = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });
const dez = (n: number, s = 2) => n.toLocaleString('de-DE', { minimumFractionDigits: s, maximumFractionDigits: s });
const stand = HEIZKOSTEN_STAND.split('-').reverse().join('/');

// Vorbelegte Preise je Einheit aus den Modulen. Heizöl rechnet heizkosten.js
// je kWh; auf der Rechnung steht der Literpreis.
const OEL_CENT_JE_LITER = Math.round(BRENNSTOFFE.heizoel.arbeitspreisCent * kwhJeLiterHeizoel());
const PREISE = {
  gas: BRENNSTOFFE.gas.arbeitspreisCent,
  heizoel: OEL_CENT_JE_LITER,
  fernwaerme: BRENNSTOFFE.fernwaerme.arbeitspreisCent,
  waermepumpe: WAERMEPUMPENSTROM_CENT_PRO_KWH,
};

// Beispiel: dieselbe Heizmenge in einer 100-m²-Wohnung und in einem Haus mit
// beheiztem Keller – zeigt, wie stark der Flächenfaktor die Klasse verschiebt.
const bspWohnung = berechneJahresenergie({ strom: {}, heizung: { traeger: 'gas', menge: 13000, preisCentJeEinheit: PREISE.gas }, wohnflaeche: 100 });
const bspHaus = berechneJahresenergie({ strom: {}, heizung: { traeger: 'gas', menge: 13000, preisCentJeEinheit: PREISE.gas }, wohnflaeche: 100, mitBeheiztemKeller: true });
const bspDezentral = berechneJahresenergie({ strom: {}, heizung: { traeger: 'gas', menge: 13000, preisCentJeEinheit: PREISE.gas }, wohnflaeche: 100, dezentralesWarmwasser: true });
if (!bspWohnung.kennwert || !bspHaus.kennwert || bspHaus.kennwert.kwhJeQm >= bspWohnung.kennwert.kwhJeQm) {
  throw new Error('Jahresenergie: Beispiel widerspricht § 82 Abs. 2 GModG');
}

const klassenZeilen = EFFIZIENZKLASSEN.map((k, i) => {
  const von = i === 0 ? '' : 'über ' + EFFIZIENZKLASSEN[i - 1].bis + ' ';
  const bis = Number.isFinite(k.bis) ? 'bis ' + k.bis : '';
  return '<tr><td>' + k.klasse + '</td><td>' + (von + bis).trim() + '</td></tr>';
}).join('');

const guideHtml = `
<h3>Der Verbrauch steht auf der Abrechnung</h3>
<p>Wie viel Energie ein Haushalt verbraucht, lässt sich nicht aus Personenzahl oder Baujahr ableiten – zu unterschiedlich sind Gebäude, Geräte und Gewohnheiten. Die Jahresabrechnungen nennen die Mengen genau: Kilowattstunden Strom, Kilowattstunden Gas oder Fernwärme, Liter Heizöl und Kubikmeter Wasser, jeweils mit Arbeits- und Grundpreis. Genau diese Werte fragt der Rechner ab.</p>
<p>Vorbelegt sind ${STROMPREIS_REFERENZVERBRAUCH_KWH.toLocaleString('de-DE')} kWh Strom, der Referenzverbrauch der ${STROMPREIS_QUELLE}, zum dortigen Durchschnittspreis von ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh. Die Heizpreise sind datierte Marktannahmen (Stand ${stand}): Erdgas ${ct(PREISE.gas)} ct/kWh, Heizöl ${OEL_CENT_JE_LITER} ct/Liter, Fernwärme ${ct(PREISE.fernwaerme)} ct/kWh, Wärmepumpenstrom ${ct(PREISE.waermepumpe)} ct/kWh. Ersetzen Sie alle Werte durch die Ihrer Rechnungen. Für Wasser gibt es keinen bundesweiten Preis; die Zeile zählt nur mit, wenn Sie Menge und Preis eintragen.</p>
<p>Heizöl wird auf Kilowattstunden umgerechnet, damit sich der Verbrauch mit Gas oder Fernwärme vergleichen lässt – mit ${HEIZWERT_HEIZOEL_EL_KWH_JE_LITER} kWh je Liter, dem Heizwert für Heizöl EL nach § 9 Abs. 3 der Heizkostenverordnung. Auf diese Werte verweist die Bekanntmachung der Regeln für Energieverbrauchswerte im Wohngebäudebestand vom 29. März 2021 für den Energieverbrauchsausweis. Nur der vorbelegte Literpreis ist aus dem Kilowattstundenpreis mit dem Standardwert der EBeV 2030 von ${dez(kwhJeLiterHeizoel())} kWh je Liter umgerechnet.</p>

<h3>Einordnung wie im Energieverbrauchsausweis</h3>
<p>Der Energieverbrauchsausweis gibt den Verbrauch für Heizung und Warmwasser je Quadratmeter Gebäudenutzfläche an (§ 82 Abs. 2 GModG). Diese Fläche ist größer als die Wohnfläche. Ist sie nicht bekannt, darf sie bei Wohngebäuden mit bis zu zwei Wohneinheiten und beheiztem Keller mit dem ${dez(NUTZFLAECHE_FAKTOR.mitBeheiztemKeller)}-Fachen, sonst mit dem ${dez(NUTZFLAECHE_FAKTOR.sonstige, 1)}-Fachen der Wohnfläche angesetzt werden. Wird das Warmwasser dezentral erzeugt, etwa per Durchlauferhitzer, und ist dessen Verbrauch unbekannt, kommen ${ZUSCHLAG_DEZENTRALES_WARMWASSER} kWh je Quadratmeter hinzu.</p>
<p>Wie viel das ausmacht, zeigt ein Beispiel mit 13.000 kWh Gas und 100 m² Wohnfläche: In einer Wohnung sind das ${bspWohnung.kennwert.kwhJeQm} kWh/m² und Klasse ${bspWohnung.kennwert.klasse}, im Einfamilienhaus mit beheiztem Keller ${bspHaus.kennwert.kwhJeQm} kWh/m² und Klasse ${bspHaus.kennwert.klasse}. Mit dezentralem Warmwasser wird die Wohnung zu ${bspDezentral.kennwert.kwhJeQm} kWh/m² und Klasse ${bspDezentral.kennwert.klasse}.</p>
<table>
<thead><tr><th>Klasse</th><th>kWh je m² Nutzfläche und Jahr</th></tr></thead>
<tbody>${klassenZeilen}</tbody>
</table>
<p>Die Klassen stammen aus Anlage 10 GModG. Ein Ausweiswert ist das Ergebnis trotzdem nicht: § 82 Abs. 3 GModG verlangt eine Witterungsbereinigung des Heizverbrauchs, die ein kalter oder milder Winter sonst verzerrt. Vergleichen Sie deshalb mehrere Jahre miteinander.</p>
<p>Bei Gas kommt ein zweiter Unterschied hinzu: Verbrauchsangaben, die sich auf den Brennwert beziehen, rechnet der Ausweis auf den unteren Heizwert um (Nr. 2 der Bekanntmachung, Faktor nach DIN V 18599-1). Der Kennwert aus den Kilowattstunden der Rechnung liegt dann zu hoch. Mit drei Abrechnungsjahren und Gasmengen in Kubikmetern rechnet die <a href="${base}energie/energieausweis-vorberechnung/">Energieausweis-Vorberechnung</a>.</p>
`;

const faqs = [
  { q: 'Woher bekomme ich meine Verbrauchswerte?', a: 'Aus den Jahresabrechnungen von Stromversorger, Gasversorger oder Fernwärmeanbieter, aus Heizöl-Lieferscheinen und aus der Wasserabrechnung. Mieter finden Heizung und Wasser in der Betriebs- und Heizkostenabrechnung.' },
  { q: 'Welche Effizienzklassen gibt es?', a: 'Anlage 10 GModG kennt neun Klassen: A+ bis 30, A bis 50, B bis 75, C bis 100, D bis 130, E bis 160, F bis 200, G bis 250 und H über 250 kWh je Quadratmeter Gebäudenutzfläche und Jahr.' },
  { q: 'Warum rechnet der Rechner mit mehr Fläche als meiner Wohnfläche?', a: `Weil der Energieausweis die Gebäudenutzfläche verwendet. Ist sie unbekannt, erlaubt § 82 Abs. 2 GModG den Ansatz mit dem ${dez(NUTZFLAECHE_FAKTOR.sonstige, 1)}-Fachen der Wohnfläche, bei höchstens zwei Wohneinheiten mit beheiztem Keller mit dem ${dez(NUTZFLAECHE_FAKTOR.mitBeheiztemKeller)}-Fachen.` },
  { q: 'Ist das Ergebnis mein Energieausweis-Wert?', a: 'Nein. Der Ausweis bereinigt den Heizverbrauch um die Witterung (§ 82 Abs. 3 GModG), verlangt Abrechnungen aus mindestens 36 Monaten (§ 82 Abs. 4) und rechnet brennwertbezogene Gasmengen auf den Heizwert um. Der Rechner ordnet ein einzelnes Jahr ohne diese Schritte ein.' },
  { q: 'Warum kann ich keine Pellets auswählen?', a: 'Pellets werden in Kilogramm oder Tonnen abgerechnet, und für die Umrechnung in Kilowattstunden hat der Rechner keinen belegten Standardwert. Liegt Ihnen der Verbrauch in kWh vor, wählen Sie Fernwärme als Rechenweg.' },
];
---
<Layout
  title={`Jahresenergieverbrauch ${year}`}
  description="Strom, Heizung und Wasser aus den eigenen Abrechnungen zusammenrechnen und den Heizverbrauch nach § 82 GModG und Anlage 10 in eine Effizienzklasse einordnen."
  canonicalPath="/energie/jahresenergieverbrauch/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Jahresenergieverbrauch {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Tragen Sie die Mengen und Preise aus Ihren Jahresabrechnungen ein. Der Rechner zeigt die Energiekosten des Haushalts und ordnet den Heizverbrauch nach den Regeln des Energieverbrauchsausweises ein – ohne Witterungsbereinigung und ohne Heizwert-Umrechnung für Gas."
    sourceNote={`Mengen und Preise sind Ihre Eingaben. Vorbelegung: Strom ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh und ${STROMPREIS_REFERENZVERBRAUCH_KWH.toLocaleString('de-DE')} kWh nach ${STROMPREIS_QUELLE}; Heizpreise als Marktannahme Stand ${stand}. Heizöl ${HEIZWERT_HEIZOEL_EL_KWH_JE_LITER} kWh/l nach § 9 Abs. 3 HeizkostenV; Literpreis-Vorbelegung mit ${dez(kwhJeLiterHeizoel())} kWh/l nach EBeV 2030 Anlage 2 umgerechnet. Kennwert und Klasse nach § 82 Abs. 2 und Anlage 10 GModG (abgerufen am 15.09.2026), ohne Witterungsbereinigung und bei Gas ohne Umrechnung von Brennwert auf Heizwert.`}
    explanation={`Kennwert = Heizenergie in kWh ÷ Gebäudenutzfläche (Wohnfläche × ${dez(NUTZFLAECHE_FAKTOR.sonstige, 1)} bzw. × ${dez(NUTZFLAECHE_FAKTOR.mitBeheiztemKeller)}), bei dezentralem Warmwasser + ${ZUSCHLAG_DEZENTRALES_WARMWASSER} kWh/m².`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="strom_kwh">Strom (kWh/Jahr)</label>
          <input type="number" id="strom_kwh" min="0" max="100000" value={STROMPREIS_REFERENZVERBRAUCH_KWH} step="50" />
        </div>
        <div class="calc-group">
          <label for="strom_preis">Strom-Arbeitspreis (ct/kWh)</label>
          <input type="number" id="strom_preis" min="0" max="200" value={STROMPREIS_CENT_PRO_KWH} step="0.1" />
        </div>
        <div class="calc-group">
          <label for="strom_grund">Strom-Grundpreis (€/Jahr)</label>
          <input type="number" id="strom_grund" min="0" max="2000" value="0" step="5" />
        </div>
        <div class="calc-group">
          <label for="traeger">Heizung</label>
          <select id="traeger" data-preise={JSON.stringify(PREISE)}>
            <option value="gas" selected>Erdgas (kWh)</option>
            <option value="heizoel">Heizöl (Liter)</option>
            <option value="fernwaerme">Fernwärme (kWh)</option>
            <option value="waermepumpe">Wärmepumpe (kWh Strom)</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="heiz_menge">Heizenergie laut Abrechnung (<span id="einheit">kWh</span>/Jahr)</label>
          <input type="number" id="heiz_menge" min="0" max="500000" value="12000" step="100" />
        </div>
        <div class="calc-group">
          <label for="heiz_preis">Heiz-Arbeitspreis (ct je <span id="einheit2">kWh</span>)</label>
          <input type="number" id="heiz_preis" min="0" max="500" value={PREISE.gas} step="0.1" />
        </div>
        <div class="calc-group">
          <label for="heiz_grund">Heiz-Grundpreis (€/Jahr)</label>
          <input type="number" id="heiz_grund" min="0" max="5000" value="0" step="5" />
        </div>
        <div class="calc-group">
          <label for="wasser_m3">Wasser (m³/Jahr, optional)</label>
          <input type="number" id="wasser_m3" min="0" max="10000" step="1" placeholder="—" />
        </div>
        <div class="calc-group">
          <label for="wasser_preis">Wasser und Abwasser (€/m³, optional)</label>
          <input type="number" id="wasser_preis" min="0" max="50" step="0.01" placeholder="—" />
        </div>
        <div class="calc-group">
          <label for="flaeche">Wohnfläche (m², für die Einordnung)</label>
          <input type="number" id="flaeche" min="0" max="2000" value="100" step="1" />
        </div>
        <div class="calc-group">
          <label><input type="checkbox" id="keller" style="width:auto;margin-right:0.4rem;" />Höchstens zwei Wohneinheiten mit beheiztem Keller</label>
          <label><input type="checkbox" id="dezentral" style="width:auto;margin-right:0.4rem;" />Warmwasser dezentral (z. B. Durchlauferhitzer)</label>
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Energiekosten im Jahr</div>
        <div id="ergebnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.9rem;color:#555;display:flex;flex-direction:column;gap:0.3rem;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Energieverbrauch aus der Abrechnung einordnen"
    content={guideHtml}
    relatedSlugs={['heizkosten-rechner', 'stromkosten-rechner', 'energieausweis-vorberechnung']}
  />
</Layout>

<script type="module">
const { berechneJahresenergie, HEIZENERGIETRAEGER } = await import(window.__base + 'scripts/jahresenergie.js');
const eur = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
const traegerFeld = document.getElementById('traeger');
const PREISE = JSON.parse(traegerFeld.dataset.preise);
function berechne() {
  const traeger = traegerFeld.value;
  const einheit = HEIZENERGIETRAEGER[traeger].einheit;
  document.getElementById('einheit').textContent = einheit;
  document.getElementById('einheit2').textContent = einheit === 'Liter' ? 'Liter' : 'kWh';
  const r = berechneJahresenergie({
    strom: { kwh: wert('strom_kwh'), preisCent: wert('strom_preis'), grundpreisJahr: wert('strom_grund') },
    heizung: { traeger, menge: wert('heiz_menge'), preisCentJeEinheit: wert('heiz_preis'), grundpreisJahr: wert('heiz_grund') },
    wasser: { m3: wert('wasser_m3'), preisJeM3: wert('wasser_preis') },
    wohnflaeche: wert('flaeche'),
    mitBeheiztemKeller: document.getElementById('keller').checked,
    dezentralesWarmwasser: document.getElementById('dezentral').checked,
  });
  document.getElementById('ergebnis').textContent = eur(r.gesamt);
  const teile = [
    `<span>Strom: <strong>${eur(r.strom.kosten)}</strong> für ${r.strom.kwh.toLocaleString('de-DE')} kWh</span>`,
    `<span>Heizung: <strong>${eur(r.heizung.kosten)}</strong> für ${r.heizung.kwh.toLocaleString('de-DE')} kWh</span>`,
  ];
  if (r.wasser) teile.push(`<span>Wasser: <strong>${eur(r.wasser.kosten)}</strong> für ${r.wasser.m3.toLocaleString('de-DE')} m³</span>`);
  teile.push(`<span>Je Monat: <strong>${eur(r.monat)}</strong></span>`);
  if (r.kennwert) teile.push(`<span>Heizkennwert: <strong>${r.kennwert.kwhJeQm} kWh/m²</strong> bei ${r.kennwert.nutzflaeche.toLocaleString('de-DE')} m² Nutzfläche – Klasse <strong>${r.kennwert.klasse}</strong> (ohne Witterungsbereinigung${r.kennwert.brennwertbezogen ? '; Gas nach Brennwert abgerechnet? Dann liegt der Ausweiswert niedriger' : ''})</span>`);
  document.getElementById('details').innerHTML = teile.join('');
}
traegerFeld.addEventListener('change', () => {
  document.getElementById('heiz_preis').value = PREISE[traegerFeld.value];
  berechne();
});
document.querySelectorAll('.calc-form input').forEach((el) => {
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
berechne();
</script>
