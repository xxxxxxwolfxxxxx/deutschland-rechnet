---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'jahresenergieverbrauch')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Jahresenergieverbrauch ${year}`}
  description="Strom-, Gas- und Wasserverbrauch deines Haushalts berechnen – mit Vergleich zum Durchschnitt."
  canonicalPath="/energie/jahresenergieverbrauch/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Jahresenergieverbrauch {year}</h1>
  </div>
   <CalculatorShell
     calculator={calc}
     intro="Schätzen Sie den Jahresenergieverbrauch Ihres Haushalts für Strom, Gas und Wasser. So erkennen Sie, ob Ihr Verbrauch über dem Durchschnitt liegt und wo Sie sparen können."
     sourceNote="Strom, Gas, Wasser."
     explanation="Der Verbrauch wird anhand deutscher Durchschnittswerte für verschiedene Haushaltsgrößen geschätzt. Ein 2-Personen-Haushalt verbraucht im Schnitt 2.500 kWh Strom und 12.000 kWh Gas pro Jahr."
      faqs={[
        { q: "Wie vergleiche ich meinen Verbrauch mit dem Durchschnitt?", a: "Durchschnittswerte: Strom 1-Person 1.500 kWh/a, 2-Person 2.500 kWh/a, 4-Person 3.500 kWh/a. Gas 1-Person 5.000 kWh/a, 4-Person 20.000 kWh/a (unsaniert). Sparhaushalte sind 20-30% unter diesen Werten." },
        { q: "Warum ist mein Verbrauch höher als der Durchschnitt?", a: "Mögliche Gründe: Schlechte Dämmung (vor 1978), alte Heizung, zu hohe Raumtemperatur (jedes °C +6%), alte/viele Elektrogeräte, häufige Dusche/Bad. Ein hydraulischer Abgleich oder Heizungsprüfung kann schon 10-20% sparen." },
        { q: "Wie zuverlässig sind die prognostizierten Verbrauchswerte?", a: "Sehr zuverlässig für den Wärmebedarf (±10-15% Unsicherheit), da dieser von Gebäudephysik bestimmt wird. Stromverbrauch hängt mehr von Nutzerverhalten ab (±20-30%). Witterung kann Jahr zu Jahr stark variieren (kalter Winter +20%)." },
        { q: "Kann ich meinen Energieverbrauch senken, ohne die Heizung zu wechseln?", a: "Ja, mit einfachen Maßnahmen: 1°C Temperatursenkung = 6-8%, Fenster abdichten (2-5%), Duschköpfe-Sparaufsätze (10-15% Wasser), alte Heizpumpe prüfen (5%). Größere Effekte: Isolierung von Heizungsrohren (10%), Heizkörper-Thermostaten (5-10%)." },
        { q: "Wie viel kostet mich eine kWh Energie durchschnittlich?", a: "2024: Strom ~35-45 ct/kWh (regional unterschiedlich), Gas ~10-15 ct/kWh, Wasser ~2-3 €/m³. Für einen Durchschnittshaushalt (2.500 kWh Strom + 15.000 kWh Gas): ~2.000-2.500 €/a. Prognose: Strom ab 2025 günstiger durch Windkraft-Ausbau." },
        { q: "Wie schnell amortisiert sich eine Energiesparberatung?", a: "Eine professionelle Energieberatung vor Ort kostet nach BAFA-Förderung (bis zu 80 % Zuschuss, gedeckelt) für Eigentümer meist nur noch 30 bis 100 Euro Eigenanteil. Sie führt oft zu 15-25 % Einsparung und amortisiert sich damit in der Regel innerhalb von 1 bis 2 Jahren." },
        { q: "Wie viel Strom verbraucht ein Haushalt pro Person?", a: "Als Richtwert gelten rund 1.500 kWh für den ersten Haushaltsmitglied und je etwa 800-1.000 kWh für jede weitere Person, da sich Grundlasten wie Kühlschrank oder Router teilen. Ein 1-Personen-Haushalt liegt so bei ca. 1.500 kWh, ein 4-Personen-Haushalt bei rund 3.500-4.000 kWh pro Jahr." },
        { q: "Erhöht elektrische Warmwasserbereitung meinen Stromverbrauch stark?", a: "Ja, deutlich. Wird das Warmwasser über einen elektrischen Durchlauferhitzer oder Boiler erzeugt statt über die Zentralheizung, kommen pro Person etwa 500-800 kWh Strom pro Jahr hinzu. Ein 3-Personen-Haushalt kann dadurch 1.500-2.400 kWh mehr Strom verbrauchen." },
        { q: "Wie hoch ist der Heizenergiebedarf pro Quadratmeter?", a: "Das hängt stark vom Baustandard ab: unsanierte Altbauten (vor 1978) benötigen 150-250 kWh/m² pro Jahr, Gebäude der 1980er/90er rund 100 kWh/m², moderne Neubauten 50-70 kWh/m² und KfW-Effizienz- oder Passivhäuser nur 15-40 kWh/m². Multipliziert mit der Wohnfläche ergibt das den Jahres-Heizwärmebedarf." }
      ]}
   >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="personen">Anzahl Personen im Haushalt</label>
          <input type="number" id="personen" min="1" max="10" value="2" step="1" />
        </div>
        <div class="calc-group">
          <label for="wohnflaeche">Wohnfläche (m²)</label>
          <input type="number" id="wohnflaeche" min="20" max="300" value="80" step="5" />
        </div>
        <div class="calc-group">
          <label for="baujahr">Baujahr des Gebäudes</label>
          <select id="baujahr">
            <option value="vor1978">vor 1978 (unsaniert)</option>
            <option value="1979-1995" selected>1979-1995</option>
            <option value="1996-2009">1996-2009</option>
            <option value="nach2010">nach 2010 (effizient)</option>
            <option value="nach2020">nach 2020 (KfW/Effizienzhaus)</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="warmewasser">Warmwasseraufbereitung</label>
          <select id="warmewasser">
            <option value="zentral" selected>Zentral über Heizung</option>
            <option value="dezentral">Dezentral (Durchlauferhitzer)</option>
            <option value="solar">Solarunterstützt</option>
          </select>
        </div>
      </div>
       <div class="calc-result">
         <div class="label">Gesamtenergiekosten pro Jahr</div>
         <div id="ergebnis">— €</div>
         <div class="result-actions">
           <button 
             data-copy-result="#ergebnis" 
             class="btn-copy"
             title="Resultat kopieren"
           >
             📋 Kopieren
           </button>
           <button 
             data-save-pdf="#ergebnis" 
             class="btn-pdf"
             title="Als PDF speichern"
           >
             📄 PDF
           </button>
         </div>
       </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

<script type="module">
function berechne() {
  const personen = parseInt(document.getElementById('personen').value) || 2;
  const wohnflaeche = parseFloat(document.getElementById('wohnflaeche').value) || 80;
  const baujahr = document.getElementById('baujahr').value;
  const warmewasser = document.getElementById('warmewasser').value;
  
  // Grundverbrauchswerte (Durchschnitt Deutschland)
  const stromProPerson = 750; // kWh/Jahr pro Person
  const wasserProPersonProTag = 125; // Liter/Tag pro Person
  
  // Heizwärmebedarf abhängig von Baujahr und Wohnfläche
  let spezHeizwaermeBedarf;
  switch (baujahr) {
    case 'vor1978': spezHeizwaermeBedarf = 160; break; // kWh/(m²·a)
    case '1979-1995': spezHeizwaermeBedarf = 100; break;
    case '1996-2009': spezHeizwaermeBedarf = 70; break;
    case 'nach2010': spezHeizwaermeBedarf = 50; break;
    case 'nach2020': spezHeizwaermeBedarf = 35; break;
    default: spezHeizwaermeBedarf = 80;
  }
  
  // Warmwasserzuschlag
  const wwZuschlag = warmewasser === 'dezentral' ? 1.3 : 
                     warmewasser === 'solar' ? 0.7 : 1.0;
  
  // Berechnungen
  const jahresStrom = personen * stromProPerson;
  const jahresWasserLiter = personen * wasserProPersonProTag * 365;
  const jahresWasserM3 = jahresWasserLiter / 1000;
  const jahresHeizwaermeKwh = wohnflaeche * spezHeizwaermeBedarf * wwZuschlag;
  
  // Energiepreise (Durchschnitt 2024)
  const stromPreis = 0.42; // €/kWh
  const gasPreis = 0.12; // €/kWh
  const wasserPreis = 1.80; // €/m³ (inkl. Abwasser)
  
  // Kosten
  const stromKosten = jahresStrom * stromPreis;
  const gasKosten = jahresHeizwaermeKwh * gasPreis;
  const wasserKosten = jahresWasserM3 * wasserPreis;
  const gesamtKosten = stromKosten + gasKosten + wasserKosten;
  
  // Vergleichswerte (2-Personen-Haushalt, 80m², Baujahr 1990-2010)
  const vergleichStrom = 2 * stromProPerson * stromPreis;
  const vergleichGas = 80 * 85 * gasPreis; // Durchschnittswert
  const vergleichWasser = 2 * wasserProPersonProTag * 365 / 1000 * wasserPreis;
  const vergleichGesamt = vergleichStrom + vergleichGas + vergleichWasser;
  
  const fmt = (n) => n.toLocaleString('de-DE', {minimumFractionDigits:0, maximumFractionDigits:0}) + ' €';
  const fmtWh = (n) => n.toLocaleString('de-DE', {minimumFractionDigits:0}) + ' kWh';
  const fmtLiter = (n) => n.toLocaleString('de-DE', {minimumFractionDigits:0}) + ' Liter';
  const fmtM3 = (n) => n.toLocaleString('de-DE', {minimumFractionDigits:1}) + ' m³';
  
  document.getElementById('ergebnis').textContent = fmt(gesamtKosten);
  document.getElementById('ergebnis').style.color = gesamtKosten < vergleichGesamt ? '#1e7e34' : '#b71c1c';
  
  document.getElementById('details').innerHTML =
    `<span>Stromverbrauch: <strong>${fmtWh(jahresStrom)}</strong> (Vergleich: ${fmtWh(2 * stromProPerson)})</span>` +
    `<span>Stromkosten: <strong>${fmt(stromKosten)}</strong> (Vergleich: ${fmt(vergleichStrom)})</span>` +
    `<span>Heizwärme: <strong>${fmtWh(jahresHeizwaermeKwh)}</strong> (Vergleich: ${fmtWh(80 * 85)})</span>` +
    `<span>Heizkosten: <strong>${fmt(gasKosten)}</strong> (Vergleich: ${fmt(vergleichGas)})</span>` +
    `<span>Wasserverbrauch: <strong>${fmtLiter(jahresWasserLiter)}</strong> (${fmtM3(jahresWasserM3)})</span>` +
    `<span>Wasserkosten: <strong>${fmt(wasserKosten)}</strong> (Vergleich: ${fmt(vergleichWasser)})</span>` +
    `<span>Dein Gesamtverbrauch: <strong>${((gesamtKosten/vergleichGesamt-1)*100).toFixed(1)}%</strong> gegenüber Durchschnitt</span>`;
}
['personen','wohnflaeche'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
['baujahr','warmewasser'].forEach(id => document.getElementById(id).addEventListener('change', berechne));
berechne();
</script>

<CalculatorGuide
  title="Energieverbrauch realistisch bewerten"
  content={`<p>Der Jahresenergieverbrauch eines Haushalts setzt sich aus drei Teilen zusammen: <strong>Heizwärme</strong> (ca. 70-80 % des Gesamtverbrauchs), <strong>Warmwasser</strong> (ca. 10-15 %) und <strong>Strom</strong> für Beleuchtung und Geräte (ca. 10 %). Wie hoch der Verbrauch ausfällt, hängt vor allem vom Gebäudezustand, vom Nutzerverhalten und von der Witterung des jeweiligen Jahres ab. Die folgenden Richtwerte (Stand 2026) helfen Ihnen, Ihren eigenen Verbrauch einzuordnen.</p>

<h4>Stromverbrauch nach Haushaltsgröße</h4>
<p>Der Stromverbrauch steigt mit jeder Person, aber nicht linear – Grundlasten wie Kühlschrank, Router oder Standby-Geräte teilen sich auf alle Bewohner auf. Deutlich höher liegt der Verbrauch, wenn das Warmwasser elektrisch (per Durchlauferhitzer oder Boiler) statt über die Heizung erzeugt wird.</p>
<table>
  <thead>
    <tr><th>Haushaltsgröße</th><th>Ohne Warmwasser (Strom)</th><th>Mit elektr. Warmwasser</th></tr>
  </thead>
  <tbody>
    <tr><td>1 Person</td><td>ca. 1.500 kWh/a</td><td>ca. 2.300 kWh/a</td></tr>
    <tr><td>2 Personen</td><td>ca. 2.500 kWh/a</td><td>ca. 3.600 kWh/a</td></tr>
    <tr><td>3 Personen</td><td>ca. 3.200 kWh/a</td><td>ca. 4.700 kWh/a</td></tr>
    <tr><td>4 Personen</td><td>ca. 3.800 kWh/a</td><td>ca. 5.500 kWh/a</td></tr>
    <tr><td>5 Personen</td><td>ca. 4.500 kWh/a</td><td>ca. 6.500 kWh/a</td></tr>
  </tbody>
</table>

<h4>Heizenergiebedarf nach Gebäudestandard</h4>
<p>Der Heizwärmebedarf wird in Kilowattstunden pro Quadratmeter und Jahr (kWh/m²·a) angegeben. Multipliziert mit Ihrer Wohnfläche ergibt sich der Jahres-Heizwärmebedarf. Der Unterschied zwischen einem unsanierten Altbau und einem Passivhaus ist enorm – bis zum Fünf- bis Zehnfachen.</p>
<table>
  <thead>
    <tr><th>Gebäudestandard</th><th>Heizbedarf (kWh/m²·a)</th><th>Beispiel 100 m²</th></tr>
  </thead>
  <tbody>
    <tr><td>Altbau unsaniert (vor 1978)</td><td>150-250</td><td>15.000-25.000 kWh</td></tr>
    <tr><td>Bestand 1979-1995</td><td>100-150</td><td>10.000-15.000 kWh</td></tr>
    <tr><td>Bestand 1996-2009</td><td>70-100</td><td>7.000-10.000 kWh</td></tr>
    <tr><td>Neubau ab 2010</td><td>50-70</td><td>5.000-7.000 kWh</td></tr>
    <tr><td>KfW-Effizienzhaus / Neubau ab 2020</td><td>30-50</td><td>3.000-5.000 kWh</td></tr>
    <tr><td>Passivhaus</td><td>≤ 15</td><td>≤ 1.500 kWh</td></tr>
  </tbody>
</table>

<h4>Faktoren, die den Verbrauch beeinflussen</h4>
<p>Der <strong>Gebäudezustand</strong> ist der dominante Faktor – Außenwanddämmung, Fensterqualität und Heizungstechnik entscheiden über den Großteil des Verbrauchs. Daneben zählt das <strong>Nutzerverhalten</strong>: Jedes Grad höhere Raumtemperatur erhöht den Heizbedarf um etwa 6 %, auch Lüftungsgewohnheiten, Duschfrequenz und die Effizienz der Elektrogeräte spielen eine Rolle. Die <strong>Witterung</strong> schwankt von Jahr zu Jahr um rund ±15 % – ein kalter Winter kann den Heizverbrauch spürbar nach oben treiben.</p>

<h4>Verbrauch senken und Sparpotenziale erkennen</h4>
<p>Die größten Einsparungen bringt eine <strong>Gebäudesanierung</strong> (Dämmung, neue Fenster, moderne Heizung) mit 40-60 %. Ohne bauliche Maßnahmen helfen: hydraulischer Abgleich der Heizung (10-15 %), moderne Thermostatventile (5-10 %), Dämmung freiliegender Heizungsrohre (3-5 %) und der Austausch alter Heizungspumpen. Beim Strom senken LED-Beleuchtung (10-15 %), der Austausch alter Großgeräte (10-20 %) und das konsequente Abschalten von Standby-Geräten (5-10 %) den Verbrauch.</p>

<h4>So ordnen Sie Ihren eigenen Verbrauch ein</h4>
<p>Der Vergleich mit dem statistischen Durchschnitt ist nützlich, sollte aber realistisch interpretiert werden: Ein älterer Bestand hat naturgemäß höhere Werte als ein Neubau. Entscheidend ist die eigene Entwicklung über die Jahre – stabile Werte sind gut, steigende deuten auf Verschleiß von Heizung oder Fenstern hin. Die Heizwärmeprognose ist mit rund ±10 % recht zuverlässig, weil sie auf der Gebäudephysik beruht; der Stromverbrauch schwankt mit ±20-30 % stärker, weil er stark vom Verhalten abhängt. Eine BAFA-geförderte Energieberatung deckt konkrete Sparpotenziale für Ihr Gebäude auf.</p>`}
  relatedSlugs={['heizkosten-rechner', 'energieausweis-vorberechnung', 'co2-einsparung-renovierung']}
/>
</Layout>