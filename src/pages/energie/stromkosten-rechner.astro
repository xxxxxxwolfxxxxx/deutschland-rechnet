---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  STROMPREIS_CENT_PRO_KWH,
  STROMPREIS_QUELLE,
  STROMPREIS_REFERENZVERBRAUCH_KWH,
  STROMPREIS_BESTANDTEILE,
  STROMPREIS_UMLAGEN,
  STROMPREIS_AMTLICH,
  stromkostenProJahr,
} from '../../../public/scripts/strompreis.js';
const calc = CALCULATORS.find(c => c.slug === 'stromkosten-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

const euro = (b: number) => b.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const euro2 = (b: number) => b.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const ct = (b: number) => b.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 3 });
const kwh = (b: number) => b.toLocaleString('de-DE') + ' kWh';

const HAUSHALTE = [
  { label: '1 Person', verbrauchKwh: 1500 },
  { label: '2 Personen', verbrauchKwh: 2500 },
  { label: '3 Personen', verbrauchKwh: 3500 },
  { label: '4 Personen', verbrauchKwh: 4500 },
  { label: '5+ Personen', verbrauchKwh: 5500 },
];

// Die Vergleichstabelle entsteht zur Buildzeit aus demselben Modul, mit dem
// der Rechner im Browser arbeitet. Text und Ergebnis können so nicht mehr
// auseinanderlaufen – genau daran war diese Seite vorher gescheitert.
const vergleich = HAUSHALTE.map(h => ({ ...h, ...stromkostenProJahr({ verbrauchKwh: h.verbrauchKwh }) }));
const musterhaushalt = stromkostenProJahr({ verbrauchKwh: STROMPREIS_REFERENZVERBRAUCH_KWH });
---
<Layout
  title={`Stromkosten-Rechner ${year}`}
  description={`Stromkosten ${year} berechnen: Jahresverbrauch in Euro umrechnen mit dem durchschnittlichen Haushaltsstrompreis von ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh (${STROMPREIS_QUELLE}). Vergleichstabelle für 1-5-Personen-Haushalte und konkrete Spartipps.`}
  canonicalPath="/energie/stromkosten-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Stromkosten-Rechner {year} – kWh in Euro umrechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Berechnen Sie Ihre jährlichen Stromkosten aus Verbrauch und Strompreis. So erkennen Sie Einsparpotenzial und können Angebote verschiedener Stromanbieter vergleichen."
    sourceNote={`Kosten = Verbrauch × Preis. Voreingestellt sind ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh – der durchschnittliche Strompreis für Haushalte 2026 nach der BDEW-Strompreisanalyse April 2026 (Datenstand 04/2026, abgerufen am 12.08.2026), bezogen auf einen Jahresverbrauch von ${kwh(STROMPREIS_REFERENZVERBRAUCH_KWH)} und einschließlich des anteiligen Grundpreises.`}
    explanation={`Der durchschnittliche Haushaltsstrompreis liegt 2026 bei ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh einschließlich aller Steuern, Abgaben und Umlagen sowie des anteiligen Grundpreises. Ein typischer Haushalt verbraucht 1.500 bis 5.500 kWh im Jahr, je nach Personenzahl.`}
    faqs={[
      { q: "Was ist eine kWh?", a: "Eine Kilowatt-Stunde (kWh) ist die Energiemenge, die ein 1 kW-Gerät in einer Stunde verbraucht. Beispiel: Ein 100W-Gerät verbraucht in 10 Stunden 1 kWh. Der Stromzähler zeigt den Verbrauch in kWh." },
      { q: "Wie hoch ist ein durchschnittlicher Stromverbrauch?", a: "1-Person-Haushalt: 1.500 kWh/Jahr, 2-Person: 2.500 kWh, 3-Person: 3.500 kWh, 4-Person: 4.500 kWh. Mit elektrischer Heizung oder Wärmepumpe kann der Verbrauch verdoppeln sich." },
      { q: "Ist der Grundpreis im Ergebnis enthalten?", a: `Anteilig ja. Der voreingestellte Durchschnittspreis von ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh ist ein Vollpreis: Der BDEW legt ihn auf einen Jahresverbrauch von ${kwh(STROMPREIS_REFERENZVERBRAUCH_KWH)} um und rechnet die monatliche Grundgebühr darin ein, ebenso die Mehrwertsteuer. Sie dürfen den Grundpreis also nicht noch einmal aufschlagen. Zwei Einschränkungen: Bei deutlich kleinerem Verbrauch verteilt sich der Grundpreis auf weniger Kilowattstunden, die Rechnung fällt dann etwas zu niedrig aus – bei sehr großem Verbrauch umgekehrt. Und wer den Arbeitspreis aus der eigenen Rechnung einträgt, muss den Grundpreis selbst dazurechnen.` },
      { q: "Wie kann ich Strom sparen?", a: "LED-Lampen statt Glühbirnen, Geräte ausschalten (nicht nur Stand-by), Kühlschrank nicht neben Herd stellen, duschen statt baden (falls Boiler), Waschamaschine nur voll laden, bei neuen Geräten auf Effizienzklasse achten." },
      { q: "Lohnt sich eine Wärmepumpe wirtschaftlich?", a: "Bei hohen Strompreisen und altér Heizung: Ja. Wärmepumpen brauchen ca. 3x weniger Energie als Heizöl/Gas-Heizungen (COP 3-4). Mit Solaranlage noch besser. Kosten: 10.000-30.000€, amortisiert sich in 10-15 Jahren." },
      { q: "Wie hoch ist der Strompreis 2026 wirklich?", a: `Es kommt darauf an, welche Zahl gemeint ist. Der BDEW ermittelt für 2026 einen Durchschnitt von ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh – das ist der Preis der Tarife, die Sie heute abschließen können. Das Statistische Bundesamt kommt für das ${STROMPREIS_AMTLICH.zeitraum} auf ${ct(STROMPREIS_AMTLICH.centProKwh)} ct/kWh, weil es misst, was Haushalte in ihren bestehenden Verträgen tatsächlich zahlen. Die Lücke von rund ${ct(Math.round((STROMPREIS_AMTLICH.centProKwh - STROMPREIS_CENT_PRO_KWH) * 10) / 10)} ct/kWh ist ungefähr das, was ein Tarifwechsel bringen kann – bei ${kwh(STROMPREIS_REFERENZVERBRAUCH_KWH)} sind das gut ${euro(Math.round((STROMPREIS_AMTLICH.centProKwh - STROMPREIS_CENT_PRO_KWH) * STROMPREIS_REFERENZVERBRAUCH_KWH / 100))} im Jahr.` },
      { q: "Warum ist der Strompreis 2026 gesunken?", a: `Vor allem wegen der Netzentgelte: Sie liegen 2026 bei ${ct(STROMPREIS_BESTANDTEILE.netzentgelt)} ct/kWh und damit 1,6 ct/kWh niedriger als im Vorjahr, weil der Bund seit 2026 einen Zuschuss zu den Übertragungsnetzentgelten zahlt. Auch Beschaffung und Vertrieb sind mit ${ct(STROMPREIS_BESTANDTEILE.beschaffungUndVertrieb)} ct/kWh leicht günstiger. Die Steuern, Abgaben und Umlagen sind mit ${ct(Math.round(STROMPREIS_BESTANDTEILE.steuernAbgabenUmlagen * 10) / 10)} ct/kWh unverändert geblieben.` },
      { q: "Welche Haushaltsgeräte verbrauchen am meisten Strom?", a: "Die größten Stromfresser: 1. Warmwasserboiler (800-1.500 kWh/a), 2. Kühl-Gefrierkombination (200-400 kWh/a), 3. Waschmaschine + Trockner (300-500 kWh/a), 4. Geschirrspüler (200-300 kWh/a), 5. Beleuchtung (200-400 kWh/a). Ein alter Kühlschrank (Klasse D) verbraucht bis 3x mehr als ein neues A-Gerät." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-group">
        <label>Haushaltsgröße (Richtwert)</label>
        <div class="presets">
          <button type="button" class="preset-btn" data-kwh="1500">1 Person<span>1.500 kWh</span></button>
          <button type="button" class="preset-btn" data-kwh="2500">2 Personen<span>2.500 kWh</span></button>
          <button type="button" class="preset-btn active" data-kwh="3500">3 Personen<span>3.500 kWh</span></button>
          <button type="button" class="preset-btn" data-kwh="4500">4 Personen<span>4.500 kWh</span></button>
          <button type="button" class="preset-btn" data-kwh="5500">5+ Personen<span>5.500 kWh</span></button>
        </div>
      </div>
      <div class="calc-grid">
        <div class="calc-group">
          <label for="kwh">Jahresverbrauch (kWh)</label>
          <input type="number" id="kwh" min="0" max="100000" value="3500" step="100" />
        </div>
        <div class="calc-group">
          <label for="preis">Strompreis (Cent/kWh)</label>
          <input type="number" id="preis" min="0" max="100" value={STROMPREIS_CENT_PRO_KWH} step="0.1" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Stromkosten pro Jahr</div>
        <div id="jahr">— €</div>
      </div>
      <p id="monat" style="margin-top:0.5rem;font-size:0.95rem;color:#666;"></p>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Stromkosten verstehen und optimieren"
    content={`<p>Der durchschnittliche Strompreis für Haushalte liegt 2026 bei <strong>${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh</strong>. Die Zahl stammt aus der BDEW-Strompreisanalyse April 2026 und bezieht sich auf einen Musterhaushalt mit ${kwh(STROMPREIS_REFERENZVERBRAUCH_KWH)} Jahresverbrauch; der Grundpreis ist anteilig eingerechnet. So verteilt sich der Preis:</p>
<ul>
  <li><strong>Strombeschaffung und Vertrieb:</strong> ${ct(STROMPREIS_BESTANDTEILE.beschaffungUndVertrieb)} ct/kWh (41,3 %)</li>
  <li><strong>Netzentgelt:</strong> ${ct(STROMPREIS_BESTANDTEILE.netzentgelt)} ct/kWh (24,9 %)</li>
  <li><strong>Steuern, Abgaben und Umlagen:</strong> ${ct(Math.round(STROMPREIS_BESTANDTEILE.steuernAbgabenUmlagen * 10) / 10)} ct/kWh (33,9 %)</li>
</ul>

<p><strong>Die Abgaben im Einzelnen:</strong> Mehrwertsteuer ${ct(STROMPREIS_UMLAGEN.mehrwertsteuer)} ct/kWh, Stromsteuer ${ct(STROMPREIS_UMLAGEN.stromsteuer)} ct/kWh, Konzessionsabgabe ${ct(STROMPREIS_UMLAGEN.konzessionsabgabe)} ct/kWh, Aufschlag für besondere Netznutzung ${ct(STROMPREIS_UMLAGEN.besondereNetznutzung)} ct/kWh, Offshore-Netzumlage ${ct(STROMPREIS_UMLAGEN.offshoreNetzumlage)} ct/kWh und KWKG-Umlage ${ct(STROMPREIS_UMLAGEN.kwkgUmlage)} ct/kWh. Eine EEG-Umlage taucht hier nicht mehr auf: Sie wurde zum 1. Juli 2022 auf null gesetzt und ist seither kein Bestandteil des Strompreises. Der Ausbau der erneuerbaren Energien wird seitdem aus dem Bundeshaushalt finanziert.</p>

<p><strong>Warum der Preis 2026 gesunken ist:</strong> Der Rückgang gegenüber dem Vorjahr geht fast vollständig auf die Netzentgelte zurück, die um 1,6 ct/kWh gefallen sind – der Bund bezuschusst seit 2026 die Übertragungsnetzentgelte. Beschaffung und Vertrieb sind leicht günstiger, die Steuern und Abgaben unverändert.</p>

<h3>Stromkosten nach Haushaltsgröße (${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh, Stand 2026)</h3>
<table>
<thead><tr><th>Haushalt</th><th>Verbrauch (kWh/a)</th><th>Kosten pro Jahr</th><th>Kosten pro Monat</th></tr></thead>
<tbody>
${vergleich.map(z => `<tr><td>${z.label}</td><td>${z.verbrauchKwh.toLocaleString('de-DE')}</td><td>${euro2(z.jahr)}</td><td>${euro2(z.monat)}</td></tr>`).join('\n')}
</tbody>
</table>
<p><small>Der Grundpreis ist in den ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh bereits anteilig enthalten und wird nicht zusätzlich addiert. Genau aufgeht die Rechnung beim Musterhaushalt mit ${kwh(STROMPREIS_REFERENZVERBRAUCH_KWH)} (${euro2(musterhaushalt.jahr)} im Jahr). Bei ${kwh(1500)} verteilt sich der Grundpreis auf weniger Kilowattstunden – dort liegen die tatsächlichen Kosten etwas über dem Tabellenwert, bei ${kwh(5500)} etwas darunter.</small></p>

<h3>Zwei offizielle Zahlen, zwei Bedeutungen</h3>
<table>
<thead><tr><th>Quelle</th><th>Zeitraum</th><th>Preis</th><th>Was gemessen wird</th></tr></thead>
<tbody>
<tr><td>BDEW-Strompreisanalyse</td><td>2026 (Datenstand 04/2026)</td><td>${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh</td><td>Tarife, die heute abschließbar sind – Tarifprodukte und Grundversorgung, gewichtet nach der Vertragsstruktur der Bundesnetzagentur, Musterhaushalt ${kwh(STROMPREIS_REFERENZVERBRAUCH_KWH)}</td></tr>
<tr><td>Statistisches Bundesamt</td><td>${STROMPREIS_AMTLICH.zeitraum}</td><td>${ct(STROMPREIS_AMTLICH.centProKwh)} ct/kWh</td><td>Was Haushalte in bestehenden Verträgen tatsächlich zahlen, mengengewichtet, Verbrauchsband ${STROMPREIS_AMTLICH.verbrauchsband}</td></tr>
</tbody>
</table>
<p>Beide Zahlen sind korrekt und messen Verschiedenes. Der amtliche Wert liegt höher, weil viele Haushalte in älteren, teureren Verträgen und in der Grundversorgung sitzen. Die Differenz ist deshalb keine statistische Unschärfe, sondern der ungefähre Betrag, den ein Tarifwechsel bringen kann.</p>

<h3>Regionale Preisunterschiede in Deutschland</h3>
<p>Der Durchschnitt verdeckt erhebliche regionale Unterschiede, die vor allem aus den Netzentgelten kommen: Sie werden je Netzgebiet festgelegt und sind dort am höchsten, wo viel erneuerbare Erzeugung an wenige Abnehmer angeschlossen ist. Deshalb zahlen Haushalte im windreichen Norden und Osten traditionell mehr als im dicht besiedelten Westen. Der Bundeszuschuss zu den Übertragungsnetzentgelten dämpft diesen Unterschied ab 2026, hebt ihn aber nicht auf. Den Preis für Ihr Netzgebiet nennt Ihr Netzbetreiber; er steht auch auf Ihrer Stromrechnung.</p>

<h3>Die 5 wirksamsten Strom-Spartipps mit konkreter Ersparnis</h3>
<p><strong>1. Alte Kühl-Gefrierkombination ersetzen:</strong> Ein 15 Jahre alter Kühlschrank verbraucht 350-450 kWh/a, ein neues A-Gerät nur 100-150 kWh/a. Bei ${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh sind das ${euro(250 * STROMPREIS_CENT_PRO_KWH / 100)} bis ${euro(300 * STROMPREIS_CENT_PRO_KWH / 100)} Ersparnis pro Jahr. Die Investition (400-600 Euro) amortisiert sich in 4-6 Jahren.</p>
<p><strong>2. LED-Beleuchtung komplett umstellen:</strong> 10 Halogenspots (je 50 W, 3 h/Tag) verbrauchen 548 kWh/a, ersetzt durch LED (je 5 W) nur 55 kWh/a. Die eingesparten 493 kWh sind ${euro(493 * STROMPREIS_CENT_PRO_KWH / 100)} pro Jahr.</p>
<p><strong>3. Stand-by konsequent abschalten:</strong> TV, Konsole, PC-Monitor, Router-Zweitgerät und Kaffeevollautomat im Stand-by verbrauchen zusammen 200-350 kWh/a. Mit schaltbaren Steckdosenleisten (5-10 Euro) sparen Sie ${euro(200 * STROMPREIS_CENT_PRO_KWH / 100)} bis ${euro(350 * STROMPREIS_CENT_PRO_KWH / 100)} pro Jahr.</p>
<p><strong>4. Waschmaschine bei 30 statt 60 Grad:</strong> Ein 60-Grad-Waschgang verbraucht ca. 1,2 kWh, bei 30 Grad nur 0,4 kWh. Bei 200 Waschgängen pro Jahr sind das 160 kWh weniger, also ${euro(160 * STROMPREIS_CENT_PRO_KWH / 100)}.</p>
<p><strong>5. Stromanbieter wechseln:</strong> Der Grundversorger ist fast immer teurer. Wie viel drin ist, zeigt der Abstand zwischen dem amtlichen Durchschnitt der Bestandsverträge (${ct(STROMPREIS_AMTLICH.centProKwh)} ct/kWh) und den heute abschließbaren Tarifen (${ct(STROMPREIS_CENT_PRO_KWH)} ct/kWh): bei ${kwh(STROMPREIS_REFERENZVERBRAUCH_KWH)} rund ${euro(Math.round((STROMPREIS_AMTLICH.centProKwh - STROMPREIS_CENT_PRO_KWH) * STROMPREIS_REFERENZVERBRAUCH_KWH / 100))} im Jahr.</p>`}
    relatedSlugs={['heizkosten-rechner', 'photovoltaik-rechner', 'waermepumpe-rechner']}
  />
</Layout>

<style>
.presets {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.5rem;
}
.preset-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.15rem;
  padding: 0.45rem 0.75rem;
  background: var(--bg);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-family: var(--font-ui);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text);
  transition: border-color 0.15s, background 0.15s, color 0.15s;
  line-height: 1.2;
}
.preset-btn span {
  font-size: 0.68rem;
  font-weight: 400;
  color: var(--muted);
}
.preset-btn:hover { border-color: var(--cat-color, var(--red)); }
.preset-btn.active {
  border-color: var(--cat-color, var(--red));
  background: color-mix(in srgb, var(--cat-color, var(--red)) 8%, white);
  color: var(--cat-color, var(--red));
}
.preset-btn.active span { color: var(--cat-color, var(--red)); opacity: 0.75; }
</style>

<script>
function fmt(n: number) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const kwh = parseFloat((document.getElementById('kwh') as HTMLInputElement).value)||0;
  const preis = parseFloat((document.getElementById('preis') as HTMLInputElement).value)||0;
  const jahr = Math.round(kwh * preis) / 100;
  document.getElementById('jahr')!.textContent = fmt(jahr);
  document.getElementById('monat')!.textContent = 'Pro Monat: ' + fmt(jahr/12);
}
document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    (document.getElementById('kwh') as HTMLInputElement).value = btn.dataset.kwh!;
    berechne();
  });
});
['kwh','preis'].forEach(id => document.getElementById(id)!.addEventListener('input', () => {
  document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
  berechne();
}));
berechne();
</script>
