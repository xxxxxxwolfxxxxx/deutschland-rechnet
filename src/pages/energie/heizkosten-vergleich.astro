---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  BRENNSTOFFE,
  CO2_PREISKORRIDOR_2026,
  waermepreisCent,
} from '../../../public/scripts/heizkosten.js';
const calc = CALCULATORS.find(c => c.slug === 'heizkosten-vergleich')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

const ct = (b: number) => b.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 2 });
const wp = BRENNSTOFFE.waermepumpe;

const faqs = [
  { q: 'Warum wird der Grundpreis mitgerechnet?', a: `Weil ein Vergleich allein über den Arbeitspreis systematisch die falsche Heizung gewinnen lässt. Fernwärme hat oft einen Grundpreis im mittleren dreistelligen Bereich, Heizöl und Pellets haben gar keinen. Erst die Summe aus Arbeits- und Grundpreis ist vergleichbar.` },
  { q: 'Was unterscheidet COP und JAZ bei Wärmepumpen?', a: 'Der COP ist ein Laborwert unter festgelegten Prüfbedingungen. Die Jahresarbeitszahl (JAZ) beschreibt den tatsächlichen Betrieb über ein ganzes Jahr, mit realem Wetter, Vorlauftemperaturen und Takten. Sie liegt regelmäßig unter dem COP. Rechnen Sie mit der JAZ – sie geht direkt in den Wärmepreis ein: Strompreis geteilt durch JAZ.' },
  { q: 'Wie wirkt sich die Gebäudedämmung aus?', a: 'Stärker als die Wahl des Energieträgers. Ein unsanierter Altbau braucht rund 150 bis 180 kWh je Quadratmeter und Jahr, ein Effizienzhaus 50 bis 70 kWh. Weil der Bedarf in jede Zeile des Vergleichs linear eingeht, halbiert eine Sanierung die Kosten jeder Heizungsart gleichermaßen.' },
  { q: 'Wie sicher sind die Preisannahmen?', a: `Sie sind Marktannahmen mit Stand ${year}, keine Rechtsgrößen. Brennstoffpreise schwanken regional, saisonal und je Vertrag erheblich. Belastbar ist am Vergleich die Methode, nicht die letzte Stelle des Ergebnisses – tragen Sie die Preise Ihrer eigenen Rechnung ein.` },
  { q: 'Welche Kosten fehlen in diesem Vergleich?', a: 'Anschaffung, Einbau, Wartung, Schornsteinfeger und Förderung. Der Vergleich zeigt allein die laufenden Energiekosten. Eine Wärmepumpe kann bei den Energiekosten vorn liegen und trotzdem über die gesamte Nutzungsdauer teurer sein – oder umgekehrt, wenn Förderung hinzukommt.' },
  { q: 'Was gilt seit 2026 rechtlich für neue Heizungen?', a: 'Das Gebäudeenergiegesetz wurde zum 29. Juli 2026 neu gefasst und heißt seither Gebäudemodernisierungsgesetz. Die frühere Pflicht, neue Heizungen zu 65 Prozent mit erneuerbaren Energien zu betreiben, ist entfallen. § 42 GModG listet stattdessen zehn zulässige Optionen für den Heizungsersatz auf, Gas- und Ölheizungen ausdrücklich eingeschlossen. Für sie gilt nach § 43 Abs. 1 GModG aber eine wachsende Quote erneuerbarer Brennstoffe: 10 Prozent ab 2029, 15 ab 2030, 30 ab 2035 und 60 ab 2040.' },
];
---
<Layout
  title={`Heizkosten-Vergleich ${year}`}
  description="Heizkosten verschiedener Energieträger vergleichen – Gas, Öl, Wärmepumpe, Pellets und Fernwärme, mit Arbeits- und Grundpreis."
  canonicalPath="/energie/heizkosten-vergleich/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}energie/`} class="back-link">← Energie</a>
    <h1>Heizkosten-Vergleich {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Vergleichen Sie die laufenden Energiekosten verschiedener Heizungsarten für Ihr Gebäude – mit Arbeitspreis, Grundpreis und dem enthaltenen CO₂-Preis."
    sourceNote="Arbeits- und Grundpreis je Energieträger, CO₂-Preis nach § 10 BEHG."
    explanation={`Der Wärmebedarf ergibt sich aus Wohnfläche, Dämmstandard und Raumtemperatur. Er wird für jede Heizungsart in Kosten umgerechnet: bei Verbrennung über den Nutzungsgrad, bei der Wärmepumpe über die Jahresarbeitszahl. Verglichen werden nur die laufenden Energiekosten – Anschaffung, Wartung und Förderung bleiben außen vor.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="wohnflaeche">Wohnfläche (m²)</label>
          <input type="number" id="wohnflaeche" min="20" max="500" value="120" step="5" />
        </div>
        <div class="calc-group">
          <label for="daemmstandard">Dämmstandard</label>
          <select id="daemmstandard">
            <option value="unsaniert">Unsaniert (Altbau, 150 kWh/m²)</option>
            <option value="teilSaniert" selected>Teilsaniert (105 kWh/m²)</option>
            <option value="effizienzhaus">Effizienzhaus (60 kWh/m²)</option>
            <option value="passivhaus">Passivhaus (23 kWh/m²)</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="raumtemperatur">Raumtemperatur (°C)</label>
          <input type="number" id="raumtemperatur" min="16" max="26" value="20" step="0.5" />
        </div>
        <div class="calc-group">
          <label for="jaz">Jahresarbeitszahl Wärmepumpe (JAZ)</label>
          <input type="number" id="jaz" min="2.5" max="5.5" value={wp.jaz} step="0.1" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Niedrigste Energiekosten pro Jahr</div>
        <div id="ergebnis">— €</div>
        <div class="result-actions">
          <button data-copy-result="#ergebnis" class="btn-copy" title="Resultat kopieren">📋 Kopieren</button>
          <button data-save-pdf="#ergebnis" class="btn-pdf" title="Als PDF speichern">📄 PDF</button>
        </div>
      </div>
      <p id="bedarf" style="margin-top:0.75rem;font-size:0.88rem;color:#666;"></p>
      <div style="overflow-x:auto;margin-top:0.5rem;">
        <table id="rangliste" style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <thead>
            <tr>
              <th style="text-align:left;padding:0.4rem 0.5rem;">Energieträger</th>
              <th style="text-align:right;padding:0.4rem 0.5rem;">Wärmepreis</th>
              <th style="text-align:right;padding:0.4rem 0.5rem;">Verbrauch</th>
              <th style="text-align:right;padding:0.4rem 0.5rem;">Grundpreis</th>
              <th style="text-align:right;padding:0.4rem 0.5rem;">Kosten/Jahr</th>
              <th style="text-align:right;padding:0.4rem 0.5rem;">davon CO₂</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <p style="margin-top:0.5rem;font-size:0.8rem;color:#888;">
        Der Wärmepreis ist der Preis je Kilowattstunde nutzbarer Wärme, die Verbrauchsspalte zeigt die dafür abgerechnete Menge Brennstoff beziehungsweise Strom. Nur laufende Energiekosten. Anschaffung, Wartung, Schornsteinfeger und Förderung sind nicht enthalten.
        Der CO₂-Preis ist im Arbeitspreis bereits enthalten und wird nicht hinzugerechnet.
      </p>
    </div>
  </CalculatorShell>

<script type="module">
const { BRENNSTOFFE, berechneHeizkosten, waermepreisCent, abgerechneteKwh } = await import(window.__base + 'scripts/heizkosten.js');

// Spezifischer Wärmebedarf in kWh je m² und Jahr bei 20 °C Raumtemperatur.
const BEDARF_JE_QM = {
  unsaniert: 150,
  teilSaniert: 105,
  effizienzhaus: 60,
  passivhaus: 23,
};
// Faustregel: rund 6 % Mehr- oder Minderverbrauch je Grad Raumtemperatur.
const TEMPERATURFAKTOR_JE_GRAD = 0.06;
const REFERENZTEMPERATUR = 20;

const fmt = (n) => n.toLocaleString('de-DE', {maximumFractionDigits:0}) + ' €';
const fmt2 = (n) => n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
const ct = (n) => n.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:2});

function berechne() {
  const flaeche = parseFloat(document.getElementById('wohnflaeche').value) || 120;
  const daemm = document.getElementById('daemmstandard').value;
  const temp = parseFloat(document.getElementById('raumtemperatur').value) || REFERENZTEMPERATUR;
  const jaz = parseFloat(document.getElementById('jaz').value) || BRENNSTOFFE.waermepumpe.jaz;

  const tempFaktor = 1 + TEMPERATURFAKTOR_JE_GRAD * (temp - REFERENZTEMPERATUR);
  const spezBedarf = (BEDARF_JE_QM[daemm] ?? BEDARF_JE_QM.unsaniert) * tempFaktor;
  const waermebedarf = flaeche * spezBedarf;

  const ergebnisse = Object.entries(BRENNSTOFFE).map(([key, b]) => {
    // Bei der Wärmepumpe ist die Jahresarbeitszahl Eingabe und tritt an die
    // Stelle des hinterlegten Nutzungsgrads.
    const nutzungsgrad = key === 'waermepumpe' ? jaz : b.nutzungsgrad;
    const verbrauchKwh = abgerechneteKwh({ waermebedarfKwh: waermebedarf, nutzungsgrad });
    const r = berechneHeizkosten({
      verbrauchKwh,
      preisCent: b.arbeitspreisCent,
      grundpreisJahr: b.grundpreisJahr,
      brennstoff: b.behg,
    });
    return {
      key,
      label: b.label,
      verbrauchKwh,
      waermepreis: waermepreisCent({ arbeitspreisCent: b.arbeitspreisCent, nutzungsgrad }),
      ...r,
    };
  }).sort((a, b) => a.kosten - b.kosten);

  const guenstigste = ergebnisse[0];
  document.getElementById('ergebnis').textContent = fmt(guenstigste.kosten);
  document.getElementById('ergebnis').style.color = '#1e7e34';
  document.getElementById('bedarf').textContent =
    `Wärmebedarf: ${Math.round(waermebedarf).toLocaleString('de-DE')} kWh im Jahr ` +
    `(${Math.round(spezBedarf)} kWh je m²). Günstigste Variante: ${guenstigste.label}.`;

  const medaille = ['🥇','🥈','🥉'];
  document.querySelector('#rangliste tbody').innerHTML = ergebnisse.map((e, i) =>
    `<tr style="border-top:1px solid #eee;">` +
    `<td style="padding:0.4rem 0.5rem;">${medaille[i] ?? (i + 1) + '.'} ${e.label}</td>` +
    `<td style="padding:0.4rem 0.5rem;text-align:right;">${ct(e.waermepreis)} ct/kWh</td>` +
    `<td style="padding:0.4rem 0.5rem;text-align:right;">${Math.round(e.verbrauchKwh).toLocaleString('de-DE')} kWh</td>` +
    `<td style="padding:0.4rem 0.5rem;text-align:right;">${e.grundpreis > 0 ? fmt(e.grundpreis) : '–'}</td>` +
    `<td style="padding:0.4rem 0.5rem;text-align:right;"><strong>${fmt(e.kosten)}</strong></td>` +
    `<td style="padding:0.4rem 0.5rem;text-align:right;">${e.co2Anteil.kosten > 0 ? fmt2(e.co2Anteil.kosten) : '–'}</td>` +
    `</tr>`).join('');
}

['wohnflaeche','raumtemperatur','jaz'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('daemmstandard').addEventListener('change', berechne);
berechne();
</script>

  <CalculatorGuide
    title="Energieträger vergleichen und die beste Wahl treffen"
    content={`<p>Die Wahl der Heizung wirkt zwanzig Jahre und länger. Ein belastbarer Vergleich braucht mehr als den Preis je Kilowattstunde.</p>

<p><strong>Vergleichen Sie Wärme, nicht Brennstoff.</strong> Der häufigste Fehler ist, den Strompreis einer Wärmepumpe direkt gegen den Gaspreis zu stellen. Eine Wärmepumpe macht aus einer Kilowattstunde Strom mehrere Kilowattstunden Wärme. Bei ${ct(wp.arbeitspreisCent)} ct Wärmepumpenstrom und einer Jahresarbeitszahl von ${ct(wp.jaz)} kostet die Kilowattstunde Wärme ${ct(waermepreisCent(wp))} ct – das ist die Zahl, die neben den Gaspreis gehört. Umgekehrt gilt für Verbrennungsheizungen: Der Nutzungsgrad ist kleiner als eins, aus einer Kilowattstunde Brennstoff wird etwas weniger Wärme.</p>

<p><strong>Der Grundpreis entscheidet mit.</strong> Fernwärme wird oft mit einem niedrigen Arbeitspreis beworben, hat aber einen Grundpreis, der sich nach der Anschlussleistung richtet und mehrere hundert Euro im Jahr betragen kann. Bei Heizöl und Pellets gibt es keinen Grundpreis, dafür Lieferkosten und gebundenes Kapital im Lager. Dieser Rechner rechnet den Grundpreis mit, weil ein Vergleich ohne ihn regelmäßig die falsche Heizung gewinnen lässt.</p>

<p><strong>Die Dämmung schlägt den Energieträger.</strong> Ein unsanierter Altbau braucht rund 150 kWh je Quadratmeter und Jahr, ein Effizienzhaus 60. Weil der Bedarf linear in jede Zeile eingeht, senkt eine Sanierung die Kosten jeder Heizungsart im gleichen Verhältnis – und macht anschließend auch eine Wärmepumpe erst richtig wirtschaftlich, weil niedrige Vorlauftemperaturen die Jahresarbeitszahl heben.</p>

<p><strong>Was dieser Vergleich nicht kann.</strong> Er zeigt laufende Energiekosten, keine Vollkosten. Anschaffung und Einbau (Gasbrennwert deutlich günstiger als Wärmepumpe), Wartung und Schornsteinfeger, Förderung und Restnutzungsdauer der Altanlage bleiben außen vor. Auch künftige Preise kennt niemand: Der CO₂-Preis steigt zwar planmäßig – für 2026 gilt nach § 10 Abs. 2 Satz 5 BEHG ein Korridor von ${CO2_PREISKORRIDOR_2026.min} bis ${CO2_PREISKORRIDOR_2026.max} Euro je Tonne –, der Brennstoffpreis selbst folgt aber dem Weltmarkt.</p>

<p><strong>Rechtlicher Rahmen seit 2026.</strong> Das Gebäudeenergiegesetz wurde zum 29. Juli 2026 neu gefasst und heißt jetzt Gebäudemodernisierungsgesetz. Die 65-Prozent-Pflicht für erneuerbare Energien bei neuen Heizungen ist entfallen; § 71 GEG ist aufgehoben. § 42 GModG nennt stattdessen zehn Optionen für den Heizungsersatz, von der Wärmepumpe über Hybridlösungen und Wärmenetzanschluss bis zur weiterhin zulässigen Gas-, Öl- oder Flüssiggasheizung. Wer eine solche nach dem 29. Juli 2026 neu einbaut, muss nach § 43 Abs. 1 GModG einen steigenden Anteil erneuerbarer Brennstoffe einsetzen: ab 2029 mindestens 10 Prozent, ab 2030 15 Prozent, ab 2035 30 Prozent, ab 2040 60 Prozent. Diese Pflicht lässt sich auch über eine Solarthermieanlage (§ 43 Abs. 3), eine Lüftungsanlage mit Wärmerückgewinnung (§ 43 Abs. 4) oder eine ausreichend dimensionierte Wärmepumpen-Hybridheizung (§ 43 Abs. 5) erfüllen. Ein Betriebsverbot für Öl- und Gaskessel ab 2045 enthält das Gesetz nicht mehr; § 42a GModG kündigt für die Zeit ab 2045 lediglich eine erst noch zu beschließende Grüngas- und Grünheizölquote an.</p>

<p><strong>Für Mieter.</strong> Die im CO₂-Preis steckenden Kosten trägt in Wohngebäuden nicht der Mieter allein. Das Kohlendioxidkostenaufteilungsgesetz verteilt sie nach dem Ausstoß je Quadratmeter Wohnfläche: Unter 12 kg CO₂ im Jahr trägt der Mieter alles, ab 52 kg nur noch 5 Prozent. Je schlechter das Gebäude gedämmt ist, desto größer der Anteil des Vermieters.</p>`}
    relatedSlugs={['heizkosten-rechner', 'waermepumpe-rechner', 'co2-einsparung-renovierung']}
  />
</Layout>
