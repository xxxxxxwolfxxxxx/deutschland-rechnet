---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  berechneScheidungskosten,
  EHESACHE_MINDESTWERT,
  MONATE_NETTOEINKOMMEN,
  VERSORGUNGSAUSGLEICH_JE_ANRECHT,
  VERSORGUNGSAUSGLEICH_MINDESTWERT,
  KINDSCHAFTSSACHE_ANTEIL,
  KINDSCHAFTSSACHE_HOECHSTBETRAG,
  GERICHT_GEBUEHRENSATZ,
  VERFAHRENSGEBUEHR_SATZ,
  TERMINSGEBUEHR_SATZ,
  AUSLAGENPAUSCHALE_HOECHSTBETRAG,
  UMSATZSTEUERSATZ,
} from '../../../public/scripts/scheidungskosten.js';
const calc = CALCULATORS.find(c => c.slug === 'scheidungskosten-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const proz = (n: number) => (n * 100).toLocaleString('de-DE') + ' %';
const satz = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 1 });

const bsp = berechneScheidungskosten({ nettoMonat: 4000, anrechte: 2, anwaelte: 1 });
if (bsp.verfahrenswert.gesamt !== 14400 || bsp.gericht !== 688 || bsp.gesamt !== 2978.75) {
  throw new Error('Scheidungskosten: Beispielrechnung weicht von den Gebuehrentabellen ab');
}
const bspKind = berechneScheidungskosten({ nettoMonat: 4000, anrechte: 2, kindschaftssachen: 1, anwaelte: 2 });
const reich = berechneScheidungskosten({ nettoMonat: 4000, anrechte: 2, anwaelte: 1, vermoegen: 900000 });
if (reich.gesamt !== bsp.gesamt) throw new Error('Vermoegen darf die Rechnung nicht veraendern');

const NETTO = [2000, 3000, 4000, 6000, 10000];
const tabelle = NETTO.map((n) => ({
  n,
  eins: berechneScheidungskosten({ nettoMonat: n, anrechte: 2, anwaelte: 1 }),
  zwei: berechneScheidungskosten({ nettoMonat: n, anrechte: 2, anwaelte: 2 }),
}));

const guideHtml = `
<h3>Der Verfahrenswert: Einkommen, nicht Vermögen</h3>
<p>Gerichts- und Anwaltsgebühren richten sich nach dem Verfahrenswert. Für die Scheidung selbst bestimmt ihn das Gericht nach § 43 Abs. 1 FamGKG „nach Ermessen" unter Berücksichtigung von Umfang, Bedeutung und den Vermögens- und Einkommensverhältnissen, mindestens mit ${eur(EHESACHE_MINDESTWERT)}. Fest geregelt ist nur die Einkommensseite: Einzusetzen ist nach Absatz 2 „das in drei Monaten erzielte Nettoeinkommen der Ehegatten". Beide Einkommen zusammen, mal ${MONATE_NETTOEINKOMMEN} – das ist der Kern, und mit ihm rechnet dieser Rechner.</p>
<p>Ob und wie Vermögen den Wert erhöht oder Kinder ihn mindern, schreibt das Gesetz nicht vor; die Familiengerichte handhaben das unterschiedlich. Der Rechner unterstellt dazu nichts. Die frühere Fassung dieser Seite rechnete die Gebühren aus dem Gesamtvermögen – eine Größe, die in § 43 nur als ein Umstand unter mehreren vorkommt.</p>

<h3>Folgesachen im Verbund</h3>
<p>Scheidung und Folgesachen gelten als ein Verfahren (§ 44 Abs. 1 FamGKG); ihre Werte werden addiert und die Gebühr einmal aus der Summe berechnet.</p>
<ul>
<li><strong>Versorgungsausgleich:</strong> je Anrecht ${proz(VERSORGUNGSAUSGLEICH_JE_ANRECHT)} des dreimonatigen Nettoeinkommens, insgesamt mindestens ${eur(VERSORGUNGSAUSGLEICH_MINDESTWERT)} (§ 50 Abs. 1 FamGKG). Ein Anrecht ist jede einzelne Versorgung – die gesetzliche Rente des einen Ehegatten ist eines, eine Betriebsrente ein weiteres.</li>
<li><strong>Sorge- oder Umgangsverfahren im Verbund:</strong> je Verfahren ${proz(KINDSCHAFTSSACHE_ANTEIL)} des Werts der Scheidung, höchstens ${eur(KINDSCHAFTSSACHE_HOECHSTBETRAG)}, auch wenn es mehrere Kinder betrifft (§ 44 Abs. 2 FamGKG).</li>
</ul>

<h3>Welche Gebühren anfallen</h3>
<p>Das Gericht erhebt für das Verfahren eine ${satz(GERICHT_GEBUEHRENSATZ)}-Gebühr nach Nr. 1110 des Kostenverzeichnisses zum FamGKG, die volle Gebühr ergibt sich aus § 28 FamGKG. Der Anwalt erhält nach dem RVG eine ${satz(VERFAHRENSGEBUEHR_SATZ)}-Verfahrensgebühr (Nr. 3100) und eine ${satz(TERMINSGEBUEHR_SATZ)}-Terminsgebühr (Nr. 3104), dazu höchstens ${eur(AUSLAGENPAUSCHALE_HOECHSTBETRAG)} Auslagenpauschale (Nr. 7002) und ${proz(UMSATZSTEUERSATZ)} Umsatzsteuer. Nicht eingerechnet sind eine Einigungsgebühr, Gebühren für streitige Folgesachen wie Unterhalt oder Zugewinn und Auslagen des Gerichts.</p>
<p><strong>Beispiel:</strong> ${eur(4000)} Nettoeinkommen beider im Monat, zwei Anrechte im Versorgungsausgleich. Die Scheidung ist ${eur(bsp.verfahrenswert.ehesache)} wert, der Versorgungsausgleich ${eur(bsp.verfahrenswert.versorgungsausgleich)}, zusammen ${eur(bsp.verfahrenswert.gesamt)}. Das Gericht verlangt ${eur(bsp.gericht)}, ein Anwalt ${eur(bsp.anwaltGesamt)} – zusammen ${eur(bsp.gesamt)}. Kommt ein Sorgerechtsverfahren hinzu und hat jeder Ehegatte einen Anwalt, sind es ${eur(bspKind.gesamt)}.</p>

<h3>Kosten nach Einkommen</h3>
<p>Mit zwei Anrechten im Versorgungsausgleich, ohne Kindschaftssachen:</p>
<table>
<thead><tr><th>Netto beider / Monat</th><th>Verfahrenswert</th><th>Gericht</th><th>Gesamt, 1 Anwalt</th><th>Gesamt, 2 Anwälte</th></tr></thead>
<tbody>
${tabelle.map(({ n, eins, zwei }) => `<tr><td>${eur(n)}</td><td>${eur(eins.verfahrenswert.gesamt)}</td><td>${eur(eins.gericht)}</td><td>${eur(eins.gesamt)}</td><td>${eur(zwei.gesamt)}</td></tr>`).join('\n')}
</tbody>
</table>
<p>Die Gebühren wachsen langsamer als das Einkommen: Die Tabellen des FamGKG und des RVG sind degressiv gestaffelt.</p>
`;

const faqs = [
  { q: 'Wonach richten sich die Kosten einer Scheidung?', a: `Nach dem Verfahrenswert. Dessen fester Bestandteil ist das Nettoeinkommen beider Ehegatten aus drei Monaten (§ 43 Abs. 2 FamGKG), mindestens ${eur(EHESACHE_MINDESTWERT)}. Der Versorgungsausgleich und Kindschaftssachen im Verbund kommen hinzu.` },
  { q: 'Zählt das Vermögen?', a: 'Das Gesetz nennt die Vermögensverhältnisse als einen Umstand, den das Gericht nach Ermessen berücksichtigt, gibt aber keine Formel vor. Der Rechner rechnet deshalb nur mit dem Einkommen; ein Zuschlag für Vermögen würde die Kosten erhöhen.' },
  { q: 'Was kostet eine Scheidung bei 4.000 € Netto im Monat?', a: `Mit zwei Anrechten im Versorgungsausgleich und einem Anwalt ${eur(bsp.gesamt)}: ${eur(bsp.gericht)} Gerichtsgebühren und ${eur(bsp.anwaltGesamt)} für den Anwalt einschließlich Umsatzsteuer.` },
  { q: 'Wie erhöht der Versorgungsausgleich die Kosten?', a: `Jedes auszugleichende Anrecht erhöht den Verfahrenswert um ${proz(VERSORGUNGSAUSGLEICH_JE_ANRECHT)} des dreimonatigen Nettoeinkommens, zusammen um mindestens ${eur(VERSORGUNGSAUSGLEICH_MINDESTWERT)} (§ 50 Abs. 1 FamGKG).` },
  { q: 'Was ändert ein zweiter Anwalt?', a: 'Die Gerichtsgebühr bleibt gleich, die Anwaltskosten verdoppeln sich. Weitere Kosten entstehen, wenn Unterhalt, Zugewinn oder Hausrat streitig im Verbund entschieden werden – diese Folgesachen hat der Rechner nicht.' },
];
---
<Layout
  title={`Scheidungskosten-Rechner ${year}`}
  description="Scheidungskosten nach FamGKG und RVG: Verfahrenswert aus dem Nettoeinkommen, Versorgungsausgleich, Gerichts- und Anwaltsgebühren nach den amtlichen Tabellen."
  canonicalPath="/familie/scheidungskosten-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}familie/`} class="back-link">← Familie &amp; Soziales</a>
    <h1>Scheidungskosten-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner ermittelt den Verfahrenswert einer Scheidung aus dem Nettoeinkommen beider Ehegatten und rechnet daraus Gerichts- und Anwaltsgebühren nach den gesetzlichen Tabellen."
    sourceNote="Verfahrenswert nach §§ 43, 44 und 50 FamGKG, Gerichtsgebühr nach § 28 FamGKG und KV Nr. 1110, Anwaltsvergütung nach § 13 RVG und VV Nr. 3100, 3104, 7002, 7008 (Gebührentabellen in der Fassung BGBl. 2025 I Nr. 109, abgerufen am 14.09.2026). Nicht berücksichtigt: Ermessenszu- oder -abschläge für Vermögen und Kinder, Einigungsgebühr, streitige Folgesachen, gerichtliche Auslagen."
    explanation="Verfahrenswert = Nettoeinkommen beider aus drei Monaten (mindestens 3.000 €), plus 10 % davon je Anrecht im Versorgungsausgleich (mindestens 1.000 €), plus 20 % je Kindschaftssache (höchstens 5.000 €). Gericht: 2,0 Gebühren. Anwalt: 2,5 Gebühren, Pauschale, Umsatzsteuer."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="netto">Nettoeinkommen beider Ehegatten im Monat (€)</label>
          <input type="number" id="netto" min="0" max="1000000" value="4000" step="100" />
        </div>
        <div class="calc-group">
          <label for="anrechte">Anrechte im Versorgungsausgleich</label>
          <input type="number" id="anrechte" min="0" max="20" value="2" step="1" />
        </div>
        <div class="calc-group">
          <label for="kindschaft">Sorge- oder Umgangsverfahren im Verbund</label>
          <input type="number" id="kindschaft" min="0" max="5" value="0" step="1" />
        </div>
        <div class="calc-group">
          <label for="anwalt">Anwälte</label>
          <select id="anwalt">
            <option value="1" selected>Ein Anwalt</option>
            <option value="2">Zwei Anwälte</option>
          </select>
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Gerichts- und Anwaltskosten</div>
        <div id="kosten">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So werden Scheidungskosten berechnet"
    content={guideHtml}
    relatedSlugs={['ehegattenunterhalt-rechner', 'unterhaltsrechner']}
  />
</Layout>

<script type="module">
const { berechneScheidungskosten } = await import(window.__base + 'scripts/scheidungskosten.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = berechneScheidungskosten({
    nettoMonat: wert('netto'),
    anrechte: wert('anrechte'),
    kindschaftssachen: wert('kindschaft'),
    anwaelte: parseInt(document.getElementById('anwalt').value, 10),
  });
  const w = r.verfahrenswert;
  document.getElementById('kosten').textContent = eur(r.gesamt);
  const wertTeile = [`Scheidung ${eur(w.ehesache)}`];
  if (w.versorgungsausgleich > 0) wertTeile.push(`Versorgungsausgleich ${eur(w.versorgungsausgleich)}`);
  if (w.kindschaft > 0) wertTeile.push(`Kindschaft ${eur(w.kindschaft)}`);
  document.getElementById('details').innerHTML = [
    `<span>Verfahrenswert: <strong>${eur(w.gesamt)}</strong> (${wertTeile.join(' + ')})</span>`,
    `<span>Gericht: <strong>${eur(r.gericht)}</strong></span>`,
    `<span>Je Anwalt: <strong>${eur(r.anwalt.brutto)}</strong></span>`,
  ].join('');
}
['netto', 'anrechte', 'kindschaft'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('anwalt').addEventListener('change', berechne);
berechne();
</script>
