---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { berechneMutterschutz, SCHUTZFRIST_VOR_TAGE, SCHUTZFRIST_NACH_TAGE, SCHUTZFRIST_NACH_VERLAENGERT_TAGE } from '../../../public/scripts/mutterschutz.js';
const calc = CALCULATORS.find(c => c.slug === 'mutterschutz-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const datum = (s: string) => s.split('-').reverse().join('.');
const wochen = (tage: number) => tage / 7;

const termin = berechneMutterschutz({ geburtstermin: '2026-11-20' });
const frueher = berechneMutterschutz({ geburtstermin: '2026-11-20', entbindung: '2026-11-10' });
const spaeter = berechneMutterschutz({ geburtstermin: '2026-11-20', entbindung: '2026-11-27' });
if (frueher.ende !== termin.ende || spaeter.tageGesamt !== termin.tageGesamt + 7) {
  throw new Error('Mutterschutz: Beispiele widersprechen § 3 MuSchG');
}

const faqs = [
  { q: 'Wie lange dauert die Schutzfrist?', a: `${wochen(SCHUTZFRIST_VOR_TAGE)} Wochen vor dem voraussichtlichen Entbindungstag und ${wochen(SCHUTZFRIST_NACH_TAGE)} Wochen nach der Entbindung (§ 3 Abs. 1 und 2 MuSchG). Nach Früh- oder Mehrlingsgeburten und wenn vor Ablauf von acht Wochen eine Behinderung des Kindes ärztlich festgestellt wird, sind es ${wochen(SCHUTZFRIST_NACH_VERLAENGERT_TAGE)} Wochen nach der Entbindung.` },
  { q: 'Was passiert, wenn das Kind früher kommt?', a: `Die Frist vor der Entbindung verkürzt sich, und die Frist danach verlängert sich um genau diese Tage (§ 3 Abs. 2 Satz 3 MuSchG). Kommt das Kind zehn Tage früher, endet der Mutterschutz trotzdem am selben Tag wie bei einer Geburt am Termin – im Beispiel dieser Seite am ${datum(frueher.ende)}.` },
  { q: 'Was passiert, wenn das Kind später kommt?', a: `Die Frist vor der Entbindung verlängert sich entsprechend (§ 3 Abs. 1 Satz 5 MuSchG), die ${wochen(SCHUTZFRIST_NACH_TAGE)} Wochen danach zählen ab der tatsächlichen Geburt. Eine Woche Verspätung verlängert den Mutterschutz insgesamt um eine Woche.` },
  { q: 'Wie hoch ist das Mutterschaftsgeld?', a: 'Gesetzlich Versicherte erhalten es von ihrer Krankenkasse für die Schutzfristen und den Entbindungstag (§ 19 Abs. 1 MuSchG), höchstens 13 € je Kalendertag; den Unterschied zum bisherigen Nettoentgelt zahlt der Arbeitgeber als Zuschuss. Frauen, die nicht gesetzlich krankenversichert sind, erhalten nach § 19 Abs. 2 MuSchG insgesamt höchstens 210 € vom Bundesamt für Soziale Sicherung.' },
  { q: 'Muss ich in der Schutzfrist vor der Geburt aufhören zu arbeiten?', a: 'Nein. Der Arbeitgeber darf eine Schwangere in dieser Zeit nur beschäftigen, soweit sie sich ausdrücklich dazu bereit erklärt (§ 3 Abs. 1 Satz 1 MuSchG). Nach der Entbindung gilt das Beschäftigungsverbot der Schutzfrist dagegen ohne diese Möglichkeit.' },
];

const guideHtml = `
<h3>Die Schutzfristen nach § 3 MuSchG</h3>
<p>Vor der Entbindung darf der Arbeitgeber eine Schwangere in den letzten ${wochen(SCHUTZFRIST_VOR_TAGE)} Wochen nicht beschäftigen, soweit sie sich nicht ausdrücklich dazu bereit erklärt. Maßgeblich ist der voraussichtliche Entbindungstag laut ärztlichem Zeugnis oder Zeugnis der Hebamme. Nach der Entbindung gilt ein Beschäftigungsverbot von ${wochen(SCHUTZFRIST_NACH_TAGE)} Wochen, das sich auf ${wochen(SCHUTZFRIST_NACH_VERLAENGERT_TAGE)} Wochen verlängert bei Frühgeburten, bei Mehrlingsgeburten und wenn vor Ablauf von acht Wochen bei dem Kind eine Behinderung ärztlich festgestellt wird.</p>

<h3>Wenn das Kind nicht am Termin kommt</h3>
<p>Der Termin legt nur den Beginn fest. Kommt das Kind später, verlängert sich die Frist davor; die Frist danach zählt ab der tatsächlichen Geburt. Kommt es früher, verkürzt sich die Frist davor – und die fehlenden Tage werden an die Frist danach angehängt (§ 3 Abs. 2 Satz 3 MuSchG).</p>
<table>
<thead><tr><th>Termin 20.11.2026</th><th>Beginn</th><th>Geburt</th><th>Ende</th><th>Tage insgesamt</th></tr></thead>
<tbody>
<tr><td>Geburt am Termin</td><td>${datum(termin.beginn)}</td><td>${datum(termin.entbindung)}</td><td>${datum(termin.ende)}</td><td>${termin.tageGesamt}</td></tr>
<tr><td>10 Tage früher</td><td>${datum(frueher.beginn)}</td><td>${datum(frueher.entbindung)}</td><td>${datum(frueher.ende)}</td><td>${frueher.tageGesamt}</td></tr>
<tr><td>7 Tage später</td><td>${datum(spaeter.beginn)}</td><td>${datum(spaeter.entbindung)}</td><td>${datum(spaeter.ende)}</td><td>${spaeter.tageGesamt}</td></tr>
</tbody>
</table>
<p>Tragen Sie vor der Geburt nur den Termin ein. Ist das Kind da, ergänzen Sie das tatsächliche Datum – dann zeigt der Rechner das verbindliche Ende.</p>

<h3>Mutterschaftsgeld</h3>
<p>Für die Schutzfristen und den Entbindungstag erhalten gesetzlich Versicherte Mutterschaftsgeld von ihrer Krankenkasse (§ 19 Abs. 1 MuSchG), höchstens 13 € je Kalendertag; den Unterschied zum bisherigen Nettoentgelt gleicht der Arbeitgeber mit einem Zuschuss aus. Wer nicht gesetzlich krankenversichert ist, erhält vom Bundesamt für Soziale Sicherung insgesamt höchstens 210 € (§ 19 Abs. 2 MuSchG).</p>
`;
---
<Layout
  title={`Mutterschutz-Rechner ${year}`}
  description="Beginn und Ende des Mutterschutzes nach § 3 MuSchG – mit verlängerter Frist und der Verschiebung bei Geburt vor oder nach dem Termin."
  canonicalPath="/familie/mutterschutz-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}familie/`} class="back-link">← Familie &amp; Soziales</a>
    <h1>Mutterschutz-Rechner {year} – Fristen berechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner ermittelt Beginn und Ende der Schutzfristen aus dem voraussichtlichen Entbindungstag – und, sobald das Kind da ist, aus dem tatsächlichen Geburtsdatum."
    sourceNote="Schutzfristen nach § 3 Abs. 1 und 2 MuSchG, Mutterschaftsgeld nach § 19 MuSchG (abgerufen am 14.09.2026). Keine Rechtsberatung; maßgeblich ist der Termin laut ärztlichem Zeugnis oder Zeugnis der Hebamme."
    explanation="Beginn = Termin − 6 Wochen. Ende = Geburt + 8 Wochen (12 Wochen bei Früh-, Mehrlingsgeburt oder festgestellter Behinderung) + die Tage, um die das Kind vor dem Termin kam."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="geburtstermin">Voraussichtlicher Entbindungstag</label>
          <input type="date" id="geburtstermin" />
        </div>
        <div class="calc-group">
          <label for="entbindung">Tatsächliche Geburt (falls schon bekannt)</label>
          <input type="date" id="entbindung" />
        </div>
        <div class="calc-group">
          <label for="verlaengert">Besondere Umstände</label>
          <select id="verlaengert">
            <option value="0" selected>keine (8 Wochen nach der Geburt)</option>
            <option value="1">Früh-, Mehrlingsgeburt oder Behinderung (12 Wochen)</option>
          </select>
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Mutterschutz</div>
        <div id="ergebnis">—</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.9rem;color:#555;display:flex;flex-direction:column;gap:0.35rem;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So werden die Schutzfristen berechnet"
    content={guideHtml}
    relatedSlugs={['elterngeld-rechner', 'schwangerschafts-rechner']}
  />
</Layout>

<script type="module">
const { berechneMutterschutz } = await import(window.__base + 'scripts/mutterschutz.js');
const datum = (s) => s.split('-').reverse().join('.');
function berechne() {
  const termin = document.getElementById('geburtstermin').value;
  if (!termin) return;
  const entbindung = document.getElementById('entbindung').value || undefined;
  const r = berechneMutterschutz({ geburtstermin: termin, entbindung, verlaengert: document.getElementById('verlaengert').value === '1' });
  document.getElementById('ergebnis').textContent = `${datum(r.beginn)} bis ${datum(r.ende)}`;
  const teile = [
    `<span>Beginn: <strong>${datum(r.beginn)}</strong> (6 Wochen vor dem Termin)</span>`,
    `<span>Ende: <strong>${datum(r.ende)}</strong> (${r.schutzNachGeburt / 7} Wochen nach der Geburt${r.verkuerzung > 0 ? ` plus ${r.verkuerzung} Tage, weil das Kind früher kam` : ''})</span>`,
    `<span>Insgesamt: <strong>${r.tageGesamt} Tage</strong></span>`,
  ];
  if (!entbindung) teile.push('<span>Berechnet mit Geburt am Termin – das Ende verschiebt sich, wenn das Kind später kommt.</span>');
  document.getElementById('details').innerHTML = teile.join('');
}
document.getElementById('geburtstermin').valueAsDate = new Date(Date.now() + 90 * 24 * 60 * 60 * 1000);
['geburtstermin', 'entbindung', 'verlaengert'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('verlaengert').addEventListener('change', berechne);
berechne();
</script>
