---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  KINDERGELD_MONAT,
  KINDERFREIBETRAG_JE_ELTERNTEIL,
  BEA_FREIBETRAG_JE_ELTERNTEIL,
  FREIBETRAG_JE_KIND,
  berechneKindergeld,
} from '../../../public/scripts/kindergeld.js';
const calc = CALCULATORS.find(c => c.slug === 'kindergeld-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Beträge kommen aus dem Rechenmodul. Vor dem 11.08.2026 stand hier
// durchgängig der Betrag des Jahres 2025 (255 €) und ein Kinderfreibetrag
// von 6.672 € – ebenfalls der Vorjahreswert.
const euro = (n: number) => n.toLocaleString('de-DE') + ' €';
const kindergeldTabelle = [1, 2, 3, 4, 5].map((n) => berechneKindergeld({ anzahlKinder: n }));

const faqs = [
  { q: 'Wer hat Anspruch auf Kindergeld?', a: 'Eltern, deren Kinder unter 18 Jahren sind, oder unter 25 Jahren wenn das Kind in Ausbildung oder Studium ist.' },
  { q: 'Wie hoch ist das Kindergeld?', a: `Das Kindergeld beträgt seit Januar 2026 einheitlich ${euro(KINDERGELD_MONAT)} pro Kind und Monat (§ 66 Abs. 1 EStG) – unabhängig von der Reihenfolge der Kinder. Die frühere Staffelung (mehr ab dem dritten oder vierten Kind) wurde abgeschafft.` },
  { q: 'Wird mein Einkommen berücksichtigt?', a: 'Nein, Kindergeld ist grundsätzlich einkommensunabhängig. Es gibt aber Grenzen beim Kinderfreibetrag.' },
  { q: 'Wann endet der Kindergeldanspruch?', a: 'Entweder wenn das Kind 18 wird, bei Ausbildung mit 25 Jahren oder wenn das Kind eine Erwerbstätigkeit beginnt.' },
  { q: 'Kann Kindergeld gepfändet werden?', a: 'Grundsätzlich nicht. Nach § 76 EStG kann der Anspruch auf Kindergeld nur wegen gesetzlicher Unterhaltsansprüche des Kindes gepfändet werden, für das es festgesetzt und ausgezahlt wird. Für alle anderen Forderungen ist es unpfändbar.' },
  { q: 'Kann ich Kindergeld und Kinderfreibetrag zusammen nutzen?', a: 'Nein, dies wird automatisch in der Steuererklärung verglichen. Die günstigere Variante wird angewendet.' },
  { q: 'Wie beantrage ich Kindergeld?', a: 'Kindergeld wird nicht automatisch gezahlt, sondern muss bei der Familienkasse der Bundesagentur für Arbeit beantragt werden. Der Antrag ist seit 2024 vollständig digital über das Portal "Familienkasse Digital" möglich. Für Neugeborene wird der Antrag innerhalb der ersten sechs Monate empfohlen, da eine rückwirkende Zahlung nur für maximal sechs Monate erfolgt.' },
  { q: 'Was ist der Kinderzuschlag?', a: 'Der Kinderzuschlag nach § 6a BKGG ist eine zusätzliche Leistung für Familien mit geringem Einkommen, die zwar ihren eigenen Bedarf, aber nicht den ihrer Kinder vollständig decken können. Sein Höchstbetrag ist nicht fest, sondern nach § 6a Abs. 2 BKGG an das sächliche Existenzminimum eines Kindes gekoppelt und wird jährlich neu ermittelt; hinzu kommt ein Sofortzuschlag von 25 € monatlich. Den aktuellen Betrag gibt die Familienkasse bekannt. Er kann parallel zum Kindergeld bezogen werden.' },
];
---
<Layout
  title={`Kindergeld-Rechner ${year}`}
  description={`Kindergeld ${year} kostenlos berechnen – ${euro(KINDERGELD_MONAT)} pro Kind nach § 66 EStG. Monats- und Jahresbetrag auf einen Blick.`}
  canonicalPath="/familie/kindergeld-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}familie/`} class="back-link">← Familie &amp; Soziales</a>
    <h1>Kindergeld-Rechner {year} – monatlicher Anspruch</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro={`Mit dem Kindergeld-Rechner berechnen Sie den monatlichen und jährlichen Kindergeldanspruch für Ihre Familie. Seit Januar 2026 beträgt das Kindergeld einheitlich ${euro(KINDERGELD_MONAT)} pro Kind und Monat (§ 66 Abs. 1 EStG). Der Rechner zeigt Ihnen außerdem, ob der Kinderfreibetrag nach § 32 Abs. 6 EStG für Sie steuerlich günstiger wäre – das lohnt sich in der Regel ab einem zu versteuernden Einkommen von ca. 75.000 € (Zusammenveranlagung).`}
    sourceNote={`${euro(KINDERGELD_MONAT)} je Kind und Monat nach § 66 Abs. 1 EStG. Freibeträge nach § 32 Abs. 6 Satz 1 EStG: ${euro(KINDERFREIBETRAG_JE_ELTERNTEIL)} sächliches Existenzminimum und ${euro(BEA_FREIBETRAG_JE_ELTERNTEIL)} Betreuungs- und Erziehungsbedarf, je Elternteil – zusammenveranlagt ${euro(FREIBETRAG_JE_KIND)} je Kind. Quelle: Gesetzestext, gesetze-im-internet.de.`}
    explanation={`Das Kindergeld wird nach § 66 EStG bzw. § 6 BKGG gezahlt und beträgt seit Januar 2026 einheitlich ${euro(KINDERGELD_MONAT)} pro Kind und Monat. Der Anspruch besteht bis zum 18. Lebensjahr, bei Ausbildung oder Studium bis zum 25. Lebensjahr. Das Finanzamt führt bei der Steuererklärung automatisch eine Günstigerprüfung durch: Es vergleicht das ausgezahlte Kindergeld mit der Steuerersparnis durch die Freibeträge nach § 32 Abs. 6 EStG (zusammen ${euro(FREIBETRAG_JE_KIND)} je Kind bei Zusammenveranlagung) und wendet die für Sie vorteilhaftere Variante an.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-group">
        <label for="kinder">Anzahl Kinder (mit Anspruch)</label>
        <select id="kinder">
          <option value="1">1 Kind</option>
          <option value="2">2 Kinder</option>
          <option value="3" selected>3 Kinder</option>
          <option value="4">4 Kinder</option>
          <option value="5">5 Kinder</option>
          <option value="6">6 Kinder</option>
        </select>
      </div>
      <div class="calc-result">
        <div class="label">Kindergeld pro Monat</div>
        <div id="monat">— €</div>
      </div>
      <p id="jahr" style="margin-top:0.5rem;font-size:0.95rem;color:#666;"></p>
      <p id="proKind" style="margin-top:0.25rem;font-size:0.82rem;color:#999;"></p>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Kindergeld 2026 – Anspruch, Antrag und Kinderfreibetrag im Vergleich"
    content={`
    <p><strong>Kindergeld</strong> ist eine der wichtigsten Familienleistungen in Deutschland und steht grundsätzlich allen Eltern zu – unabhängig vom Einkommen. Seit Januar 2026 beträgt es einheitlich <strong>${euro(KINDERGELD_MONAT)} pro Kind und Monat</strong> (§ 66 Abs. 1 EStG). Die frühere Staffelung, bei der ab dem dritten Kind höhere Beträge gezahlt wurden, ist entfallen.</p>

    <h4>Kindergeld nach Kinderzahl im Überblick</h4>
    <p>Da für jedes Kind der gleiche Betrag von ${euro(KINDERGELD_MONAT)} gilt, ergibt sich der Gesamtbetrag durch Multiplikation. Die folgende Tabelle zeigt den monatlichen und jährlichen Anspruch nach Anzahl der Kinder.</p>
    <table>
      <thead>
        <tr><th>Anzahl Kinder</th><th>Pro Monat</th><th>Pro Jahr</th></tr>
      </thead>
      <tbody>
        ${kindergeldTabelle.map((r) => `<tr><td>${r.anzahlKinder} ${r.anzahlKinder === 1 ? 'Kind' : 'Kinder'}</td><td>${euro(r.monat)}</td><td>${euro(r.jahr)}</td></tr>`).join('\n        ')}
      </tbody>
    </table>

    <p><strong>Antragstellung bei der Familienkasse:</strong> Kindergeld wird nicht automatisch ausgezahlt, sondern muss bei der Familienkasse der Bundesagentur für Arbeit beantragt werden. Der Antrag kann seit 2024 vollständig digital über das Portal <em>Familienkasse Digital</em> gestellt werden. Für Neugeborene empfiehlt sich der Antrag innerhalb der ersten sechs Monate nach Geburt – eine rückwirkende Zahlung ist nur für maximal sechs Monate möglich (§ 66 Abs. 3 EStG).</p>

    <p><strong>Kindergeld vs. Kinderfreibetrag – die Günstigerprüfung:</strong> Das Finanzamt vergleicht bei der Einkommensteuererklärung automatisch, ob das ausgezahlte Kindergeld (${euro(KINDERGELD_MONAT)} × 12 = ${euro(KINDERGELD_MONAT * 12)} pro Kind und Jahr) oder die Freibeträge nach § 32 Abs. 6 EStG steuerlich vorteilhafter sind. Zusammenveranlagte Eltern setzen je Kind ${euro(KINDERFREIBETRAG_JE_ELTERNTEIL * 2)} für das sächliche Existenzminimum und ${euro(BEA_FREIBETRAG_JE_ELTERNTEIL * 2)} für den Betreuungs- und Erziehungsbedarf an, zusammen ${euro(FREIBETRAG_JE_KIND)}. Bei zusammenveranlagten Ehepaaren lohnt sich der Kinderfreibetrag in der Regel ab einem zu versteuernden Einkommen von etwa 75.000 € – bei Alleinerziehenden bereits ab ca. 40.000 €. Sie müssen sich nicht vorab entscheiden: Die günstigere Variante wird automatisch angewendet.</p>

    <p><strong>Anspruchsdauer und Verlängerung:</strong> Kindergeld wird grundsätzlich bis zum 18. Geburtstag gezahlt. Bei Kindern in Ausbildung, Studium oder einem anerkannten Freiwilligendienst (FSJ, BFD) verlängert sich der Anspruch bis zum 25. Lebensjahr (§ 32 Abs. 4 EStG). Zwischen zwei Ausbildungsabschnitten besteht der Anspruch für bis zu vier Monate weiter. Bei Kindern mit Behinderung, die sich nicht selbst unterhalten können, entfällt die Altersgrenze vollständig.</p>

    <p><strong>Was hat sich zum Januar 2026 geändert?</strong> Das Kindergeld ist von 255 € auf ${euro(KINDERGELD_MONAT)} gestiegen. § 66 Abs. 3 EStG koppelt es an die Freibeträge: Werden diese angehoben, erhöht sich das Kindergeld entsprechend und wird auf volle Euro kaufmännisch gerundet. Die Freibeträge nach § 32 Abs. 6 EStG wurden ebenfalls angehoben, um die kalte Progression auszugleichen. Der Sofortzuschlag von 25 € monatlich für Kinder in Familien mit geringem Einkommen bleibt bestehen (§ 6a Abs. 2 Satz 4 BKGG).</p>

    <p><strong>Praktische Hinweise:</strong> Kindergeld wird in der Regel am Anfang oder Mitte des Monats ausgezahlt – der genaue Termin richtet sich nach der letzten Ziffer Ihrer Kindergeldnummer. Ein Kontoauszug mit dem Verwendungszweck „FK" + Kindergeldnummer bestätigt den Eingang. Kindergeld ist weitgehend pfändungsgeschützt: Nach § 76 EStG kann der Anspruch nur wegen gesetzlicher Unterhaltsansprüche des Kindes gepfändet werden, für das es festgesetzt und ausgezahlt wird. Bei getrennt lebenden Eltern erhält derjenige Elternteil das Kindergeld, bei dem das Kind überwiegend lebt.</p>
    `}
    relatedSlugs={['elterngeld-rechner', 'betreuungskosten-rechner']}
  />
</Layout>

<script type="module">
const { berechneKindergeld } = await import(window.__base + 'scripts/kindergeld.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const kinder = parseInt(document.getElementById('kinder').value)||1;
  const r = berechneKindergeld({ anzahlKinder: kinder });
  document.getElementById('monat').textContent = fmt(r.monat);
  document.getElementById('jahr').textContent = 'Pro Jahr: ' + fmt(r.jahr);
  document.getElementById('proKind').textContent = `${fmt(r.betragProKind)} je Kind × ${kinder} = ${fmt(r.monat)} / Monat`;
}
document.getElementById('kinder').addEventListener('change', berechne);
berechne();
</script>
