---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import ArtikelRentenpunkte from '../../components/artikel/zweiter-rentenpunkt-unerreichbar.astro';
import {
  AKTUELLER_RENTENWERT,
  BBG_RENTE_JAHR,
  DURCHSCHNITTSENTGELT_VORLAEUFIG,
  MAX_ENTGELTPUNKTE_JAHR,
} from '../../../public/scripts/rentenwerte.js';
const calc = CALCULATORS.find(c => c.slug === 'rentenpunkte-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

const euro = (betrag: number) => betrag.toLocaleString('de-DE') + ' €';
const punkte = (wert: number) => wert.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });

const rentenwertText = AKTUELLER_RENTENWERT.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €';
const durchschnittText = euro(DURCHSCHNITTSENTGELT_VORLAEUFIG);
const bbgText = euro(BBG_RENTE_JAHR);
const maxPunkteText = punkte(MAX_ENTGELTPUNKTE_JAHR);

const faqs = [
  { q: 'Wie entstehen Rentenpunkte?', a: `Aus Beiträgen. Nach § 70 Abs. 1 SGB VI wird das beitragspflichtige Jahresentgelt durch das Durchschnittsentgelt aller Versicherten geteilt – für ${year} sind das ${durchschnittText}. Wer genau so viel verdient, erhält einen Entgeltpunkt.` },
  { q: 'Wer erwirbt Rentenpunkte?', a: 'Alle Pflichtversicherten der gesetzlichen Rentenversicherung, also abhängig Beschäftigte und einzelne Gruppen Selbstständiger. Beamte, Richter und Berufssoldaten sind nach § 5 Abs. 1 Satz 1 Nr. 1 SGB VI versicherungsfrei und erwerben keine Entgeltpunkte, sondern Ansprüche aus der Beamtenversorgung.' },
  { q: 'Wie viele Punkte sind in einem Jahr höchstens möglich?', a: `${maxPunkteText} Punkte. Beiträge werden nach § 157 SGB VI nur bis zur Beitragsbemessungsgrenze erhoben, ${year} bis ${bbgText} im Jahr. Was darüber verdient wird, erhöht die Rente nicht.` },
  { q: 'Zählen Zeiten ohne Beiträge mit?', a: 'Teilweise. Anrechnungszeiten wie Krankheit, Arbeitslosigkeit oder Ausbildung werden über die Gesamtleistungsbewertung der §§ 71 bis 74 SGB VI bewertet, also aus dem Durchschnitt der übrigen Beitragszeiten. Für berufliche Ausbildung und Fachschule sind das höchstens 0,0625 Punkte im Monat und insgesamt höchstens drei Jahre; Zeiten einer Schul- oder Hochschulausbildung werden nach § 74 Satz 4 SGB VI gar nicht bewertet.' },
  { q: 'Wie viel Rente ergibt ein Rentenpunkt?', a: `Ein Entgeltpunkt ergibt derzeit ${rentenwertText} Rente im Monat. Dieser aktuelle Rentenwert wird jedes Jahr zum 1. Juli neu festgesetzt, zuletzt durch § 1 der Rentenwertbestimmungsverordnung 2026.` },
  { q: 'Wo sehe ich meine bisherigen Punkte?', a: 'In der Renteninformation und im Versicherungsverlauf der Deutschen Rentenversicherung. Alle Punkte aus allen Beschäftigungen werden dort addiert. Lücken lassen sich in einer kostenlosen Kontenklärung schließen.' },
];
---
<Layout
  title={`Rentenpunkte-Rechner ${year}`}
  description={`Rentenpunkte (Entgeltpunkte) und Rentenanspruch kostenlos berechnen – nach § 70 SGB VI mit dem aktuellen Rentenwert von ${rentenwertText}.`}
  canonicalPath="/familie/rentenpunkte-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}familie/`} class="back-link">← Familie &amp; Soziales</a>
    <h1>Rentenpunkte-Rechner {year} – Rentenanspruch berechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Rentenpunkte-Rechner berechnen Sie Ihre Entgeltpunkte für die gesetzliche Rente. Erfahren Sie, wie viele Punkte Ihr Gehalt pro Jahr ergibt und was das für Ihre spätere Rente bedeutet."
    sourceNote={`Ein Punkt = ${durchschnittText} Jahresverdienst.`}
    explanation={`Entgeltpunkte werden nach § 70 Abs. 1 SGB VI berechnet: beitragspflichtiges Jahresentgelt geteilt durch das Durchschnittsentgelt aller Versicherten (${durchschnittText}). Weil Beiträge nur bis zur Beitragsbemessungsgrenze von ${bbgText} erhoben werden, sind höchstens ${maxPunkteText} Punkte im Jahr möglich. Auch Kindererziehungs- und Pflegezeiten ergeben Punkte.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="brutto">Jahres-Bruttogehalt (€)</label>
          <input type="number" id="brutto" min="0" max="500000" value="45000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="jahre">Anzahl Jahre (Simulation)</label>
          <input type="number" id="jahre" min="1" max="50" value="1" step="1" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Rentenpunkte pro Jahr</div>
        <div id="punkte">—</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
      <div id="bbg-hinweis" style="display:none;margin-top:0.75rem;padding:0.75rem 1rem;border-radius:8px;background:#fff3cd;font-size:0.88rem;"></div>
      <section id="rp-block" aria-labelledby="rp-titel" style="margin-top:1.5rem;">
        <h2 id="rp-titel" style="font-size:1.15rem;margin:0 0 0.5rem;">Was Ihr Verdienst und Ihre Beitragsjahre an Rente bringen</h2>
        <p id="rp-text" style="font-size:0.9rem;margin:0 0 0.75rem;"></p>
        <div><svg id="rp-svg" role="img" aria-labelledby="rp-titel rp-text" style="display:block;width:100%;height:auto;"></svg></div>
        <div style="overflow-x:auto;"><table id="rp-tabelle"></table></div>
      </section>
    </div>
    <ArtikelRentenpunkte slot="artikel" />
  </CalculatorShell>

  <CalculatorGuide
    title="Rentenpunkte – Basis der Rentenberechnung"
    content={`Rentenpunkte – im Gesetz Entgeltpunkte – sind die Grundlage jeder Rentenberechnung. Sie entstehen aus gezahlten Beiträgen: Ein Jahr mit dem Durchschnittsentgelt aller Versicherten ergibt genau einen Punkt, derzeit also ein Jahresverdienst von ${durchschnittText}.

Wer die Hälfte verdient, erhält 0,5 Punkte. Nach oben gibt es dagegen eine harte Grenze: Beiträge werden nach § 157 SGB VI nur bis zur Beitragsbemessungsgrenze erhoben, im Jahr ${year} bis ${bbgText}. Mehr als ${maxPunkteText} Punkte sind in einem Jahr deshalb nicht erreichbar, auch bei doppeltem oder dreifachem Durchschnittsverdienst nicht.

Beitragsfreie Zeiten zählen nicht pauschal mit, sondern über die Gesamtleistungsbewertung der §§ 71 bis 74 SGB VI: Sie werden mit dem Durchschnitt der übrigen Beitragszeiten bewertet. Für Zeiten der beruflichen Ausbildung oder einer Fachschule ist dieser Wert auf 0,0625 Punkte im Monat und auf insgesamt drei Jahre begrenzt. Zeiten einer Schul- oder Hochschulausbildung sind zwar Anrechnungszeiten und verlängern die Wartezeit, bringen aber nach § 74 Satz 4 SGB VI keine Entgeltpunkte.

Kindererziehungszeiten ergeben dagegen echte Punkte: 0,0833 Entgeltpunkte je Kalendermonat nach § 70 Abs. 2 SGB VI, also rund einen Punkt pro Jahr.

Die ausgewiesene Rente ist ein heutiger Wert. Sie entsteht aus dem aktuellen Rentenwert von ${rentenwertText} je Punkt und unterstellt einen Rentenbeginn genau mit der Regelaltersgrenze, also einen Zugangsfaktor von 1,0.

Planungstipp: Prüfen Sie Ihr Versicherungskonto regelmäßig bei der Deutschen Rentenversicherung. Fehlende Zeiten senken die spätere Rente; die Kontenklärung ist kostenlos.`}
    relatedSlugs={['renten-rechner', 'elterngeld-rechner']}
  />

</Layout>

<script type="module">
const { berechneRentenpunkte } = await import(window.__base + 'scripts/rentenpunkte.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function pkt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:4, maximumFractionDigits:4}); }
function berechne() {
  const brutto = parseFloat(document.getElementById('brutto').value)||0;
  const jahre = parseInt(document.getElementById('jahre').value)||1;
  const r = berechneRentenpunkte({ bruttoJahr: brutto, jahre });
  document.getElementById('punkte').textContent = pkt(r.entgeltpunkte) + ' Punkte/Jahr';
  document.getElementById('details').innerHTML =
    (jahre > 1 ? `<span>Punkte gesamt (${jahre} Jahre): <strong>${pkt(r.entgeltpunkteGesamt)}</strong></span>` : '') +
    `<span>Rente daraus: <strong>${fmt(r.monatsrente)}</strong>/Monat</span>` +
    `<span>Rentenwert: ${fmt(r.rentenwert)}/Punkt</span>`;
  const hinweis = document.getElementById('bbg-hinweis');
  if (r.ueberBeitragsbemessungsgrenze) {
    hinweis.style.display = 'block';
    hinweis.innerHTML = `<strong>Beitragsbemessungsgrenze erreicht.</strong> Beiträge werden nur aus ${fmt(r.beitragsbemessungsgrenze)} im Jahr erhoben (§ 157 SGB VI). Der Verdienst darüber erhöht die Rente nicht – mehr als ${pkt(r.maxEntgeltpunkte)} Punkte im Jahr sind nicht möglich.`;
  } else {
    hinweis.style.display = 'none';
  }
}
['brutto','jahre'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
const D = await import(window.__base + 'scripts/diagramm.js');
let rpLetzte = false;
function zeigeRentenVerlauf() {
  rpLetzte = true;
  const brutto = parseFloat(document.getElementById('brutto').value) || 0;
  const jahre = parseInt(document.getElementById('jahre').value) || 1;
  const eur0 = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20ac';
  const grenze = berechneRentenpunkte({ bruttoJahr: 1, jahre }).beitragsbemessungsgrenze;
  const max = Math.round(grenze * 1.3 / 5000) * 5000;
  const punkte = D.reihe(0, max, 2500, (b) => ({ y: berechneRentenpunkte({ bruttoJahr: b, jahre }).monatsrente }));
  const hier = berechneRentenpunkte({ bruttoJahr: brutto, jahre });
  document.getElementById('rp-text').textContent =
    `Aus ${eur0(brutto)} brutto im Jahr und ${jahre} ${jahre === 1 ? 'Jahr' : 'Jahren'} ergibt sich eine Monatsrente von ${eur0(hier.monatsrente)}. ` +
    `Über der Beitragsbemessungsgrenze von ${eur0(grenze)} wächst die Rente nicht mehr.`;
  D.zeichneKurve(document.getElementById('rp-svg'), {
    serien: [{ punkte }], marker: { x: Math.min(brutto, max), y: hier.monatsrente },
    xFormat: (n) => (n / 1000).toLocaleString('de-DE') + ' Tsd. \u20ac', yFormat: eur0,
  });
  const stufen = [...new Set([10, 20, 30, 40, 45, jahre])].sort((a, b) => a - b);
  D.fuelleTabelle(document.getElementById('rp-tabelle'), ['Beitragsjahre', 'Entgeltpunkte', 'Monatsrente'],
    stufen.map((j) => {
      const r = berechneRentenpunkte({ bruttoJahr: brutto, jahre: j });
      return { zellen: [j === 1 ? '1 Jahr' : j + ' Jahre', pkt(r.entgeltpunkteGesamt), fmt(r.monatsrente)], markiert: j === jahre };
    }));
}
['brutto', 'jahre'].forEach((id) => document.getElementById(id).addEventListener('input', zeigeRentenVerlauf));
D.beiGroessenaenderung(() => rpLetzte && zeigeRentenVerlauf());
zeigeRentenVerlauf();

berechne();
</script>
