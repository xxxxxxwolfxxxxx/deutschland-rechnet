---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { berechneWieVielHaus } from '../../../public/scripts/wie-viel-haus.js';
import { BUNDESLAENDER } from '../../../public/scripts/grunderwerbsteuer.js';
import { MAKLER_PROVISION_PROZENT_JE_SEITE } from '../../../public/scripts/immokauf-nebenkosten.js';
const calc = CALCULATORS.find(c => c.slug === 'wie-viel-haus')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus wie-viel-haus.js und den Modulen dahinter.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const pz = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' %';
const laender = Object.entries(BUNDESLAENDER).sort((a, b) => a[1].name.localeCompare(b[1].name, 'de'));

const basis = { rate: 1500, eigenkapital: 80000, sollzins: 3.5, tilgung: 2, zinsbindung: 15, mitMakler: false };
const nw = berechneWieVielHaus({ ...basis, bundesland: 'nw' });
const by = berechneWieVielHaus({ ...basis, bundesland: 'by' });
const nwMakler = berechneWieVielHaus({ ...basis, bundesland: 'nw', mitMakler: true });
const drei = berechneWieVielHaus({ ...basis, bundesland: 'nw', tilgung: 3 });
const anschluss = berechneWieVielHaus({ ...basis, bundesland: 'nw', anschlusszins: 5.5 });
if (nw.kaufpreis + (nw.nebenkosten?.gesamt ?? 0) > nw.budget || !(by.kaufpreis > nw.kaufpreis) || !(anschluss.anschlussrate > basis.rate)) {
  throw new Error('Wie viel Haus: Beispiel widerspricht dem Modul');
}

const guideHtml = `
<h3>Von der Rate zum Kaufpreis</h3>
<p>Der Rechner beginnt bei der Rate, die Sie dauerhaft tragen können – nicht bei einer Faustregel über das Einkommen. Bei einem Annuitätendarlehen ist die Jahresrate die Summe aus Sollzins und anfänglicher Tilgung, jeweils auf den Darlehensbetrag bezogen. Umgekehrt trägt eine Monatsrate von ${eur(basis.rate)} bei ${pz(basis.sollzins)} Zins und ${pz(basis.tilgung)} Tilgung ein Darlehen von ${eur(nw.darlehen)}.</p>
<p>Zusammen mit ${eur(basis.eigenkapital)} Eigenkapital stehen ${eur(nw.budget)} zur Verfügung. Davon gehen die Kaufnebenkosten ab, die selbst vom Kaufpreis abhängen: Grunderwerbsteuer zum Satz des Bundeslandes, Notar- und Grundbuchgebühren nach dem GNotKG und gegebenenfalls die Maklerprovision. In Nordrhein-Westfalen (${pz(nw.nebenkosten!.gewSatz)} Grunderwerbsteuer) bleibt ohne Makler ein Kaufpreis von ${eur(nw.kaufpreis)}, in Bayern (${pz(by.nebenkosten!.gewSatz)}) sind es ${eur(by.kaufpreis)}. Mit Makler zu ${pz(MAKLER_PROVISION_PROZENT_JE_SEITE)} sinkt der Kaufpreis in Nordrhein-Westfalen auf ${eur(nwMakler.kaufpreis)}.</p>

<h3>Tilgung und Zinsbindung</h3>
<p>Mit ${pz(basis.tilgung)} Anfangstilgung dauert es ${nw.laufzeitJahre.toLocaleString('de-DE')} Jahre, bis das Darlehen bei gleichbleibendem Zins getilgt ist. Nach ${basis.zinsbindung} Jahren Zinsbindung sind noch ${eur(nw.restschuld)} offen; in dieser Zeit fließen ${eur(nw.zinsenBindung)} Zinsen. Mit ${pz(3)} Tilgung trägt dieselbe Rate nur ${eur(drei.darlehen)}, das Darlehen ist aber nach ${drei.laufzeitJahre.toLocaleString('de-DE')} Jahren abbezahlt.</p>
<p>Die Restschuld muss nach der Bindung zu dem Zins weiterfinanziert werden, der dann gilt. Liegt er bei ${pz(5.5)} statt ${pz(basis.sollzins)}, steigt die Rate für dasselbe Laufzeitende auf ${eur(anschluss.anschlussrate)}. Tragen Sie im Rechner einen Anschlusszins ein, um diese Frage für Ihre Zahlen zu beantworten.</p>

<h3>Die Haushaltsrechnung</h3>
<p>Ob die Rate tragbar ist, zeigt nur Ihr eigenes Budget: Nettoeinkommen minus aller festen Ausgaben ohne die bisherige Miete. Was danach nach Abzug der Rate bleibt, muss Lebenshaltung, Rücklagen für das Haus und unerwartete Ausgaben decken. Banken prüfen das mit eigenen Haushaltsrechnungen; eine gesetzliche Obergrenze für den Anteil der Rate am Einkommen gibt es nicht.</p>
<p>Nicht enthalten sind die Kosten der Grundschuldbestellung, die laufenden Kosten des Hauses (Grundsteuer, Versicherung, Instandhaltung) und Zinsaufschläge, die eine Bank bei wenig Eigenkapital verlangen kann.</p>
`;

const faqs = [
  { q: 'Wie hängen Rate und Darlehen zusammen?', a: `Jahresrate = Darlehen × (Sollzins + anfängliche Tilgung). Eine Monatsrate von ${eur(basis.rate)} trägt bei ${pz(basis.sollzins)} Zins und ${pz(basis.tilgung)} Tilgung ${eur(nw.darlehen)} Darlehen.` },
  { q: 'Welche Kaufnebenkosten rechnet der Rechner?', a: `Grunderwerbsteuer zum Satz Ihres Bundeslandes – zwischen 3,5 und 6,5 % –, Notar- und Grundbuchgebühren nach dem GNotKG und auf Wunsch eine Maklerprovision von ${pz(MAKLER_PROVISION_PROZENT_JE_SEITE)} des Kaufpreises. Die Kosten der Grundschuld sind nicht enthalten.` },
  { q: 'Was passiert nach der Zinsbindung?', a: `Die Restschuld wird neu finanziert. Im Beispiel sind nach ${basis.zinsbindung} Jahren noch ${eur(nw.restschuld)} offen. Steigt der Zins auf ${pz(5.5)}, braucht es ${eur(anschluss.anschlussrate)} im Monat, um zum selben Zeitpunkt schuldenfrei zu sein.` },
  { q: 'Wie viel Prozent des Einkommens darf die Rate ausmachen?', a: 'Dafür gibt es keine gesetzliche Grenze, und verbreitete Faustregeln beruhen auf keiner nachprüfbaren Quelle. Maßgeblich ist, was nach Rate und festen Ausgaben zum Leben bleibt – das zeigt die Haushaltsrechnung im Rechner.' },
  { q: 'Warum ist der Kaufpreis in Bayern höher?', a: `Weil Bayern mit ${pz(by.nebenkosten!.gewSatz)} die niedrigste Grunderwerbsteuer hat. Bei gleichem Budget bleibt dort mehr für den Kaufpreis: im Beispiel ${eur(by.kaufpreis - nw.kaufpreis)} mehr als in Nordrhein-Westfalen.` },
];
---
<Layout
  title={`Wie viel Haus kann ich mir leisten? ${year}`}
  description="Maximaler Kaufpreis aus tragbarer Rate, Eigenkapital und Kaufnebenkosten des Bundeslandes – mit Restschuld nach der Zinsbindung und Anschlussrate."
  canonicalPath="/wohnen/wie-viel-haus/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}wohnen/`} class="back-link">← Wohnen &amp; Immobilien</a>
    <h1>Wie viel Haus kann ich mir leisten? {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner geht von der Monatsrate aus, die Sie tragen können, und rechnet über Zins, Tilgung, Eigenkapital und die Kaufnebenkosten Ihres Bundeslandes zurück auf den höchsten Kaufpreis – samt Restschuld nach der Zinsbindung."
    sourceNote="Darlehen = Rate × 12 ÷ (Sollzins + Tilgung); Tilgungsplan als Annuitätendarlehen. Kaufnebenkosten: Grunderwerbsteuer nach Landessatz (§ 11 GrEStG), Notar und Grundbuch nach GNotKG (KV 21100, 22110, 22200, 14110, 14150), Maklerprovision nach Wahl. Ohne Grundschuld, laufende Hauskosten und Zinsaufschläge."
    explanation="Der Kaufpreis wird so bestimmt, dass Kaufpreis und Nebenkosten zusammen Eigenkapital plus Darlehen nicht übersteigen. Die Anschlussrate tilgt die Restschuld bis zum ursprünglich geplanten Laufzeitende."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="rate">Tragbare Monatsrate (€)</label>
          <input type="number" id="rate" min="0" max="20000" value={basis.rate} step="50" />
        </div>
        <div class="calc-group">
          <label for="eigenkapital">Eigenkapital (€)</label>
          <input type="number" id="eigenkapital" min="0" max="5000000" value={basis.eigenkapital} step="5000" />
        </div>
        <div class="calc-group">
          <label for="zins">Sollzins (% p. a.)</label>
          <input type="number" id="zins" min="0" max="15" value={basis.sollzins} step="0.05" />
        </div>
        <div class="calc-group">
          <label for="tilgung">Anfängliche Tilgung (% p. a.)</label>
          <input type="number" id="tilgung" min="0" max="20" value={basis.tilgung} step="0.1" />
        </div>
        <div class="calc-group">
          <label for="zinsbindung">Zinsbindung (Jahre)</label>
          <input type="number" id="zinsbindung" min="1" max="40" value={basis.zinsbindung} step="1" />
        </div>
        <div class="calc-group">
          <label for="anschlusszins">Anschlusszins (% p. a.)</label>
          <input type="number" id="anschlusszins" min="0" max="15" value={basis.sollzins} step="0.05" />
        </div>
        <div class="calc-group">
          <label for="bundesland">Bundesland</label>
          <select id="bundesland">
            {laender.map(([k, l]) => <option value={k} selected={k === 'nw'}>{l.name} ({l.satz.toLocaleString('de-DE')} %)</option>)}
          </select>
        </div>
        <div class="calc-group">
          <label><input type="checkbox" id="makler" style="width:auto;margin-right:0.4rem;" />Mit Makler ({MAKLER_PROVISION_PROZENT_JE_SEITE.toLocaleString('de-DE')} %)</label>
        </div>
        <div class="calc-group">
          <label for="einkommen">Haushaltsnettoeinkommen (€/Monat, optional)</label>
          <input type="number" id="einkommen" min="0" max="100000" value="" step="100" placeholder="—" />
        </div>
        <div class="calc-group">
          <label for="ausgaben">Feste Ausgaben ohne Miete (€/Monat, optional)</label>
          <input type="number" id="ausgaben" min="0" max="100000" value="" step="50" placeholder="—" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Höchster Kaufpreis</div>
        <div id="ergebnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.9rem;color:#555;display:flex;flex-direction:column;gap:0.3rem;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Wie viel Haus eine Rate trägt"
    content={guideHtml}
    relatedSlugs={['hauskauf-rechner', 'tilgungsplan', 'immobilienkauf-nebenkosten', 'grunderwerbsteuer-rechner']}
  />
</Layout>

<script type="module">
const { berechneWieVielHaus } = await import(window.__base + 'scripts/wie-viel-haus.js');
const eur = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = berechneWieVielHaus({
    rate: wert('rate'), eigenkapital: wert('eigenkapital'), sollzins: wert('zins'), tilgung: wert('tilgung'),
    zinsbindung: wert('zinsbindung'), anschlusszins: document.getElementById('anschlusszins').value,
    bundesland: document.getElementById('bundesland').value, mitMakler: document.getElementById('makler').checked,
    einkommen: wert('einkommen'), ausgaben: wert('ausgaben'),
  });
  document.getElementById('ergebnis').textContent = eur(r.kaufpreis);
  const nk = r.nebenkosten;
  const teile = [
    `<span>Darlehen: <strong>${eur(r.darlehen)}</strong> + Eigenkapital = ${eur(r.budget)}</span>`,
  ];
  if (nk) {
    teile.push(`<span>Kaufnebenkosten: <strong>${eur(nk.gesamt)}</strong> (Grunderwerbsteuer ${eur(nk.grunderwerbsteuer)}, Notar ${eur(nk.notar)}, Grundbuch ${eur(nk.grundbuch)}${nk.maklerKaeufer ? `, Makler ${eur(nk.maklerKaeufer)}` : ''})</span>`);
  }
  if (r.darlehen > 0) {
    teile.push(`<span>Laufzeit bei gleichem Zins: <strong>${r.laufzeitJahre.toLocaleString('de-DE')} Jahre</strong></span>`);
    teile.push(r.restschuld > 0
      ? `<span>Restschuld nach der Zinsbindung: <strong>${eur(r.restschuld)}</strong>, Zinsen bis dahin ${eur(r.zinsenBindung)}; Anschlussrate: <strong>${eur(r.anschlussrate)}</strong></span>`
      : `<span>Das Darlehen ist vor Ende der Zinsbindung getilgt.</span>`);
  }
  if (r.haushalt) {
    teile.push(`<span>Frei nach festen Ausgaben: <strong>${eur(r.haushalt.frei)}</strong>, nach der Rate: <strong style="color:${r.haushalt.nachRate < 0 ? '#b71c1c' : 'inherit'}">${eur(r.haushalt.nachRate)}</strong> (Rate = ${r.haushalt.rateAnteilEinkommen.toLocaleString('de-DE')} % des Einkommens)</span>`);
  }
  document.getElementById('details').innerHTML = teile.join('');
}
document.querySelectorAll('.calc-form input, .calc-form select').forEach((el) => {
  el.addEventListener('input', berechne);
  el.addEventListener('change', berechne);
});
berechne();
</script>
