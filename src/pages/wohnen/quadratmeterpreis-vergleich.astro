---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { berechneQmPreis, ANRECHNUNG } from '../../../public/scripts/qm-preis.js';
const calc = CALCULATORS.find(c => c.slug === 'quadratmeterpreis-vergleich')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const qm = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' m²';
const anteil = (n: number) => ({ 1: 'vollständig', 0.5: 'zur Hälfte', 0.25: 'zu einem Viertel', 0: 'gar nicht' } as Record<number, string>)[n];

const bsp = berechneQmPreis({ kaufpreis: 360000, beworbeneFlaeche: 85, flaechen: { vollHoch: 64, halbHoch: 16, niedrig: 5 } });
if (bsp.wohnflaeche !== 72 || bsp.preisWoFlV !== 5000) throw new Error('qm-Preis: Beispiel stimmt nicht');

const guideHtml = `
<h3>Welche Fläche im Nenner steht</h3>
<p>Der Quadratmeterpreis ist nur so gut wie die Fläche, durch die man teilt. Für Wohnraum regelt die Wohnflächenverordnung, wie Grundflächen angerechnet werden (§ 4 WoFlV):</p>
<ul>
<li>Räume und Raumteile mit mindestens zwei Metern lichter Höhe: ${anteil(ANRECHNUNG.voll)}</li>
<li>mit mindestens einem, aber weniger als zwei Metern lichter Höhe: ${anteil(ANRECHNUNG.halb)}</li>
<li>mit weniger als einem Meter lichter Höhe: ${anteil(ANRECHNUNG.keine)}</li>
<li>unbeheizte Wintergärten und ähnliche Räume: ${anteil(ANRECHNUNG.wintergarten)}</li>
<li>Balkone, Loggien, Dachgärten und Terrassen: in der Regel ${anteil(ANRECHNUNG.balkonRegel)}, höchstens ${anteil(ANRECHNUNG.balkonHoechst)}</li>
</ul>
<p>Keller, Waschküchen, Dachböden, Heizungsräume und Garagen gehören nach § 2 Abs. 3 WoFlV gar nicht zur Wohnfläche.</p>

<h3>Beispiel: Dachgeschoss</h3>
<p>Eine Wohnung wird für ${eur(360000)} mit ${qm(85)} angeboten – das wären ${eur(bsp.preisBeworben ?? 0)} je Quadratmeter. Die ${qm(85)} sind aber die Grundfläche: ${qm(64)} mit voller Höhe, ${qm(16)} unter Schrägen zwischen einem und zwei Metern, ${qm(5)} unter einem Meter. Nach § 4 WoFlV ergibt das ${qm(bsp.wohnflaeche)} Wohnfläche und ${eur(bsp.preisWoFlV ?? 0)} je Quadratmeter, also ${(bsp.aufschlagProzent ?? 0).toLocaleString('de-DE')} % mehr, als das Exposé nahelegt.</p>

<h3>Vergleichswerte</h3>
<p>Ob ein Quadratmeterpreis für die Lage hoch oder niedrig ist, beantwortet dieser Rechner nicht. Verlässliche Vergleichswerte veröffentlichen die Gutachterausschüsse für Grundstückswerte in ihren Grundstücksmarktberichten; Bodenrichtwerte stehen in den Portalen der Länder. Frühere Fassungen dieser Seite enthielten eine Tabelle mit Preisen für zwölf Städte ohne belegte Herkunft – sie ist entfernt.</p>
`;

const faqs = [
  { q: 'Wie wird der Quadratmeterpreis berechnet?', a: 'Kaufpreis geteilt durch Wohnfläche. Entscheidend ist, welche Fläche man nimmt: Nach § 4 WoFlV zählen Flächen unter Dachschrägen und Balkone nur anteilig.' },
  { q: 'Wie werden Balkone angerechnet?', a: 'Nach § 4 Nr. 4 WoFlV in der Regel zu einem Viertel, höchstens zur Hälfte.' },
  { q: 'Zählen Flächen unter Dachschrägen?', a: 'Ab zwei Metern lichter Höhe vollständig, zwischen einem und zwei Metern zur Hälfte, unter einem Meter gar nicht (§ 4 WoFlV).' },
  { q: 'Wo finde ich Vergleichspreise für meine Region?', a: 'In den Grundstücksmarktberichten der örtlichen Gutachterausschüsse für Grundstückswerte. Dieser Rechner enthält keine regionalen Preise.' },
];
---
<Layout
  title={`Quadratmeterpreis-Rechner ${year}`}
  description="Quadratmeterpreis aus Kaufpreis und Wohnfläche nach § 4 WoFlV – mit Dachschrägen, Wintergarten und Balkon."
  canonicalPath="/wohnen/quadratmeterpreis-vergleich/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}wohnen/`} class="back-link">← Wohnen &amp; Immobilien</a>
    <h1>Quadratmeterpreis-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner teilt den Kaufpreis durch die Fläche – einmal durch die Fläche aus dem Exposé und einmal durch die Wohnfläche nach der Wohnflächenverordnung, die Sie aus den Grundflächen berechnen lassen können."
    sourceNote="Anrechnung der Grundflächen nach § 4 WoFlV, nicht anrechenbare Räume nach § 2 Abs. 3 WoFlV (abgerufen am 14.09.2026). Der Rechner enthält keine Marktpreise."
    explanation="Wohnfläche nach WoFlV: volle Höhe ganz, 1 bis 2 m lichte Höhe zur Hälfte, unter 1 m nicht, unbeheizter Wintergarten zur Hälfte, Balkon in der Regel zu einem Viertel. Preis je m² = Kaufpreis ÷ Fläche."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="kaufpreis">Kaufpreis (€)</label>
          <input type="number" id="kaufpreis" min="0" max="100000000" value="360000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="beworben">Fläche laut Exposé (m²)</label>
          <input type="number" id="beworben" min="0" max="10000" value="85" step="1" />
        </div>
        <div class="calc-group">
          <label for="vollHoch">Grundfläche ab 2 m lichter Höhe (m²)</label>
          <input type="number" id="vollHoch" min="0" max="10000" value="64" step="1" />
        </div>
        <div class="calc-group">
          <label for="halbHoch">Grundfläche 1 bis unter 2 m Höhe (m²)</label>
          <input type="number" id="halbHoch" min="0" max="10000" value="16" step="1" />
        </div>
        <div class="calc-group">
          <label for="niedrig">Grundfläche unter 1 m Höhe (m²)</label>
          <input type="number" id="niedrig" min="0" max="10000" value="5" step="1" />
        </div>
        <div class="calc-group">
          <label for="wintergarten">Unbeheizter Wintergarten (m²)</label>
          <input type="number" id="wintergarten" min="0" max="10000" value="0" step="1" />
        </div>
        <div class="calc-group">
          <label for="balkon">Balkon, Loggia, Terrasse (m²)</label>
          <input type="number" id="balkon" min="0" max="10000" value="0" step="1" />
        </div>
        <div class="calc-group">
          <label for="balkonFaktor">Balkon anrechnen</label>
          <select id="balkonFaktor">
            <option value="regel" selected>zu einem Viertel (Regel)</option>
            <option value="haelfte">zur Hälfte (Höchstsatz)</option>
          </select>
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Preis je m² Wohnfläche nach WoFlV</div>
        <div id="wert">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide title="Wohnfläche und Quadratmeterpreis" content={guideHtml} relatedSlugs={['hauskauf-rechner', 'immobilienkauf-nebenkosten', 'mietrendite-rechner']} />
</Layout>

<script type="module">
const { berechneQmPreis } = await import(window.__base + 'scripts/qm-preis.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const qm = (n) => n.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' m²';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = berechneQmPreis({
    kaufpreis: wert('kaufpreis'),
    beworbeneFlaeche: wert('beworben'),
    flaechen: {
      vollHoch: wert('vollHoch'),
      halbHoch: wert('halbHoch'),
      niedrig: wert('niedrig'),
      wintergarten: wert('wintergarten'),
      balkon: wert('balkon'),
      balkonZurHaelfte: document.getElementById('balkonFaktor').value === 'haelfte',
    },
  });
  document.getElementById('wert').textContent = r.preisWoFlV === null ? '— €' : `${eur(r.preisWoFlV)}/m²`;
  const teile = [
    `<span>Wohnfläche nach WoFlV: <strong>${qm(r.wohnflaeche)}</strong> von ${qm(r.grundflaeche)} Grundfläche</span>`,
  ];
  if (r.preisBeworben !== null) teile.push(`<span>Preis je m² laut Exposé: <strong>${eur(r.preisBeworben)}/m²</strong></span>`);
  if (r.aufschlagProzent !== null && r.aufschlagProzent !== 0) {
    teile.push(`<span>Unterschied: <strong>${r.aufschlagProzent > 0 ? '+' : ''}${r.aufschlagProzent.toLocaleString('de-DE')} %</strong></span>`);
  }
  document.getElementById('details').innerHTML = teile.join('');
}
['kaufpreis', 'beworben', 'vollHoch', 'halbHoch', 'niedrig', 'wintergarten', 'balkon'].forEach((id) =>
  document.getElementById(id).addEventListener('input', berechne));
document.getElementById('balkonFaktor').addEventListener('change', berechne);
berechne();
</script>
