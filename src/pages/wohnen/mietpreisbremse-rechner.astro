---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelMietpreisbremse from '../../components/artikel/mietpreisbremse-30-monate-frist.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'mietpreisbremse-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Mietpreisbremse-Rechner ${year}`}
  description="Zulässige Miethöhe nach Mietpreisbremse (§ 556d BGB) prüfen – ortsübliche Vergleichsmiete + 10% Grenze."
  canonicalPath="/wohnen/mietpreisbremse-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}wohnen/`} class="back-link">← Wohnen</a>
    <h1>Mietpreisbremse-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Mietpreisbremse-Rechner prüfen Sie, ob Ihre Miete die zulässige Höchstgrenze überschreitet. So erfahren Sie, ob Sie als Mieter zu viel zahlen und eine Rückforderung geltend machen können. Der Rechner vergleicht Ihre aktuelle Miete mit der ortsüblichen Vergleichsmiete plus dem gesetzlichen Zuschlag."
    sourceNote="Maximal 10% über ortsüblicher Miete."
    explanation="Die Mietpreisbremse ist in § 556d BGB geregelt und begrenzt die Miete bei Neuvermietungen auf maximal 10 % über der ortsüblichen Vergleichsmiete. Sie gilt nur in Gebieten mit angespanntem Wohnungsmarkt, die per Landesverordnung ausgewiesen wurden. Das Mietrechtsanpassungsgesetz vom 18. Dezember 2018 hat die qualifizierte Rüge abgeschafft – seit dem 1. Januar 2019 genügt eine einfache Beanstandung in Textform. Wie weit die Rückforderung zurückreicht, hängt seit dem 1. April 2020 an § 556g Abs. 2 Satz 3 BGB: Wer innerhalb von 30 Monaten nach Mietbeginn rügt, holt die Differenz ab Mietbeginn zurück; danach nur noch für die Zukunft."
    faqs={[
      { q: "Gilt die Mietpreisbremse in meiner Stadt?", a: "Die Mietpreisbremse gilt nur in Gebieten, die per Landesverordnung als angespannter Wohnungsmarkt ausgewiesen wurden. Dazu zählen fast alle deutschen Großstädte wie Berlin, München, Hamburg, Frankfurt und Köln. Prüfen Sie die aktuelle Verordnung Ihres Bundeslandes, da die Gebietskulisse regelmäßig angepasst wird." },
      { q: "Was ist die 'ortsübliche Vergleichsmiete'?", a: "Die ortsübliche Vergleichsmiete ist die durchschnittliche Nettokaltmiete für vergleichbare Wohnungen in der Region. Sie wird aus dem qualifizierten Mietspiegel ermittelt und basiert auf Baujahr, Größe, Ausstattung und Lage. Existiert kein Mietspiegel, kann ein Sachverständigengutachten oder eine Mietdatenbank herangezogen werden." },
      { q: "Schützt die Mietpreisbremse Bestandsmieter?", a: "Nein, die Mietpreisbremse nach § 556d BGB gilt nur bei Neuvermietungen. Für bestehende Mietverhältnisse gelten die Kappungsgrenzen nach § 558 BGB: maximal 20% Mieterhöhung innerhalb von drei Jahren, in angespannten Märkten sogar nur 15%." },
      { q: "Kann ich zu viel gezahlte Miete zurückfordern?", a: "Ja, und wie weit zurück, entscheidet § 556g Abs. 2 Satz 3 BGB. Rügen Sie innerhalb von 30 Monaten nach Beginn des Mietverhältnisses, bekommen Sie die zu viel gezahlte Miete ab Mietbeginn zurück. Rügen Sie später, wirkt die Rüge nur noch für die Zukunft – die bis dahin gezahlte Differenz ist verloren. Der Anspruch wächst also 30 Monate lang und verfällt im 31. Monat schlagartig." },
      { q: "Welche Ausnahmen gibt es von der Mietpreisbremse?", a: "Ausgenommen sind Neubauten, die nach dem 1. Oktober 2014 erstmals genutzt und vermietet wurden (§ 556f Satz 1 BGB – beides muss zutreffen, nicht nur die Vermietung), umfassend modernisierte Wohnungen (§ 556f Satz 2) und Fälle, in denen die Vormiete bereits über der zulässigen Grenze lag (§ 556e Abs. 1 BGB). Dann ist allerdings die Vormiete die Obergrenze, nicht die Wunschmiete des Vermieters. Auch möblierte Wohnungen auf Zeit können Sonderregelungen unterliegen." },
      { q: "Wie schreibe ich eine wirksame Rüge?", a: "Seit dem 1. Januar 2019 genügt eine einfache Rüge: Sie beanstanden gegenüber dem Vermieter, dass die Miete gegen die Mietpreisbremse verstößt. Eine detaillierte Begründung ist nicht mehr nötig. § 556g Abs. 4 BGB verlangt nur Textform nach § 126b BGB – eine E-Mail genügt, eine Unterschrift ist nicht nötig. Versenden Sie die Rüge nachweisbar, etwa per Einschreiben oder E-Mail mit Empfangsbestätigung. Musterschreiben bietet der Deutsche Mieterbund an." },
      { q: "Habe ich einen Auskunftsanspruch gegenüber dem Vermieter?", a: "Ja. Nach § 556g Abs. 3 BGB müssen Vermieter Ihnen auf Verlangen Auskunft über die Tatsachen geben, die für die zulässige Miethöhe maßgeblich sind, etwa die Höhe der Vormiete oder durchgeführte Modernisierungen. Berufen sie sich auf eine Ausnahme, müssen sie das teils sogar unaufgefordert vor Vertragsschluss offenlegen." },
      { q: "Was ist der Unterschied zwischen qualifiziertem und einfachem Mietspiegel?", a: "Ein qualifizierter Mietspiegel wird nach wissenschaftlichen Grundsätzen erstellt, von Gemeinde und Interessenvertretern anerkannt und alle zwei Jahre aktualisiert. Er hat vor Gericht eine starke Beweiskraft. Ein einfacher Mietspiegel ist weniger formalisiert. Existiert gar kein Mietspiegel, kann die Vergleichsmiete über Sachverständigengutachten oder Vergleichswohnungen ermittelt werden." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="vergleich">Ortsübliche Vergleichsmiete (€/m²)</label>
          <input type="number" id="vergleich" min="3" max="50" value="12.00" step="0.10" />
        </div>
        <div class="calc-group">
          <label for="aktmiete">Verlangte Kaltmiete (€/m²)</label>
          <input type="number" id="aktmiete" min="3" max="80" value="14.50" step="0.10" />
        </div>
        <div class="calc-group">
          <label for="flaeche">Wohnfläche (m²)</label>
          <input type="number" id="flaeche" min="10" max="500" value="70" step="5" />
        </div>
        <div class="calc-group">
          <label for="modernisierung">Modernisierungsumlage (€/m²/Monat)</label>
          <input type="number" id="modernisierung" min="0" max="3" value="0" step="0.10" />
          <small style="color:#666;">Nur Maßnahmen der letzten drei Jahre, gekappt nach § 559 Abs. 3a BGB.</small>
        </div>
      </div>
      <div class="calc-group" style="margin-top:0.25rem;">
        <label for="vormiete">Vormiete (€/m², 0 = keine oder unbekannt)</label>
        <input type="number" id="vormiete" min="0" max="80" value="0" step="0.10" />
        <small style="color:#666;">Lag die Vormiete höher als die zulässige Miete, darf der Vermieter nach § 556e Abs. 1 Satz 1 BGB <strong>sie</strong> verlangen – nicht mehr. Mietminderungen und Erhöhungen im letzten Jahr vor Ende des Vormietverhältnisses zählen nach Satz 2 nicht mit.</small>
      </div>
       <div class="calc-result" id="result-box">
         <div class="label">Zulässige Kaltmiete gesamt</div>
         <div id="erlaubt">— €</div>
         <div class="result-actions">
           <button 
             data-copy-result="#erlaubt" 
             class="btn-copy"
             title="Resultat kopieren"
           >
             📋 Kopieren
           </button>
           <button 
             data-save-pdf="#result-box" 
             class="btn-pdf"
             title="Als PDF speichern"
           >
             📄 PDF
           </button>
         </div>
       </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>

      <section class="frist" id="frist" aria-labelledby="frist-titel">
        <h2 id="frist-titel">Wann Sie rügen, entscheidet über Ihr Geld</h2>
        <div class="calc-group frist-eingabe">
          <label for="monate">Mietbeginn liegt zurück (Monate)</label>
          <input type="number" id="monate" min="0" max="120" value="6" step="1" />
        </div>
        <p id="frist-text" class="frist-text"></p>
        <div class="frist-flaeche"><svg id="frist-svg" role="img" aria-labelledby="frist-titel frist-text"></svg></div>
        <table class="frist-tabelle" id="frist-tabelle">
          <thead><tr><th>Rüge im Monat</th><th>Rückforderung rückwirkend</th><th>Ersparnis ab dann pro Monat</th></tr></thead>
          <tbody></tbody>
        </table>
      </section>
    </div>
    <ArtikelMietpreisbremse slot="artikel" />
  </CalculatorShell>

</Layout>

<style>
  .frist { margin-top: 1.5rem; }
  .frist h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
  .frist-eingabe { max-width: 14rem; }
  .frist-text { font-size: 0.92rem; margin: 0.5rem 0 0.75rem; }
  .frist-flaeche { width: 100%; }
  .frist-flaeche svg { display: block; width: 100%; height: auto; }
  .frist-tabelle { width: 100%; border-collapse: collapse; font-size: 0.88rem; margin-top: 0.75rem; }
  .frist-tabelle th, .frist-tabelle :global(td) { padding: 0.35rem 0.5rem; text-align: right; border-bottom: 1px solid #e3e3e3; }
  .frist-tabelle th:first-child, .frist-tabelle :global(td:first-child) { text-align: left; }
  .frist-tabelle :global(tr.ist-monat td) { background: #fff3cd; font-weight: 600; }
  .frist-tabelle :global(tr.verfallen td) { color: #8a8a8a; }
</style>

<script type="module">
const { berechneMietpreisbremse, RUECKFORDERUNG_MONATE } = await import(window.__base + 'scripts/mietpreisbremse.js');
const SVG_NS = 'http://www.w3.org/2000/svg';
const MONATE_MAX = 48;
const TABELLEN_MONATE = [3, 6, 12, 24, RUECKFORDERUNG_MONATE, RUECKFORDERUNG_MONATE + 1];
// Rückforderung rückwirkend: nur bei Rüge binnen 30 Monaten (§ 556g Abs. 2 Satz 3 BGB).
function rueckforderung(zuvielGesamt, monat) {
  return monat <= RUECKFORDERUNG_MONATE ? zuvielGesamt * monat : 0;
}
let letzteFrist = null;
function el(name, attrs) {
  const n = document.createElementNS(SVG_NS, name);
  Object.entries(attrs).forEach(([k, v]) => n.setAttribute(k, v));
  return n;
}
function zeichneFrist(zuvielGesamt, monat) {
  letzteFrist = { zuvielGesamt, monat };
  const svg = document.getElementById('frist-svg');
  const breite = Math.max(280, Math.min(640, svg.parentElement.clientWidth || 640));
  const hoehe = breite < 480 ? 220 : 260;
  const r = { l: 52, r: 14, o: 14, u: 32 };
  const max = zuvielGesamt * RUECKFORDERUNG_MONATE;
  const x = (m) => r.l + (m / MONATE_MAX) * (breite - r.l - r.r);
  const y = (v) => hoehe - r.u - (v / max) * (hoehe - r.u - r.o);
  svg.setAttribute('viewBox', `0 0 ${breite} ${hoehe}`);
  svg.replaceChildren();
  svg.appendChild(el('line', { x1: r.l, y1: y(0), x2: breite - r.r, y2: y(0), stroke: '#999', 'stroke-width': 1 }));
  [0, 12, 24, 36, 48].forEach((m) => {
    const t = el('text', { x: x(m), y: hoehe - 12, 'text-anchor': 'middle', 'font-size': 11, fill: '#666' });
    t.textContent = m + ' Mon.';
    svg.appendChild(t);
  });
  [0, 0.5, 1].forEach((f) => {
    svg.appendChild(el('line', { x1: r.l, y1: y(max * f), x2: breite - r.r, y2: y(max * f), stroke: '#e3e3e3', 'stroke-width': 1 }));
    const t = el('text', { x: r.l - 6, y: y(max * f) + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#666' });
    t.textContent = Math.round(max * f).toLocaleString('de-DE') + ' €';
    svg.appendChild(t);
  });
  svg.appendChild(el('polyline', { points: `${x(0)},${y(0)} ${x(RUECKFORDERUNG_MONATE)},${y(max)}`, fill: 'none', stroke: '#c8102e', 'stroke-width': 2.5 }));
  svg.appendChild(el('line', { x1: x(RUECKFORDERUNG_MONATE), y1: y(max), x2: x(RUECKFORDERUNG_MONATE), y2: y(0), stroke: '#c8102e', 'stroke-width': 2, 'stroke-dasharray': '4 4' }));
  svg.appendChild(el('line', { x1: x(RUECKFORDERUNG_MONATE), y1: y(0), x2: x(MONATE_MAX), y2: y(0), stroke: '#c8102e', 'stroke-width': 2.5 }));
  const aktuell = rueckforderung(zuvielGesamt, Math.min(monat, MONATE_MAX));
  if (monat <= MONATE_MAX) {
    svg.appendChild(el('circle', { cx: x(monat), cy: y(aktuell), r: 5, fill: '#fff', stroke: '#1b1b1b', 'stroke-width': 2 }));
  }
}
function zeigeFrist(r, flaeche, monat) {
  const box = document.getElementById('frist');
  box.hidden = !r.istZuHoch;
  if (!r.istZuHoch) return;
  const jetzt = rueckforderung(r.zuvielGesamt, monat);
  const text = document.getElementById('frist-text');
  text.textContent = monat <= RUECKFORDERUNG_MONATE
    ? `Rügen Sie jetzt (Monat ${monat}), bekommen Sie rückwirkend ${fmt(jetzt)} zurück – und sparen danach ${fmt(r.zuvielGesamt)} im Monat. Jeder weitere Monat Warten kostet ${fmt(r.zuvielGesamt)}, im Monat ${RUECKFORDERUNG_MONATE + 1} verfällt der gesamte Rückforderungsanspruch.`
    : `Der Mietbeginn liegt mehr als ${RUECKFORDERUNG_MONATE} Monate zurück: Eine Rüge wirkt nur noch für die Zukunft (${fmt(r.zuvielGesamt)} weniger pro Monat), die bisher gezahlte Differenz ist verloren.`;
  const tbody = document.querySelector('#frist-tabelle tbody');
  tbody.replaceChildren();
  const zeilen = [...new Set([...TABELLEN_MONATE, monat])].sort((a, b) => a - b);
  zeilen.forEach((m) => {
    const tr = document.createElement('tr');
    if (m === monat) tr.classList.add('ist-monat');
    if (m > RUECKFORDERUNG_MONATE) tr.classList.add('verfallen');
    [`Monat ${m}`, fmt(rueckforderung(r.zuvielGesamt, m)), fmt(r.zuvielGesamt)].forEach((t) => {
      const td = document.createElement('td');
      td.textContent = t;
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  zeichneFrist(r.zuvielGesamt, monat);
}
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' \u20ac'; }
function fmtQm(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' \u20ac/m\u00b2'; }
function berechne() {
  const vergleichsmiete = parseFloat(document.getElementById('vergleich').value)||12;
  const aktuelleKaltmiete = parseFloat(document.getElementById('aktmiete').value)||14.50;
  const flaeche = parseFloat(document.getElementById('flaeche').value)||70;
  const modernisierung = parseFloat(document.getElementById('modernisierung').value)||0;
  const vormiete = parseFloat(document.getElementById('vormiete').value)||0;
  const r = berechneMietpreisbremse({ vergleichsmiete, aktuelleKaltmiete, flaeche, vormiete, modernisierung });
  // Die Kopfzahl muss die tatsaechlich zulaessige Miete zeigen. Frueher stand
  // hier erlaubtGesamt, waehrend die Detailzeile darunter den Bestandsschutz
  // beruecksichtigte - zwei verschiedene Zahlen uebereinander.
  document.getElementById('erlaubt').textContent = fmt(r.effektivErlaubtGesamt);
  const box = document.getElementById('result-box');
  box.style.background = r.istZuHoch ? '#c8102e' : '';
  const teile = [
    `<span>Zul\u00e4ssig: <strong>${fmtQm(r.effektivErlaubtProQm)}</strong></span>`,
    `<span>Verlangt: <strong>${fmtQm(aktuelleKaltmiete)}</strong></span>`,
  ];
  if (r.vormieteGreift) {
    teile.push(`<span>Grenze ist die Vormiete (\u00a7 556e Abs. 1 BGB)</span>`);
  }
  if (r.modernisierungGekappt) {
    teile.push(`<span>Modernisierung gekappt auf <strong>${fmtQm(r.modernisierungKappung)}</strong> (\u00a7 559 Abs. 3a BGB)</span>`);
  }
  if (r.istZuHoch) {
    teile.push(`<span style="color:#c8102e">Zu viel: <strong>${fmtQm(r.zuvielProQm)} (${fmt(r.zuvielGesamt)}/Monat)</strong></span>`);
    teile.push(`<span style="color:#c8102e">Pro Jahr: <strong>${fmt(r.jahresErsparnis)}</strong></span>`);
    teile.push(`<span style="color:#c8102e">R\u00fcckforderung bei R\u00fcge binnen 30 Monaten: <strong>bis ${fmt(r.rueckforderungMaximal)}</strong></span>`);
  } else {
    teile.push(`<span style="color:#1e7e34"><strong>Miete ist zul\u00e4ssig</strong></span>`);
  }
  document.getElementById('details').innerHTML = teile.join('');
  const monat = Math.max(0, Math.round(parseFloat(document.getElementById('monate').value) || 0));
  zeigeFrist(r, flaeche, monat);
}
window.addEventListener('resize', () => {
  if (letzteFrist && !document.getElementById('frist').hidden) zeichneFrist(letzteFrist.zuvielGesamt, letzteFrist.monat);
});
['vergleich','aktmiete','flaeche','modernisierung','vormiete','monate'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
