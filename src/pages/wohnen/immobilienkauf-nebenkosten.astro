---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { BUNDESLAENDER } from '../../../public/scripts/grunderwerbsteuer.js';
import { MAKLER_PROVISION_PROZENT_JE_SEITE } from '../../../public/scripts/immokauf-nebenkosten.js';
const calc = CALCULATORS.find(c => c.slug === 'immobilienkauf-nebenkosten')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Die Auswahlliste stand hier hart im Markup und lief gegen das Rechenmodul
// auseinander: Bremen mit 5,0 % (statt 5,5 %) und Thüringen mit 6,5 % (statt
// 5,0 %). Jetzt aus derselben Quelle wie der Grunderwerbsteuer-Rechner.
const laender = Object.entries(BUNDESLAENDER)
  .map(([kuerzel, land]) => ({ kuerzel, ...land }))
  .sort((a, b) => a.name.localeCompare(b.name, 'de'));

const proz = (n: number) =>
  n.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 2 }) + ' %';

// Der Satz ist ein Bruttosatz (3,00 % netto + 19 % USt). Die Beschriftung sagte
// bis 12.08.2026 „+ MwSt", obwohl die Steuer darin schon enthalten ist.
const maklerSatz = proz(MAKLER_PROVISION_PROZENT_JE_SEITE);
---
<Layout
  title={`Immobilienkauf-Nebenkosten ${year}`}
  description="Nebenkosten beim Immobilienkauf berechnen: Grunderwerbsteuer, Notar, Makler nach Bundesland. Alle Kaufnebenkosten auf einen Blick."
  canonicalPath="/wohnen/immobilienkauf-nebenkosten/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}wohnen/`} class="back-link">← Wohnen & Immobilien</a>
    <h1>Immobilienkauf-Nebenkosten {year} – Gesamtkosten berechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Immobilienkauf-Nebenkosten-Rechner berechnen Sie alle Kosten, die neben dem Kaufpreis anfallen. Viele Käufer unterschätzen die Nebenkosten, die je nach Bundesland und Maklerbeteiligung 4,5-12 % des Kaufpreises betragen. Der Rechner schlüsselt alle Posten einzeln auf, damit Sie die tatsächlichen Gesamtkosten kennen."
    sourceNote="4,5-12% des Kaufpreises."
    explanation="Die Kaufnebenkosten setzen sich aus gesetzlich geregelten Gebühren zusammen: Grunderwerbsteuer (3,5-6,5 % nach GrEStG), Notarkosten (ca. 0,6-0,8 % inkl. MwSt) und Grundbuchgebühren (ca. 0,25-0,35 %). Notar- und Grundbuchgebühren sind Wertgebühren nach Tabelle B des GNotKG (§ 34) und damit degressiv: Je höher der Kaufpreis, desto kleiner der Prozentsatz. Seit Dezember 2020 verlangt § 656c BGB, dass sich Käufer und Verkäufer bei Doppeltätigkeit des Maklers in gleicher Höhe verpflichten. Kaufnebenkosten müssen vollständig aus Eigenkapital finanziert werden, da Banken sie nicht beleihen."
    faqs={[
      { q: "Wie setzt sich die Grunderwerbsteuer zusammen?", a: "Sie ist eine Ländersteuer, daher unterschiedlich: von 3,5% in Bayern und Sachsen-Anhalt bis 6,5% in NRW und anderen Ländern. Fiktive Preise für bewegliche Sachen (z.B. Möbel) können ausgehandelt werden, um die Steuer zu senken." },
      { q: "Kann ich die Grundbuchgebühren sparen?", a: "Nein, die sind per Gesetz geregelt (rund 0,2-0,5%). Aber: Eine frühzeitige Anmeldung spart Zeit. Sollte man mehrere Grundbucheinträge brauchen (Schulden), können diese gebündelt werden." },
      { q: "Lohnt sich ein Makler wirklich?", a: "Der Makler kostet 3-7,5% des Kaufpreises. Dafür bekommt man: Besichtigungen koordiniert, Verhandlung unterstützt, Market-Screening. Ohne Makler: mehr Eigenrecherche, aber man spart die Gebühr. Je höher der Preis, desto eher lohnt sich der Makler." },
      { q: "Wann muss ich Notargebühren zahlen?", a: "Der Notar ist beim Immobilienkauf verpflichtend; seine Gebühren liegen inklusive Mehrwertsteuer bei rund 0,6-0,8 % des Kaufpreises, dazu kommen rund 0,25-0,35 % Grundbuchgebühren. Er ist neutral und schützt Käufer UND Verkäufer. Die Gebühren sind im GNotKG festgelegt und nach Kaufpreis gestaffelt – vergleichen bringt nichts, jeder Notar rechnet gleich ab." },
      { q: "Sind die Nebenkosten von der Steuer absetzbar?", a: "Nein, nicht direkt. Aber: Maklerprovision kann bei Vermietung über 2 Jahre abgeschrieben werden. Notarkosten und Grundbuchgebühren sind Herstellungskosten und erhöhen die Anschaffungskosten – werden über Absetzung für Abnutzung aufgelöst." },
      { q: "Muss ich für Inspektionen extra zahlen?", a: "Ja, Gutachten/Inspektionen sind freiwillig (aber empfohlen): Bauherrenmodell (TÜV/DEKRA) 300-500€, Energieausweis 50-300€, Makler-Inspektion inklusive. Sparen lohnt sich da nicht – Überraschungen kosten mehr." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="kaufpreis">Kaufpreis (€)</label>
          <input type="number" id="kaufpreis" min="0" max="100000000" value="400000" step="10000" />
        </div>
        <div class="calc-group">
          <label for="bundesland">Bundesland</label>
          <select id="bundesland">
            {laender.map(l => (
              <option value={l.kuerzel} selected={l.kuerzel === 'nw'}>
                {l.name} ({proz(l.satz)})
              </option>
            ))}
          </select>
        </div>
        <div class="calc-group">
          <label for="makler">Maklerprovision</label>
          <select id="makler">
            <option value="1">Mit Makler ({maklerSatz} inkl. MwSt je Seite)</option>
            <option value="0">Ohne Makler (Privatverkauf)</option>
          </select>
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Gesamte Nebenkosten</div>
        <div id="gesamt">— €</div>
      </div>
      <table class="result-table" id="aufstellung" style="margin-top:1rem;width:100%;border-collapse:collapse;font-size:0.88rem;"></table>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Immobilienkauf-Nebenkosten verstehen und sparen"
    content="<p>Die Nebenkosten beim Immobilienkauf sind oft eine überraschende Größe für Käufer. Sie setzen sich zusammen aus mehreren Komponenten: Grunderwerbsteuer (je nach Bundesland 3,5-6,5%), Notargebühren (ca. 0,6-0,8% inkl. MwSt), Grundbuchgebühren (ca. 0,25-0,35%), Maklergebühren (3-7,5% optional) und weitere Inspektions- oder Vermessungskosten.</p>\n\n<p><strong>Grunderwerbsteuer nach Bundesland:</strong> Ein kritischer Kostenfaktor. Bayern und Sachsen-Anhalt sind mit 3,5% günstig. Nordrhein-Westfalen, Baden-Württemberg und andere sind mit 6-6,5% teuer. Eine Umzug oder ein Kauf im grenznahen Ausland kann strategisch sinnvoll sein, ist aber nicht immer praktikabel.</p>\n\n<p><strong>Notarkosten sind gesetzlich geregelt:</strong> Nach dem Gerichts- und Notarkostengesetz (GNotKG) sind die Gebühren Wertgebühren nach Tabelle B (§ 34, Anlage 2) und nach Kaufpreis gestaffelt. Beispiel: Bei 500.000 € Kaufpreis beträgt die volle Gebühr 935 €; für den Kaufvertrag fallen 3,0 Notargebühren an (Beurkundung 2,0 nach KV 21100, Vollzug 0,5 nach KV 22110, Betreuung 0,5 nach KV 22200), also rund 3.340 € inklusive Mehrwertsteuer, dazu 1,5 Grundbuchgebühren (Auflassungsvormerkung 0,5 nach KV 14150, Eigentumsumschreibung 1,0 nach KV 14110) von rund 1.400 €. Zusammen also etwa 4.700 € und nicht, wie oft zu lesen, 8.000-10.000 €. Verhandelbar ist davon nichts.</p>\n\n<p><strong>Maklergebühren sind verhandelbar:</strong> Die übliche Quote (3-7,5%) ist Marktusance, nicht Gesetz. In Boom-Zeiten (2010-2021) sind oft 7,5% Standard. Heute (2024) sind 3-5% nach Marktkampf üblich. Als Käufer: direkt-kaufen oder Makler-Quote verhandeln.</p>\n\n<p><strong>Nebenkosten-Finanzierung:</strong> Banken finanzieren den Kaufpreis, aber NICHT die Nebenkosten. Diese müssen Sie aus Eigenkapital bezahlen. Ein Kaufpreis von 500.000€ mit 60.000€ Nebenkosten erfordert also 60.000€ Eigenkapital zusätzlich zum normalen Eigenkapital für die Hypothek.</p>\n\n<p><strong>Steuerliche Aspekte:</strong> Als Privatperson sind Nebenkosten keine direkt abzugsfähigen Betriebsausgaben. Sie erhöhen aber die Anschaffungskosten der Immobilie, werden also über Abschreibung berücksichtigt (bei Vermietung). Dies ist ein längerfristiger Vorteil, nicht sofort.</p>\n\n<p><strong>Spar-Strategien:</strong> Manche Käufer handeln aus, dass der Verkäufer die Maklergebühren trägt. Andere verhandeln Möbel/Einrichtung separat (reduziert Grunderwerbsteuer-Basis). Auch: In manchen Bundesländern gibt es Freibeträge oder Anreize – lokal recherchieren!</p>\n\n<p><strong>Checkliste für Sicherheit:</strong> Vor Notartermin alle Kosten prüfen, Angebot von Notary einholen, Grundbuchgebühren klären, ggf. Vermessung erforderlich (gibt es bereits?), Inspektionstermine buchen. Mit Checkliste vermeiden Sie böse Überraschungen.</p>"
    relatedSlugs={['grundbuch-eintragung', 'hauskauf-rechner', 'grunderwerbsteuer-rechner']}
  />
</Layout>

<style>
.result-table td { padding: 0.3rem 0; border-bottom: 1px solid var(--border); }
.result-table tr:last-child td { border-bottom: none; font-weight: 600; }
.result-table td:last-child { text-align: right; }
</style>

<script type="module">
const { berechneImmokaufNebenkosten, MAKLER_PROVISION_PROZENT_JE_SEITE } =
  await import(window.__base + 'scripts/immokauf-nebenkosten.js');
const maklerSatzText = MAKLER_PROVISION_PROZENT_JE_SEITE.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' % inkl. MwSt';
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const kaufpreis = parseFloat(document.getElementById('kaufpreis').value)||0;
  const bundesland = document.getElementById('bundesland').value;
  const mitMakler = document.getElementById('makler').value === '1';
  const r = berechneImmokaufNebenkosten({ kaufpreis, bundesland, mitMakler });
  document.getElementById('gesamt').textContent = fmt(r.gesamt) + ` (${r.gesamtProzent.toLocaleString('de-DE')} %)`;
  const rows = [
    ['Grunderwerbsteuer', `${r.gewSatz.toLocaleString('de-DE', { minimumFractionDigits: 1 })} %`, fmt(r.grunderwerbsteuer)],
    ['Notar (inkl. MwSt)', 'GNotKG, 3,0 Gebühren', fmt(r.notar)],
    ['Grundbuch', 'GNotKG, 1,5 Gebühren', fmt(r.grundbuch)],
    ...(mitMakler ? [['Makler (Käuferanteil)', maklerSatzText, fmt(r.maklerKaeufer)]] : []),
    ['Gesamt', `${r.gesamtProzent.toLocaleString('de-DE')} %`, fmt(r.gesamt)],
  ];
  document.getElementById('aufstellung').innerHTML = rows.map(([label, satz, betrag]) =>
    `<tr><td>${label}</td><td style="color:var(--muted)">${satz}</td><td>${betrag}</td></tr>`
  ).join('');
}
['kaufpreis','bundesland','makler'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
