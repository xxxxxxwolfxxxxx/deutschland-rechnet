}
.hinweis {
  margin-top: 2rem;
  padding: 0.9rem 1.1rem;
  background: var(--surface);
  border-left: 3px solid var(--gold);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 0.85rem !important;
  line-height: 1.6 !important;
  color: var(--text-light);
}
</style>
