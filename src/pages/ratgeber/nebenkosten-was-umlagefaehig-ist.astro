  margin: 1rem 0 1.5rem;
  padding-left: 1.2rem;
}
.liste li {
  margin-bottom: 0.5rem;
  line-height: 1.6;
}
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
