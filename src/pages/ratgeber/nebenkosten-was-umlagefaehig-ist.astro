  background: var(--dark);
  color: white;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 600;
  padding: 0.7rem 0.6rem;
  text-align: left;
  white-space: nowrap;
}
tbody th {
  text-align: left;
  font-weight: 600;
  padding: 0.6rem;
  min-width: 12ch;
}
