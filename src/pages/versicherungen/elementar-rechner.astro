---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { berechneEntschaedigung } from '../../../public/scripts/unterversicherung.js';
const calc = CALCULATORS.find(c => c.slug === 'elementar-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const pz = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' %';

const bsp = berechneEntschaedigung({ schaden: 50000, versicherungssumme: 300000, versicherungswert: 400000, selbstbehalt: 500 });
const bspVerzicht = berechneEntschaedigung({ schaden: 50000, versicherungssumme: 300000, versicherungswert: 400000, selbstbehalt: 500, unterversicherungsverzicht: true });
if (bsp.leistung !== 37000 || bspVerzicht.leistung !== 49500) throw new Error('Unterversicherung: Beispiel stimmt nicht');

const guideHtml = `
<h3>Warum eine zu niedrige Versicherungssumme jeden Schaden kürzt</h3>
<p>Nach einer Überschwemmung oder einem Starkregen zeigt sich, ob die Versicherungssumme noch zum Haus oder zum Hausrat passt. § 75 VVG bestimmt: Ist die Versicherungssumme erheblich niedriger als der Versicherungswert zur Zeit des Schadens, muss der Versicherer nur „nach dem Verhältnis der Versicherungssumme zu diesem Wert" leisten. Das trifft nicht erst den Totalschaden, sondern jeden Teilschaden im selben Verhältnis.</p>
<p><strong>Beispiel:</strong> Das Gebäude wäre heute für ${eur(400000)} wiederherzustellen, versichert sind ${eur(300000)}. Ein Wasserschaden von ${eur(50000)} wird im Verhältnis ${pz(bsp.quoteProzent)} gekürzt – ${eur(bsp.kuerzung)} weniger. Nach ${eur(500)} Selbstbehalt zahlt der Versicherer ${eur(bsp.leistung)}, ${eur(bsp.eigenanteil)} bleiben beim Eigentümer. Mit einem vereinbarten Unterversicherungsverzicht wären es ${eur(bspVerzicht.leistung)}.</p>

<h3>Was der Rechner braucht</h3>
<ul>
<li><strong>Versicherungssumme:</strong> steht in der Police.</li>
<li><strong>Versicherungswert:</strong> der Wert, auf den es nach Ihrem Vertrag ankommt, zum Zeitpunkt des Schadens. Welcher Wert maßgeblich ist, bestimmen die Versicherungsbedingungen.</li>
<li><strong>Selbstbehalt:</strong> für Elementarschäden oft gesondert vereinbart, ebenfalls in der Police.</li>
<li><strong>Unterversicherungsverzicht:</strong> Manche Verträge verzichten unter Bedingungen auf die Kürzung. Ob Ihrer das tut, steht in den Bedingungen.</li>
</ul>

<h3>Was der Rechner nicht weiß</h3>
<p>Wann eine Unterversicherung „erheblich" ist, sagt § 75 VVG nicht; der Rechner zeigt die Quote deshalb immer an. In welcher Reihenfolge Kürzung und Selbstbehalt angewendet werden, regeln die Bedingungen – gerechnet ist erst die Kürzung, dann der Abzug. Und einen Beitrag für die Elementarversicherung schätzt der Rechner nicht: Den kalkuliert jeder Versicherer nach eigenen Tarifmerkmalen, belegbare Durchschnittswerte gibt es nicht. Frühere Fassungen dieser Seite enthielten eine solche Prämienschätzung ohne Quelle; sie ist entfernt.</p>
`;

const faqs = [
  { q: 'Was ist eine Unterversicherung?', a: 'Die Versicherungssumme liegt unter dem Versicherungswert. Ist sie erheblich niedriger, leistet der Versicherer nach § 75 VVG nur im Verhältnis der Summe zum Wert – auch bei Teilschäden.' },
  { q: 'Wie viel wird bei Unterversicherung gekürzt?', a: `Im Verhältnis Versicherungssumme zu Versicherungswert. Sind ${eur(300000)} bei ${eur(400000)} Wert versichert, werden ${pz(bsp.quoteProzent)} eines Schadens ersetzt: von ${eur(50000)} also ${eur(50000 - bsp.kuerzung)} vor Selbstbehalt.` },
  { q: 'Was ist ein Unterversicherungsverzicht?', a: 'Eine Vertragsklausel, mit der der Versicherer auf die Kürzung nach § 75 VVG verzichtet, meist unter Bedingungen. Ob sie vereinbart ist, steht in den Versicherungsbedingungen.' },
  { q: 'Was kostet eine Elementarversicherung?', a: 'Das legt jeder Versicherer nach eigenem Tarif fest. Der Rechner schätzt keine Prämie, sondern zeigt, was im Schadenfall ankommt.' },
];
---
<Layout
  title={`Elementarschaden-Rechner ${year}`}
  description="Was zahlt die Versicherung nach Hochwasser oder Starkregen? Kürzung bei Unterversicherung nach § 75 VVG, Selbstbehalt und Unterversicherungsverzicht."
  canonicalPath="/versicherungen/elementar-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}versicherungen/`} class="back-link">← Versicherungen</a>
    <h1>Elementarschaden-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner zeigt, was die Versicherung nach einem Elementarschaden tatsächlich zahlt – mit Kürzung bei Unterversicherung und Selbstbehalt, gerechnet mit den Zahlen aus Ihrer Police."
    sourceNote="Leistungskürzung bei Unterversicherung nach § 75 VVG (abgerufen am 14.09.2026). Versicherungssumme, Selbstbehalt und Unterversicherungsverzicht aus Ihrem Vertrag. Reihenfolge von Kürzung und Selbstbehalt nach den jeweiligen Bedingungen; hier zuerst die Kürzung. Keine Prämienschätzung."
    explanation="Leistung = Schaden × (Versicherungssumme ÷ Versicherungswert), höchstens die Versicherungssumme, minus Selbstbehalt. Mit Unterversicherungsverzicht entfällt die Kürzung."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="schaden">Schaden (€)</label>
          <input type="number" id="schaden" min="0" max="100000000" value="50000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="summe">Versicherungssumme laut Police (€)</label>
          <input type="number" id="summe" min="0" max="100000000" value="300000" step="10000" />
        </div>
        <div class="calc-group">
          <label for="wert">Versicherungswert zum Schadenzeitpunkt (€)</label>
          <input type="number" id="wert" min="0" max="100000000" value="400000" step="10000" />
        </div>
        <div class="calc-group">
          <label for="sb">Selbstbehalt (€)</label>
          <input type="number" id="sb" min="0" max="1000000" value="500" step="100" />
        </div>
        <div class="calc-group">
          <label for="verzicht">Unterversicherungsverzicht</label>
          <select id="verzicht">
            <option value="nein" selected>nicht vereinbart</option>
            <option value="ja">vereinbart</option>
          </select>
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Leistung der Versicherung</div>
        <div id="leistung">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So rechnet die Versicherung nach einem Schaden"
    content={guideHtml}
    relatedSlugs={['pflege-rechner', 'rechtsschutz-rechner', 'zahnzusatz-rechner']}
  />
</Layout>

<script type="module">
const { berechneEntschaedigung } = await import(window.__base + 'scripts/unterversicherung.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = berechneEntschaedigung({
    schaden: wert('schaden'),
    versicherungssumme: wert('summe'),
    versicherungswert: wert('wert'),
    selbstbehalt: wert('sb'),
    unterversicherungsverzicht: document.getElementById('verzicht').value === 'ja',
  });
  document.getElementById('leistung').textContent = eur(r.leistung);
  const teile = [
    `<span>Ersetzt werden: <strong>${r.quoteProzent.toLocaleString('de-DE')} %</strong>${r.unterversichert ? ' (Summe unter dem Wert)' : ''}</span>`,
    `<span>Kürzung: <strong>${eur(r.kuerzung)}</strong></span>`,
    `<span>Bleibt bei Ihnen: <strong>${eur(r.eigenanteil)}</strong></span>`,
  ];
  if (r.unterversichert) teile.push(`<span>Ohne Kürzung bräuchte es eine Summe von <strong>${eur(r.noetigeSumme)}</strong></span>`);
  document.getElementById('details').innerHTML = teile.join('');
}
['schaden', 'summe', 'wert', 'sb'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('verzicht').addEventListener('change', berechne);
berechne();
</script>
