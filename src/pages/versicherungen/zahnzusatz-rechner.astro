---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { berechneZahnersatz, festzuschussUmrechnen, FESTZUSCHUSS_ANTEIL } from '../../../public/scripts/zahnersatz.js';
const calc = CALCULATORS.find(c => c.slug === 'zahnzusatz-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const proz = (n: number) => Math.round(n * 100) + ' %';

const ohne = berechneZahnersatz({ gesamtkosten: 3000, festzuschuss: 900 });
const mitTarif = berechneZahnersatz({ gesamtkosten: 3000, festzuschuss: 900, erstattungProzent: 90, bezug: 'gesamt', beitragMonat: 30, monateBeitrag: 24 });
const aufEigenanteil = berechneZahnersatz({ gesamtkosten: 3000, festzuschuss: 900, erstattungProzent: 90, bezug: 'eigenanteil' });
const begrenzt = berechneZahnersatz({ gesamtkosten: 3000, festzuschuss: 900, erstattungProzent: 90, bezug: 'gesamt', hoechstbetrag: 1000 });
if (ohne.eigenanteil !== 2100 || mitTarif.erstattung !== 1800 || aufEigenanteil.erstattung !== 1890) {
  throw new Error('Zahnersatz: Beispiel stimmt nicht');
}
const bonus10 = festzuschussUmrechnen(900, 'ohneBonus', 'bonus10Jahre');

const guideHtml = `
<h3>Was die Krankenkasse zahlt</h3>
<p>Beim Zahnersatz zahlt die gesetzliche Krankenkasse keinen Prozentsatz der Rechnung, sondern Festzuschüsse, die sich am Befund orientieren. Nach § 55 Abs. 1 SGB V betragen sie ${proz(FESTZUSCHUSS_ANTEIL.ohneBonus)} der für die Regelversorgung festgesetzten Beträge. Wer die Zähne regelmäßig gepflegt und in den letzten fünf Jahren die Vorsorgeuntersuchungen wahrgenommen hat, erhält ${proz(FESTZUSCHUSS_ANTEIL.bonus5Jahre)}, nach zehn Jahren ${proz(FESTZUSCHUSS_ANTEIL.bonus10Jahre)}. Wählt man eine aufwendigere Versorgung als die Regelversorgung, bleibt der Festzuschuss gleich – den Rest trägt man selbst.</p>
<p>Beide Zahlen stehen im Heil- und Kostenplan, den die Zahnarztpraxis vor der Behandlung erstellt: die voraussichtlichen Gesamtkosten und der Festzuschuss. Aus ihnen rechnet dieser Rechner.</p>

<h3>Beispiel</h3>
<p>Eine Krone mit Brückenglied kostet laut Heil- und Kostenplan ${eur(3000)}, der Festzuschuss ohne Bonus beträgt ${eur(900)}. Der Eigenanteil liegt bei ${eur(ohne.eigenanteil)}. Mit zehn Jahren Bonusheft stiege der Festzuschuss auf ${eur(bonus10)}.</p>
<p>Wie viel eine Zusatzversicherung davon übernimmt, hängt an einer Formulierung im Tarif, die leicht überlesen wird:</p>
<ul>
<li><strong>„90 % inklusive Kassenleistung"</strong>: Der Tarif füllt auf 90 % der Gesamtkosten auf. Das sind ${eur(mitTarif.erstattung)}, es bleiben ${eur(mitTarif.eigenanteilMitTarif)}.</li>
<li><strong>„90 % des Eigenanteils"</strong>: Der Tarif zahlt 90 % dessen, was nach dem Festzuschuss übrig ist – ${eur(aufEigenanteil.erstattung)}, es bleiben ${eur(aufEigenanteil.eigenanteilMitTarif)}.</li>
</ul>
<p>Hat der Tarif im Behandlungsjahr eine Leistungsgrenze von ${eur(1000)}, zahlt er in beiden Fällen nur ${eur(begrenzt.erstattung)}. Solche Grenzen stehen im Tarif meist als Staffel nach Vertragsjahren – tragen Sie den Betrag ein, der im Jahr der Behandlung gilt.</p>

<h3>Beiträge gegenrechnen</h3>
<p>Wer ${eur(30)} im Monat zahlt und nach zwei Jahren behandelt wird, hat ${eur(mitTarif.beitraege)} Beiträge gezahlt. Die Erstattung von ${eur(mitTarif.erstattung)} übersteigt das um ${eur(mitTarif.saldo)}. Ob sich ein Tarif lohnt, ist damit nicht beantwortet – es hängt davon ab, ob und wann Zahnersatz nötig wird. Mit einem konkreten Heil- und Kostenplan lässt sich aber genau rechnen, was der Tarif in diesem Fall bringt.</p>
`;

const faqs = [
  { q: 'Wie viel zahlt die Krankenkasse beim Zahnersatz?', a: `Einen Festzuschuss von ${proz(FESTZUSCHUSS_ANTEIL.ohneBonus)} der Regelversorgung, mit Bonusheft ${proz(FESTZUSCHUSS_ANTEIL.bonus5Jahre)} nach fünf und ${proz(FESTZUSCHUSS_ANTEIL.bonus10Jahre)} nach zehn Jahren (§ 55 Abs. 1 SGB V). Der Betrag steht im Heil- und Kostenplan.` },
  { q: 'Was bedeutet „90 % inklusive Kassenleistung"?', a: `Der Tarif füllt die Kassenleistung auf 90 % der Gesamtkosten auf. Bei ${eur(3000)} Kosten und ${eur(900)} Festzuschuss zahlt er ${eur(mitTarif.erstattung)}; ein Tarif mit 90 % des Eigenanteils zahlte ${eur(aufEigenanteil.erstattung)}.` },
  { q: 'Wie hoch ist mein Eigenanteil?', a: 'Gesamtkosten laut Heil- und Kostenplan minus Festzuschuss. Tragen Sie beide Beträge in den Rechner ein.' },
  { q: 'Was kostet eine Zahnzusatzversicherung?', a: 'Das setzt jeder Versicherer nach Tarif und Eintrittsalter fest. Der Rechner nimmt Ihren Monatsbeitrag als Eingabe und stellt ihn der Erstattung gegenüber.' },
];
---
<Layout
  title={`Zahnersatz- und Zahnzusatz-Rechner ${year}`}
  description="Eigenanteil beim Zahnersatz aus dem Heil- und Kostenplan: Festzuschuss nach § 55 SGB V, Erstattung der Zahnzusatzversicherung und Beiträge im Vergleich."
  canonicalPath="/versicherungen/zahnzusatz-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}versicherungen/`} class="back-link">← Versicherungen</a>
    <h1>Zahnersatz- und Zahnzusatz-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Der Rechner nimmt Gesamtkosten und Festzuschuss aus Ihrem Heil- und Kostenplan und zeigt, was eine Zahnzusatzversicherung davon übernimmt – und was nach den Beiträgen bleibt."
    sourceNote="Festzuschüsse nach § 55 Abs. 1 SGB V (abgerufen am 14.09.2026). Gesamtkosten und Festzuschuss aus dem Heil- und Kostenplan, Leistung, Höchstbetrag und Beitrag aus Ihrem Tarif. Der Rechner enthält keine Marktpreise."
    explanation="Eigenanteil = Gesamtkosten − Festzuschuss. Tarifleistung je nach Bedingung: Prozentsatz der Gesamtkosten minus Festzuschuss oder Prozentsatz des Eigenanteils, begrenzt auf den Höchstbetrag des Jahres und den Eigenanteil."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="gesamt">Gesamtkosten laut Heil- und Kostenplan (€)</label>
          <input type="number" id="gesamt" min="0" max="100000" value="3000" step="50" />
        </div>
        <div class="calc-group">
          <label for="zuschuss">Festzuschuss laut Heil- und Kostenplan (€)</label>
          <input type="number" id="zuschuss" min="0" max="100000" value="900" step="10" />
        </div>
        <div class="calc-group">
          <label for="prozent">Leistung des Tarifs (%)</label>
          <input type="number" id="prozent" min="0" max="100" value="90" step="5" />
        </div>
        <div class="calc-group">
          <label for="bezug">Prozentsatz bezieht sich auf</label>
          <select id="bezug">
            <option value="gesamt" selected>Gesamtkosten inkl. Kassenleistung</option>
            <option value="eigenanteil">den Eigenanteil</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="hoechst">Höchstbetrag im Behandlungsjahr (€, 0 = keiner)</label>
          <input type="number" id="hoechst" min="0" max="100000" value="0" step="100" />
        </div>
        <div class="calc-group">
          <label for="beitrag">Monatsbeitrag (€)</label>
          <input type="number" id="beitrag" min="0" max="500" value="30" step="1" />
        </div>
        <div class="calc-group">
          <label for="monate">Beitragsmonate bis zur Behandlung</label>
          <input type="number" id="monate" min="0" max="600" value="24" step="1" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Eigenanteil mit Tarif</div>
        <div id="ergebnis">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="So wird der Eigenanteil berechnet"
    content={guideHtml}
    relatedSlugs={['pflege-rechner', 'elementar-rechner', 'rechtsschutz-rechner']}
  />
</Layout>

<script type="module">
const { berechneZahnersatz } = await import(window.__base + 'scripts/zahnersatz.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = berechneZahnersatz({
    gesamtkosten: wert('gesamt'),
    festzuschuss: wert('zuschuss'),
    erstattungProzent: wert('prozent'),
    bezug: document.getElementById('bezug').value,
    hoechstbetrag: wert('hoechst'),
    beitragMonat: wert('beitrag'),
    monateBeitrag: wert('monate'),
  });
  document.getElementById('ergebnis').textContent = eur(r.eigenanteilMitTarif);
  const teile = [
    `<span>Eigenanteil ohne Tarif: <strong>${eur(r.eigenanteil)}</strong></span>`,
    `<span>Tarif zahlt: <strong>${eur(r.erstattung)}</strong>${r.begrenzt ? ' (Höchstbetrag erreicht)' : ''}</span>`,
    `<span>Beiträge bis zur Behandlung: <strong>${eur(r.beitraege)}</strong></span>`,
    `<span>Erstattung minus Beiträge: <strong>${r.saldo >= 0 ? '+' : '−'}${eur(Math.abs(r.saldo))}</strong></span>`,
  ];
  document.getElementById('details').innerHTML = teile.join('');
}
['gesamt', 'zuschuss', 'prozent', 'hoechst', 'beitrag', 'monate'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('bezug').addEventListener('change', berechne);
berechne();
</script>
