---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  berechneRueckstufung,
  KLASSEN,
  QUELLE,
  RUECKKAUF_GRENZE_HAFTPFLICHT,
  RUECKKAUF_FRIST_MONATE,
} from '../../../public/scripts/kfz-versicherung.js';
const calc = CALCULATORS.find(c => c.slug === 'kfz-versicherung-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const sf = (k: string) => (k === 'S' || k === 'M' ? `Klasse ${k}` : `SF ${k.replace('1/2', '½')}`);

const bsp = berechneRueckstufung({ sparte: 'haftpflicht', klasse: '10', jahresbeitrag: 500, entschaedigung: 1200 });

// Vergleich ueber die Klassen bei gleichem Beitrag zu 100 Prozent.
const GRUND = 1000;
const PROBE = ['3', '5', '10', '15', '20', '25', '35'];
const vergleich = (sparte: 'haftpflicht' | 'vollkasko') => PROBE.map((k) => {
  const heute = berechneRueckstufung({ sparte, klasse: k, jahresbeitrag: GRUND }).satzHeute;
  const r = berechneRueckstufung({ sparte, klasse: k, jahresbeitrag: GRUND * heute / 100 });
  return { k, heute, beitrag: GRUND * heute / 100, ziel: r.zielKlasse, mehr: r.mehrbeitrag };
});
const kh = vergleich('haftpflicht');
const teuerste = kh.reduce((a, b) => (b.mehr > a.mehr ? b : a));
const sf35 = kh[kh.length - 1];

const guideHtml = `
<h3>Warum dieser Rechner keinen Beitrag schätzt</h3>
<p>Was eine Kfz-Versicherung kostet, entsteht aus der Typklasse des Fahrzeugmodells, der Regionalklasse des Zulassungsbezirks, dem Beitragssatz der Schadenfreiheitsklasse und dem Tarif des Versicherers. Die Typ- und Regionalklassen sind öffentlich, die Tarife nicht. Ein Rechner ohne Tarifdaten kann deshalb keinen Beitrag nennen, der mehr ist als eine erfundene Zahl. Rechnen lässt sich dagegen, was eine Schadenmeldung über die folgenden Jahre kostet – wenn man den eigenen Beitrag kennt. Er steht im Versicherungsschein oder in der Beitragsrechnung, getrennt nach Haftpflicht und Vollkasko.</p>

<h3>Wie die Rückstufung funktioniert</h3>
<p>Das folgende gilt nach den AKB 2025 der GHV Versicherung; die meisten Versicherer sind ähnlich aufgebaut, die Tabellen weichen ab. Der Vertrag wird zum 1. Januar nach dem Schadenverlauf des vergangenen Kalenderjahres neu eingestuft, maßgeblich ist der Tag der Schadenmeldung (I.3). Nach einem schadenfreien Jahr geht es eine Klasse nach oben (I.3.2), aus SF ½, 0, S oder M direkt in SF 1 (I.3.4.1). Nach einem Schaden wird nach der Tabelle in Anhang 1.2 zurückgestuft (I.3.5). Kosten für Gutachter, Rechtsberatung und Prozesse zählen dabei nicht als Entschädigung (I.4.1.1). Die Teilkasko kennt keine Schadenfreiheitsklassen: Das System gilt nur in der Kfz-Haftpflicht- und der Vollkaskoversicherung (I.1).</p>

<h3>Was ein Haftpflichtschaden je nach Klasse kostet</h3>
<p>Die Tabelle rechnet für jede Klasse denselben Beitrag zu 100 Prozent von ${eur(GRUND)} – so werden die Klassen vergleichbar. Gezeigt ist der Mehrbeitrag in der Kfz-Haftpflicht über zehn Jahre nach einem Schaden.</p>
<table><thead><tr><th>Klasse heute</th><th>Beitragssatz</th><th>Beitrag heute</th><th>nach einem Schaden</th><th>Mehrbeitrag in 10 Jahren</th></tr></thead><tbody>
${kh.map((z) => `<tr><td>${sf(z.k)}</td><td>${z.heute} %</td><td>${eur(z.beitrag)}</td><td>${sf(z.ziel)}</td><td>${eur(z.mehr)}</td></tr>`).join('\n')}
</tbody></table>
<p>Am teuersten ist ein Schaden in dieser Reihe aus ${sf(teuerste.k)}: ${eur(teuerste.mehr)} in zehn Jahren. Wer in ${sf(sf35.k)} steht, zahlt heute am wenigsten und fällt trotzdem auf ${sf(sf35.ziel)} zurück – ${eur(sf35.mehr)} über zehn Jahre. Der Unterschied liegt nicht in der Höhe des Rückfalls, sondern darin, wie steil die Beitragssätze in der Zielklasse noch sind.</p>

<h3>Zurückkaufen statt selbst zahlen</h3>
<p>Wer nicht sofort entscheiden will, kann den Schaden melden und später erstatten. Die AKB der GHV sehen das in I.5 für die Kfz-Haftpflicht vor: Nach Abschluss der Regulierung teilt der Versicherer die Höhe der Entschädigung mit; beträgt sie nicht mehr als ${eur(RUECKKAUF_GRENZE_HAFTPFLICHT)} und wird sie innerhalb von ${RUECKKAUF_FRIST_MONATE} Monaten erstattet, gilt der Vertrag als schadenfrei. Andere Versicherer setzen andere Grenzen und regeln auch die Vollkasko – maßgeblich sind die eigenen Bedingungen.</p>
`;

const faqs = [
  { q: 'Wann lohnt es sich, einen Schaden selbst zu zahlen?', a: `Wenn die Entschädigung, die der Versicherer zahlen müsste, kleiner ist als der Mehrbeitrag, den die Rückstufung in den folgenden Jahren kostet. Beispiel mit den Tabellen der GHV: ${sf('10')} in der Kfz-Haftpflicht, 500 € Jahresbeitrag – ein Schaden stuft auf ${sf(bsp.zielKlasse)} zurück und kostet in zehn Jahren ${eur(bsp.mehrbeitrag)} mehr. Ein Schaden von 1.200 € wäre selbst gezahlt knapp günstiger.` },
  { q: 'Warum zeigt der Rechner keinen Versicherungsbeitrag an?', a: 'Weil er ihn nicht kennen kann. Der Beitrag hängt an Typklasse, Regionalklasse, Beitragssatz und dem Tarif des einzelnen Versicherers, und die Tarife sind nicht öffentlich. Einen realen Beitrag liefert nur ein Angebot. Der Rechner nimmt deshalb den Beitrag, den Sie schon zahlen, und rechnet die Folgen eines Schadens.' },
  { q: 'Beeinflusst ein Teilkaskoschaden die SF-Klasse?', a: 'Nein. Das Schadenfreiheitssystem gilt nur in der Kfz-Haftpflicht- und der Vollkaskoversicherung (AKB der GHV, I.1). Glasbruch, Wildschaden oder Diebstahl über die Teilkasko ändern die Klasse nicht.' },
  { q: 'Kann ich einen gemeldeten Schaden zurückkaufen?', a: `Bei der GHV in der Kfz-Haftpflicht, wenn die Entschädigung nicht mehr als ${eur(RUECKKAUF_GRENZE_HAFTPFLICHT)} beträgt und innerhalb von ${RUECKKAUF_FRIST_MONATE} Monaten nach der Mitteilung erstattet wird (AKB I.5). Grenze, Frist und Sparten sind bei anderen Versicherern anders geregelt.` },
  { q: 'Ab wann gilt eine Rückstufung?', a: 'Der Vertrag wird zum 1. Januar nach dem Schadenverlauf des vergangenen Kalenderjahres neu eingestuft; maßgeblich ist der Tag der Schadenmeldung. Die neue Einstufung gilt ab der ersten Beitragsfälligkeit im neuen Jahr (AKB der GHV, I.3 und I.3.1). Der Beitrag des Schadenjahres selbst ändert sich nicht.' },
  { q: 'Stimmen die Tabellen für meinen Versicherer?', a: 'Nicht zwingend. Beitragssätze und Rückstufungstabellen stehen im Anhang der Versicherungsbedingungen jedes Versicherers und unterscheiden sich. Die Richtung des Ergebnisses bleibt meist gleich, die Beträge weichen ab. Prüfen Sie im Zweifel den Anhang Ihrer eigenen AKB.' },
];
---
<Layout
  title={`Kfz-Versicherung-Rechner ${year}`}
  description="Schaden melden oder selbst zahlen? Der Rechner zeigt, was die Rückstufung der SF-Klasse in Haftpflicht oder Vollkasko über die Folgejahre kostet – mit Ihrem eigenen Beitrag und belegten Tabellen."
  canonicalPath="/auto/kfz-versicherung-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto &amp; Mobilität</a>
    <h1>Kfz-Versicherung-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Schaden melden oder selbst zahlen? Mit diesem Rechner sehen Sie, was eine Schadenmeldung über die folgenden Jahre kostet. Sie tragen Ihre SF-Klasse und den Jahresbeitrag ein, den Sie heute für Haftpflicht oder Vollkasko zahlen; der Rechner stuft zurück, stuft Jahr für Jahr wieder hoch und summiert den Mehrbeitrag."
    sourceNote={`Beitragssätze und Rückstufungstabelle für Pkw aus den AKB 2025 der GHV Versicherung (Anhang 1.1 und 1.2), Neueinstufung nach I.3. Andere Versicherer verwenden eigene Tabellen. Unterstellt ist ein gleichbleibender Beitrag zu 100 Prozent, also keine Änderung von Typklasse, Regionalklasse oder Tarif.`}
    explanation={`Aus Ihrem Jahresbeitrag und dem Beitragssatz Ihrer SF-Klasse ergibt sich der Beitrag zu 100 Prozent. Ohne Schadenmeldung steigt der Vertrag jedes Jahr eine Klasse, mit Meldung fällt er zum 1. Januar in die Klasse der Rückstufungstabelle und steigt von dort wieder. Die Differenz der Beiträge über den gewählten Zeitraum ist der Preis der Meldung. Beispiel: ${sf('10')} in der Haftpflicht, 500 € im Jahr – zurück auf ${sf(bsp.zielKlasse)}, ${eur(bsp.mehrbeitrag)} Mehrbeitrag in zehn Jahren.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="sparte">Vertragsteil</label>
          <select id="sparte">
            <option value="haftpflicht" selected>Kfz-Haftpflicht</option>
            <option value="vollkasko">Vollkasko</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="klasse">Ihre SF-Klasse heute</label>
          <select id="klasse">
            {KLASSEN.map((k) => <option value={k} selected={k === '10'}>{sf(k)}</option>)}
          </select>
        </div>
        <div class="calc-group">
          <label for="beitrag">Ihr Jahresbeitrag für diesen Vertragsteil (€)</label>
          <input type="number" id="beitrag" min="1" max="20000" value="500" step="10" />
        </div>
        <div class="calc-group">
          <label for="entschaedigung">Entschädigung, die der Versicherer zahlen müsste (€)</label>
          <input type="number" id="entschaedigung" min="0" max="1000000" value="1200" step="50" />
          <small style="color:#666;">In der Vollkasko: Schaden abzüglich Selbstbeteiligung.</small>
        </div>
        <div class="calc-group">
          <label for="schaeden">Schäden im Kalenderjahr</label>
          <select id="schaeden">
            <option value="1" selected>ein Schaden</option>
            <option value="2">zwei oder mehr</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="jahre">Betrachteter Zeitraum</label>
          <select id="jahre">
            <option value="5">5 Jahre</option>
            <option value="10" selected>10 Jahre</option>
            <option value="15">15 Jahre</option>
            <option value="20">20 Jahre</option>
          </select>
        </div>
      </div>

      <div class="calc-result" id="result-box">
        <div class="label">Mehrbeitrag durch die Schadenmeldung</div>
        <div id="mehr">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
      <div id="verlauf" style="margin-top:1rem;overflow-x:auto;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Rückstufung verstehen: was ein Schaden wirklich kostet"
    content={guideHtml}
    relatedSlugs={['kfz-steuer-co2', 'spritkosten-rechner', 'fuehrerschein-kosten']}
  />
</Layout>

<script type="module">
const { berechneRueckstufung, RUECKKAUF_GRENZE_HAFTPFLICHT, RUECKKAUF_FRIST_MONATE } =
  await import(window.__base + 'scripts/kfz-versicherung.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const sf = (k) => (k === 'S' || k === 'M' ? `Klasse ${k}` : `SF ${k.replace('1/2', '½')}`);
function berechne() {
  const sparte = document.getElementById('sparte').value;
  const r = berechneRueckstufung({
    sparte,
    klasse: document.getElementById('klasse').value,
    jahresbeitrag: parseFloat(document.getElementById('beitrag').value) || 0,
    entschaedigung: parseFloat(document.getElementById('entschaedigung').value) || 0,
    schaeden: parseInt(document.getElementById('schaeden').value, 10) || 1,
    jahre: parseInt(document.getElementById('jahre').value, 10) || 10,
  });
  document.getElementById('mehr').textContent = eur(r.mehrbeitrag);
  const teile = [
    `<span>Rückstufung: <strong>${sf(document.getElementById('klasse').value)} → ${sf(r.zielKlasse)}</strong></span>`,
    `<span>Beitrag zu 100 %: <strong>${eur(r.beitrag100)}</strong></span>`,
    r.eingeholtImJahr
      ? `<span>Abstand eingeholt im <strong>${r.eingeholtImJahr}. Jahr</strong></span>`
      : `<span>Im Zeitraum <strong>nicht eingeholt</strong></span>`,
  ];
  if (r.entschaedigung > 0) {
    teile.push(r.selbstZahlenLohnt
      ? `<span style="flex-basis:100%;color:#1e7e34;"><strong>Selbst zahlen lohnt sich:</strong> ${eur(r.entschaedigung)} Entschädigung gegen ${eur(r.mehrbeitrag)} Mehrbeitrag.</span>`
      : `<span style="flex-basis:100%;color:#b71c1c;"><strong>Melden lohnt sich:</strong> Die Rückstufung kostet mit ${eur(r.mehrbeitrag)} weniger als die ${eur(r.entschaedigung)} Entschädigung.</span>`);
  }
  if (r.rueckkaufMoeglich) {
    teile.push(`<span style="flex-basis:100%;">Nach den AKB der GHV (I.5) lässt sich ein Haftpflichtschaden bis ${eur(RUECKKAUF_GRENZE_HAFTPFLICHT)} innerhalb von ${RUECKKAUF_FRIST_MONATE} Monaten zurückkaufen – bei anderen Versicherern gelten eigene Grenzen.</span>`);
  }
  document.getElementById('details').innerHTML = teile.join('');
  document.getElementById('verlauf').innerHTML =
    '<table style="font-size:0.85rem;border-collapse:collapse;width:100%;"><thead><tr>' +
    ['Jahr', 'ohne Meldung', 'Beitrag', 'mit Meldung', 'Beitrag', 'Mehr'].map((h) => `<th style="text-align:left;padding:0.25rem 0.5rem;border-bottom:1px solid #ddd;">${h}</th>`).join('') +
    '</tr></thead><tbody>' +
    r.zeilen.map((z) => `<tr><td style="padding:0.2rem 0.5rem;">${z.jahr}</td><td style="padding:0.2rem 0.5rem;">${sf(z.klasseOhne)} (${z.satzOhne} %)</td><td style="padding:0.2rem 0.5rem;">${eur(z.beitragOhne)}</td><td style="padding:0.2rem 0.5rem;">${sf(z.klasseMit)} (${z.satzMit} %)</td><td style="padding:0.2rem 0.5rem;">${eur(z.beitragMit)}</td><td style="padding:0.2rem 0.5rem;">${eur(z.mehr)}</td></tr>`).join('') +
    '</tbody></table>';
}
['beitrag', 'entschaedigung'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
['sparte', 'klasse', 'schaeden', 'jahre'].forEach((id) => document.getElementById(id).addEventListener('change', berechne));
berechne();
</script>
