---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  LADESTROM_HEIM_CENT_PRO_KWH,
  LADESTROM_HEIM_EURO_PRO_KWH,
  LADESTROM_AC_CENT_PRO_KWH,
  LADESTROM_DC_CENT_PRO_KWH,
  LADESTROM_ADHOC_AUTOBAHN_CENT_PRO_KWH,
  LADESTROM_QUELLE,
} from '../../../public/scripts/strompreis.js';
import { corsaBenzin, corsaElektro, BENZINPREIS, ADAC_STROMPREIS, ADAC_STAND, adacVerbrauchJe100km } from '../../../public/scripts/adac-autokosten.js';
import { vergleicheAntriebe } from '../../../public/scripts/antriebsvergleich.js';
const calc = CALCULATORS.find(c => c.slug === 'spritkosten-vergleich')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

const eur = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const eur0 = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const ct = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });
const r1 = (n: number) => Math.round(n * 10) / 10;

// Vorbelegung: Verbrauch der beiden Corsa-Varianten aus der ADAC-Übersicht,
// Benzinpreis wie vom ADAC angesetzt, Strom zum Haushaltstarif.
const VERBRAUCH_BENZIN = r1(adacVerbrauchJe100km(corsaBenzin, BENZINPREIS));
const VERBRAUCH_STROM = r1(adacVerbrauchJe100km(corsaElektro, ADAC_STROMPREIS));
const KM = 12000;

const ladeweg = (cent: number) =>
  vergleicheAntriebe({
    kmProJahr: KM,
    antriebe: [
      { name: 'Benzin', verbrauch: VERBRAUCH_BENZIN, preis: BENZINPREIS },
      { name: 'Strom', verbrauch: VERBRAUCH_STROM, preis: cent / 100 },
    ],
  });
const zeilen = [
  ['Zu Hause', LADESTROM_HEIM_CENT_PRO_KWH],
  ['Öffentlich AC', LADESTROM_AC_CENT_PRO_KWH],
  ['Öffentlich DC', LADESTROM_DC_CENT_PRO_KWH],
  ['Ad hoc an der Autobahn', LADESTROM_ADHOC_AUTOBAHN_CENT_PRO_KWH],
].map(([name, cent]) => {
  const v = ladeweg(cent as number);
  const strom = v.antriebe.find((a) => a.name === 'Strom')!;
  const benzin = v.antriebe.find((a) => a.name === 'Benzin')!;
  return '<tr><td>' + name + '</td><td>' + ct(cent as number) + ' ct</td><td>' + eur(strom.je100km) + '</td><td>' + eur0(benzin.jahr - strom.jahr) + '</td></tr>';
}).join('');
const heim = ladeweg(LADESTROM_HEIM_CENT_PRO_KWH);
if (heim.guenstigster !== 'Strom') throw new Error('Spritvergleich: Heimladen muss im Beispiel günstiger sein');
// Strompreis, ab dem das E-Auto im Beispiel teurer fährt als der Benziner.
const gleichstandCent = (VERBRAUCH_BENZIN * BENZINPREIS) / VERBRAUCH_STROM * 100;

const guideHtml = `
<h3>Die Rechnung</h3>
<p>Kosten je 100 km sind Verbrauch je 100 km mal Preis je Liter oder Kilowattstunde. Den Verbrauch kennen Sie am genauesten aus Tankbelegen oder Ladeabrechnungen: getankte Liter oder geladene kWh geteilt durch die gefahrenen Kilometer, mal 100. Beim Elektroauto zählt die Menge, die an der Wallbox oder Säule abgerechnet wird – sie liegt wegen der Ladeverluste über dem Wert im Bordcomputer.</p>

<h3>Beispiel: derselbe Corsa als Benziner und als Elektroauto</h3>
<p>Aus den Betriebskosten der ADAC Autokostenübersicht ${ADAC_STAND} ergeben sich ${VERBRAUCH_BENZIN.toLocaleString('de-DE')} l Benzin und ${VERBRAUCH_STROM.toLocaleString('de-DE')} kWh Strom je 100 km. Bei ${BENZINPREIS.toLocaleString('de-DE')} € je Liter kostet der Benziner ${eur(VERBRAUCH_BENZIN * BENZINPREIS)} je 100 km. Was das Elektroauto kostet, hängt am Ladeort (Preise nach ${LADESTROM_QUELLE}, Heimstrom nach BDEW):</p>
<table>
<thead><tr><th>Ladeort</th><th>Preis je kWh</th><th>Strom je 100 km</th><th>Ersparnis gegenüber Benzin bei ${KM.toLocaleString('de-DE')} km/Jahr</th></tr></thead>
<tbody>${zeilen}</tbody>
</table>
<p>Ab rund ${ct(gleichstandCent)} ct je kWh fährt das Elektroauto in diesem Beispiel teurer als der Benziner. Wer überwiegend ohne Vertrag schnell lädt, verliert den Energiekostenvorteil also vollständig.</p>

<h3>Was der Vergleich nicht zeigt</h3>
<p>Nur die Energiekosten. Kaufpreis, Wertverlust, Versicherung, Steuer und Werkstatt vergleicht der Elektroauto-TCO-Rechner – dort kann ein niedriger Energiepreis durch einen höheren Kaufpreis wieder aufgezehrt werden.</p>
`;

const faqs = [
  { q: 'Wie ermittle ich meinen Verbrauch?', a: 'Aus Tank- oder Ladebelegen: Liter oder kWh seit dem letzten vollen Tanken oder Laden, geteilt durch die gefahrenen Kilometer, mal 100. Beim Elektroauto die abgerechneten kWh nehmen, nicht den Bordcomputerwert.' },
  { q: 'Was kostet Laden an öffentlichen Säulen?', a: `Öffentliches Normalladen (AC) kostet im Schnitt ${ct(LADESTROM_AC_CENT_PRO_KWH)} ct/kWh, Schnellladen (DC) ${ct(LADESTROM_DC_CENT_PRO_KWH)} ct/kWh, ohne Vertrag an der Autobahn bis zu ${ct(LADESTROM_ADHOC_AUTOBAHN_CENT_PRO_KWH)} ct/kWh (${LADESTROM_QUELLE}). Zu Hause gilt der Haushaltstarif, im Durchschnitt ${ct(LADESTROM_HEIM_CENT_PRO_KWH)} ct/kWh.` },
  { q: 'Warum bleibt ein Feld leer?', a: 'Ein Antrieb ohne Verbrauch oder Preis wird nicht gewertet – sonst erschiene er mit 0 € als der günstigste. Für Diesel ist nichts vorbelegt; tragen Sie Verbrauch und Preis Ihres Fahrzeugs ein.' },
  { q: 'Ist das E-Auto damit insgesamt günstiger?', a: 'Das zeigt dieser Rechner nicht. Er vergleicht nur die Energiekosten. Für Kaufpreis, Wertverlust, Versicherung und Werkstatt gibt es den Elektroauto-TCO-Rechner.' },
];
---
<Layout
  title={`Spritkosten-Vergleich ${year}`}
  description="Energiekosten von Benzin, Diesel und Strom nebeneinander: Kosten je 100 km, im Monat und im Jahr aus eigenem Verbrauch und Preis."
  canonicalPath="/auto/spritkosten-vergleich/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto &amp; Mobilität</a>
    <h1>Spritkosten-Vergleich {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Tragen Sie für bis zu drei Antriebe Verbrauch und Preis ein. Der Rechner zeigt die Energiekosten je 100 km, im Monat und im Jahr – und was der teurere Antrieb mehr kostet."
    sourceNote={`Kosten = km ÷ 100 × Verbrauch × Preis. Vorbelegung: Verbrauch aus der ADAC Autokostenübersicht ${ADAC_STAND} (${corsaBenzin.name}, ${corsaElektro.name}), Benzinpreis ${BENZINPREIS.toLocaleString('de-DE')} €/l wie vom ADAC angesetzt, Strom ${ct(LADESTROM_HEIM_CENT_PRO_KWH)} ct/kWh aus der BDEW-Strompreisanalyse; Ladepreise nach ${LADESTROM_QUELLE}.`}
    explanation="Ein Antrieb ohne Verbrauch oder Preis wird nicht gewertet. Die Mehrkosten beziehen sich auf den günstigsten gewerteten Antrieb."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="km">Fahrleistung (km/Jahr)</label>
          <input type="number" id="km" min="0" max="100000" value={KM} step="1000" />
        </div>
      </div>
      <div class="sv-tabelle">
        <table>
          <thead><tr><th>Antrieb</th><th>Verbrauch je 100 km</th><th>Preis</th></tr></thead>
          <tbody>
            <tr><td>Benzin</td><td><input type="number" id="v_benzin" aria-label="Verbrauch Benzin in Liter" min="0" step="0.1" value={VERBRAUCH_BENZIN} /> l</td><td><input type="number" id="p_benzin" aria-label="Preis Benzin je Liter" min="0" step="0.01" value={BENZINPREIS} /> €/l</td></tr>
            <tr><td>Diesel</td><td><input type="number" id="v_diesel" aria-label="Verbrauch Diesel in Liter" min="0" step="0.1" placeholder="—" /> l</td><td><input type="number" id="p_diesel" aria-label="Preis Diesel je Liter" min="0" step="0.01" placeholder="—" /> €/l</td></tr>
            <tr><td>Strom</td><td><input type="number" id="v_strom" aria-label="Verbrauch Strom in kWh" min="0" step="0.1" value={VERBRAUCH_STROM} /> kWh</td><td><input type="number" id="p_strom" aria-label="Strompreis je kWh" min="0" step="0.01" value={LADESTROM_HEIM_EURO_PRO_KWH} /> €/kWh</td></tr>
          </tbody>
        </table>
      </div>
      <div class="calc-result">
        <div class="label">Günstigster Antrieb</div>
        <div id="guenstigster">—</div>
      </div>
      <div class="sv-tabelle"><table id="ergebnis"></table></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Benzin, Diesel und Strom: Was die Energie je Kilometer kostet"
    content={guideHtml}
    relatedSlugs={['spritkosten-rechner', 'elektroauto-tco-rechner', 'fahrtkosten-rechner', 'kfz-steuer-rechner']}
  />
</Layout>

<script type="module">
const { vergleicheAntriebe } = await import(window.__base + 'scripts/antriebsvergleich.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const v = vergleicheAntriebe({
    kmProJahr: wert('km'),
    antriebe: ['Benzin', 'Diesel', 'Strom'].map((name) => ({
      name, verbrauch: wert('v_' + name.toLowerCase()), preis: wert('p_' + name.toLowerCase()),
    })),
  });
  document.getElementById('guenstigster').textContent = v.guenstigster ?? '—';
  document.getElementById('ergebnis').innerHTML =
    '<thead><tr><th>Antrieb</th><th>je 100 km</th><th>je Monat</th><th>je Jahr</th><th>Mehrkosten/Jahr</th></tr></thead><tbody>' +
    v.antriebe.map((a) => `<tr><td>${a.name}</td><td>${eur(a.je100km)}</td><td>${eur(a.monat)}</td><td>${eur(a.jahr)}</td><td>${a.mehrkostenJahr > 0 ? eur(a.mehrkostenJahr) : '–'}</td></tr>`).join('') +
    '</tbody>';
}
document.querySelectorAll('.calc-form input').forEach((el) => el.addEventListener('input', berechne));
berechne();
</script>

<style>
.page-header { margin-bottom: 2rem; }
.sv-tabelle { overflow-x: auto; margin-top: 1rem; }
.sv-tabelle table { width: 100%; border-collapse: collapse; }
.sv-tabelle th, .sv-tabelle td { padding: 0.4rem 0.5rem; text-align: left; white-space: nowrap; }
.sv-tabelle input { width: 5.5rem; }
</style>
