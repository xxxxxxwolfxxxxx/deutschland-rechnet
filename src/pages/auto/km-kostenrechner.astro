---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import PageByline from '../../components/PageByline.astro';
import {
  LADESTROM_HEIM_CENT_PRO_KWH,
  LADESTROM_AC_CENT_PRO_KWH,
  LADESTROM_DC_CENT_PRO_KWH,
} from '../../../public/scripts/strompreis.js';

const base = import.meta.env.BASE_URL;
---

<CalculatorLayout
  title="KM-Kostenrechner - Kosten pro Kilometer inkl. Verschleiß"
  description="Kosten pro Kilometer inklusive Verschleiß, Abnutzung und Wertverlust berechnen. Einzeln aufgeschlüsselt nach Fixkosten und variablen Kosten - kostenlos und ohne Anmeldung."
  canonicalPath="/auto/km-kostenrechner/"
  categoryColor="#1565c0"
  categoryLight="#e3f2fd"
  faqs={[
    { q: "Wie hoch ist die Abnutzung pro Kilometer?", a: "Als Abnutzung oder Verschleiß gelten Reifen, Bremsen, Kupplung, Auspuff und Stoßdämpfer - also Teile, die sich durch das Fahren abnutzen und unabhängig von der planmäßigen Wartung ersetzt werden müssen. Rechnerisch liegt dieser Posten bei den meisten Fahrzeugen im niedrigen einstelligen Cent-Bereich pro Kilometer. Wer ihn genau kennen will, summiert die Rechnungen für Verschleißteile der letzten Jahre und teilt sie durch die in dieser Zeit gefahrenen Kilometer. Der Wertverlust zählt nicht zum Verschleiß, sondern wird getrennt gerechnet - er ist meist der deutlich größere Posten." },
    { q: "Warum unterscheiden sich meine Kosten von der ADAC-Kilometerkostentabelle?", a: "Der ADAC rechnet mit Neuwagenpreisen, pauschalen Haltedauern und einer angenommenen Jahresfahrleistung. Wer einen bezahlten Gebrauchtwagen länger fährt, hat kaum noch Wertverlust und liegt deutlich darunter; wer wenig fährt, liegt darüber, weil sich die Fixkosten auf weniger Kilometer verteilen. Dieser Rechner nutzt deine eigenen Zahlen statt Durchschnittswerte - das Ergebnis weicht deshalb bewusst von Tabellenwerten ab." },
    { q: "Was zählt alles zu den Fixkosten beim Auto?", a: "Zu den Fixkosten gehören Kfz-Versicherung, Kfz-Steuer, Hauptuntersuchung (TÜV), Stellplatz bzw. Garagenmiete sowie der Wertverlust des Fahrzeugs. Diese Kosten fallen unabhängig davon an, wie viel Sie fahren." },
    { q: "Wie berechne ich den Wertverlust meines Autos?", a: "Ziehen Sie den aktuellen Marktwert (z. B. über DAT oder Schwacke) vom Kaufpreis ab und teilen Sie durch die bisherige Haltedauer in Monaten. Neuwagen verlieren im ersten Jahr ca. 20-25 % an Wert, danach sinkt der jährliche Wertverlust auf ca. 5-10 %." },
    { q: "Wie hoch sind die durchschnittlichen Autokosten laut ADAC?", a: "Laut ADAC liegen die Gesamtkosten pro Kilometer bei Kleinwagen bei ca. 30-40 Cent, in der Kompaktklasse bei 40-55 Cent und in der Mittelklasse bei 55-75 Cent. Diese Werte beinhalten alle Kosten inklusive Wertverlust." },
    { q: "Ist ein E-Auto pro Kilometer günstiger als ein Verbrenner?", a: "Die reinen Energiekosten sind beim E-Auto meist niedriger (ca. 5-7 Euro pro 100 km vs. 8-14 Euro beim Verbrenner). Hinzu kommen niedrigere Wartungskosten. Allerdings ist der höhere Anschaffungspreis zu berücksichtigen, der sich erst ab ca. 15.000 km/Jahr amortisiert." },
    { q: "Ab welcher Kilometerleistung lohnt sich ein eigenes Auto?", a: "Unter ca. 5.000 km pro Jahr sind Carsharing oder Mietwagen oft günstiger, da die Fixkosten pro Kilometer dann sehr hoch ausfallen. Ab ca. 10.000 km/Jahr sinken die Kosten pro Kilometer deutlich, und ein eigenes Auto wird wirtschaftlicher." }
  ]}
>
  <div class="calculator">
    <form id="kmKostenForm" class="calc-form">
      <div class="form-group">
        <label for="annualKm">Jährliche Kilometerleistung</label>
        <input type="number" id="annualKm" name="annualKm" min="500" max="200000" step="500" value="15000" required />
        <small>Durchschnittliche Jahresfahrleistung in km</small>
      </div>

      <fieldset class="cost-group">
        <legend>Variable Kosten – fallen nur beim Fahren an</legend>

        <div class="form-row">
          <div class="form-group">
            <label for="consumption">Verbrauch</label>
            <input type="number" id="consumption" min="0" max="50" step="0.1" value="7.0" required />
            <small>Liter bzw. kWh je 100 km</small>
          </div>
          <div class="form-group">
            <label for="fuelPrice">Preis je Liter / kWh (€)</label>
            <input type="number" id="fuelPrice" min="0" max="10" step="0.01" value="1.75" required />
            <small>Für E-Autos: Ladepreis je kWh – zu Hause {LADESTROM_HEIM_CENT_PRO_KWH} ct, öffentlich {LADESTROM_AC_CENT_PRO_KWH} ct, Schnellladen {LADESTROM_DC_CENT_PRO_KWH} ct</small>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="maintenance">Wartung &amp; Reparatur (€/Jahr)</label>
            <input type="number" id="maintenance" min="0" max="20000" step="10" value="600" required />
            <small>Inspektion, Ölwechsel, Reparaturen</small>
          </div>
          <div class="form-group">
            <label for="wear">Verschleiß &amp; Abnutzung (€/Jahr)</label>
            <input type="number" id="wear" min="0" max="20000" step="10" value="350" required />
            <small>Reifen, Bremsen, Kupplung, Auspuff</small>
          </div>
        </div>
      </fieldset>

      <fieldset class="cost-group">
        <legend>Fixkosten – fallen an, egal wie viel du fährst</legend>

        <div class="form-row">
          <div class="form-group">
            <label for="depreciation">Wertverlust (€/Jahr)</label>
            <input type="number" id="depreciation" min="0" max="50000" step="50" value="1500" required />
            <small>Kaufpreis minus heutiger Wert, geteilt durch die Haltejahre</small>
          </div>
          <div class="form-group">
            <label for="insurance">Kfz-Versicherung (€/Jahr)</label>
            <input type="number" id="insurance" min="0" max="20000" step="10" value="600" required />
            <small>Haftpflicht und ggf. Kasko</small>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="tax">Kfz-Steuer (€/Jahr)</label>
            <input type="number" id="tax" min="0" max="5000" step="5" value="150" required />
            <small>Jahresbetrag laut Steuerbescheid</small>
          </div>
          <div class="form-group">
            <label for="other">Sonstiges (€/Jahr)</label>
            <input type="number" id="other" min="0" max="20000" step="10" value="200" required />
            <small>Stellplatz, TÜV, Mitgliedschaften</small>
          </div>
        </div>
      </fieldset>

      <button type="submit" class="calc-button">Berechnen</button>
    </form>

    <div id="result" style="display: none;">
      <div class="result-box">
        <h2>Kosten pro Kilometer</h2>
        <div class="result-value">
          <span id="costPerKm">€0,00</span>
          <span class="period">/km</span>
        </div>
      </div>

      <div class="split-box">
        <div class="split-part">
          <h3>Variable Kosten</h3>
          <div class="split-value" id="variablePerKm">0,00 €/km</div>
          <p>Sprit, Wartung, Verschleiß</p>
        </div>
        <div class="split-part">
          <h3>Fixkosten</h3>
          <div class="split-value" id="fixedPerKm">0,00 €/km</div>
          <p>Wertverlust, Versicherung, Steuer</p>
        </div>
      </div>

      <div class="result-boxes">
        <div class="result-card">
          <h3>Verschleiß je km</h3>
          <div class="value" id="wearPerKm">0,00 €</div>
        </div>

        <div class="result-card">
          <h3>Monatliche Kosten</h3>
          <div class="value" id="monthlyCosts">0,00 €</div>
        </div>

        <div class="result-card">
          <h3>Kosten für 100 km</h3>
          <div class="value" id="cost100km">0,00 €</div>
        </div>

        <div class="result-card">
          <h3>Jahresgesamtkosten</h3>
          <div class="value" id="annualTotal">0,00 €</div>
        </div>
      </div>

      <p class="hint" id="fixedShareHint"></p>

      <div class="info-box">
        <h3>Was gehört zu den Fahrtkosten?</h3>
        <ul>
          <li><strong>Sprit:</strong> Kosten für Benzin, Diesel oder Strom</li>
          <li><strong>Versicherung:</strong> Kfz-Haftpflicht, Kaskoversicherung</li>
          <li><strong>Wartung:</strong> Ölwechsel, Filter, Inspektion, Reparaturen</li>
          <li><strong>Kfz-Steuer:</strong> Jährliche Steuer je nach Emissionsgruppe</li>
          <li><strong>Abnutzung:</strong> Verschleiß von Reifen, Bremsbelägen, Batterie (bei E-Autos)</li>
          <li><strong>Tipp:</strong> Rechne deine echten Kosten für ein genaues Ergebnis</li>
        </ul>
      </div>
    </div>
    <PageByline path={`${base}auto/km-kostenrechner/`} />
  </div>

  <CalculatorGuide
    title="Kilometerkosten verstehen und richtig berechnen"
    content={`<p>Die <strong>Kosten pro Kilometer</strong> sind eine der wichtigsten Kennzahlen für Autobesitzer. Sie zeigen, was jeder gefahrene Kilometer tatsächlich kostet, wenn alle Ausgaben berücksichtigt werden. Diese Information ist unverzichtbar für Pendler, Vielfahrer und alle, die ihre Mobilitätskosten optimieren wollen.</p>

<p><strong>Vollkostenrechnung vs. reine Spritkosten:</strong> Viele Autofahrer kennen nur ihre Tankkosten und unterschätzen die wahren Kilometerskosten erheblich. Zu einer ehrlichen Vollkostenrechnung gehören: Kraftstoff oder Strom, Kfz-Versicherung (Haftpflicht und ggf. Kasko), Kfz-Steuer, Wartung und Reparaturen, TÜV/HU, Reifenverschleiß, Parkgebühren und der Wertverlust des Fahrzeugs. Letzterer ist oft der größte Einzelposten: Ein Neuwagen verliert im ersten Jahr durchschnittlich 20-25 Prozent seines Wertes.</p>

<p><strong>Durchschnittliche Kosten in Deutschland:</strong> Laut ADAC liegen die Gesamtkosten pro Kilometer für einen Kleinwagen bei ca. 0,30-0,40 Euro, für die Kompaktklasse bei 0,40-0,55 Euro und für einen Mittelklassewagen bei 0,55-0,75 Euro. Diese Werte beinhalten den Wertverlust. Wer einen älteren Gebrauchtwagen fährt, hat zwar keinen hohen Wertverlust mehr, dafür aber oft höhere Reparaturkosten.</p>

<p><strong>Steuerliche Relevanz:</strong> Die Entfernungspauschale für den Weg zur ersten Tätigkeitsstätte beträgt 0,38 Euro je vollem Entfernungskilometer ab dem ersten Kilometer (§ 9 Abs. 1 Satz 3 Nr. 4 EStG). Sie kann in der Einkommensteuererklärung als Werbungskosten geltend gemacht werden, unabhängig vom genutzten Verkehrsmittel. Bei beruflich veranlassten Fahrten außerhalb dieses Wegs können stattdessen die tatsächlichen Kosten oder pauschale Kilometersätze angesetzt werden (§ 9 Abs. 1 Satz 3 Nr. 4a EStG).</p>

<p><strong>Fahrgemeinschaften und Mitfahrgelegenheiten:</strong> Wer regelmäßig die gleiche Strecke fährt, kann durch Fahrgemeinschaften die Kosten pro Person deutlich senken. Bei vier Mitfahrern reduzieren sich die individuellen Kosten auf ein Viertel. Auch Mitfahrplattformen nutzen Kilometerkostensätze als Orientierung für faire Preise.</p>

<p><strong>Praxistipp:</strong> Führen Sie ein Haushaltsbuch oder nutzen Sie eine App, um alle Autokosten über ein Jahr zu erfassen. Teilen Sie die Jahresgesamtkosten durch die gefahrenen Kilometer, um Ihren persönlichen Kilometersatz zu ermitteln. So erkennen Sie, ob ein Jobwechsel mit längerem Arbeitsweg wirklich lohnt oder ob ein Umstieg auf den ÖPNV günstiger wäre.</p>`}
    relatedSlugs={['fahrtkosten-rechner', 'spritkosten-rechner', 'spritkosten-vergleich', 'kfz-steuer-rechner']}
  />
</CalculatorLayout>

<style>
.calculator {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem;
  margin: 2rem 0;
}

.calc-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-group {
  margin-bottom: 0.5rem;
}

.form-group label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--text);
}

.form-group input {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 1rem;
  background: var(--bg);
  color: var(--text);
}

.form-group small {
  display: block;
  font-size: 0.8rem;
  color: var(--text-light);
  margin-top: 0.3rem;
}

.calc-button {
  background: #1565c0;
  color: white;
  border: none;
  padding: 0.75rem 2rem;
  border-radius: var(--radius-sm);
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: 0.5rem;
}

.calc-button:hover {
  background: #1e53e5;
}

.result-box {
  background: linear-gradient(135deg, #1565c0 0%, #1e53e5 100%);
  color: white;
  padding: 2rem;
  border-radius: var(--radius);
  margin-bottom: 2rem;
  text-align: center;
}

.result-box h2 {
  font-size: 0.95rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  opacity: 0.9;
}

.result-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 0.5rem;
}

#costPerKm {
  font-size: 2.5rem;
  font-weight: 700;
}

.period {
  font-size: 1rem;
  opacity: 0.9;
}

.result-boxes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.result-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 1.5rem;
  text-align: center;
}

.result-card h3 {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-light);
  margin: 0 0 0.75rem 0;
}

.result-card .value {
  font-size: 1.6rem;
  font-weight: 700;
  color: #1565c0;
}

.cost-group {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 1.25rem 1.25rem 0.5rem;
  margin: 0;
}

.cost-group legend {
  font-size: 0.85rem;
  font-weight: 600;
  color: #1565c0;
  padding: 0 0.5rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: 1rem;
}

.split-box {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.split-part {
  background: var(--bg);
  border: 1px solid var(--border);
  border-top: 3px solid #1565c0;
  border-radius: var(--radius-sm);
  padding: 1.25rem;
  text-align: center;
}

.split-part h3 {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-light);
  margin: 0 0 0.5rem 0;
}

.split-value {
  font-size: 1.4rem;
  font-weight: 700;
  color: #1565c0;
}

.split-part p {
  font-size: 0.78rem;
  color: var(--text-light);
  margin: 0.4rem 0 0 0;
}

.hint {
  font-size: 0.88rem;
  line-height: 1.6;
  color: var(--text-light);
  margin: 0 0 1.5rem 0;
}

.info-box {
  background: var(--bg);
  padding: 1.5rem;
  border-radius: var(--radius);
  border-left: 4px solid #1565c0;
}

.info-box h3 {
  font-size: 1rem;
  margin: 0 0 1rem 0;
  color: var(--text);
}

.info-box ul {
  margin: 0;
  padding-left: 1.5rem;
}

.info-box li {
  margin: 0.75rem 0;
  color: var(--text-light);
  line-height: 1.6;
}

@media (max-width: 640px) {
  .calculator {
    padding: 1.5rem;
  }

  #costPerKm {
    font-size: 2rem;
  }

  .result-boxes,
  .form-row,
  .split-box {
    grid-template-columns: 1fr;
  }
}
</style>

<script define:vars={{}}>
// Vier Nachkommastellen fuer Cent-genaue km-Saetze, zwei fuer Eurobetraege.
const euroPerKm = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 3 });
const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const euroExact = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });

const num = (id) => {
  const value = parseFloat(document.getElementById(id).value);
  return Number.isFinite(value) && value >= 0 ? value : 0;
};

document.getElementById('kmKostenForm').addEventListener('submit', function (e) {
  e.preventDefault();

  const annualKm = num('annualKm');
  if (annualKm <= 0) return;

  // Verbrauch ist auf 100 km bezogen, deshalb durch 100 teilen.
  const fuelPerYear = (num('consumption') / 100) * num('fuelPrice') * annualKm;
  const wearPerYear = num('wear');
  const variablePerYear = fuelPerYear + num('maintenance') + wearPerYear;
  const fixedPerYear = num('depreciation') + num('insurance') + num('tax') + num('other');
  const totalPerYear = variablePerYear + fixedPerYear;

  const costPerKm = totalPerYear / annualKm;
  const fixedShare = totalPerYear > 0 ? (fixedPerYear / totalPerYear) * 100 : 0;

  document.getElementById('costPerKm').textContent = euroPerKm.format(costPerKm);
  document.getElementById('variablePerKm').textContent = euroPerKm.format(variablePerYear / annualKm) + '/km';
  document.getElementById('fixedPerKm').textContent = euroPerKm.format(fixedPerYear / annualKm) + '/km';
  document.getElementById('wearPerKm').textContent = euroPerKm.format(wearPerYear / annualKm);
  document.getElementById('monthlyCosts').textContent = euroExact.format(totalPerYear / 12);
  document.getElementById('cost100km').textContent = euroExact.format(costPerKm * 100);
  document.getElementById('annualTotal').textContent = euro.format(totalPerYear);

  document.getElementById('fixedShareHint').textContent =
    `${Math.round(fixedShare)} % deiner Autokosten fallen an, ohne dass du fährst. `
    + `Würdest du nur die Hälfte fahren, läge dein Kilometersatz bei `
    + `${euroPerKm.format((totalPerYear - variablePerYear / 2) / (annualKm / 2))} statt `
    + `${euroPerKm.format(costPerKm)}.`;

  document.getElementById('result').style.display = 'block';
  document.getElementById('result').scrollIntoView({ behavior: 'smooth' });
});
</script>
