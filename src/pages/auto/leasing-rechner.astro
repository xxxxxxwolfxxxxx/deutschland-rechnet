---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelLeasingfaktor from '../../components/artikel/leasingfaktor-was-er-verschweigt.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'leasing-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Leasing-Rechner ${year}`}
  description="Monatliche Leasingrate und Gesamtkosten berechnen. Leasing vs. Kauf vergleichen."
  canonicalPath="/auto/leasing-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto &amp; Mobilität</a>
    <h1>Leasing-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Leasing-Rechner berechnen Sie die monatliche Leasingrate für ein Fahrzeug."
    sourceNote="Abschreibung + Finanzierungskosten."
    explanation="Die Rate deckt zwei Posten: den Wertverlust, also Fahrzeugpreis minus Restwert minus Anzahlung, und die Zinsen auf das durchschnittlich gebundene Kapital. Beides geteilt durch die Laufzeit. Die Anzahlung senkt die Rate deutlich, die Gesamtkosten aber nur um den Zinsanteil – warum das so ist und wo die Grenze liegt, steht im Text unter dem Rechner."
    faqs={[
      {
        q: "Ist Leasing günstiger als Kauf?",
        a: "Kommt auf die Nutzung an. Wer 10.000 km/Jahr fährt und alle 3 Jahre ein neues Auto will, kann mit Leasing sparen. Wer 200.000 km mit einem Auto fährt, ist beim Kauf billiger. Leasing ist Mietmodell – Kauf ist Investition."
      },
      {
        q: "Was ist der Restwert im Leasing?",
        a: "Der Restwert ist der Wert, den der Leasinggeber dem Fahrzeug zum Vertragsende beimisst; er bestimmt, wie viel Wertverlust die Raten decken müssen. Wer ihn trägt, hängt vom Vertragstyp ab. Dieser Rechner bildet Kilometerleasing ab: Dort wird am Ende nach gefahrenen Kilometern und übermäßigem Verschleiß abgerechnet, nicht nach der Differenz zu einem kalkulierten Wert – das Restwertrisiko bleibt beim Leasinggeber. Beim Restwertleasing ist es umgekehrt, und genau deshalb gilt dort nach § 506 Abs. 2 Satz 1 Nr. 3 BGB das Verbraucherdarlehensrecht."
      },
      {
        q: "Wie viele Kilometer sind im Leasing inbegriffen?",
        a: "Üblich sind 10.000 bis 15.000 km im Jahr, jeder Mehrkilometer kostet extra. Teuer ist beides: Wer 15.000 km bucht und 30.000 fährt, zahlt drei Jahre lang je 15.000 Mehrkilometer nach – bei 0,15 €/km rund 6.750 €, bei 0,20 €/km rund 9.000 €. Wer umgekehrt zu viel bucht und nur 10.000 km fährt, bekommt die nicht gefahrenen Kilometer meist gar nicht oder nur zu einem Bruchteil erstattet und zahlt je gefahrenem Kilometer entsprechend mehr."
      },
      {
        q: "Wer zahlt Versicherung und Wartung bei Leasing?",
        a: "Beim reinen Finanzierungsleasing trägt der Leasingnehmer Versicherung, Wartung, Reparaturen und Kfz-Steuer selbst; der Leasinggeber überlässt nur das Fahrzeug. Beim Full-Service-Leasing sind Wartung und teils Versicherung in der Rate enthalten – die Rate ist dann höher und mit der eines reinen Finanzierungsleasings nicht vergleichbar. Der Leasingfaktor unterscheidet die beiden nicht, weil er nur Rate und Fahrzeugpreis kennt."
      },
      {
        q: "Kann ich aus einem Leasingvertrag vorzeitig aussteigen?",
        a: "In der Regel nicht einseitig. Ein Leasingvertrag über eine feste Laufzeit ist ein befristeter Vertrag; ein ordentliches Kündigungsrecht gibt es nur, wenn der Vertrag es einräumt. Das Recht des Verbraucherdarlehensnehmers auf jederzeitige vorzeitige Erfüllung aus § 500 Abs. 2 BGB hilft hier nicht weiter: Beim Kilometerleasing gilt das Verbraucherdarlehensrecht ohnehin nicht, und für Restwertleasing nimmt § 506 Abs. 2 Satz 2 BGB genau diese Vorschrift ausdrücklich aus. Was bleibt, ist eine Aufhebung im Einvernehmen oder die Übernahme durch einen Dritten – beides zu Bedingungen, die der Leasinggeber setzt. Das Widerrufsrecht nach § 355 BGB betrifft nur die ersten 14 Tage."
      },
      {
        q: "Elektrofahrzeuge leasen – ist das günstiger?",
        a: "Pauschal lässt sich das nicht sagen, und eine Zahl dafür steht in keiner Quelle. Die Leasingrate hängt an denselben zwei Größen wie bei jedem anderen Fahrzeug: am Wertverlust bis zum kalkulierten Restwert und am Zins. Gerade der Restwert ist bei Elektroautos schwerer zu kalkulieren, weil der Gebrauchtmarkt jünger und die Preisentwicklung volatiler ist – ein vorsichtig angesetzter Restwert hebt die Rate. Für reine Elektrofahrzeuge kommt eine befristete Kfz-Steuerbefreiung nach § 3d KraftStG hinzu; deren Voraussetzungen und Fristen ändern sich, prüfen Sie den aktuellen Wortlaut. Wartungsfrei sind sie nicht: Bremsen, Reifen, Klimaanlage und die Prüfung der Hochvoltanlage fallen weiter an."
      }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="neupreis">Fahrzeugpreis (€)</label>
          <input type="number" id="neupreis" min="5000" max="200000" value="35000" step="500" />
        </div>
        <div class="calc-group">
          <label for="anzahlung">Anzahlung (€)</label>
          <input type="number" id="anzahlung" min="0" max="50000" value="5000" step="500" />
        </div>
        <div class="calc-group">
          <label for="laufzeit">Laufzeit (Monate)</label>
          <select id="laufzeit">
            <option value="12">12 Monate</option>
            <option value="24" selected>24 Monate</option>
            <option value="36">36 Monate</option>
            <option value="48">48 Monate</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="restwert">Restwert (€)</label>
          <input type="number" id="restwert" min="0" max="200000" value="18000" step="500" />
        </div>
        <div class="calc-group">
          <label for="zins">Sollzins (% p.a.)</label>
          <input type="number" id="zins" min="0" max="15" value="3.5" step="0.1" />
        </div>
        <div class="calc-group">
          <label for="km">Jährliche km-Leistung</label>
          <select id="km">
            <option value="10000">10.000 km</option>
            <option value="15000" selected>15.000 km</option>
            <option value="20000">20.000 km</option>
            <option value="30000">30.000 km</option>
          </select>
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Monatliche Leasingrate</div>
        <div id="rate">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>
    <ArtikelLeasingfaktor slot="artikel" />
  </CalculatorShell>

</Layout>

<script type="module">
const { berechneLeasing } = await import(window.__base + 'scripts/leasing.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const neupreis = parseFloat(document.getElementById('neupreis').value)||35000;
  const anzahlung = parseFloat(document.getElementById('anzahlung').value)||5000;
  const laufzeit = parseInt(document.getElementById('laufzeit').value)||24;
  const restwert = parseFloat(document.getElementById('restwert').value)||18000;
  const zins = parseFloat(document.getElementById('zins').value)||3.5;
  const km = parseInt(document.getElementById('km').value)||15000;
  const r = berechneLeasing({ neupreis, anzahlung, laufzeit, restwert, zins, km });
  document.getElementById('rate').textContent = fmt(r.rate);
  document.getElementById('details').innerHTML =
    `<span>Gesamtkosten: <strong>${fmt(r.gesamtkosten)}</strong></span>` +
    `<span>Zinskosten: <strong>${fmt(r.zinskosten)}</strong></span>` +
    `<span>÷ Anzahlung: <strong>${fmt(anzahlung)}</strong></span>` +
    `<span>÷ Restwert: <strong>${fmt(restwert)}</strong></span>` +
    `<span>Effektivkosten/km: <strong>${fmt(r.kostenProKm)}</strong></span>`;
}
['neupreis','anzahlung','restwert','zins'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
['laufzeit','km'].forEach(id =>
  document.getElementById(id).addEventListener('change', berechne));
berechne();
</script>
