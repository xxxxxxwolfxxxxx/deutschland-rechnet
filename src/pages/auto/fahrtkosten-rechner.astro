---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelPendlerpauschale from '../../components/artikel/pendlerpauschale-was-sie-bringt.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'fahrtkosten-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Pendlerpauschale-Rechner ${year}`}
  description={`Entfernungspauschale (Pendlerpauschale) ${year} berechnen: 0,38 € je Entfernungskilometer ab dem ersten Kilometer nach § 9 Abs. 1 Satz 3 Nr. 4 EStG, mit Höchstbetrag und Jahresabzug.`}
  canonicalPath="/auto/fahrtkosten-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto &amp; Mobilität</a>
    <h1>Pendlerpauschale-Rechner {year} – Fahrtkosten steuerlich absetzen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Fahrtkosten-Rechner berechnen Sie die steuerliche Kilometerpauschale für Fahrten zwischen Wohnung und Arbeitsstätte. Erfahren Sie, wie viel Sie über die Steuererklärung zurückbekommen und ob sich ein Umzug finanziell lohnt."
    sourceNote={`§ 9 Abs. 1 Satz 3 Nr. 4 EStG, Rechtsstand ${year}: 0,38 € je vollem Entfernungskilometer.`}
    explanation="Die Entfernungspauschale nach § 9 Abs. 1 Satz 3 Nr. 4 EStG beträgt 0,38 € je vollem Entfernungskilometer – seit 2026 einheitlich ab dem ersten Kilometer, die frühere Staffelung mit 0,30 € für die ersten 20 Kilometer ist entfallen. Maßgeblich ist die einfache Entfernung der kürzesten Straßenverbindung, nicht Hin- und Rückfahrt. Der Abzug ist auf 4.500 € im Jahr begrenzt, außer bei Nutzung eines eigenen Kraftwagens."
    faqs={[
      {
        q: "Was ist die Pendlerpauschale und wie funktioniert sie?",
        a: "Die Pendlerpauschale (Entfernungspauschale) nach § 9 Absatz 1 Satz 3 Nummer 4 EStG ermöglicht es Arbeitnehmern, die Kosten für den Weg zur ersten Tätigkeitsstätte steuerlich geltend zu machen. Sie beträgt 0,38 € je vollem Kilometer der einfachen Entfernung zwischen Wohnung und Tätigkeitsstätte – unabhängig davon, welches Verkehrsmittel Sie benutzen."
      },
      {
        q: "Wird die Hin- oder die Hinfahrt berechnet?",
        a: "Es ist die einfache Entfernung – also nur die Hinfahrt. Die Pauschale deckt bereits implizit die Rückfahrt ab. Geben Sie also die Entfernung zwischen Ihrer Wohnung und Ihrem Arbeitsplatz ein, nicht die doppelte Strecke."
      },
      {
        q: "Was ändert sich 2026 und danach?",
        a: "Ab dem 1. Januar 2026 erhöht sich die Pauschale auf 0,35 € pro Kilometer für die ersten 20 km und auf 0,38 € für jede weitere Kilometer. Diese Erhöhung soll die gestiegenen Mobilitätskosten berücksichtigen."
      },
      {
        q: "Kann ich die Pendlerpauschale und Fahrtkosten kombinieren?",
        a: "Für den Weg zur ersten Tätigkeitsstätte gilt ausschließlich die Entfernungspauschale von 0,38 € je Entfernungskilometer; tatsächliche Kosten können Sie dafür nicht ansetzen. Anders bei beruflich veranlassten Fahrten außerhalb dieses Wegs (§ 9 Abs. 1 Satz 3 Nr. 4a EStG): Dort sind die tatsächlichen Kosten oder pauschale Kilometersätze möglich."
      },
      {
        q: "Gelten manche Tage nicht als Arbeitstage?",
        a: "Standardmäßig werden etwa 220 Arbeitstage pro Jahr angenommen (5 Tage pro Woche, 52 Wochen, minus Urlaub und Feiertage). Wenn Sie viel Home-Office haben, müssen Sie die Zahl entsprechend reduzieren. Nur Tage mit physischer Anwesenheit zählen."
      },
      {
        q: "Muss ich belegen, dass ich tatsächlich zur Arbeit fahre?",
        a: "Das Finanzamt vertraut grundsätzlich auf die Pauschale ohne Nachweise. Allerdings sollten Sie die Arbeitsstättenanerkennung dokumentieren. Bei Audits kann das Finanzamt Nachweise verlangen – halten Sie Verträge und Arbeitgeber-Bescheinigungen bereit."
      }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="entfernung">Entfernung (km, einfach)</label>
          <input type="number" id="entfernung" min="1" max="500" value="25" step="1" />
        </div>
        <div class="calc-group">
          <label for="arbeitstage">Arbeitstage pro Jahr</label>
          <input type="number" id="arbeitstage" min="1" max="365" value="220" step="1" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Jährlicher Werbungskosten-Abzug</div>
        <div id="jahresabzug">— €</div>
      </div>
      <p id="info" style="margin-top:0.5rem;font-size:0.85rem;color:#666;"></p>
    </div>

    <ArtikelPendlerpauschale slot="artikel" />
  </CalculatorShell>
</Layout>

<script type="module">
const { berechnefahrtkosten } = await import(window.__base + 'scripts/fahrtkosten.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const entfernung = parseFloat(document.getElementById('entfernung').value)||0;
  const arbeitstage = parseInt(document.getElementById('arbeitstage').value)||220;
  const r = berechnefahrtkosten({ entfernungKm: entfernung, arbeitstageProJahr: arbeitstage });
  document.getElementById('jahresabzug').textContent = fmt(r.jahresabzug);
  document.getElementById('info').textContent = `Pro Arbeitstag: ${fmt(r.pauschaleTaeglich)} · bei ${arbeitstage} Arbeitstagen`;
}
['entfernung','arbeitstage'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
