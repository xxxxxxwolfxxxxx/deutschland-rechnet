---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  berechneFuehrerschein,
  pruefgebuehren,
  SONDERFAHRTEN_B,
  GEBUEHREN,
  MINUTEN_JE_AUSBILDUNGSFAHRT,
} from '../../../public/scripts/fuehrerschein.js';
const calc = CALCULATORS.find(c => c.slug === 'fuehrerschein-kosten')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

// Alle Zahlen dieser Seite kommen aus demselben Modul, das der Rechner laedt.
const eur = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const eur0 = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const geb = pruefgebuehren();
const gebNetto = pruefgebuehren({ mitUmsatzsteuer: false });
const sonder = SONDERFAHRTEN_B.ueberland + SONDERFAHRTEN_B.autobahn + SONDERFAHRTEN_B.dunkelheit;

// Rechenbeispiel mit ausgedachter Preisliste – ausdrücklich als solche
// benannt. Es zeigt nur, wie stark die Zahl der Übungsstunden wirkt.
const preisliste = { grundbetrag: 400, preisUebungsstunde: 65, preisSonderfahrt: 80, vorstellungTheorie: 50, vorstellungPraxis: 180, sonstiges: 100 };
const mit20 = berechneFuehrerschein({ ...preisliste, uebungsstunden: 20 });
const mit35 = berechneFuehrerschein({ ...preisliste, uebungsstunden: 35 });
const mitWiederholung = berechneFuehrerschein({ ...preisliste, uebungsstunden: 20, versuchePraxis: 2 });
if (Math.round((mit35.gesamt - mit20.gesamt) * 100) !== 15 * 65 * 100 || mit20.sonderfahrten !== 12) {
  throw new Error('Führerschein: Beispiel widerspricht dem Modul');
}

const guideHtml = `
<h3>Was die Fahrschule berechnet</h3>
<p>Die Preise legt jede Fahrschule selbst fest. § 32 des Fahrlehrergesetzes verpflichtet sie aber, einen Preisaushang zu führen, der für jede Klasse dieselben Posten nennt: den Grundbetrag für den theoretischen Unterricht und die allgemeinen Aufwendungen, die Vorstellungsentgelte für die theoretische und die praktische Prüfung, das Entgelt für eine Fahrstunde zu 45 Minuten und das für die besonderen Ausbildungsfahrten. Genau diese Felder fragt der Rechner ab – Sie können die Preisliste Ihrer Fahrschule also Zeile für Zeile übertragen und mehrere Schulen vergleichen.</p>

<h3>Die Pflichtfahrten nach Anlage 4 FahrschAusbO</h3>
<p>Unabhängig davon, wie schnell jemand lernt, schreibt die Fahrschüler-Ausbildungsordnung für Klasse B besondere Ausbildungsfahrten zu je ${MINUTEN_JE_AUSBILDUNGSFAHRT} Minuten vor (§ 5 Abs. 3 mit Anlage 4):</p>
<table>
<thead><tr><th>Ausbildungsfahrt</th><th>Anzahl</th></tr></thead>
<tbody>
<tr><td>Überland (Bundes- oder Landstraße)</td><td>${SONDERFAHRTEN_B.ueberland}</td></tr>
<tr><td>Autobahn oder Kraftfahrstraße</td><td>${SONDERFAHRTEN_B.autobahn}</td></tr>
<tr><td>Bei Dämmerung oder Dunkelheit</td><td>${SONDERFAHRTEN_B.dunkelheit}</td></tr>
<tr><td><strong>Zusammen</strong></td><td><strong>${sonder}</strong></td></tr>
</tbody>
</table>
<p>Das sind Mindestanforderungen (§ 5 Abs. 6 FahrschAusbO). Die Übungsstunden der Grundausbildung kommen hinzu; wie viele es werden, entscheidet der Ausbildungsstand – dafür gibt es keine gesetzliche Zahl.</p>

<h3>Die amtlichen Gebühren</h3>
<p>Für Prüfung und Erteilung gelten bundeseinheitliche Sätze aus der Gebührenordnung für Maßnahmen im Straßenverkehr (GebOSt):</p>
<table>
<thead><tr><th>Gebühr</th><th>GebOSt-Nr.</th><th>Satz</th><th>mit 19 % USt</th></tr></thead>
<tbody>
<tr><td>Theoretische Prüfung, am PC</td><td>401.1, 401.3</td><td>${eur(gebNetto.theorie)}</td><td>${eur(geb.theorie)}</td></tr>
<tr><td>Praktische Prüfung Klasse B</td><td>402.3</td><td>${eur(gebNetto.praxis)}</td><td>${eur(geb.praxis)}</td></tr>
<tr><td>Erteilung der Fahrerlaubnis</td><td>202.1</td><td>${eur(GEBUEHREN.erteilung)}</td><td>–</td></tr>
</tbody>
</table>
<p>Die Prüfstelle darf nach § 1 Abs. 3 GebOSt die Umsatzsteuer hinzurechnen, wenn die Prüfung ihr unterliegt; der Rechner rechnet sie deshalb standardmäßig ein. Fällt eine Prüfung ohne ausreichende Entschuldigung aus, wird die volle Gebühr erhoben. Jede Wiederholung kostet die Prüfgebühr erneut – und bei der Fahrschule in aller Regel auch das Vorstellungsentgelt.</p>

<h3>Wo die Kosten tatsächlich entstehen</h3>
<p>Ein Rechenbeispiel mit einer <em>angenommenen</em> Preisliste (Grundbetrag 400 €, Übungsstunde 65 €, Sonderfahrt 80 €, Vorstellung 50 € und 180 €, Sonstiges 100 €): Mit 20 Übungsstunden kommen ${eur0(mit20.gesamt)} zusammen, davon nur ${eur(mit20.posten.amtlich)} amtliche Gebühren. Jede weitere Übungsstunde kostet den vollen Stundensatz – 35 statt 20 Stunden machen ${eur0(mit35.gesamt)}. Eine zweite praktische Prüfung erhöht die Summe auf ${eur0(mitWiederholung.gesamt)}.</p>
<p>Die amtlichen Gebühren machen also nur einen kleinen Teil aus. Den Unterschied zwischen zwei Fahrschulen bestimmen der Stundensatz und die Zahl der Übungsstunden.</p>

<h3>Was außerdem nötig ist</h3>
<p>Wer die Fahrerlaubnis beantragt, braucht einen Sehtest bei einer amtlich anerkannten Sehteststelle (§ 12 Abs. 2 FeV) und den Nachweis einer Schulung in Erster Hilfe mit mindestens neun Unterrichtseinheiten zu je 45 Minuten (§ 19 Abs. 1 FeV). Deren Preise und die für Lichtbild und Lernmaterial sind nicht geregelt – tragen Sie sie unter „Sonstiges“ ein.</p>
`;

const faqs = [
  { q: 'Wie viele Fahrstunden sind Pflicht?', a: `Vorgeschrieben sind nur die ${sonder} besonderen Ausbildungsfahrten für Klasse B: ${SONDERFAHRTEN_B.ueberland} Überland-, ${SONDERFAHRTEN_B.autobahn} Autobahn- und ${SONDERFAHRTEN_B.dunkelheit} Fahrten bei Dämmerung oder Dunkelheit zu je 45 Minuten (§ 5 Abs. 3 und Anlage 4 FahrschAusbO). Die Zahl der übrigen Übungsstunden legt das Gesetz nicht fest.` },
  { q: 'Was kosten Theorie- und Fahrprüfung?', a: `Die theoretische Prüfung am PC kostet ${eur(gebNetto.theorie)} (GebOSt Nr. 401.1 und 401.3), die praktische Prüfung Klasse B ${eur(gebNetto.praxis)} (Nr. 402.3), jeweils zuzüglich Umsatzsteuer, sofern die Prüfstelle sie erhebt – also ${eur(geb.theorie)} und ${eur(geb.praxis)}. Hinzu kommt das Vorstellungsentgelt der Fahrschule.` },
  { q: 'Was kostet die Fahrerlaubnis bei der Behörde?', a: `Die Erteilung kostet nach GebOSt Nr. 202.1 ${eur(GEBUEHREN.erteilung)}. Wird eine anlassbezogene Eignungsbegutachtung nötig, kommen weitere Gebühren hinzu.` },
  { q: 'Wie lange ist der Führerschein gültig?', a: 'Führerscheine, die ab dem 19. Januar 2013 ausgestellt werden, sind 15 Jahre gültig (§ 24a Abs. 1 FeV). Befristet ist das Dokument, nicht die Fahrerlaubnis – eine neue Prüfung ist beim Umtausch nicht nötig.' },
  { q: 'Woher bekomme ich die Preise meiner Fahrschule?', a: 'Aus ihrem Preisaushang. § 32 FahrlG verpflichtet Fahrschulen, die Entgelte je Klasse anzugeben – Grundbetrag, Fahrstunde, besondere Ausbildungsfahrten und Vorstellung zur Prüfung – und das auch in Werbung mit Preisangaben.' },
];
---
<Layout
  title={`Führerschein-Kosten ${year}`}
  description="Kosten für den Führerschein Klasse B aus der Preisliste der eigenen Fahrschule – mit den Pflichtfahrten nach FahrschAusbO und den amtlichen Gebühren nach GebOSt."
  canonicalPath="/auto/fuehrerschein-kosten/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto &amp; Mobilität</a>
    <h1>Führerschein-Kosten {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Übertragen Sie die Preisliste Ihrer Fahrschule: Der Rechner addiert die Pflichtfahrten nach der Fahrschüler-Ausbildungsordnung und die amtlichen Prüfungs- und Erteilungsgebühren – für Klasse B."
    sourceNote={`Besondere Ausbildungsfahrten nach § 5 Abs. 3 und Anlage 4 FahrschAusbO; Gebühren nach GebOSt Nr. 202.1, 401.1, 401.3 und 402.3, Umsatzsteuer nach § 1 Abs. 3 GebOSt; Preisaushang nach § 32 FahrlG (abgerufen am 15.09.2026). Die Fahrschulpreise sind Ihre Eingaben.`}
    explanation={`Gesamt = Grundbetrag + Übungsstunden × Preis + ${sonder} Sonderfahrten × Preis + Vorstellungsentgelte + amtliche Gebühren + Sonstiges. Wiederholungen zählen Prüfgebühr und Vorstellungsentgelt erneut.`}
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="grundbetrag">Grundbetrag (€)</label>
          <input type="number" id="grundbetrag" min="0" max="3000" value="400" step="10" />
        </div>
        <div class="calc-group">
          <label for="preisUebungsstunde">Preis je Übungsstunde, 45 min (€)</label>
          <input type="number" id="preisUebungsstunde" min="0" max="200" value="65" step="1" />
        </div>
        <div class="calc-group">
          <label for="uebungsstunden">Übungsstunden ohne Sonderfahrten</label>
          <input type="number" id="uebungsstunden" min="0" max="100" value="20" step="1" />
        </div>
        <div class="calc-group">
          <label for="preisSonderfahrt">Preis je Sonderfahrt, 45 min (€)</label>
          <input type="number" id="preisSonderfahrt" min="0" max="200" value="80" step="1" />
        </div>
        <div class="calc-group">
          <label for="vorstellungTheorie">Vorstellung Theorieprüfung (€)</label>
          <input type="number" id="vorstellungTheorie" min="0" max="500" value="50" step="5" />
        </div>
        <div class="calc-group">
          <label for="vorstellungPraxis">Vorstellung praktische Prüfung (€)</label>
          <input type="number" id="vorstellungPraxis" min="0" max="1000" value="180" step="5" />
        </div>
        <div class="calc-group">
          <label for="sonstiges">Sonstiges: Sehtest, Erste Hilfe, Foto, Lernmaterial (€)</label>
          <input type="number" id="sonstiges" min="0" max="2000" value="100" step="5" />
        </div>
        <div class="calc-group">
          <label for="versuchePraxis">Anläufe praktische Prüfung</label>
          <select id="versuchePraxis">
            <option value="1" selected>1</option>
            <option value="2">2</option>
            <option value="3">3</option>
          </select>
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Gesamtkosten Klasse B</div>
        <div id="kosten">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:0.35rem 1.5rem;flex-wrap:wrap;"></div>
      <p style="margin-top:0.5rem;font-size:0.82rem;color:#777;">Vorbelegt ist eine angenommene Preisliste – ersetzen Sie die Werte durch die Ihrer Fahrschule.</p>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Was der Führerschein kostet – und was davon festgelegt ist"
    content={guideHtml}
    relatedSlugs={['kfz-versicherung-rechner', 'kfz-steuer-rechner', 'km-kostenrechner']}
  />
</Layout>

<script type="module">
const { berechneFuehrerschein } = await import(window.__base + 'scripts/fuehrerschein.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
const felder = ['grundbetrag', 'preisUebungsstunde', 'uebungsstunden', 'preisSonderfahrt', 'vorstellungTheorie', 'vorstellungPraxis', 'sonstiges'];
function berechne() {
  const r = berechneFuehrerschein({
    ...Object.fromEntries(felder.map((id) => [id, wert(id)])),
    versuchePraxis: wert('versuchePraxis'),
  });
  document.getElementById('kosten').textContent = eur(r.gesamt);
  document.getElementById('details').innerHTML = [
    `<span>Fahrschule: <strong>${eur(r.fahrschule)}</strong> (${r.anteilFahrschule} %)</span>`,
    `<span>davon ${r.sonderfahrten} Pflicht-Sonderfahrten: <strong>${eur(r.posten.sonderfahrten)}</strong></span>`,
    `<span>Fahrstunden insgesamt: <strong>${r.fahrstundenGesamt}</strong></span>`,
    `<span>Amtliche Gebühren: <strong>${eur(r.posten.amtlich)}</strong></span>`,
  ].join('');
}
[...felder, 'versuchePraxis'].forEach((id) => document.getElementById(id).addEventListener('input', berechne));
document.getElementById('versuchePraxis').addEventListener('change', berechne);
berechne();
</script>
