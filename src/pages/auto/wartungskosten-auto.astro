---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelGebrauchtwagen from '../../components/artikel/gebrauchtwagen-alter-kosten.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import { HU_ERSTE_NACH_MONATEN, HU_ABSTAND_MONATE } from '../../../public/scripts/wartungskosten.js';
const calc = CALCULATORS.find(c => c.slug === 'wartungskosten-auto')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Wartungskosten Auto ${year} – Werkstattkosten pro Kilometer aus den eigenen Rechnungen`}
  description="Inspektion, Hauptuntersuchung, Reifen und Bremsen mit ihren Intervallen auf Jahr, Monat und Kilometer umlegen – mit Beträgen aus Ihren eigenen Rechnungen."
  canonicalPath="/auto/wartungskosten-auto/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto &amp; Mobilität</a>
    <h1>Wartungskosten Auto {year} – Werkstattkosten pro Kilometer</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Was kostet die Werkstatt Ihres Autos im Jahr, im Monat und je Kilometer? Tragen Sie Beträge und Intervalle aus Ihren Rechnungen und dem Serviceheft ein – der Rechner legt jeden Posten danach um, ob zuerst die Kilometer oder die Zeit erreicht sind."
    sourceNote={`Keine Durchschnittswerte: Beträge und Intervalle sind Ihre Eingaben, die voreingestellten Zahlen nur Beispiele. Intervall der Hauptuntersuchung für Pkw nach Anlage VIII Nr. 2.1.2.1 StVZO: erstmals nach ${HU_ERSTE_NACH_MONATEN}, danach alle ${HU_ABSTAND_MONATE} Monate (abgerufen am 14.09.2026).`}
    explanation="Jeder Posten wird so oft im Jahr fällig, wie es sein Kilometer- oder sein Zeitintervall verlangt – maßgeblich ist das, was zuerst erreicht wird. Kosten je Jahr = Betrag × Fälligkeiten je Jahr; Kosten je Kilometer = Summe ÷ Jahresfahrleistung."
    faqs={[
      {
        q: "Wie oft muss ein Auto zur Hauptuntersuchung?",
        a: `Ein Pkw erstmals ${HU_ERSTE_NACH_MONATEN} Monate nach der Erstzulassung, danach alle ${HU_ABSTAND_MONATE} Monate (Anlage VIII Nr. 2.1.2.1 StVZO).`
      },
      {
        q: "Warum sinken die Kosten pro Kilometer, je mehr ich fahre?",
        a: "Weil ein Teil der Posten nach Zeit fällig wird: die Hauptuntersuchung und bei vielen Herstellern die Inspektion, wenn das Kilometerintervall nicht vorher erreicht ist. Diese Kosten verteilen sich bei höherer Fahrleistung auf mehr Kilometer."
      },
      {
        q: "Wo finde ich die Intervalle für Inspektion und Verschleißteile?",
        a: "Im Serviceheft oder in der Betriebsanleitung Ihres Fahrzeugs, bei Verschleißteilen wie Reifen und Bremsen am besten aus Ihren eigenen Rechnungen: Kilometerstand beim letzten und vorletzten Wechsel."
      },
      {
        q: "Warum schätzt der Rechner keine Werte nach Fahrzeugklasse?",
        a: "Weil es dafür keine belastbare Quelle gibt. Werkstattpreise hängen an Modell, Region und Werkstatt. Frühere Fassungen dieser Seite rechneten mit Klassenwerten und einem Altersfaktor ohne Beleg; mit Ihren eigenen Rechnungen ist das Ergebnis genauer."
      },
      {
        q: "Wie berücksichtige ich unvorhergesehene Reparaturen?",
        a: "Über den Posten „Rücklage für Reparaturen\": ein Jahresbetrag, den Sie selbst festlegen – etwa aus den Reparaturen der vergangenen Jahre."
      },
      {
        q: "Wie unterscheidet sich dieser Rechner vom KM-Kostenrechner?",
        a: "Der KM-Kostenrechner betrachtet die Vollkosten pro Kilometer inklusive Sprit, Versicherung, Steuer und Wertverlust. Dieser Rechner isoliert den Werkstatt- und Verschleißanteil."
      }
    ]}
  >
    <div class="calc-form">
      <div class="calc-group">
        <label>Jahresfahrleistung – Schnellauswahl</label>
        <div class="presets">
          <button type="button" class="preset-btn" data-km="5000">5.000 km</button>
          <button type="button" class="preset-btn" data-km="10000">10.000 km</button>
          <button type="button" class="preset-btn active" data-km="15000">15.000 km</button>
          <button type="button" class="preset-btn" data-km="25000">25.000 km</button>
          <button type="button" class="preset-btn" data-km="40000">40.000 km</button>
        </div>
      </div>
      <div class="calc-grid">
        <div class="calc-group">
          <label for="km">Fahrleistung (km/Jahr)</label>
          <input type="number" id="km" min="0" max="200000" value="15000" step="1000" />
        </div>
      </div>
      <p class="hinweis">Beispielwerte – ersetzen Sie sie durch die Beträge aus Ihren Rechnungen. Ein leeres Intervall zählt nicht.</p>
      <div class="posten-tabelle">
        <div class="posten-kopf"><span>Posten</span><span>Betrag €</span><span>alle km</span><span>alle Monate</span></div>
        <div class="posten-zeile" data-name="Inspektion"><span>Inspektion</span><input type="number" min="0" placeholder="Betrag €" value="400" aria-label="Inspektion Betrag" /><input type="number" min="0" placeholder="alle km" value="30000" aria-label="Inspektion Kilometerintervall" /><input type="number" min="0" placeholder="alle Monate" value="24" aria-label="Inspektion Zeitintervall" /></div>
        <div class="posten-zeile" data-name="Hauptuntersuchung"><span>Hauptuntersuchung</span><input type="number" min="0" placeholder="Betrag €" value="150" aria-label="Hauptuntersuchung Betrag" /><input type="number" min="0" placeholder="alle km" value="" aria-label="Hauptuntersuchung Kilometerintervall" /><input type="number" min="0" placeholder="alle Monate" value={HU_ABSTAND_MONATE} aria-label="Hauptuntersuchung Zeitintervall" /></div>
        <div class="posten-zeile" data-name="Reifensatz"><span>Reifensatz</span><input type="number" min="0" placeholder="Betrag €" value="600" aria-label="Reifen Betrag" /><input type="number" min="0" placeholder="alle km" value="40000" aria-label="Reifen Kilometerintervall" /><input type="number" min="0" placeholder="alle Monate" value="" aria-label="Reifen Zeitintervall" /></div>
        <div class="posten-zeile" data-name="Bremsen"><span>Bremsen</span><input type="number" min="0" placeholder="Betrag €" value="350" aria-label="Bremsen Betrag" /><input type="number" min="0" placeholder="alle km" value="60000" aria-label="Bremsen Kilometerintervall" /><input type="number" min="0" placeholder="alle Monate" value="" aria-label="Bremsen Zeitintervall" /></div>
        <div class="posten-zeile" data-name="Rücklage für Reparaturen"><span>Rücklage Reparaturen</span><input type="number" min="0" placeholder="Betrag €" value="300" aria-label="Rücklage Betrag" /><input type="number" min="0" placeholder="alle km" value="" aria-label="Rücklage Kilometerintervall" /><input type="number" min="0" placeholder="alle Monate" value="12" aria-label="Rücklage Zeitintervall" /></div>
      </div>
      <div class="calc-result">
        <div class="label">Werkstattkosten pro Kilometer</div>
        <div id="proKm">— ct</div>
      </div>
      <div class="breakdown" id="breakdown"></div>
    </div>

    <ArtikelGebrauchtwagen slot="artikel" />
  </CalculatorShell>
</Layout>

<style>
.posten-tabelle { display: grid; gap: 0.35rem; margin: 0.5rem 0 1rem; }
.posten-kopf, .posten-zeile {
  display: grid;
  grid-template-columns: minmax(7rem, 1.4fr) repeat(3, minmax(0, 1fr));
  gap: 0.4rem;
  align-items: center;
}
.posten-kopf { font-size: 0.75rem; font-weight: 600; color: var(--text-light); }
@media (max-width: 480px) {
  .posten-kopf { display: none; }
  .posten-zeile { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 0.4rem; }
  .posten-zeile span { grid-column: 1 / -1; font-weight: 600; }
}
.posten-zeile span { font-size: 0.85rem; }
.posten-zeile input {
  width: 100%;
  min-width: 0;
  padding: 0.35rem 0.4rem;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
}
.presets {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.5rem;
}
.preset-btn {
  padding: 0.4rem 0.85rem;
  background: var(--bg);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-family: var(--font-ui);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text);
  transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.preset-btn:hover { border-color: var(--cat-color, var(--red)); }
.preset-btn.active {
  border-color: var(--cat-color, var(--red));
  background: color-mix(in srgb, var(--cat-color, var(--red)) 8%, white);
  color: var(--cat-color, var(--red));
}
.breakdown {
  margin-top: 1rem;
  display: grid;
  gap: 0.4rem;
}
.breakdown-row {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  font-size: 0.9rem;
  padding: 0.35rem 0;
  border-bottom: 1px solid var(--border);
}
.breakdown-row.total {
  border-bottom: 2px solid var(--cat-color, var(--red));
  font-size: 1rem;
}
.hinweis {
  margin-top: 0.75rem;
  font-size: 0.85rem;
  color: var(--text-light);
}
</style>

<script type="module">
const { berechneWartungskosten } = await import(window.__base + 'scripts/wartungskosten.js');

const euro = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
const zahl = (el) => parseFloat(el.value) || 0;

function berechne() {
  const posten = [...document.querySelectorAll('.posten-zeile')].map((zeile) => {
    const [betrag, alleKm, alleMonate] = zeile.querySelectorAll('input');
    return { name: zeile.dataset.name, betrag: zahl(betrag), alleKm: zahl(alleKm), alleMonate: zahl(alleMonate) };
  });
  const r = berechneWartungskosten({ kmProJahr: zahl(document.getElementById('km')), posten });

  document.getElementById('proKm').textContent = r.centProKm === null
    ? '— ct/km'
    : r.centProKm.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' ct/km';
  const zeilen = r.posten.map((p) =>
    `<div class="breakdown-row"><span>${p.name} (${p.haeufigkeit.toLocaleString('de-DE', { maximumFractionDigits: 2 })}× im Jahr)</span><strong>${euro(p.proJahr)}</strong></div>`);
  zeilen.push(`<div class="breakdown-row total"><span>Gesamt pro Jahr</span><strong>${euro(r.gesamtProJahr)}</strong></div>`);
  zeilen.push(`<div class="breakdown-row"><span>Gesamt pro Monat</span><strong>${euro(r.gesamtProMonat)}</strong></div>`);
  document.getElementById('breakdown').innerHTML = zeilen.join('');
}

document.querySelectorAll('.preset-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('km').value = btn.dataset.km;
    berechne();
  });
});
document.getElementById('km').addEventListener('input', () => {
  document.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('active'));
  berechne();
});
document.querySelectorAll('.posten-zeile input').forEach((el) => el.addEventListener('input', berechne));
berechne();
</script>
