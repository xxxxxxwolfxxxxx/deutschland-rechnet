---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  LADESTROM_HEIM_CENT_PRO_KWH,
  LADESTROM_HEIM_EURO_PRO_KWH,
  LADESTROM_AC_CENT_PRO_KWH,
  LADESTROM_QUELLE,
} from '../../../public/scripts/strompreis.js';
import { corsaElektro, ADAC_STROMPREIS, ADAC_STAND, adacVerbrauchJe100km } from '../../../public/scripts/adac-autokosten.js';
import { berechneLeasingkosten } from '../../../public/scripts/eauto-leasing.js';
import { ELEKTRO_BEFREIUNG } from '../../../public/scripts/kfz-steuer.js';
const datum = (s: string) => s.split('-').reverse().join('.');
const calc = CALCULATORS.find(c => c.slug === 'e-auto-leasing-kostenrechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

const eur = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const eur0 = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const pz = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
const ct = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });

// Verbrauch des Corsa Electric aus der ADAC Autokostenübersicht – derselbe
// Wert, mit dem der TCO-Rechner vorbelegt ist.
const VERBRAUCH = Math.round(adacVerbrauchJe100km(corsaElektro, ADAC_STROMPREIS) * 10) / 10;

// Zwei ausgedachte Angebote für dasselbe Auto, ausdrücklich als Beispiel
// gekennzeichnet: gleiche Rate, einmal mit Sonderzahlung.
const beispiel = {
  listenpreis: 40000, rate: 299, laufzeitMonate: 36, sonderzahlung: 0, ueberfuehrung: 1000,
  vertragsKmJahr: 10000, erwarteteKmJahr: 10000, mehrKmSatz: 0.1,
  verbrauchJe100km: VERBRAUCH, strompreis: LADESTROM_HEIM_EURO_PRO_KWH,
};
const ohneSonder = berechneLeasingkosten(beispiel);
const mitSonder = berechneLeasingkosten({ ...beispiel, sonderzahlung: 5000 });
const mehrKm = berechneLeasingkosten({ ...beispiel, erwarteteKmJahr: 15000 });
const oeffentlich = berechneLeasingkosten({ ...beispiel, strompreis: LADESTROM_AC_CENT_PRO_KWH / 100 });
if (ohneSonder.leasingfaktor !== mitSonder.leasingfaktor || !(mitSonder.gesamtkostenfaktor > ohneSonder.gesamtkostenfaktor)) {
  throw new Error('Leasing: Sonderzahlung muss nur den Gesamtkostenfaktor erhöhen');
}

const guideHtml = `
<h3>Der Leasingfaktor – und warum er allein nicht reicht</h3>
<p>Die Monatsrate steht im Angebot; berechnen lässt sie sich nicht. Um Angebote für unterschiedlich teure Autos vergleichbar zu machen, ist der <strong>Leasingfaktor</strong> gebräuchlich: Monatsrate geteilt durch den Bruttolistenpreis, mal 100. Er ist keine gesetzlich definierte Größe, sondern eine Vergleichszahl. Wichtig ist der Bezug: Er gilt je <em>Monat</em>. Eine Rate von 299 € für ein Auto mit 40.000 € Listenpreis ergibt ${pz(ohneSonder.leasingfaktor)}.</p>
<p>Der Leasingfaktor lässt sich schönen – mit einer Sonderzahlung. Dasselbe Angebot mit 5.000 € Sonderzahlung hat denselben Leasingfaktor von ${pz(mitSonder.leasingfaktor)}, kostet über 36 Monate aber ${eur0(mitSonder.vertragskosten - ohneSonder.vertragskosten)} mehr. Der <strong>Gesamtkostenfaktor</strong> legt Sonderzahlung und Überführung auf die Laufzeit um: ${pz(ohneSonder.gesamtkostenfaktor)} gegen ${pz(mitSonder.gesamtkostenfaktor)}. Vergleichen Sie Angebote deshalb mit dem Gesamtkostenfaktor.</p>

<h3>Kilometer: der zweite Kostenblock</h3>
<p>Beim Kilometerleasing ist eine Jahresfahrleistung vereinbart. Wer mehr fährt, zahlt je Mehrkilometer den Satz aus dem Vertrag. Ob und bis zu welcher Grenze Minderkilometer vergütet werden, regelt ebenfalls der Vertrag – der Rechner setzt sie vorsichtshalber nicht an. Im Beispiel kosten 15.000 statt 10.000 km im Jahr bei 0,10 € je Kilometer ${eur0(mehrKm.mehrKmKosten)} Nachzahlung am Vertragsende. Ist absehbar, dass Sie mehr fahren, ist ein Vertrag mit höherer Fahrleistung meist die bessere Wahl – vergleichen lässt sich das, indem Sie beide Angebote nacheinander eintragen.</p>

<h3>Stromkosten: Wo Sie laden, entscheidet</h3>
<p>Der Rechner rechnet den Strom über die erwartete Fahrleistung. Vorbelegt ist der Verbrauch des ${corsaElektro.name} von ${VERBRAUCH.toLocaleString('de-DE')} kWh je 100 km aus der ADAC Autokostenübersicht ${ADAC_STAND} und der Haushaltsstrompreis von ${ct(LADESTROM_HEIM_CENT_PRO_KWH)} ct/kWh. Wer statt zu Hause an öffentlichen Normalladesäulen lädt (im Schnitt ${ct(LADESTROM_AC_CENT_PRO_KWH)} ct/kWh nach ${LADESTROM_QUELLE}), zahlt im Beispiel über drei Jahre ${eur0(oeffentlich.stromkosten)} statt ${eur0(ohneSonder.stromkosten)}.</p>

<h3>Was im Rechner fehlt</h3>
<p>Versicherung, Wartung und Reifen sind nur dann in der Rate enthalten, wenn das Angebot sie ausdrücklich einschließt – sonst kommen sie hinzu. Ebenfalls nicht enthalten sind Kosten für Schäden, die bei Rückgabe über normale Gebrauchsspuren hinausgehen, und eine Wallbox.</p>
`;

const faqs = [
  { q: 'Wie berechnet sich der Leasingfaktor?', a: `Monatsrate ÷ Bruttolistenpreis × 100. Er bezieht sich auf einen Monat, nicht auf ein Jahr: 299 € Rate bei 40.000 € Listenpreis ergeben ${pz(ohneSonder.leasingfaktor)}. Eine gesetzliche Definition gibt es nicht; die Zahl dient nur dem Vergleich von Angeboten.` },
  { q: 'Was ist der Gesamtkostenfaktor?', a: 'Er rechnet Sonderzahlung und Überführungskosten gleichmäßig auf die Monate um und teilt dann durch den Listenpreis. Anders als der Leasingfaktor steigt er, wenn ein Angebot die Rate mit einer hohen Sonderzahlung drückt.' },
  { q: 'Was kosten Mehrkilometer?', a: 'So viel, wie der Vertrag je Kilometer festlegt. Tragen Sie den Satz aus Ihrem Angebot ein; der Rechner multipliziert ihn mit der Differenz aus erwarteter und vereinbarter Fahrleistung über die Laufzeit.' },
  { q: 'Muss ich für ein geleastes E-Auto Kfz-Steuer zahlen?', a: `Reine Elektroautos sind nach § 3d KraftStG ${ELEKTRO_BEFREIUNG.jahre} Jahre ab Erstzulassung befreit, sofern die Erstzulassung bis zum ${datum(ELEKTRO_BEFREIUNG.zulassungBis)} erfolgt, längstens bis zum ${datum(ELEKTRO_BEFREIUNG.spaetestensBis)}. Die Befreiung knüpft an das Fahrzeug und seine Erstzulassung an, nicht daran, ob es gekauft oder geleast wurde.` },
];
---
<Layout
  title={`E-Auto Leasing Kostenrechner ${year}`}
  description="Was ein E-Auto-Leasingvertrag wirklich kostet: Leasingfaktor, Gesamtkostenfaktor, Mehrkilometer und Stromkosten aus dem eigenen Angebot berechnen."
  canonicalPath="/auto/e-auto-leasing-kostenrechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto &amp; Mobilität</a>
    <h1>E-Auto Leasing Kostenrechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Tragen Sie die Werte aus Ihrem Leasingangebot ein. Der Rechner zeigt Leasingfaktor und Gesamtkostenfaktor zum Vergleich von Angeboten und rechnet Mehrkilometer und Strom zu den Gesamtkosten dazu."
    sourceNote={`Leasingfaktor = Rate ÷ Bruttolistenpreis × 100; Gesamtkostenfaktor zusätzlich mit (Sonderzahlung + Überführung) ÷ Laufzeit – gebräuchliche Vergleichszahlen, keine Rechtsgrößen. Vertragswerte sind Ihre Eingaben. Vorbelegter Verbrauch: ADAC Autokostenübersicht ${ADAC_STAND} (${corsaElektro.name}); Strompreis ${ct(LADESTROM_HEIM_CENT_PRO_KWH)} ct/kWh aus der BDEW-Strompreisanalyse.`}
    explanation="Gesamtkosten = Rate × Laufzeit + Sonderzahlung + Überführung + Mehrkilometer × Satz + Stromkosten. Minderkilometer werden nicht gegengerechnet."
    faqs={faqs}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="listenpreis">Bruttolistenpreis (€)</label>
          <input type="number" id="listenpreis" min="0" max="300000" value={beispiel.listenpreis} step="500" />
        </div>
        <div class="calc-group">
          <label for="rate">Monatsrate (€)</label>
          <input type="number" id="rate" min="0" max="5000" value={beispiel.rate} step="1" />
        </div>
        <div class="calc-group">
          <label for="laufzeit">Laufzeit (Monate)</label>
          <input type="number" id="laufzeit" min="1" max="96" value={beispiel.laufzeitMonate} step="1" />
        </div>
        <div class="calc-group">
          <label for="sonderzahlung">Sonderzahlung (€)</label>
          <input type="number" id="sonderzahlung" min="0" max="100000" value={beispiel.sonderzahlung} step="100" />
        </div>
        <div class="calc-group">
          <label for="ueberfuehrung">Überführung und Zulassung (€)</label>
          <input type="number" id="ueberfuehrung" min="0" max="5000" value={beispiel.ueberfuehrung} step="10" />
        </div>
        <div class="calc-group">
          <label for="vertragsKm">Vereinbarte Fahrleistung (km/Jahr)</label>
          <input type="number" id="vertragsKm" min="0" max="100000" value={beispiel.vertragsKmJahr} step="1000" />
        </div>
        <div class="calc-group">
          <label for="erwarteteKm">Erwartete Fahrleistung (km/Jahr)</label>
          <input type="number" id="erwarteteKm" min="0" max="100000" value={beispiel.erwarteteKmJahr} step="1000" />
        </div>
        <div class="calc-group">
          <label for="mehrKmSatz">Mehrkilometer laut Vertrag (€/km)</label>
          <input type="number" id="mehrKmSatz" min="0" max="2" value={beispiel.mehrKmSatz} step="0.01" />
        </div>
        <div class="calc-group">
          <label for="verbrauch">Verbrauch (kWh/100 km)</label>
          <input type="number" id="verbrauch" min="0" max="50" value={VERBRAUCH} step="0.1" />
        </div>
        <div class="calc-group">
          <label for="strompreis">Strompreis (€/kWh)</label>
          <input type="number" id="strompreis" min="0" max="2" value={LADESTROM_HEIM_EURO_PRO_KWH} step="0.01" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">Gesamtkosten über die Laufzeit</div>
        <div id="gesamt">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#555;display:flex;gap:0.35rem 1.5rem;flex-wrap:wrap;"></div>
      <p style="margin-top:0.5rem;font-size:0.82rem;color:#777;">Vorbelegt ist ein angenommenes Angebot – ersetzen Sie die Vertragswerte durch Ihre.</p>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Leasingangebote richtig vergleichen"
    content={guideHtml}
    relatedSlugs={['leasing-rechner', 'elektroauto-tco-rechner', 'spritkosten-vergleich']}
  />
</Layout>

<script type="module">
const { berechneLeasingkosten } = await import(window.__base + 'scripts/eauto-leasing.js');
const eur = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const pz = (n) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
const wert = (id) => parseFloat(document.getElementById(id).value) || 0;
function berechne() {
  const r = berechneLeasingkosten({
    listenpreis: wert('listenpreis'), rate: wert('rate'), laufzeitMonate: wert('laufzeit'),
    sonderzahlung: wert('sonderzahlung'), ueberfuehrung: wert('ueberfuehrung'),
    vertragsKmJahr: wert('vertragsKm'), erwarteteKmJahr: wert('erwarteteKm'), mehrKmSatz: wert('mehrKmSatz'),
    verbrauchJe100km: wert('verbrauch'), strompreis: wert('strompreis'),
  });
  document.getElementById('gesamt').textContent = eur(r.gesamt);
  document.getElementById('details').innerHTML = [
    `<span>Leasingfaktor: <strong>${pz(r.leasingfaktor)}</strong></span>`,
    `<span>Gesamtkostenfaktor: <strong>${pz(r.gesamtkostenfaktor)}</strong></span>`,
    `<span>Vertrag: <strong>${eur(r.vertragskosten)}</strong></span>`,
    `<span>Mehrkilometer: <strong>${r.mehrKm.toLocaleString('de-DE')} km = ${eur(r.mehrKmKosten)}</strong></span>`,
    `<span>Strom: <strong>${eur(r.stromkosten)}</strong></span>`,
    `<span>Je Monat: <strong>${eur(r.jeMonat)}</strong></span>`,
    `<span>Je km: <strong>${r.jeKm.toLocaleString('de-DE', { minimumFractionDigits: 3 })} €</strong></span>`,
  ].join('');
}
document.querySelectorAll('.calc-form input').forEach((el) => el.addEventListener('input', berechne));
berechne();
</script>

<style>
.page-header { margin-bottom: 2rem; }
</style>
