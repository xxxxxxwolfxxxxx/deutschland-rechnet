---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
import {
  LADESTROM_HEIM_CENT_PRO_KWH,
  LADESTROM_HEIM_EURO_PRO_KWH,
  LADESTROM_AC_CENT_PRO_KWH,
  LADESTROM_DC_CENT_PRO_KWH,
  LADESTROM_ADHOC_AUTOBAHN_CENT_PRO_KWH,
  LADESTROM_ADHOC_AUTOBAHN_EURO_PRO_KWH,
  LADESTROM_QUELLE,
  LADEWEGE,
  ladekostenJe100km,
} from '../../../public/scripts/strompreis.js';
const calc = CALCULATORS.find(c => c.slug === 'elektroauto-tco-rechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();

const ct = (b: number) => b.toLocaleString('de-DE', { maximumFractionDigits: 1 });
const eur = (b: number) => b.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// Ladestrom ist kein einzelner Preis, sondern drei: Wer zu Hause lädt, zahlt
// seinen Haushaltstarif, wer unterwegs lädt, den Preis des Säulenbetreibers.
// Die Tabelle entsteht zur Buildzeit aus demselben Modul, mit dem der Rechner
// arbeitet – vorher nannte die Seite vier verschiedene Werte.
const EV_VERBRAUCH_KWH_JE_100KM = 20;
const ladewege = LADEWEGE.map(w => ({
  ...w,
  je100km: ladekostenJe100km({
    verbrauchKwhJe100km: EV_VERBRAUCH_KWH_JE_100KM,
    centProKwh: w.centProKwh,
  }),
}));
---
<Layout
  title={`Elektroauto TCO-Rechner ${year}`}
  description="Elektroauto vs. Benziner TCO berechnen – Gesamtkosten über 5-10 Jahre vergleichen."
  canonicalPath="/auto/elektroauto-tco-rechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}auto/`} class="back-link">← Auto & Mobilität</a>
    <h1>Elektroauto TCO-Rechner {year}</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Elektroauto TCO-Rechner vergleichen Sie die Gesamtkosten (Total Cost of Ownership) eines E-Autos mit einem vergleichbaren Benziner über 5-10 Jahre."
    sourceNote="Berechnung basiert auf aktuellen Strompreisen, Benzinpreisen und Wartungskosten."
    explanation="TCO (Total Cost of Ownership) berücksichtigt nicht nur den Kaufpreis, sondern auch Versicherung, Wartung, Sprit/Strom und Wertverlust."
    faqs={[
      { q: "Wann lohnt sich ein Elektroauto wirtschaftlich?", a: "Ab 10.000-15.000 km/Jahr ist ein E-Auto meist günstiger als ein Benziner über 8+ Jahre. Bei 5.000 km/Jahr rechnet es sich nicht." },
      { q: "Was kostet der Strom vs. Benzin?", a: "E-Auto: ca. 3-5€ pro 100 km (bei 20€/kWh). Benziner: ca. 8-10€ pro 100 km (bei 1,80€/Liter). E-Auto ist ca. 50% günstiger beim Betrieb." },
      { q: "Ist die Batterie ein Kostenfaktor?", a: "Batterien halten heute 10+ Jahre. Garantie meist 8 Jahre oder 160.000 km. Austausch kostet 5.000-10.000€, aber sehr selten nötig." },
      { q: "Wartungskosten E-Auto vs. Benziner?", a: "E-Auto: 100-150€/Jahr (Reifen, Inspektion). Benziner: 400-600€/Jahr (Öl, Filter, Zündkerzen, TÜV)." },
      { q: "Gibt es noch Förderungen?", a: "Die bundesweite Umweltprämie (BAFA) ist Ende 2023 ausgelaufen. 2026 gibt es je nach Bundesland und Kommune noch regionale Zuschüsse sowie vergünstigte KfW-Kredite für Wallboxen. Die größten geldwerten Vorteile liegen bei der Dienstwagenbesteuerung (0,25 % statt 1 %) und der Kfz-Steuerbefreiung." },
      { q: "Ist mein E-Auto von der Kfz-Steuer befreit?", a: "Reine Elektroautos, die bis zum 31.12.2025 erstmals zugelassen wurden, sind nach § 3d KraftStG bis längstens Ende 2030 von der Kfz-Steuer befreit. Für spätere Erstzulassungen gilt die Befreiung nach aktueller Rechtslage nicht automatisch – hier ist eine gesetzliche Verlängerung im politischen Gespräch, aber noch nicht final beschlossen." },
      { q: "Was bringt die THG-Quote?", a: "Halter reiner E-Autos können jährlich ihre Treibhausgasminderungsquote (THG-Quote) über einen Anbieter verkaufen. Die Prämie ist von anfänglich mehreren Hundert Euro stark gefallen und liegt 2026 meist nur noch bei etwa 25 bis 100 Euro pro Jahr, abhängig vom Zertifikatspreis." },
      { q: "Was kostet öffentliches Laden im Vergleich zu Hause?", a: `Zu Hause laden Sie zum Haushaltsstrompreis von ${ct(LADESTROM_HEIM_CENT_PRO_KWH)} ct/kWh. Öffentliches Normalladen (AC) kostet im Schnitt ${ct(LADESTROM_AC_CENT_PRO_KWH)} ct/kWh, Schnellladen (DC) ${ct(LADESTROM_DC_CENT_PRO_KWH)} ct/kWh. Ohne Vertrag an einem Autobahn-Schnelllader werden bis zu ${ct(LADESTROM_ADHOC_AUTOBAHN_CENT_PRO_KWH)} ct/kWh fällig. Unterwegs laden kostet also grob das Anderthalb- bis Zweifache – wer überwiegend zu Hause oder am Arbeitsplatz lädt, senkt die Energiekosten erheblich.` },
      { q: "Wie stark verliert ein E-Auto an Wert?", a: "Der Restwert ist stark modellabhängig. Gefragte Modelle mit guter Reichweite und aktueller Batterietechnik halten ihren Wert ähnlich gut wie Verbrenner. Ältere E-Autos mit kleiner Batterie verlieren dagegen überdurchschnittlich. Setzen Sie im Rechner einen realistischen Restwert für Ihr konkretes Modell an." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="ev_preis">E-Auto Kaufpreis (€)</label>
          <input type="number" id="ev_preis" min="20000" max="150000" value="40000" step="5000" />
        </div>
        <div class="calc-group">
          <label for="benziner_preis">Benziner Kaufpreis (€)</label>
          <input type="number" id="benziner_preis" min="15000" max="100000" value="35000" step="5000" />
        </div>
        <div class="calc-group">
          <label for="jahres_km">Jährliche Fahrtleistung (km)</label>
          <input type="number" id="jahres_km" min="1000" max="50000" value="12000" step="1000" />
        </div>
        <div class="calc-group">
          <label for="zeitraum">Zeitraum (Jahre)</label>
          <select id="zeitraum">
            <option value="5">5 Jahre</option>
            <option value="8" selected>8 Jahre</option>
            <option value="10">10 Jahre</option>
          </select>
        </div>
        <div class="calc-group">
          <label for="strompreis">Strompreis (€/kWh)</label>
          <input type="number" id="strompreis" min="0.15" max={LADESTROM_ADHOC_AUTOBAHN_EURO_PRO_KWH} value={LADESTROM_HEIM_EURO_PRO_KWH} step="0.01" />
        </div>
        <div class="calc-group">
          <label for="benzinpreis">Benzinpreis (€/Liter)</label>
          <input type="number" id="benzinpreis" min="1.5" max="2.5" value="1.85" step="0.05" />
        </div>
      </div>

      <div class="calc-result">
        <div class="label">E-Auto Gesamtkosten</div>
        <div id="ev_kosten">— €</div>
      </div>
      <div class="calc-result">
        <div class="label">Benziner Gesamtkosten</div>
        <div id="benziner_kosten">— €</div>
      </div>
      <div class="calc-result" style="background:#e8f5e9;">
        <div class="label">Ersparnis mit E-Auto</div>
        <div id="ersparnis">— €</div>
      </div>

      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Elektroauto vs. Verbrenner: Gesamtkosten im Vergleich"
    content={`<p>Die Entscheidung zwischen Elektroauto und Verbrenner ist mehr als eine Frage des Kaufpreises. Die <strong>Total Cost of Ownership (TCO)</strong> umfasst alle Kosten, die während der gesamten Nutzungsdauer eines Fahrzeugs anfallen: Anschaffung, Energie, Wartung, Versicherung, Steuern und Wertverlust. Nur wer alle Blöcke zusammenrechnet, erkennt, welches Antriebskonzept für das eigene Fahrprofil wirklich günstiger ist.</p>

<h4>TCO-Vergleich über 5 Jahre (Beispielrechnung)</h4>
<p>Die folgende Modellrechnung zeigt einen Mittelklassewagen bei 15.000 km pro Jahr über 5 Jahre (75.000 km gesamt), Heimladen zu ${eur(LADESTROM_HEIM_EURO_PRO_KWH)} Euro/kWh und Benzin zu 1,80 Euro/Liter. Die Werte sind Richtgrößen und ersetzen keine individuelle Kalkulation.</p>
<table>
  <thead>
    <tr><th>Kostenblock (5 Jahre)</th><th>Elektroauto</th><th>Benziner</th></tr>
  </thead>
  <tbody>
    <tr><td>Anschaffungspreis</td><td>42.000 €</td><td>33.000 €</td></tr>
    <tr><td>Energie (Strom bzw. Benzin)</td><td>ca. 4.990 €</td><td>ca. 9.450 €</td></tr>
    <tr><td>Wartung &amp; Verschleiß</td><td>ca. 750 €</td><td>ca. 2.750 €</td></tr>
    <tr><td>Kfz-Steuer</td><td>0 € (befreit)</td><td>ca. 600 €</td></tr>
    <tr><td>Versicherung</td><td>ca. 3.100 €</td><td>ca. 2.800 €</td></tr>
    <tr><td>THG-Prämie (Gutschrift)</td><td>ca. −300 €</td><td>–</td></tr>
    <tr><td>Restwert nach 5 Jahren</td><td>−21.000 €</td><td>−14.850 €</td></tr>
    <tr><td><strong>Gesamtkosten (TCO)</strong></td><td><strong>ca. 29.540 €</strong></td><td><strong>ca. 33.750 €</strong></td></tr>
  </tbody>
</table>
<p>Im Beispiel ist das E-Auto trotz höherem Kaufpreis über 5 Jahre rund <strong>4.200 Euro günstiger</strong> – vor allem wegen niedriger Energie- und Wartungskosten. Bei geringer Fahrleistung oder teurem Ladestrom kann sich das Bild umkehren.</p>

<h4>Anschaffung, Kfz-Steuer und Dienstwagenvorteil</h4>
<p>Elektroautos haben meist einen höheren Listenpreis als vergleichbare Verbrenner. Dafür sind reine E-Autos mit Erstzulassung bis 31.12.2025 nach § 3d KraftStG bis längstens Ende 2030 von der <strong>Kfz-Steuer</strong> befreit. Dienstwagenfahrer profitieren zusätzlich: Für die private Nutzung werden nur 0,25 % des Bruttolistenpreises pro Monat versteuert (bei Fahrzeugen bis 70.000 Euro), gegenüber 1 % beim Verbrenner. Eine bundesweite Kaufprämie gibt es seit Ende 2023 nicht mehr, wohl aber regionale Zuschüsse einzelner Länder und Kommunen.</p>

<h4>Energiekosten: Heimladen schlägt öffentliches Laden</h4>
<p>Die laufenden Kosten machen den größten Unterschied – und sie hängen davon ab, wo geladen wird. Ein E-Auto mit ${EV_VERBRAUCH_KWH_JE_100KM} kWh je 100 km kostet auf denselben 100 Kilometern:</p>

<table>
  <thead>
    <tr><th>Ladeweg</th><th>Preis je kWh</th><th>Kosten je 100 km</th></tr>
  </thead>
  <tbody>
    ${ladewege.map(w => `<tr><td>${w.label}</td><td>${ct(w.centProKwh)} ct</td><td>${eur(w.je100km)} Euro</td></tr>`).join('')}
  </tbody>
</table>

<p>Ein Benziner mit 7 Litern kommt bei 1,80 Euro/Liter auf 12,60 Euro pro 100 km. Zu Hause geladen fährt das E-Auto also für etwa die Hälfte, am Schnelllader schmilzt der Vorteil auf wenige Euro. Ladepreise nach ${LADESTROM_QUELLE}.</p>

<h4>Wartung, Versicherung und Restwert</h4>
<p>E-Autos haben spürbar geringere <strong>Wartungskosten</strong>: Ölwechsel, Zahnriemen, Auspuff und Kupplung entfallen, und die Bremsbeläge halten dank Rekuperation zwei- bis dreimal so lange. Laut ADAC liegen die jährlichen Wartungskosten bei etwa 100–200 Euro, Verbrenner bei 400–800 Euro. Die <strong>Versicherung</strong> ist mal günstiger, mal teurer – ein Vergleich lohnt. Der <strong>Restwert</strong> ist stark modellabhängig: Gefragte E-Modelle halten ihren Wert gut, ältere mit kleiner Batterie verlieren überdurchschnittlich.</p>

<h4>Praxistipp und THG-Quote</h4>
<p>Wer eine eigene <strong>Wallbox</strong> hat und überwiegend zu Hause oder am Arbeitsplatz lädt, spart am meisten – idealerweise mit dynamischem oder PV-Strom. Zusätzlich können Halter jährlich ihre <strong>THG-Quote</strong> verkaufen; die Prämie ist 2026 allerdings auf meist 25–100 Euro pro Jahr gesunken. Als Faustregel amortisiert sich ein E-Auto ab etwa 10.000–15.000 km Jahresfahrleistung innerhalb von rund 5–8 Jahren gegenüber einem vergleichbaren Benziner.</p>`}
    relatedSlugs={['spritkosten-vergleich', 'kfz-steuer-rechner', 'fahrtkosten-rechner', 'e-auto-leasing-kostenrechner']}
  />
</Layout>

<script type="module">
function berechne() {
  const ev_preis = parseFloat(document.getElementById('ev_preis').value)||40000;
  const benziner_preis = parseFloat(document.getElementById('benziner_preis').value)||35000;
  const jahres_km = parseFloat(document.getElementById('jahres_km').value)||12000;
  const zeitraum = parseInt(document.getElementById('zeitraum').value)||8;
  const strompreis = parseFloat(document.getElementById('strompreis').value)||0;
  const benzinpreis = parseFloat(document.getElementById('benzinpreis').value)||1.85;

  const gesamtKm = jahres_km * zeitraum;
  const ev_verbrauch = 0.20; // 20 kWh/100km
  const benziner_verbrauch = 0.07; // 7 Liter/100km
  const ev_betrieb = gesamtKm * ev_verbrauch * strompreis / 100;
  const benziner_betrieb = gesamtKm * benziner_verbrauch * benzinpreis / 100;

  const ev_wert = ev_preis * 0.50; // 50% Restwert nach zeitraum
  const benziner_wert = benziner_preis * 0.45; // 45% Restwert

  const ev_versicherung = 120 * zeitraum; // 120€/Jahr
  const benziner_versicherung = 150 * zeitraum; // 150€/Jahr

  const ev_wartung = 100 * zeitraum; // 100€/Jahr
  const benziner_wartung = 400 * zeitraum; // 400€/Jahr

  const ev_gesamt = ev_preis + ev_betrieb + ev_versicherung + ev_wartung - ev_wert;
  const benziner_gesamt = benziner_preis + benziner_betrieb + benziner_versicherung + benziner_wartung - benziner_wert;
  const ersparnis = benziner_gesamt - ev_gesamt;

  document.getElementById('ev_kosten').textContent = ev_gesamt.toLocaleString('de-DE', {minimumFractionDigits:2}) + ' €';
  document.getElementById('benziner_kosten').textContent = benziner_gesamt.toLocaleString('de-DE', {minimumFractionDigits:2}) + ' €';
  document.getElementById('ersparnis').textContent = Math.max(0, ersparnis).toLocaleString('de-DE', {minimumFractionDigits:2}) + ' €';

  const kosten_pro_km_ev = ev_gesamt / gesamtKm;
  const kosten_pro_km_benziner = benziner_gesamt / gesamtKm;

  document.getElementById('details').innerHTML = `
    <div>Gesamtfahrleistung: <strong>${gesamtKm.toLocaleString('de-DE')} km</strong></div>
    <div>E-Auto Kosten pro km: <strong>${kosten_pro_km_ev.toLocaleString('de-DE', {maximumFractionDigits:2})} €</strong></div>
    <div>Benziner Kosten pro km: <strong>${kosten_pro_km_benziner.toLocaleString('de-DE', {maximumFractionDigits:2})} €</strong></div>
  `;
}

['ev_preis','benziner_preis','jahres_km','zeitraum','strompreis','benzinpreis'].forEach(id =>
  document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>

<style>
.page-header { margin-bottom: 2rem; }
</style>
