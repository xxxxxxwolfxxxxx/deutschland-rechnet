---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import ArtikelInflation from '../../components/artikel/inflation-was-die-rate-verschweigt.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'inflationsrechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Inflationsrechner ${year}`}
  description="Kaufkraftverlust durch Inflation kostenlos berechnen. Zeigt den realen Wertverlust über beliebige Zeiträume."
  canonicalPath="/einheiten/inflationsrechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}einheiten/`} class="back-link">← Einheiten &amp; Mathe</a>
    <h1>Inflationsrechner {year} – Kaufkraftverlust berechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Inflationsrechner berechnen Sie den Kaufkraftverlust durch Inflation über beliebige Zeiträume. Erfahren Sie, wie viel Ihre Ersparnisse in der Zukunft noch wert sein werden und welchen realen Wertverlust Inflation verursacht. Dieses Wissen ist essenziell für Altersvorsorge, Sparplanung und Investitionsentscheidungen."
    sourceNote="2-3% pro Jahr."
    explanation="Die Berechnung nutzt die Formel Kaufkraft = Betrag / (1 + Inflationsrate) hoch Zeitraum, die den exponentiellen Effekt der Geldentwertung abbildet. Die Europäische Zentralbank strebt eine Inflationsrate von 2% an, was als preisstabil gilt. Über längere Zeiträume wirkt der Zinseszinseffekt jedoch erheblich: Bei 2% jährlicher Inflation verliert Geld in 35 Jahren die Hälfte seiner Kaufkraft."
    faqs={[
      { q: "Was ist Inflation und wie beeinflusst sie meine Ersparnisse?", a: "Inflation ist der kontinuierliche Anstieg der Preise für Waren und Dienstleistungen. Sie führt dazu, dass die gleiche Menge Geld mit der Zeit weniger wert wird. Wenn Sie 10.000€ sparen und die Inflation beträgt 2% pro Jahr, sind diese 10.000€ nächstes Jahr nur noch etwa 9.800€ wert." },
      { q: "Wie unterscheiden sich Nominalzins und Realzins?", a: "Der Nominalzins ist der Zinssatz, den Sie von Ihrer Bank erhalten. Der Realzins berücksichtigt die Inflation. Wenn Ihr Sparkonto 1% Nominalzins bietet, aber die Inflation 2% beträgt, ist Ihr Realzins negativ: Sie verlieren Kaufkraft." },
      { q: "Wie wirkt sich Inflation auf Mieten und Lebenshaltungskosten aus?", a: "Mieten und Lebenshaltungskosten steigen tendenziell mit der Inflation. Ein Mietvertrag mit 2% Steigerungsklausel folgt der Inflation. Ohne Anpassung würde Ihre Miete real sinken." },
      { q: "Ist eine Inflationsrate von 2% gut oder schlecht?", a: "Eine leichte Inflation von etwa 2% gilt als normal und gesund für eine stabile Wirtschaft. Sie fördert Investitionen und Konsum. Zu hohe Inflation (über 5%) ist problematisch und reduziert die Kaufkraft stark." },
      { q: "Wie schütze ich meine Ersparnisse vor Inflation?", a: "Sie können in Investitionen übergehen, die historisch über der Inflation Rendite bieten: Immobilien, Aktien, Anleihen mit Inflationsprämie oder Rohstoffe. Geldmarktkonten und kurzfristige Sparbriefe bieten aktuell oft Renditen, die zumindest die Inflation abdecken." },
      { q: "Gibt es eine Obergrenze für Inflation?", a: "Es gibt keine gesetzliche Obergrenze. Extreme Inflation (Hyperinflation) entsteht durch massive Geldmengensteigerung und führt zu Währungszerstörung. Die Europäische Zentralbank hat ein Ziel von ca. 2% Inflation." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-grid">
        <div class="calc-group">
          <label for="betrag">Betrag (€)</label>
          <input type="number" id="betrag" min="0" max="10000000" value="10000" step="100" />
        </div>
        <div class="calc-group">
          <label for="rate">Inflationsrate (%/Jahr)</label>
          <input type="number" id="rate" min="0" max="100" value="2.5" step="0.1" />
        </div>
        <div class="calc-group">
          <label for="jahre">Zeitraum (Jahre)</label>
          <input type="number" id="jahre" min="1" max="100" value="10" step="1" />
        </div>
      </div>
      <div class="calc-result">
        <div class="label">Kaufkraft nach <span id="jahre-label">10</span> Jahren</div>
        <div id="kaufkraft">— €</div>
      </div>
      <div id="details" style="margin-top:0.75rem;font-size:0.88rem;color:#666;display:flex;gap:1.5rem;flex-wrap:wrap;"></div>
    </div>

    <ArtikelInflation slot="artikel" />
  </CalculatorShell>
</Layout>

<script type="module">
const { berechneInflation } = await import(window.__base + 'scripts/inflation.js');
function fmt(n) { return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
function berechne() {
  const betrag = parseFloat(document.getElementById('betrag').value)||0;
  const rate = parseFloat(document.getElementById('rate').value)||0;
  const jahre = parseInt(document.getElementById('jahre').value)||1;
  const r = berechneInflation({ betrag, inflationsrateProzent: rate, jahre });
  document.getElementById('jahre-label').textContent = jahre;
  document.getElementById('kaufkraft').textContent = fmt(r.kaufkraftHeute);
  document.getElementById('details').innerHTML =
    `<span>Kaufkraftverlust: ${fmt(r.verlust)} (−${r.verlustProzent.toLocaleString('de-DE')} %)</span>` +
    `<span>Nominalbedarf heute: ${fmt(r.nominalHeute)}</span>`;
}
['betrag','rate','jahre'].forEach(id => document.getElementById(id).addEventListener('input', berechne));
berechne();
</script>
