---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CalculatorGuide from '../../components/CalculatorGuide.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';
const calc = CALCULATORS.find(c => c.slug === 'einheitenrechner')!;
const cat = CATEGORIES[calc.category];
const year = new Date().getFullYear();
---
<Layout
  title={`Einheitenrechner ${year}`}
  description="Länge, Gewicht, Temperatur und Volumen kostenlos umrechnen. Meter, Kilometer, Zoll, Pfund, Celsius, Fahrenheit und viele mehr."
  canonicalPath="/einheiten/einheitenrechner/"
  categoryColor={cat.color}
  categoryLight={cat.colorLight}
  categoryImage={cat.image}
>
  <div class="page-header">
    <a href={`${import.meta.env.BASE_URL}einheiten/`} class="back-link">← Einheiten &amp; Mathe</a>
    <h1>Einheitenrechner {year} – alle Einheiten umrechnen</h1>
  </div>
  <CalculatorShell
    calculator={calc}
    intro="Mit dem Einheitenrechner rechnen Sie verschiedene Einheiten um, darunter Länge, Gewicht, Temperatur und Volumen. Besonders nützlich für internationale Vergleiche, Reisen und technische Berechnungen zwischen metrischem und anglo-amerikanischem System. Wählen Sie einfach Kategorie und Ausgangseinheit, und alle Umrechnungen erscheinen sofort."
    sourceNote="Länge, Gewicht, Temperatur."
    explanation="Die Umrechnungsfaktoren basieren auf dem Internationalen Einheitensystem (SI), das 1960 von der Generalkonferenz für Maße und Gewichte als weltweiter Standard festgelegt wurde. Alle Längeneinheiten leiten sich mathematisch exakt vom Meter ab (1 Zoll = 2,54 cm per Definition seit 1959). Temperaturumrechnungen zwischen Celsius, Fahrenheit und Kelvin folgen linearen Formeln, wobei Kelvin als absolute Temperaturskala den physikalischen Nullpunkt bei -273,15 Grad Celsius definiert."
    faqs={[
      { q: "Welche Einheiten werden unterstützt?", a: "Länge (m, km, cm, mm, Zoll, Fuß, Yards, Meilen), Gewicht (kg, g, mg, Tonnen, Pfund, Unzen), Temperatur (Celsius, Fahrenheit, Kelvin), Volumen (Liter, Milliliter, Kubikmeter, Gallonen)." },
      { q: "Warum unterscheidet sich mein Ergebnis von anderen Rechnern?", a: "Unterschiedliche Rundungen oder Approximationen. Dieser Rechner nutzt standardisierte internationale Umrechnungsfaktoren (z.B. 1 Zoll = 2,54 cm exakt)." },
      { q: "Wie rechne ich Temperaturen um?", a: "°C zu °F: (°C × 9/5) + 32. °F zu °C: (°F − 32) × 5/9. Kelvin: K = °C + 273,15. Die Umrechnung erfolgt über Celsius als Basis." },
      { q: "Was ist der Unterschied zwischen US-Gallonen und Litern?", a: "1 US-Gallone = 3,78541 Liter. 1 Liter = 0,264172 US-Gallonen. Die US-Gallone ist kleiner als die britische Gallone (4,54609 Liter)." },
      { q: "Warum sollte ich Umrechner nutzen?", a: "Für schnelle, fehlerfreie Umrechnungen zwischen verschiedenen Einheitensystemen. Besonders praktisch bei internationalen Umrechnungen (metrisch ↔ anglo-amerikanisch), etwa bei Rezepten, Bauplänen, Reisen oder technischen Datenblättern aus den USA." },
      { q: "Wie rechne ich schnell im Kopf um?", a: "Nutzen Sie Näherungswerte: 1 kg ≈ 2,2 Pfund, 1 Meile ≈ 1,6 km, 1 Zoll ≈ 2,5 cm, 1 Liter ≈ 0,26 US-Gallonen. Für Fahrenheit gilt als grobe Faustformel: °C verdoppeln und 30 addieren ergibt ungefähr °F (20 °C → etwa 70 °F)." },
      { q: "Was ist der Unterschied zwischen Masse und Gewicht?", a: "Physikalisch ist Masse (in Kilogramm) eine Materialeigenschaft, während Gewicht die Gewichtskraft (in Newton) ist, die von der Schwerkraft abhängt. Im Alltag werden beide Begriffe aber synonym verwendet, weshalb dieser Rechner Kilogramm, Gramm und Pfund als Gewichtseinheiten führt." },
      { q: "Warum verwenden die USA nicht das metrische System?", a: "Aus historischen Gründen: Die USA haben das imperiale bzw. das davon abgeleitete US-übliche Maßsystem beibehalten. Offiziell ist das metrische System zwar zugelassen, im Alltag dominieren aber weiterhin Meilen, Fuß, Pfund und Fahrenheit. Auch Großbritannien nutzt eine Mischung aus beiden Systemen." },
      { q: "Ist die Umrechnung immer exakt?", a: "Bei Länge, Gewicht und Volumen sind die Faktoren exakt definiert (z. B. 1 Zoll = 2,54 cm), die Anzeige wird jedoch gerundet. Temperaturumrechnungen sind über die Formeln ebenfalls exakt. Kleine Abweichungen zu anderen Rechnern entstehen nur durch unterschiedliche Rundungsstellen." }
    ]}
  >
    <div class="calc-form">
      <div class="calc-group">
        <label for="kategorie">Kategorie</label>
        <select id="kategorie">
          <option value="laenge">Länge</option>
          <option value="gewicht">Gewicht</option>
          <option value="temperatur">Temperatur</option>
          <option value="volumen">Volumen</option>
        </select>
      </div>
      <div class="calc-grid">
        <div class="calc-group">
          <label for="wert">Wert</label>
          <input type="number" id="wert" value="1" step="any" />
        </div>
        <div class="calc-group">
          <label for="von">Von</label>
          <select id="von"></select>
        </div>
      </div>
      <div id="ergebnis-liste" class="ergebnis-liste"></div>
    </div>
  </CalculatorShell>

  <CalculatorGuide
    title="Internationales Einheitensystem verstehen"
    content={`<p>Weltweit sind zwei Einheitensysteme im Gebrauch. Das <strong>metrische System (SI)</strong> ist international standardisiert und wird in nahezu allen Ländern verwendet. Die <strong>anglo-amerikanischen Einheiten</strong> (Zoll, Fuß, Meile, Pfund, Fahrenheit) sind vor allem in den USA und teilweise in Großbritannien üblich. Wer Rezepte, Baupläne, Datenblätter oder Reiseangaben zwischen beiden Welten übersetzt, braucht verlässliche Umrechnungsfaktoren – dieser Rechner nutzt die exakt definierten Werte des SI (Stand 2026).</p>

<h4>Metrisches und imperiales System</h4>
<p>Das metrische System baut konsequent auf Zehnerpotenzen auf: Kilo (×1000), Zenti (÷100), Milli (÷1000). Das macht das Rechnen einfach, weil man nur das Komma verschiebt. Das imperiale System ist historisch gewachsen und arbeitet mit krummen Faktoren (12 Zoll = 1 Fuß, 3 Fuß = 1 Yard, 1760 Yards = 1 Meile). Seit 1959 sind die Umrechnungen zwischen beiden Systemen international einheitlich definiert, sodass jede Umrechnung eindeutig ist.</p>

<h4>Längeneinheiten im Überblick</h4>
<table>
  <thead>
    <tr><th>Einheit</th><th>Entspricht in Meter</th><th>Merkhilfe</th></tr>
  </thead>
  <tbody>
    <tr><td>1 Millimeter (mm)</td><td>0,001 m</td><td>Dicke einer Kreditkarte</td></tr>
    <tr><td>1 Zentimeter (cm)</td><td>0,01 m</td><td>Breite eines Fingernagels</td></tr>
    <tr><td>1 Zoll (inch)</td><td>0,0254 m (= 2,54 cm)</td><td>Daumenbreite</td></tr>
    <tr><td>1 Fuß (foot)</td><td>0,3048 m (= 12 Zoll)</td><td>etwa eine Fußlänge</td></tr>
    <tr><td>1 Yard</td><td>0,9144 m (= 3 Fuß)</td><td>ein großer Schritt</td></tr>
    <tr><td>1 Meter (m)</td><td>1 m</td><td>SI-Basiseinheit</td></tr>
    <tr><td>1 Kilometer (km)</td><td>1.000 m</td><td>ca. 12 Minuten Gehweg</td></tr>
    <tr><td>1 Meile (mile)</td><td>1.609,344 m</td><td>= 1,609 km</td></tr>
  </tbody>
</table>

<h4>Gewichtseinheiten im Überblick</h4>
<table>
  <thead>
    <tr><th>Einheit</th><th>Entspricht in Kilogramm</th><th>Alltagsbezug</th></tr>
  </thead>
  <tbody>
    <tr><td>1 Milligramm (mg)</td><td>0,000001 kg</td><td>Dosierung von Medikamenten</td></tr>
    <tr><td>1 Gramm (g)</td><td>0,001 kg</td><td>etwa eine Büroklammer</td></tr>
    <tr><td>1 Unze (oz)</td><td>0,0283495 kg (= 28,35 g)</td><td>in US-Rezepten üblich</td></tr>
    <tr><td>1 Pfund (lb)</td><td>0,453592 kg</td><td>US-Pfund (nicht das dt. 500-g-Pfund)</td></tr>
    <tr><td>1 Kilogramm (kg)</td><td>1 kg</td><td>SI-Basiseinheit</td></tr>
    <tr><td>1 Tonne (t)</td><td>1.000 kg</td><td>ein Kleinwagen</td></tr>
  </tbody>
</table>
<p>Achtung: Das englische Pfund (pound, 453,6 g) ist nicht identisch mit dem deutschen Pfund im Alltag, das genau 500 Gramm bezeichnet.</p>

<h4>Temperatur: Celsius, Fahrenheit und Kelvin</h4>
<p>Die Celsius-Skala (°C) basiert auf dem Gefrierpunkt (0 °C) und Siedepunkt (100 °C) von Wasser. Fahrenheit (°F) setzt den Gefrierpunkt bei 32 °F und den Siedepunkt bei 212 °F an. Kelvin (K) ist die absolute Temperaturskala der Physik, deren Nullpunkt bei −273,15 °C liegt. Die Umrechnungsformeln lauten:</p>
<ul>
  <li><strong>°C → °F:</strong> (°C × 9/5) + 32</li>
  <li><strong>°F → °C:</strong> (°F − 32) × 5/9</li>
  <li><strong>°C → K:</strong> °C + 273,15</li>
</ul>

<h4>Praktische Alltags-Umrechnungen</h4>
<p>Für den schnellen Überschlag im Kopf helfen diese Näherungen: 1 kg ≈ 2,2 Pfund (US), 1 Meile ≈ 1,6 km, 1 Zoll ≈ 2,5 cm, 1 US-Gallone ≈ 3,79 Liter, 0 °C = 32 °F und 20 °C ≈ 68 °F (Raumtemperatur). Bei Volumen gilt: 1 US-Gallone = 3,78541 Liter und ist damit kleiner als die britische (imperiale) Gallone mit 4,54609 Litern – ein häufiger Fehler beim Umrechnen von US- und UK-Angaben.</p>`}
    relatedSlugs={['prozent-rechner', 'mwst-rechner', 'rabatt-rechner']}
  />
</Layout>

<script>
const EINHEITEN = {
  laenge: {
    einheiten: { m:1, km:1000, cm:0.01, mm:0.001, mi:1609.344, yd:0.9144, ft:0.3048, in:0.0254 },
    labels: { m:'Meter', km:'Kilometer', cm:'Zentimeter', mm:'Millimeter', mi:'Meilen', yd:'Yards', ft:'Fuß', in:'Zoll' },
  },
  gewicht: {
    einheiten: { kg:1, g:0.001, mg:0.000001, t:1000, lb:0.453592, oz:0.0283495 },
    labels: { kg:'Kilogramm', g:'Gramm', mg:'Milligramm', t:'Tonnen', lb:'Pfund', oz:'Unzen' },
  },
  temperatur: { spezial: true },
  volumen: {
    einheiten: { l:1, ml:0.001, m3:1000, cl:0.01, gal:3.78541, fl_oz:0.0295735 },
    labels: { l:'Liter', ml:'Milliliter', m3:'Kubikmeter', cl:'Centiliter', gal:'Gallone (US)', fl_oz:'Fluid Ounce' },
  },
};

function toC(wert, von) {
  if (von==='c') return wert;
  if (von==='f') return (wert - 32) * 5/9;
  if (von==='k') return wert - 273.15;
}
function fromC(celsius, zu) {
  if (zu==='c') return celsius;
  if (zu==='f') return celsius * 9/5 + 32;
  if (zu==='k') return celsius + 273.15;
}

function updateEinheiten() {
  const kat = (document.getElementById('kategorie') as HTMLSelectElement).value;
  const vonSelect = document.getElementById('von') as HTMLSelectElement;
  vonSelect.innerHTML = '';
  if (kat === 'temperatur') {
    [['c','Celsius'],['f','Fahrenheit'],['k','Kelvin']].forEach(([v,l]) => {
      const o = document.createElement('option'); o.value=v; o.textContent=l; vonSelect.appendChild(o);
    });
  } else {
    const e = EINHEITEN[kat];
    Object.keys(e.einheiten).forEach(k => {
      const o = document.createElement('option'); o.value=k; o.textContent=e.labels[k]||k; vonSelect.appendChild(o);
    });
  }
  berechne();
}

function berechne() {
  const kat = (document.getElementById('kategorie') as HTMLSelectElement).value;
  const wert = parseFloat((document.getElementById('wert') as HTMLInputElement).value)||0;
  const von = (document.getElementById('von') as HTMLSelectElement).value;
  const liste = document.getElementById('ergebnis-liste')!;
  liste.innerHTML = '';
  if (kat === 'temperatur') {
    const celsius = toC(wert, von);
    [['c','Celsius'],['f','Fahrenheit'],['k','Kelvin']].forEach(([k,label]) => {
      if (k===von) return;
      const r = Math.round(fromC(celsius,k)*10000)/10000;
      liste.innerHTML += `<div class="conv-row"><span>${label}</span><strong>${r.toLocaleString('de-DE')}</strong></div>`;
    });
  } else {
    const e = EINHEITEN[kat];
    const inBasis = wert * (e.einheiten[von]||1);
    Object.keys(e.einheiten).forEach(k => {
      if (k===von) return;
      const r = Math.round(inBasis / e.einheiten[k] * 100000) / 100000;
      liste.innerHTML += `<div class="conv-row"><span>${e.labels[k]||k}</span><strong>${r.toLocaleString('de-DE')}</strong></div>`;
    });
  }
}

document.getElementById('kategorie')!.addEventListener('change', updateEinheiten);
document.getElementById('von')!.addEventListener('change', berechne);
document.getElementById('wert')!.addEventListener('input', berechne);
updateEinheiten();
</script>

<style>
.ergebnis-liste { margin-top: 1rem; display: grid; gap: 0.5rem; }
.conv-row { display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: white; border-radius: var(--radius); border: 1px solid var(--color-border); }
</style>
