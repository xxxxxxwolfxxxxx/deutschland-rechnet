---
import RechnerArtikel from '../RechnerArtikel.astro';
import { artikelPfadVonSlug } from '../../data/ratgeber';
import { HU_ABSTAND_MONATE } from '../../../public/scripts/wartungskosten.js';

const base = import.meta.env.BASE_URL;

// Die Wertverlustkurve ist eigene Auswertung, keine übernommene Zahl: Aus der
// ADAC-Gebrauchtwagenpreisliste Frühjahr/Sommer 2026 wurden alle Zeilen mit
// Neupreis und mindestens einer Baujahrsnotierung ausgelesen und je Altersstufe
// der Median gebildet. Marktdaten stehen deshalb als datierte Konstante mit
// Fundstelle hier oben, nicht als scheinbare Tatsache im Fließtext.
//
// Quelle: ADAC Gebrauchtwagenpreise Alle Marken, Frühjahr/Sommer 2026
// (Preisnotierungen erhoben von der Deutschen Automobil Treuhand, Stand 04/2026),
// https://assets.adac.de/Autodatenbank/Autokosten/gebrauchtwagenpreise.pdf
//
// Bis September 2026 addierte dieser Artikel Werkstattkosten aus einem
// Klassen- und Altersmodell ohne Quelle und leitete daraus "das günstigste
// Autojahr" ab. Das Modell ist entfernt; der Artikel stützt sich nur noch auf
// die Preisnotierungen und rechnet die Werkstattseite als Schwelle aus.
const STAND = 'Frühjahr/Sommer 2026';
const ERHEBUNGSJAHR = 2026;
const FAHRZEUGE_GESAMT = 9772;

// Ausgewertet wird ein Preisband statt eines einzelnen Modells: Ein Modell deckt
// in der Liste selten mehr als vier bis fünf Baujahre ab, weil Ausstattungslinien
// und Motorisierungen wechseln.
const PREISBAND = { von: 25_000, bis: 40_000 };
const MEDIAN_NEUPREIS = 32_790;
const NEUWAGEN_N = 744;
const RESTWERT_NACH_ZWEI_JAHREN = 0.669;
const JUNGWAGEN_ALTER = 2;

// Median je Altersstufe: `alter` ist das Alter zu Beginn des Haltejahres,
// `wert` der Händler-Verkaufspreis zu diesem Zeitpunkt, `verlust` der Rückgang
// bis zum Ende des Jahres, `n` die Zahl der ausgewerteten Fahrzeugzeilen.
const wertverlust = [
  { alter: 2, wert: 22_325, verlust: 1_950, quote: 0.090, n: 434 },
  { alter: 3, wert: 20_500, verlust: 1_650, quote: 0.088, n: 412 },
  { alter: 4, wert: 18_600, verlust: 1_450, quote: 0.081, n: 453 },
  { alter: 5, wert: 17_075, verlust: 1_350, quote: 0.081, n: 512 },
  { alter: 6, wert: 16_750, verlust: 1_300, quote: 0.079, n: 545 },
  { alter: 7, wert: 15_475, verlust: 1_300, quote: 0.088, n: 578 },
];
const erstes = wertverlust[0];
const letztes = wertverlust[wertverlust.length - 1];
const wertverlustRueckgang = erstes.verlust - letztes.verlust;

// Restwert nach rund zwei Jahren, aufgeschlüsselt nach Preisklasse – gleiche
// Auswertung, nur anders gruppiert.
const restwertNachPreisklasse = [
  { label: 'unter 20.000 €', restwert: 0.752, n: 42 },
  { label: '20.000–30.000 €', restwert: 0.707, n: 270 },
  { label: '30.000–45.000 €', restwert: 0.653, n: 840 },
  { label: '45.000–70.000 €', restwert: 0.625, n: 1065 },
  { label: 'über 70.000 €', restwert: 0.651, n: 597 },
];
const bestesRestwertBand = restwertNachPreisklasse.reduce((a, b) => (b.restwert > a.restwert ? b : a));
const schlechtestesRestwertBand = restwertNachPreisklasse.reduce((a, b) => (b.restwert < a.restwert ? b : a));

// Der Neuwagen als Vergleichsgröße: Wertverlust der ersten zwei Jahre je Jahr.
const jungwagenWert = MEDIAN_NEUPREIS * RESTWERT_NACH_ZWEI_JAHREN;
const neuwagenWertverlustProJahr = (MEDIAN_NEUPREIS - jungwagenWert) / JUNGWAGEN_ALTER;
const faktorNeuGegenAlt = neuwagenWertverlustProJahr / letztes.verlust;
// Der Teaser in ratgeber.ts nennt "mehr als das Vierfache".
if (faktorNeuGegenAlt <= 4) throw new Error('gebrauchtwagen-alter-kosten: Teaser "mehr als das Vierfache" stimmt nicht mehr');

// Schwelle: Um so viel dürfen die Werkstattkosten des älteren Wagens je Jahr
// höher liegen als die des Neuwagens, bevor der Neuwagen günstiger wäre.
const schwelleGegenLetztes = neuwagenWertverlustProJahr - letztes.verlust;
const schwelleGegenErstes = neuwagenWertverlustProJahr - erstes.verlust;
if (!(schwelleGegenLetztes > schwelleGegenErstes && schwelleGegenErstes > 0)) {
  throw new Error('gebrauchtwagen-alter-kosten: Wertverlustdaten widersprechen dem Text');
}

// Kilometerkorrektur aus derselben Liste, Kilometerklasse III (mittlere Laufleistung).
const KM_KLASSE = 'III';
const KM_DURCHSCHNITT_BJ2019 = 79_000;
const KM_KORREKTUR = { minder30: 0.14, mehr30: -0.11 };
const KM_SPANNE = KM_KORREKTUR.minder30 - KM_KORREKTUR.mehr30;

// Handelsspanne laut derselben Veröffentlichung.
const PRIVATMARKT_ABSCHLAG = 0.08;
const HAENDLER_EINKAUF_ABSCHLAG = { von: 0.10, bis: 0.15 };

const eur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const prozent = (n: number, stellen = 0) =>
  (n * 100).toLocaleString('de-DE', { minimumFractionDigits: stellen, maximumFractionDigits: stellen }) + ' %';
const ganz = (n: number) => n.toLocaleString('de-DE');
const faktor = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });
---
<RechnerArtikel
  titel={`Der Wertverlust halbiert sich zwischen dem dritten und dem achten Jahr – gerechnet aus ${ganz(FAHRZEUGE_GESAMT)} Gebrauchtwagenpreisen`}
  lead={`Ein Neuwagen verliert in den ersten beiden Jahren im Median ${eur(neuwagenWertverlustProJahr)} Wert pro Jahr, ein sieben Jahre alter Wagen ${eur(letztes.verlust)}. Wer den älteren fährt, kann sich ${eur(schwelleGegenLetztes)} höhere Werkstattkosten im Jahr leisten, bevor der Neuwagen günstiger wäre.`}
  datum="2026-08-14"
  quellen={[
    { titel: 'ADAC Gebrauchtwagenpreise Alle Marken, Frühjahr/Sommer 2026 (PDF, Preisnotierungen der DAT)', url: 'https://assets.adac.de/Autodatenbank/Autokosten/gebrauchtwagenpreise.pdf' },
    { titel: 'Anlage VIII StVZO (Hauptuntersuchung)', url: 'https://www.gesetze-im-internet.de/stvzo_2012/anlage_viii.html' },
    { titel: 'Deutsche Automobil Treuhand (DAT)', url: 'https://www.dat.de/' },
  ]}
>
  <p>
    Die Frage, ab wann sich ein alter Wagen nicht mehr lohnt, wird fast immer an der
    Zahl entschieden, die man sieht – der Werkstattrechnung. Der größere Posten steht
    auf keiner Rechnung: der Wertverlust. Wie er mit dem Alter verläuft, lässt sich aus
    Marktpreisen genau ablesen. Für die Werkstattkosten gibt es keine solche
    Datenbasis; sie hängen am einzelnen Fahrzeug. Dieser Artikel rechnet deshalb die
    eine Seite aus und macht aus der anderen eine Schwelle, die Sie mit Ihren eigenen
    Rechnungen vergleichen können.
  </p>
  <p>
    Datenbasis ist die ADAC-Gebrauchtwagenpreisliste {STAND}, deren Notierungen die
    Deutsche Automobil Treuhand erhebt. Aus ihr wurden alle {ganz(FAHRZEUGE_GESAMT)}
    Fahrzeugzeilen ausgelesen, die einen Neupreis und mindestens eine
    Baujahrsnotierung enthalten.
  </p>

  <h3>Wie gerechnet wurde</h3>
  <p>
    Die Liste nennt für jedes Modell den Neupreis und die aktuellen
    Händler-Verkaufspreise der Baujahre {ERHEBUNGSJAHR - 2} bis {ERHEBUNGSJAHR - 8}.
    Daraus lässt sich der Wertverlust eines Haltejahres direkt ablesen: Wer heute einen
    fünf Jahre alten Wagen kauft und ein Jahr fährt, hat danach ein Auto, das so viel
    wert ist wie heute ein sechs Jahre altes. Die Differenz zweier Preise <em>derselben
    Liste zum selben Stichtag</em> – ohne Umweg über den Neupreis, ohne Annahme über
    künftige Marktentwicklung.
  </p>
  <p>
    Ausgewertet wurde nicht ein einzelnes Modell, sondern das Preisband von
    {' '}{eur(PREISBAND.von)} bis {eur(PREISBAND.bis)} Neupreis – die
    Kompaktklasse, in der die meisten Fahrzeuge liegen. Grund: Ein Modell deckt in der
    Liste selten mehr als vier Baujahre ab, weil Ausstattungslinien und Motorisierungen
    wechseln. Angegeben ist jeweils der Median über mehrere hundert Fahrzeuge je
    Altersstufe.
  </p>

  <h3>Der Wertverlust halbiert sich</h3>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Haltejahr</th>
          <th scope="col" class="num">Wert zu Beginn</th>
          <th scope="col" class="num">Wertverlust</th>
          <th scope="col" class="num">in Prozent</th>
          <th scope="col" class="num">Fahrzeuge</th>
        </tr>
      </thead>
      <tbody>
        <tr class="neuwagen">
          <th scope="row">Neuwagen, 1. und 2. Jahr</th>
          <td class="num">{eur(MEDIAN_NEUPREIS)}</td>
          <td class="num strong">{eur(neuwagenWertverlustProJahr)}</td>
          <td class="num">{prozent((1 - RESTWERT_NACH_ZWEI_JAHREN) / JUNGWAGEN_ALTER, 1)}</td>
          <td class="num dezent">{ganz(NEUWAGEN_N)}</td>
        </tr>
        {wertverlust.map((w) => (
          <tr>
            <th scope="row">{w.alter}. auf {w.alter + 1}. Jahr</th>
            <td class="num">{eur(w.wert)}</td>
            <td class="num strong">{eur(w.verlust)}</td>
            <td class="num">{prozent(w.quote, 1)}</td>
            <td class="num dezent">{ganz(w.n)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="tabellenhinweis">
    Median über Fahrzeuge mit {eur(PREISBAND.von)} bis {eur(PREISBAND.bis)} Neupreis;
    Neuwagen: Verlust bis zur Notierung des Baujahrs {ERHEBUNGSJAHR - 2}, auf zwei Jahre verteilt.
    Quelle: ADAC-Gebrauchtwagenpreise {STAND}, eigene Auswertung.
  </p>

  <p>
    Zwei Dinge fallen auf. Erstens: <strong>Die prozentuale Verlustquote ist
    bemerkenswert konstant.</strong> Sie liegt ab dem dritten Jahr zwischen
    {' '}{prozent(Math.min(...wertverlust.map((w) => w.quote)), 1)} und
    {' '}{prozent(Math.max(...wertverlust.map((w) => w.quote)), 1)} – ein alter Wagen
    verliert prozentual kaum weniger als ein junger. Die verbreitete Vorstellung, der
    Wertverlust höre irgendwann auf, ist falsch.
  </p>
  <p>
    Zweitens, und das ist der entscheidende Punkt: <strong>In Euro halbiert er sich
    trotzdem</strong>, weil der Prozentsatz auf eine immer kleinere Basis wirkt. Vom
    dritten zum achten Jahr sinkt er von {eur(erstes.verlust)} auf
    {' '}{eur(letztes.verlust)} – ein Rückgang um {eur(wertverlustRueckgang)} pro Jahr.
    Der eigentliche Sprung liegt aber davor: Ein Neuwagen verliert in seinen ersten
    beiden Jahren {eur(neuwagenWertverlustProJahr)} pro Jahr, das
    {' '}{faktor(faktorNeuGegenAlt)}-Fache eines sieben Jahre alten Wagens.
  </p>
  <p class="hinweis">
    Methodischer Vorbehalt: Das ist ein Querschnitt, keine Kohorte. Verglichen werden
    verschiedene Fahrzeuge gleichen Alters zum selben Zeitpunkt, nicht dieselben
    Fahrzeuge über acht Jahre. Der Modellmix je Baujahr schwankt, weshalb die
    Wertspalte nicht exakt der Verlustspalte folgt. Für die Größenordnung des
    Jahresverlusts ist das unerheblich, für die absolute Höhe eines konkreten
    Fahrzeugwerts nicht.
  </p>

  <h3>Die Werkstattseite als Schwelle</h3>
  <p>
    Werkstattkosten steigen mit dem Alter – wie stark, hängt an Modell, Pflege und
    Werkstatt. Eine belastbare Durchschnittskurve nach Fahrzeugalter gibt es nicht,
    und eine geschätzte würde die Rechnung nur scheinbar genauer machen. Umgekehrt
    lässt sich aber genau sagen, wie hoch der Unterschied sein dürfte:
  </p>
  <ul>
    <li>
      Gegenüber einem drei Jahre alten Wagen spart der Neuwagen nichts, solange der
      ältere nicht mehr als <strong>{eur(schwelleGegenErstes)} im Jahr</strong> zusätzlich
      in der Werkstatt kostet.
    </li>
    <li>
      Gegenüber einem sieben Jahre alten Wagen liegt die Schwelle bei
      {' '}<strong>{eur(schwelleGegenLetztes)} im Jahr</strong>.
    </li>
  </ul>
  <p>
    Ob Ihr Wagen darunter bleibt, rechnet der Rechner am Anfang dieser Seite aus Ihren
    eigenen Rechnungen: Inspektion, Hauptuntersuchung, Reifen, Bremsen und eine
    Rücklage für Reparaturen, jeweils mit dem Intervall, in dem sie anfallen.
  </p>

  <h3>Wie hart der Anfang ausfällt, hängt vom Preis ab</h3>
  <p>
    Ein Neuwagen fällt bis zum Alter von {JUNGWAGEN_ALTER} Jahren im Median auf
    {' '}{prozent(RESTWERT_NACH_ZWEI_JAHREN, 1)} des Neupreises – ausgewertet über
    {' '}{ganz(NEUWAGEN_N)} Fahrzeuge des Preisbands mit einem mittleren Neupreis von
    {' '}{eur(MEDIAN_NEUPREIS)}. Dieselbe Auswertung, nach Neupreisklassen gruppiert:
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Neupreis</th>
          <th scope="col" class="num">Restwert nach rund {JUNGWAGEN_ALTER} Jahren</th>
          <th scope="col" class="num">Fahrzeuge</th>
        </tr>
      </thead>
      <tbody>
        {restwertNachPreisklasse.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td class="num strong">{prozent(r.restwert, 1)}</td>
            <td class="num dezent">{ganz(r.n)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="tabellenhinweis">
    Median aus den Baujahrsnotierungen {ERHEBUNGSJAHR - 2} im Verhältnis zum Neupreis.
    Quelle: ADAC-Gebrauchtwagenpreise {STAND}, eigene Auswertung.
  </p>

  <p>
    Über weite Strecken gilt: Je teurer der Neuwagen, desto größer der Anteil, der in
    den ersten beiden Jahren verschwindet. Fahrzeuge unter {eur(20_000)} Neupreis halten
    im Median {prozent(bestesRestwertBand.restwert, 1)} ihres Werts, Fahrzeuge zwischen
    {' '}{eur(45_000)} und {eur(70_000)} nur
    {' '}{prozent(schlechtestesRestwertBand.restwert, 1)}. Der Aufpreis für die größere
    Motorisierung und die längere Ausstattungsliste wird also überproportional
    abgeschrieben – bezahlt wird er beim Kauf, wiedergesehen nur zum Teil.
  </p>
  <p>
    Oberhalb von {eur(70_000)} dreht sich das leicht zurück. Wer die Klasse wechselt,
    sollte den Effekt aber nicht als Regel lesen – die Streuung innerhalb jeder
    Preisklasse ist größer als der Unterschied zwischen zwei benachbarten Klassen.
  </p>
  <p class="hinweis">
    Ein Vorbehalt gehört dazu: Der Neupreis ist die Listenpreisempfehlung. Wer einen
    Neuwagen mit Rabatt kauft, startet niedriger und verliert entsprechend weniger. Die
    Gebrauchtwagennotierungen sind dagegen Händler-Verkaufspreise, also bereits
    Marktpreise. Der Abstand fällt real also etwas kleiner aus als hier gerechnet.
  </p>

  <h3>Was die Rechnung nicht enthält</h3>
  <ul>
    <li>
      <strong>Der große Einzelschaden.</strong> Getriebe, Turbolader, Steuerkette,
      bei Elektroautos die Traktionsbatterie – solche Schäden machen alte Autos
      unberechenbarer. Wer keine Rücklage hat, kauft mit einem Gebrauchtwagen ein Risiko
      mit, das keine Preisliste zeigt.
    </li>
    <li>
      <strong>Die Hauptuntersuchung.</strong> Sie ist bei Pkw nach der ersten alle
      {' '}{HU_ABSTAND_MONATE} Monate fällig (Anlage VIII StVZO). Übersteigt die
      Mängelbeseitigung den Restwert, endet die Rechnung nicht wirtschaftlich, sondern
      praktisch.
    </li>
    <li>
      <strong>Fixkosten pro Kilometer.</strong> Versicherung und Kfz-Steuer laufen
      unabhängig vom Alter weiter. Wer wenig fährt, zahlt sie auf wenige Kilometer
      verteilt – das trifft alte wie neue Autos gleichermaßen, siehe
      {' '}<a href={`${import.meta.env.BASE_URL}${artikelPfadVonSlug('autokosten-wertverlust')}`}>Autokosten je Kilometer</a>.
    </li>
  </ul>

  <h3>Zwei Zahlen, die den Wiederverkauf betreffen</h3>
  <p>
    Die Preisliste enthält zwei Angaben, die in der Kaufentscheidung meist fehlen und
    beide gegen häufiges Wechseln sprechen.
  </p>
  <p>
    <strong>Die Handelsspanne.</strong> Die notierten Preise sind
    Händler-Verkaufspreise. Auf dem Privatmarkt liegen sie laut derselben
    Veröffentlichung rund {prozent(PRIVATMARKT_ABSCHLAG)} darunter, der
    Händler-Einkaufspreis {prozent(HAENDLER_EINKAUF_ABSCHLAG.von)} bis
    {' '}{prozent(HAENDLER_EINKAUF_ABSCHLAG.bis)}. Wer beim Händler kauft und beim
    Händler in Zahlung gibt, verliert diese Spanne bei jedem Wechsel zusätzlich zum
    Wertverlust – bei einem Fahrzeug für {eur(erstes.wert)} sind das
    {' '}{eur(erstes.wert * HAENDLER_EINKAUF_ABSCHLAG.von)} bis
    {' '}{eur(erstes.wert * HAENDLER_EINKAUF_ABSCHLAG.bis)} pro Runde.
  </p>
  <p>
    <strong>Der Kilometerstand.</strong> Für die mittlere Kilometerklasse
    {' '}{KM_KLASSE} unterstellt die Liste bei Baujahr {ERHEBUNGSJAHR - 7} eine
    Durchschnittslaufleistung von {ganz(KM_DURCHSCHNITT_BJ2019)} Kilometern.
    30.000 Kilometer darunter bedeuten einen Aufschlag von
    {' '}{prozent(KM_KORREKTUR.minder30)}, 30.000 darüber einen Abschlag von
    {' '}{prozent(Math.abs(KM_KORREKTUR.mehr30))}. Zwischen einem wenig und einem viel
    gefahrenen Wagen desselben Baujahrs liegen also rund
    {' '}{prozent(KM_SPANNE)} des Werts – bei {eur(letztes.wert)} Fahrzeugwert etwa
    {' '}{eur(letztes.wert * KM_SPANNE)}.
  </p>

  <h3>Was daraus folgt</h3>
  <ul>
    <li>
      <strong>Die Haltedauer schlägt die Modellwahl.</strong> Wer denselben Wagen länger
      fährt, verteilt den teuren Anfang auf mehr Jahre.
    </li>
    <li>
      <strong>„Zu alt" ist eine Frage der Werkstattrechnung, nicht des Baujahrs.</strong>
      Solange die jährlichen Mehrkosten gegenüber einem jüngeren Wagen unter der Schwelle
      bleiben, spricht der Wertverlust fürs Behalten – und jeder Wechsel kostet die
      Handelsspanne.
    </li>
    <li>
      <strong>Der Zeitpunkt zum Verkaufen richtet sich nach dem Zustand.</strong> Steht
      eine Reparatur an, die den Restwert übersteigt, ist die Rechnung beendet.
    </li>
  </ul>

  <h3>Den eigenen Fall rechnen</h3>
  <ul>
    <li><a href={`${base}auto/unterhaltskosten-auto/`}>Unterhaltskosten-Rechner</a> – alle Kostenblöcke, getrennt nach fix und variabel</li>
    <li><a href={`${base}auto/km-kostenrechner/`}>Kilometerkosten-Rechner</a> – Vollkosten je gefahrenem Kilometer</li>
    <li><a href={`${base}auto/kfz-versicherung-rechner/`}>Kfz-Versicherungsrechner</a> – was eine Schadenmeldung an Rückstufung kostet</li>
    <li><a href={`${import.meta.env.BASE_URL}${artikelPfadVonSlug('kfz-steuer-erstzulassung')}`}>Kfz-Steuer nach Erstzulassung</a> – warum ältere Fahrzeuge hier oft besser dastehen</li>
  </ul>

  <p class="hinweis">
    Datengrundlage: ADAC Gebrauchtwagenpreise Alle Marken {STAND} (Stand 04/2026),
    Preisnotierungen der Deutschen Automobil Treuhand, eigene Auswertung von
    {' '}{ganz(FAHRZEUGE_GESAMT)} Fahrzeugzeilen. Die Notierungen gelten für unfallfreie,
    verkehrssichere Fahrzeuge mit mindestens zwölf Monaten Hauptuntersuchung und
    durchschnittlicher Laufleistung. Werkstattkosten sind nicht Teil der Auswertung.
  </p>
</RechnerArtikel>

<style>
.table-wrap {
  overflow-x: auto;
  margin: 1.5rem 0 0.5rem;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.87rem;
  background: white;
}
thead th {
  background: var(--dark);
  color: white;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 600;
  padding: 0.7rem 0.6rem;
  text-align: left;
  white-space: nowrap;
}
tbody th {
  text-align: left;
  font-weight: 600;
  padding: 0.6rem;
  min-width: 15ch;
}
tbody td { padding: 0.6rem; }
tbody tr:nth-child(even) { background: var(--surface); }
tbody tr.neuwagen { background: #fdf6e3; }
tbody tr.neuwagen th { font-style: italic; }
tbody tr.minimum { background: var(--cat-light, #eef2ff); }
tbody tr.minimum th, tbody tr.minimum td { font-weight: 700; }
.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.strong { font-weight: 700; }
.dezent { color: var(--text-light); font-size: 0.8rem; }
.marke {
  display: block;
  font-weight: 400;
  font-size: 0.72rem;
  color: var(--red);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.tabellenhinweis {
  font-size: 0.78rem !important;
  color: var(--text-light);
  margin: 0 0 1.5rem !important;
}

.hinweis {
  margin-top: 1.5rem;
  padding: 0.9rem 1.1rem;
  background: var(--surface);
  border-left: 3px solid var(--gold);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 0.85rem !important;
  line-height: 1.6 !important;
