---
import CategoryHero from './CategoryHero.astro';
import RelatedLinks from './RelatedLinks.astro';
import { CATEGORIES, type Calculator } from '../data/calculators';
import PageByline from './PageByline.astro';
import { getLastModifiedMap } from '../utils/lastModified.mjs';
import { artikelZuRechner, artikelPfad } from '../data/ratgeber';

interface Props {
  calculator: Calculator;
  intro: string;
  sourceNote: string;
  explanation?: string;
  faqs?: Array<{ q: string; a: string }>;
}
const { calculator, intro, sourceNote, explanation, faqs } = Astro.props;
const cat = CATEGORIES[calculator.category];
const base = import.meta.env.BASE_URL;
const siteUrl = import.meta.env.SITE ?? 'https://deutschland-rechnet.de';

const pagePath = `${base}${calculator.category}/${calculator.slug}/`;
const pageUrl = `${siteUrl}${pagePath}`;

// Echtes Commit-Datum der Seite. Ohne Git-Historie bleibt es undefined und
// weder Schema noch sichtbarer Hinweis behaupten dann eine Aktualität.
const lastModified = getLastModifiedMap().get(pagePath);

// Gesundheitsrechner brauchen einen medizinischen Haftungsausschluss auf der
// Seite selbst. Der allgemeine Vorbehalt im Impressum deckt nur Steuer- und
// Rechtsthemen ab, und AdSense bewertet Gesundheitsinhalte gesondert.
const isHealth = calculator.category === 'gesundheit';

// Die Ratgeber-Artikel hingen bisher allein am Ratgeber-Index. Von 111
// Rechnerseiten verlinkte genau eine ihren Artikel – entsprechend wenig
// interne Linkkraft kam bei den Texten an.
const artikel = artikelZuRechner(calculator.slug);

// Verantwortlich ist eine reale, im Impressum genannte Person. Google bewertet
// Rechner zu Geld- und Gesundheitsthemen (YMYL) auch nach solchen Signalen.
const author = {
  "@type": "Person",
  "name": "Matthias Dührkop",
  "url": `${siteUrl}${base}ueber-uns/`
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": `${calculator.title} - Deutschland rechnet`,
  "applicationCategory": "CalculatorApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  },
  "inLanguage": "de-DE",
  "url": pageUrl,
  "description": calculator.description,
  "author": author,
  "publisher": {
    "@type": "Organization",
    "name": "Deutschland rechnet",
    "url": `${siteUrl}${base}`
  },
  ...(lastModified ? { "dateModified": lastModified } : {})
};


const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
} : null;
---
<article>
  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <CategoryHero
    color={cat.color}
    image={cat.image}
    label={cat.label}
    text={intro}
    base={base}
  />

  <div class="calc-wrapper" style={`--accent: ${cat.color};`}>
    <slot />
    {explanation && (
      <div class="explanation">
        <h2>So wird gerechnet</h2>
        <p>{explanation}</p>
      </div>
    )}
    {isHealth && (
      <p class="health-disclaimer">
        <strong>Kein Ersatz für ärztlichen Rat:</strong> Diese Berechnung dient
        der allgemeinen Information. Sie stellt keine Diagnose, keine Therapie­empfehlung
        und keine medizinische Beratung dar. Bei gesundheitlichen Fragen oder
        Beschwerden wenden Sie sich bitte an eine Ärztin oder einen Arzt.
      </p>
    )}
    <p class="source-note">{sourceNote}</p>
    <PageByline path={pagePath} />
  </div>

  <!-- Der redaktionelle Teil dieser Seite, sofern sie einen hat. Steht bewusst
       direkt unter dem Rechner und vor den FAQ: Wer gerechnet hat, liest hier
       weiter, warum das Ergebnis so aussieht. -->
  <slot name="artikel" />

  {artikel.length > 0 && (
    <aside class="artikel-hinweis" style={`--accent: ${cat.color};`}>
      <h2>{artikel.length === 1 ? 'Der Artikel dazu' : 'Die Artikel dazu'}</h2>
      <ul>
        {artikel.map((a) => (
          <li>
            <a href={`${base}${artikelPfad(a)}`}>{a.titel}</a>
            <p>{a.teaser}</p>
          </li>
        ))}
      </ul>
    </aside>
  )}

  {faqs && faqs.length > 0 && (
    <div class="faq-section">
      <h2>Häufige Fragen</h2>
      <div class="faq-items">
        {faqs.map((faq) => (
          <div class="faq-item">
            <h4 class="faq-question">{faq.q}</h4>
            <div class="faq-answer">{faq.a}</div>
          </div>
        ))}
      </div>
    </div>
  )}

  <RelatedLinks current={calculator} />
</article>

<style>
.calc-wrapper {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-top: 3px solid var(--accent);
  border-radius: var(--radius);
  padding: 1.75rem;
  box-shadow: var(--shadow-sm);
  margin-bottom: 1.5rem;
}
.explanation {
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 1rem 1.25rem;
  margin: 1rem 0;
}
.explanation h2 {
  font-size: 0.9rem;
  font-family: var(--font-ui);
  font-weight: 600;
  color: var(--text);
  margin-bottom: 0.5rem;
}
.explanation p {
  font-size: 0.875rem;
  line-height: 1.6;
  margin: 0;
  color: var(--text);
}
.health-disclaimer {
  margin: 1rem 0 0;
  padding: 0.75rem 1rem;
  background: #fff8e6;
  border-left: 3px solid #e0a800;
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--text);
}
.source-note {
  font-size: 0.78rem;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 1rem;
  margin-bottom: 0;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border);
}
.artikel-hinweis {
  margin-bottom: 1.5rem;
  padding: 1.5rem 1.75rem;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-left: 4px solid var(--accent);
  border-radius: var(--radius);
}
.artikel-hinweis h2 {
  font-family: var(--font-ui);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  margin-bottom: 0.9rem;
}
.artikel-hinweis ul { list-style: none; margin: 0; padding: 0; }
.artikel-hinweis li + li {
  margin-top: 1.1rem;
  padding-top: 1.1rem;
  border-top: 1px solid var(--border);
}
.artikel-hinweis li > a {
  font-family: var(--font-display);
  font-size: 1.08rem;
  line-height: 1.3;
  font-weight: 600;
  color: var(--text);
  text-decoration: none;
}
.artikel-hinweis li > a:hover { color: var(--accent); text-decoration: underline; }
.artikel-hinweis p {
  margin: 0.35rem 0 0;
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--text-light);
}
.faq-section {
  margin-bottom: 1.5rem;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 1.75rem;
}
.faq-section h2 {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 1rem;
}
.faq-items {
  display: grid;
  gap: 0.75rem;
}
.faq-item {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 1rem;
  background: var(--bg);
}
.faq-question {
  font-weight: 600;
  color: var(--text);
  margin-bottom: 0.4rem;
  font-size: 0.95rem;
}
.faq-answer {
  color: var(--text-light);
  line-height: 1.5;
  font-size: 0.9rem;
  margin: 0;
}

/* Result action buttons */
.result-actions {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.75rem;
  flex-wrap: wrap;
}
.result-actions button {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.15s ease;
}
.result-actions button:hover {
  background: var(--surface);
  color: var(--accent);
  border-color: var(--accent);
}
.result-actions button:active {
  transform: scale(0.98);
}
</style>
